{
  "version": "2.0",
  "migrationStatus": "per-ticket-state-enabled",
  "mode": "agent-first",
  "orchestrator": {
    "agent": "cqlFlowOrchestrator",
    "entryStateFile": "state/run-input.json",
    "stateResolution": {
      "enabled": true,
      "ticketIdSource": "run-input.json",
      "ticketIdField": "ticketId",
      "stateFileTemplate": "state/tickets/{ticketId}",
      "pipelineStatusTemplate": "state/tickets/{ticketId}/pipeline-status.json",
      "approvalFileTemplate": "state/tickets/{ticketId}/approval-status.json",
      "masterIndexFile": "state/tickets/index.json",
      "createDirectoryIfMissing": true,
      "description": "Resolves per-ticket state paths at runtime using ticketId from run-input.json"
    }
  },
  "githubRepo": {
    "owner": "AbleHealth",
    "repo": "rules-engine",
    "baseBranch": "main",
    "drlTargetPath": "rules/mips",
    "branchPattern": "create-{measureNumber}-ab{ticketId}"
  },
  "governance": {
    "enabled": true,
    "guardrails": {
      "slashOnlyExecution": true,
      "mcpPreferredForAdo": true,
      "allowPatHttpsFallback": true,
      "patHttpsFallbackScope": "intake-cqlpaths-and-extraction-commit-content",
      "approvalRequiredBeforeConversion": true,
      "usePrSourceBranchOverMain": true,
      "ticketTraceabilityRequired": true,
      "guideReferenceRequiredInMapping": true,
      "blockPlaceholderOnlyDrl": true,
      "referenceFactModelRequired": true,
      "multiTicketStateRequired": true
    }
  },
  "agents": {
    "intake": {
      "slash": "/ticketDescriptionIntakeAgent",
      "file": ".github/agents/ticket-description-intake.agent.md",
      "promptModule": ".github/agents/prompts/intake.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json"
      ],
      "writes": [
        "artifacts/intake/<ticket-id>.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "extractor": {
      "slash": "/cql-extractor",
      "file": ".github/agents/cql-extractor.agent.md",
      "promptModule": ".github/agents/prompts/extraction.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "state/tickets/<ticket-id>/pipeline-status.json"
      ],
      "writes": [
        "artifacts/extraction/<ticket-id>.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "plan": {
      "slash": "/plan-approval",
      "file": ".github/agents/plan-approval.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "artifacts/extraction/<ticket-id>.json",
        "state/tickets/<ticket-id>/pipeline-status.json"
      ],
      "writes": [
        "artifacts/plan/<ticket-id>.md",
        "state/tickets/<ticket-id>/approval-status.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "approval": {
      "slash": "/approvalRecorder",
      "file": ".github/agents/approval-recorder.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/<ticket-id>/approval-status.json"
      ],
      "writes": [
        "state/tickets/<ticket-id>/approval-status.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "conversion": {
      "slash": "/conversion",
      "file": ".github/agents/conversion.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "requires": [
        ".github/skills/cql-to-drl/SKILL.md",
        ".github/skills/cql-to-drl/cql-to-drl-guide.md"
      ],
      "readState": [
        "run-input.json",
        "artifacts/extraction/<ticket-id>.json",
        "state/tickets/<ticket-id>/approval-status.json"
      ],
      "prerequisite": "state/tickets/<ticket-id>/approval-status.json::approved == true",
      "writes": [
        "artifacts/conversion/<cql-basename>.drl",
        "artifacts/conversion/<ticket-id>-mapping.md",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "pr": {
      "slash": "/pr-submission",
      "file": ".github/agents/pr-submission.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "artifacts/conversion/<ticket-id>-mapping.md",
        "state/tickets/<ticket-id>/pipeline-status.json"
      ],
      "writes": [
        "artifacts/pr/<ticket-id>-pr.md",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    }
  },
  "notes": {
    "migration": "Updated to support multi-ticket concurrent execution with per-ticket state directories",
    "stateResolution": "All <ticket-id> placeholders are resolved at agent runtime using ticket ID from run-input.json",
    "index": "Master index at state/tickets/index.json tracks all active tickets and their current stages",
    "backward_compatibility": "Legacy singleton files can be symlinked to current ticket if needed during transition"
  }
}
