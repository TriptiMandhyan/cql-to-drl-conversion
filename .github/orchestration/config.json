{
  "version": "2.0",
  "migrationStatus": "per-ticket-state-enabled",
  "mode": "agent-first",
  "statusCatalog": ".github/orchestration/statuses.json",
  "pipeline": {
    "name": "CQL to DRL Local Workflow",
    "stateDir": "state/tickets",
    "layout": {
      "canonical": {
        "agentsRoot": ".github/agents",
        "promptsRoot": ".github/agents/prompts",
        "skillsRoot": ".github/skills",
        "orchestrationRoot": ".github/orchestration",
        "stateRoot": "state/tickets",
        "artifactsRoot": "artifacts"
      },
      "legacyCompatibility": {
        "enabled": true,
        "notes": "Legacy singleton state may coexist, but per-ticket state is authoritative."
      }
    },
    "stateCompression": {
      "enabled": true,
      "maxRunHistory": 20,
      "maxErrorsPerStage": 10,
      "maxAgentMessages": 20,
      "warnSizeKb": 50
    },
    "auditTrail": {
      "enabled": true,
      "format": "jsonl",
      "directory": "state/tickets/<ticket-id>",
      "filePattern": "audit-<ticket-id>.jsonl",
      "summaryOnCompletion": true,
      "traceabilityMatrix": true
    },
    "adapters": {
      "githubCopilot": {
        "name": "GitHub Copilot",
        "entryPoint": ".github/copilot-instructions.md"
      }
    }
  },
  "orchestrator": {
    "agent": "cqlFlowOrchestrator",
    "entryStateFile": "state/run-input.json",
    "stateResolution": {
      "enabled": true,
      "ticketIdSource": "run-input.json",
      "ticketIdField": "ticketId",
      "stateFileTemplate": "state/tickets/{ticketId}",
      "pipelineStatusTemplate": "state/tickets/{ticketId}/pipeline-status.json",
      "approvalFileTemplate": "state/tickets/{ticketId}/approval-status.json",
      "masterIndexFile": "state/tickets/index.json",
      "createDirectoryIfMissing": true,
      "description": "Resolves per-ticket state paths at runtime using ticketId from run-input.json"
    }
  },
  "githubRepo": {
    "owner": "AbleHealth",
    "repo": "rules-engine",
    "baseBranch": "main",
    "drlTargetPath": "src/main/resources/com/ablehealth/measure",
    "jsonTargetPath": "src/main/resources/com/ablehealth/measure/{measureFamilyLower}/year{measureYear}",
    "testTargetPath": "src/test/java/com/ablehealth/measures/{measureFamilyLower}/year{measureYear}",
    "branchPattern": "feature/create-{measureFamilyLower}{measureNumber}-{measureYear}-ab{ticketId}"
  },
  "measureFamilies": {
    "default": "mips",
    "supported": [
      "mips",
      "ecqm",
      "hedis"
    ],
    "mipsBoundary": "MIPS-specific naming and DRL guidance applies only when measureFamily is mips. Other families must use family-specific naming, templates, and domain rules."
  },
  "apiPayload": {
    "enabled": true,
    "auth": {
      "url": "https://librarian.admin.ablehealth.com/auth/login",
      "method": "POST",
      "requiredEnv": [
        "API_AUTH_BASIC_TOKEN"
      ],
      "headers": {
        "Accept": "*/*",
        "User-Agent": "PostmanRuntime/7.51.1",
        "Authorization": "Basic ${API_AUTH_BASIC_TOKEN}"
      },
      "tokenJsonPath": "access_token"
    },
    "data": {
      "urlTemplate": "https://librarian.admin.ablehealth.com/api/v0/measures/{measureSpecification}/published_test",
      "measureSpecificationFormat": "{measureYearShort}-{measureFamilyLower}-{measureSlug}",
      "measureSlugFormat": "{measureFamilyLower}{measureNumberPadded}rate{rateNumber}",
      "measureSpecificationExample": "26-mips-mips007rate1",
      "method": "GET",
      "headers": {
        "Accept": "application/json",
        "Account": "QA1013",
        "lastKey": "1"
      },
      "authorizationFromAuthResponse": {
        "tokenJsonPath": "access_token",
        "headerName": "Authorization",
        "headerValueTemplate": "Bearer {token}"
      },
      "outputFilePattern": "{measureSlug}.json"
    }
  },
  "testRunFile": {
    "templatePath": "rules-engine/src/test/java/com/ablehealth/measures/mips/year2026/Year2026Mips047Test.java",
    "classNamePattern": "Year{measureYear}{measureFamilyPascal}{measureNumber}Rate{rateNumber}Test",
    "outputFilePattern": "Year{measureYear}{measureFamilyPascal}{measureNumber}Rate{rateNumber}Test.java"
  },
  "governance": {
    "enabled": true,
    "guardrails": {
      "slashOnlyExecution": true,
      "mcpPreferredForAdo": true,
      "mcpPreferredForPrMetadata": true,
      "allowPatHttpsFallback": false,
      "patHttpsFallbackScope": "disabled-mcp-only",
      "approvalRequiredBeforeConversion": false,
      "approvalRequiredBeforePrSubmission": true,
      "explicitApprovalCommandRequired": true,
      "usePrSourceBranchOverMain": true,
      "ticketTraceabilityRequired": true,
      "guideReferenceRequiredInMapping": true,
      "blockPlaceholderOnlyDrl": true,
      "referenceFactModelRequired": true,
      "multiTicketStateRequired": true
    }
  },
  "agents": {
    "intake": {
      "slash": "/ticketDescriptionIntakeAgent",
      "file": ".github/agents/ticket-description-intake.agent.md",
      "promptModule": ".github/agents/prompts/intake.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json"
      ],
      "writes": [
        "artifacts/intake/<ticket-id>.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "extractor": {
      "slash": "/cql-extractor",
      "file": ".github/agents/cql-extractor.agent.md",
      "promptModule": ".github/agents/prompts/extraction.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "state/tickets/<ticket-id>/pipeline-status.json"
      ],
      "writes": [
        "artifacts/extraction/<ticket-id>.json",
        "artifacts/plan/<ticket-id>.md",
        "state/tickets/<ticket-id>/approval-status.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "approval": {
      "slash": "/approvalRecorder",
      "file": ".github/agents/approval-recorder.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "artifacts/conversion/<ticket-id>-mapping.md",
        "artifacts/pr-assets/<ticket-id>/<measure-slug>.json",
        "artifacts/pr-assets/<ticket-id>/Year<measureYear><measureFamilyPascal><measureNumber>Rate<rateNumber>Test.java",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/<ticket-id>/approval-status.json"
      ],
      "reads": [
        "artifacts/conversion/<ticket-id>-mapping.md",
        "artifacts/pr-assets/<ticket-id>/<measure-slug>.json",
        "artifacts/pr-assets/<ticket-id>/Year<measureYear><measureFamilyPascal><measureNumber>Rate<rateNumber>Test.java",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/<ticket-id>/approval-status.json"
      ],
      "writes": [
        "state/tickets/<ticket-id>/approval-status.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "conversion": {
      "slash": "/conversion",
      "file": ".github/agents/conversion.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "requires": [
        ".github/skills/cql-to-drl/SKILL.md",
        ".github/skills/cql-to-drl/cql-to-drl-guide.md"
      ],
      "readState": [
        "run-input.json",
        "artifacts/extraction/<ticket-id>.json"
      ],
      "writes": [
        "artifacts/conversion/<measure-slug>.drl",
        "artifacts/conversion/<ticket-id>-mapping.md",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "apiArtifact": {
      "slash": "/apiArtifactBuilder",
      "file": ".github/agents/api-artifact-builder.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "artifacts/intake/<ticket-id>.json",
        "artifacts/conversion/<ticket-id>-mapping.md",
        "state/tickets/<ticket-id>/pipeline-status.json"
      ],
      "writes": [
        "artifacts/pr-assets/<ticket-id>/<measure-slug>.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "testArtifact": {
      "slash": "/testRunFileBuilder",
      "file": ".github/agents/test-run-file-builder.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "artifacts/pr-assets/<ticket-id>/<measure-slug>.json",
        "state/tickets/<ticket-id>/pipeline-status.json"
      ],
      "writes": [
        "artifacts/pr-assets/<ticket-id>/Year<measureYear><measureFamilyPascal><measureNumber>Rate<rateNumber>Test.java",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "pr": {
      "slash": "/pr-submission",
      "file": ".github/agents/pr-submission.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "artifacts/conversion/<ticket-id>-mapping.md",
        "artifacts/pr-assets/<ticket-id>/<measure-slug>.json",
        "artifacts/pr-assets/<ticket-id>/Year<measureYear><measureFamilyPascal><measureNumber>Rate<rateNumber>Test.java",
        "state/tickets/<ticket-id>/approval-status.json",
        "state/tickets/<ticket-id>/pipeline-status.json"
      ],
      "writes": [
        "artifacts/pr/<ticket-id>-pr.md",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/index.json"
      ]
    },
    "reset": {
      "slash": "/ticketStatusReset",
      "file": ".github/agents/ticket-status-reset.agent.md",
      "stateManager": "scripts/state_manager.py:TicketStateManager",
      "readState": [
        "run-input.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/<ticket-id>/approval-status.json"
      ],
      "reads": [
        "state/run-input.json",
        "state/tickets/<ticket-id>/pipeline-status.json",
        "state/tickets/<ticket-id>/approval-status.json"
      ],
      "writes": [
        "state/tickets/index.json"
      ],
      "deletes": [
        "state/tickets/<ticket-id>/",
        "artifacts/intake/<ticket-id>.json",
        "artifacts/extraction/<ticket-id>.json",
        "artifacts/extraction/<ticket-id>-fetched.json",
        "artifacts/extraction/raw/<ticket-id>/",
        "artifacts/plan/<ticket-id>.md",
        "artifacts/conversion/<ticket-id>-mapping.md",
        "artifacts/pr-assets/<ticket-id>/",
        "artifacts/pr/<ticket-id>-pr.md"
      ]
    },
    "learning": {
      "slash": "/learningAgent",
      "file": ".github/agents/learning.agent.md",
      "optional": true,
      "nonBlocking": true,
      "backgroundMode": true,
      "description": "Passive aggregation of metrics, CQL patterns, and error insights. Never blocks main pipeline.",
      "readState": [
        "run-input.json",
        "artifacts/extraction/<ticket-id>.json",
        "state/tickets/<ticket-id>/pipeline-status.json"
      ],
      "writes": [
        "state/learning/execution-metrics.json",
        "state/learning/cql-patterns.json",
        "state/learning/error-patterns.json"
      ]
    }
  },
  "notes": {
    "migration": "Updated to support multi-ticket concurrent execution with per-ticket state directories",
    "stateResolution": "All <ticket-id> placeholders are resolved at agent runtime using ticket ID from run-input.json",
    "index": "Master index at state/tickets/index.json tracks all active tickets and their current stages",
    "backward_compatibility": "Legacy singleton files can be symlinked to current ticket if needed during transition"
  }
}
