# Local secrets
.env.local
.env
config/env/.env.local
config/env/.env

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# OS and editor
.DS_Store
Thumbs.db
*.swp
.idea/

# Generated artifacts - exclude all ticket-related files
artifacts/intake/
artifacts/extraction/
artifacts/plan/
artifacts/conversion/
artifacts/pr/
artifacts/pr-assets/

# Per-ticket state - exclude all except run-input.json
state/tickets/
state/pipeline-status.json
state/approval-status.json

# Learning data (optional - can be excluded if you don't want to track learning patterns)
state/learning/

# Keep only run-input.json tracked
!state/run-input.json

# Local documentation (not for repo)
docs/todo.md

# Keep folder structure
!artifacts/**/.gitkeep
!state/.gitkeep
