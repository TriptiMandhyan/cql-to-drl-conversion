/*
define "Denominator Exclusion G2090 66+ Frailty + Dementia Med":
  *
  * Option ID: G2090
  *
  ,
  if exists "Denominator Exclusion G2090 66+ Frailty + Dementia Med"
  from sharedFrailtyLTI."Frailty Exists During Measurement Period" Frailty,
       sharedFrailtyLTI."Dementia Medications In Year Before or During Measurement Period" DementiaMed
  return
  ExtendedMeasureResultV2(
      Frailty
      , 'Evidence of Frailty' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G2090
  )
  ,
  ExtendedMeasureResultV2(
      DementiaMed
      , 'Dementia Medication' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G2090
  )*/
rule 'Year2026.Mips001Ssp.Exclusion.G2090'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp")
    $patient: Patient()
    exists queryYear2026MipsSharedFrailtyDementiaAge66To80WithAgeAnchor($program, $encounter.startDate;)
    and not (
        exists Year2026Mips001SspG2090Exclusion()
    )
then
    insert(new Year2026Mips001SspG2090Exclusion());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G2090", true);
end

rule 'Year2026.Mips001Ssp.Exclusion.G2090.ProviderAndGroup'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp")
    $patient: Patient()
    exists queryYear2026MipsSharedFrailtyDementiaAge66To80WithAgeAnchor($program, $encounter.startDate;)
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G2090", true);
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G2090", true);
end

rule 'Year2026.Mips001Ssp.Exclusion.G2090.EMR.QualityCode.Org'
when
    EncounterDenominator($measure: measure, measure == "Year2026.Mips001Ssp", $program: program, $encounter: clinicalActivity)
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 66 && getAgeInYearsAt($encounter.startDate) <= 80)
    $qualityCode: ClinicalActivity() from accumulate(
        queryYear2026MipsSharedFrailtyAge66To80WithAgeAnchorFrailtyAndDementiaQualityCodes($program, $encounter.startDate, $qc;),
        latestClinicalActivity($qc)
    )
    not(
        exists Year2026Mips001SspG2090ExclusionEMROrg()
    )
then
    insert(new Year2026Mips001SspG2090ExclusionEMROrg());
