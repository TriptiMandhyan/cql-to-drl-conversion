/*
define "Denominator Exclusion G2081 SNP/LTI":
  *
  * Option ID: G2081
  *
	exists (sharedFrailtyLTI."Has Long Term Care with Age Anchor"(start of "Denominator")) LTI // the start of the denominator encounter is AgeInYearsAt anchor
    ,
    if exists "Has Long Term Care Periods Longer Than 90 Consecutive Days" 
    from "Max Long Term Care Period Length" Period
    return
    ExtendedMeasureResultV2(
        'Long Term Care Period Duration' as name
        , "Max Long Term Care Period Length" as calculated_value
        , calculated_record = true
        , population = Exclusion
        , option_id = G2081
    ) 
    else if exists( ["Clinical Activity": "MIPS; MIPS_LTI_QUALITY_CODES"] LTI
                    where LTI.start_date during Interval[start of "Measurement Period", end of "Measurement Period"]    )  
    ExtendedMeasureResultV2(
        LTI
      , 'Evidence of Long Term Care' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G2081
  )*/
rule 'Year2026.Mips001Ssp.Exclusion.G2081'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp")
    $patient: Patient()
    exists queryYear2026MipsSharedHasLongTermCareWithAgeAnchor($program, $encounter.startDate;)
    and not (
        exists Year2026Mips001SspG2081Exclusion()
    )
then
    insert(new Year2026Mips001SspG2081Exclusion());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G2081", true);
end

rule 'Year2026.Mips001Ssp.Exclusion.G2081.ProviderAndGroup'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp")
    $patient: Patient()
    exists queryYear2026MipsSharedHasLongTermCareWithAgeAnchor($program, $encounter.startDate;)
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G2081", true);
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G2081", true);
end

rule 'Year2026.Mips001Ssp.Exclusion.G2081.EMR.PeriodDuration.Org'
when
    EncounterDenominator($measure: measure, measure == "Year2026.Mips001Ssp", $program: program, $encounter: clinicalActivity)
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 66)
    queryYear2026MipsSharedHasLongTermCarePeriodsLongerThan90ConsecutiveDays($program, $encounter.startDate, $consecutiveDays;)
    not(
        exists Year2026Mips001SspG2081ExclusionEMROrg()
    )
then
    insert(new Year2026Mips001SspG2081ExclusionEMROrg());
    controlSet.addPatientEMR($program, $patient, $measure, null, "Long Term Care Period Duration", "G2081", PopulationEnum.denominator_exclusion, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), String.valueOf($consecutiveDays), SupplementalInfoEnum.CALCULATED_VALUE_TYPE.displayName(), "Decimal");
end

rule 'Year2026.Mips001Ssp.Exclusion.G2081.EMR.QualityCode.Org'
when
    EncounterDenominator($measure: measure, measure == "Year2026.Mips001Ssp", $program: program, $encounter: clinicalActivity)
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 66)
    not( exists queryYear2026MipsSharedHasLongTermCarePeriodsLongerThan90ConsecutiveDays($program, $encounter.startDate, $days;) )
    $lti: QdmDatatype() from accumulate(
        Year2026MipsSharedFrailtyLtiQualityCodes(program == $program, $q: qualityCode),
        latestQdmDatatype($q)
    )
    not(
        exists Year2026Mips001SspG2081ExclusionEMROrg()
    )
then
    insert(new Year2026Mips001SspG2081ExclusionEMROrg());
    controlSet.addPatientEMR($program, $patient, $measure, null, "Evidence of Long Term Care", "G2081", PopulationEnum.denominator_exclusion, $lti, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lti.startDate.toString());
end

