/*
define "Indication of Glycemic Status Assessment"
(["Laboratory Test Performed": "VSAC; HBA1C_LABORATORY_TEST"]
    union ["Laboratory Test Performed": "eCQM Direct Reference Codes; GLUCOSE_MANAGEMENT_INDICATOR"]
    union ["Clinical Activity": "VSAC; HBA1C_LABORATORY_TEST"] 
    union ["Clinical Activity": "eCQM Direct Reference Codes; GLUCOSE_MANAGEMENT_INDICATOR"]
    union ["Clinical Activity" : "ABLE; MIPS_001_PERFORMANCE_MET_CPTII_3046F"]
    union ["Clinical Activity" : "ABLE; MIPS_001_PERFORMANCE_NOT_MET_CPTII_3044F"]
    union ["Clinical Activity" : "ABLE; MIPS_001_PERFORMANCE_NOT_MET_CPTII_3051F"]
    union ["Clinical Activity" : "ABLE; MIPS_001_PERFORMANCE_NOT_MET_CPTII_3052F"]
    union ["Clinical Activity" : "MIPS; 001_PERFORMANCE_MET_M1211"]
    union ["Clinical Activity" : "MIPS; 001_PERFORMANCE_MET_M1212"]
    union ["Clinical Activity" : "MIPS; 001_PERFORMANCE_NOT_MET_M1371"]
    union ["Clinical Activity" : "MIPS; 001_PERFORMANCE_NOT_MET_M1372"]
    union ["Clinical Activity" : "MIPS; 001_PERFORMANCE_NOT_MET_M1373"]) GlycemicStatus
    where GlycemicStatus.start_date during "Measurement Period"
*/
query queryYear2026Mips001SspIndicationOfGlycemicStatusAssessment(Program $program, QdmResultDataType $result)
    $result:= LaboratoryTestPerformed(
        withValueSet("VsacYear2026", "HBA1C_LABORATORY_TEST") ||
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "GLUCOSE_MANAGEMENT_INDICATOR"),
        startsDuring($program.measurementPeriod)
    )
    or $result:= ClinicalActivity(
        withValueSet("VsacYear2026", "HBA1C_LABORATORY_TEST") ||
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "GLUCOSE_MANAGEMENT_INDICATOR") ||
        withValueSet("AbleYear2026", "MIPS_001_PERFORMANCE_MET_CPTII_3046F") ||
        withValueSet("AbleYear2026", "MIPS_001_PERFORMANCE_NOT_MET_CPTII_3044F") ||
        withValueSet("AbleYear2026", "MIPS_001_PERFORMANCE_NOT_MET_CPTII_3051F") ||
        withValueSet("AbleYear2026", "MIPS_001_PERFORMANCE_NOT_MET_CPTII_3052F") ||
        withValueSet("MipsYear2026", "001_PERFORMANCE_MET_M1211") ||
        withValueSet("MipsYear2026", "001_PERFORMANCE_MET_M1212") ||
        withValueSet("MipsYear2026", "001_PERFORMANCE_NOT_MET_M1371") ||
        withValueSet("MipsYear2026", "001_PERFORMANCE_NOT_MET_M1372") ||
        withValueSet("MipsYear2026", "001_PERFORMANCE_NOT_MET_M1373"),
        startsDuring($program.measurementPeriod)
    )
end

/*
define "Date of Last Glycemic Status Assessment"
  (Last(("Indication of Glycemic Status Assessment") GlycemicStatus
          ) sort by GlycemicStatus.start_date asc) LastGlycemicStatus
    return LastGlycemicStatus.start_date
*/
rule 'Year2026.Mips001Ssp.LastGlycemicStatusAssessment'
salience 55
when
    $program: Program(rules contains "measure.Mips.2026.Mips001ssp")
    exists ( EncounterDenominator(measure == "Year2026.Mips001Ssp") )
    $lastGlycemicStatus: QdmResultDataType() from accumulate (
        queryYear2026Mips001SspIndicationOfGlycemicStatusAssessment($program, $result;),
        latestQdmResultDataType($result)
    )
then
    insert(new Year2026Mips001SspLastGlycemicStatusAssessment($lastGlycemicStatus));
end

/*
define "Lowest Glycemic Status Assessment Reading on Last Day" 
  First(((["Laboratory Test Performed": "VSAC; HBA1C_LABORATORY_TEST"]
          union ["Laboratory Test Performed": "eCQM Direct Reference Codes; GLUCOSE_MANAGEMENT_INDICATOR"]
          union ["Clinical Activity": "VSAC; HBA1C_LABORATORY_TEST"] 
          union ["Clinical Activity": "eCQM Direct Reference Codes; GLUCOSE_MANAGEMENT_INDICATOR"]) GlycemicStatusReading
        with "Date of Last Glycemic Status Assessment" LastDate
        such that GlycemicStatusReading.result_as_decimal is not null or empty 
                  and GlycemicStatusReading.start_date = LastDate.start_date)LastGlycemicStatusReading
  )sort by LastGlycemicStatusReading.result_as_decimal asc
*/
rule 'Year2026.Mips001Ssp.LowestGlycemicStatusAssessmentReadingOnLastDay'
salience 50
when
    Year2026Mips001SspLastGlycemicStatusAssessment($lastGlycemicStatusAssessment: record)
    $lowestResult: QdmResultDataType() from accumulate (
        $result: QdmResultDataType(
            withValueSet("VsacYear2026", "HBA1C_LABORATORY_TEST") ||
            withValueSet("Ecqm_Direct_Reference_CodesYear2026", "GLUCOSE_MANAGEMENT_INDICATOR"),
            resultAsDecimal != null,
            startDate == $lastGlycemicStatusAssessment.startDate
        ),
        lowestResultQdmResultDataType($result)
    )
then
    insert(new Year2026Mips001SspLowestGlycemicStatusAssessmentReadingOnLastDay($lowestResult));
end


/*
define "Last Glycemic Status Result Over Limit and Greater 9"
  (["Laboratory Test Performed": "VSAC; HBA1C_LABORATORY_TEST"]
        union ["Clinical Activity": "VSAC; HBA1C_LABORATORY_TEST"])HbA1c
    with "Date of Last Glycemic Status Assessment" LastDate
    such that (HbA1c.start_date = LastDate.start_date
               and HbA1c.result in ["ABLE; MIPS_001_HBA1C_GREATER_THAN_16_9"] )
  and not exists "Lowest Glycemic Status Assessment Reading on Last Day"
*/
rule 'Year2026.Mips001Ssp.LastGlycemicStatusResultOverLimitAndGreater9'
salience 45
when
    $program: Program(rules contains "measure.Mips.2026.Mips001ssp")
    exists ( EncounterDenominator(measure == "Year2026.Mips001Ssp") )
    not(
        exists Year2026Mips001SspLowestGlycemicStatusAssessmentReadingOnLastDay()
    )
    Year2026Mips001SspLastGlycemicStatusAssessment($lastGlycemicStatusAssessment: record)
    $lastGlycemicStatus: QdmResultDataType(
        withValueSet("VsacYear2026", "HBA1C_LABORATORY_TEST"),
        startDate == $lastGlycemicStatusAssessment.startDate,
        withValueSetInResult("AbleYear2026", "MIPS_001_HBA1C_GREATER_THAN_16_9", "ABLE")
    )
    and not (
        exists Year2026Mips001SspLastGlycemicStatusResultOverLimitAndGreater9()
    )
then
    insert(new Year2026Mips001SspLastGlycemicStatusResultOverLimitAndGreater9($lastGlycemicStatus));
end

/*
define "Last Glycemic Status Code Indicates Greater 9"  
    ((["Clinical Activity" : "ABLE; MIPS_001_PERFORMANCE_MET_CPTII_3046F"] CPTII 
            where CPTII.code_modifier not in [ "ABLE; CPT_CAT_II_MODIFIER "])
        union ["Clinical Activity" : "MIPS; 001_PERFORMANCE_MET_M1211"]) Greater9
    with "Date of Last Glycemic Status Assessment" LastDate
    such that  Greater9.start_date = LastDate.start_date
*/
rule 'Year2026.Mips001Ssp.LastGlycemicStatusCodeIndicatesGreater9'
salience 45
when
    $program: Program(rules contains "measure.Mips.2026.Mips001ssp")
    exists ( EncounterDenominator(measure == "Year2026.Mips001Ssp") )
    Year2026Mips001SspLastGlycemicStatusAssessment($lastGlycemicStatusAssessment: record)
    $lastGlycemicStatus: ClinicalActivity(
        (
            withValueSet("AbleYear2026", "MIPS_001_PERFORMANCE_MET_CPTII_3046F") &&
            !withModifierValueSet("AbleYear2026", "CPT_CAT_II_MODIFIER")
        ) ||
        withValueSet("MipsYear2026", "001_PERFORMANCE_MET_M1211"),
        startDate == $lastGlycemicStatusAssessment.startDate
    )
    and not (
        exists Year2026Mips001SspLastGlycemicStatusCodeIndicatesGreater9()
    )
then
    insert(new Year2026Mips001SspLastGlycemicStatusCodeIndicatesGreater9($lastGlycemicStatus));
end

/*
define "Last Glycemic Status Result Under Limit and Less 7"
  (["Laboratory Test Performed": "VSAC; HBA1C_LABORATORY_TEST"]
        union ["Clinical Activity": "VSAC; HBA1C_LABORATORY_TEST"])HbA1c
    with "Date of Last Glycemic Status Assessment" LastDate
    such that (HbA1c.start_date = LastDate.start_date
               and HbA1c.result in ["ABLE; MIPS_001_HBA1C_LESS_THAN_4"] )   
  and not exists "Lowest Glycemic Status Assessment Reading on Last Day"      
*/
rule 'Year2026.Mips001Ssp.LastGlycemicStatusResultUnderLimitAndLess7'
salience 45
when
    $program: Program(rules contains "measure.Mips.2026.Mips001ssp")
    exists ( EncounterDenominator(measure == "Year2026.Mips001Ssp") )
    not(
        exists Year2026Mips001SspLowestGlycemicStatusAssessmentReadingOnLastDay()
    )
    Year2026Mips001SspLastGlycemicStatusAssessment($lastGlycemicStatusAssessment: record)
    $lastGlycemicStatus: QdmResultDataType(
        withValueSet("VsacYear2026", "HBA1C_LABORATORY_TEST"),
        startDate == $lastGlycemicStatusAssessment.startDate,
        withValueSetInResult("AbleYear2026", "MIPS_001_HBA1C_LESS_THAN_4", "ABLE")
    )
    and not (
        exists Year2026Mips001SspLastGlycemicStatusResultUnderLimitAndLess7()
    )
then
    insert(new Year2026Mips001SspLastGlycemicStatusResultUnderLimitAndLess7($lastGlycemicStatus));
end

/*
define "Last Glycemic Status Code Indicates Less than 7"  
    ((["Clinical Activity" : "ABLE; MIPS_001_PERFORMANCE_NOT_MET_CPTII_3044F"] CPTII 
            where CPTII.code_modifier not in ["ABLE; CPT_CAT_II_MODIFIER"])
        union ["Clinical Activity" : "MIPS; 001_PERFORMANCE_NOT_MET_M1371"]) Less7
    with "Date of Last Glycemic Status Assessment" LastDate
    such that  Less7.start_date = LastDate.start_date   
*/
rule 'Year2026.Mips001Ssp.LastGlycemicStatusCodeIndicatesLessThan7'
salience 45
when
    $program: Program(rules contains "measure.Mips.2026.Mips001ssp")
    exists ( EncounterDenominator(measure == "Year2026.Mips001Ssp") )
    Year2026Mips001SspLastGlycemicStatusAssessment($lastGlycemicStatusAssessment: record)
    $lastGlycemicStatus: ClinicalActivity(
        (
            withValueSet("AbleYear2026", "MIPS_001_PERFORMANCE_NOT_MET_CPTII_3044F") &&
            !withModifierValueSet("AbleYear2026", "CPT_CAT_II_MODIFIER")
        ) ||
        withValueSet("MipsYear2026", "001_PERFORMANCE_NOT_MET_M1371"),
        startDate == $lastGlycemicStatusAssessment.startDate
    )
    and not (
        exists Year2026Mips001SspLastGlycemicStatusCodeIndicatesLessThan7()
    )
then
    insert(new Year2026Mips001SspLastGlycemicStatusCodeIndicatesLessThan7($lastGlycemicStatus));
end

