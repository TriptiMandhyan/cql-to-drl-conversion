/*
define "Denominator":
  exists("Denominator Encounter")
  and exists( ["Diagnosis": "MIPS; 001_DIABETES"] Diab
              where ( Interval[Diab.start_date, Diab.stop_date] overlaps "Measurement Period" 
// Consider ongoing if stop_date is not populated, onus is on the data to populate stop_dates for diagnoses that are resolved
                    or Diab.start_date during "Measurement Period"  )   )
  and exists("Medicare Payer")

define "Denominator Encounter":
  ["Clinical Activity": "MIPS; 001_ENCOUNTER"] Encounter
  where   Encounter.start_date during "Measurement Period"
          and AgeInYearsAt(Encounter.start_date) >= 18
          and AgeInYearsAt(Encounter.start_date) <= 75
          and Encounter.provider_id.hasMeasureMembership = true

define "Medicare Payer"
    "Patient"
    where Patient.payer_code_type, payer_code_value in ["ABLE; MEDICARE_PAYER"]
*/
rule 'Year2026.Mips001Ssp.Denominator'
when
    $program: Program(rules contains "measure.Mips.2026.Mips001ssp")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026","001_ENCOUNTER"),
        startsDuring($program.measurementPeriod)
    )
    and exists Diagnosis(
        withValueSet("MipsYear2026", "001_DIABETES"),
        overlaps($program.measurementPeriod) ||
        startsDuring($program.measurementPeriod)
    )
    Patient(
        getAgeInYearsAt($encounter.startDate) >= 18, 
        getAgeInYearsAt($encounter.startDate) <= 75,
        withPayerCodeValueInValueSet("AbleYear2026", "MEDICARE_PAYER")
    )
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips001Ssp"));
end

/*
define "Exclusion Required G9687 Hospice":
  *
  * Option ID: G9687
  *
  	exists(sharedHospice."Has Hospice") HospiceEvidence
  ,
  if exists "Exclusion Required G9687 Hospice" return
  ExtendedMeasureResultV2(
      HospiceEvidence
      , 'Evidence of Hospice' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9687
  )
*/
rule 'Year2026.Mips001Ssp.Exclusion.Hospice'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp")
    $patient: Patient()
    exists queryYear2026MipsSharedHashospiceInMeasurementPeriod($program;)
    and not (
        exists Year2026Mips001SspHospiceExclusion()
    )
then
    insert(new Year2026Mips001SspHospiceExclusion());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9687",true);
end

rule 'Year2026.Mips001Ssp.Exclusion.Hospice.ProviderAndGroup'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp")
    $patient: Patient()
    exists queryYear2026MipsSharedHashospiceInMeasurementPeriod($program;)
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9687",true);
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9687",true);
end

rule 'Year2026.Mips001Ssp.Exclusion.Hospice.EMR.Org'
when
    EncounterDenominator($measure: measure, measure == "Year2026.Mips001Ssp", $program: program, $encounter: clinicalActivity)
    $patient: Patient()
    $hospice: QdmDatatype() from accumulate(
        Year2026MipsSharedHasHospice($program == program, $h: hospice),
        latestQdmDatatype($h)
    )
    not(
        exists Year2026Mips001SspHospiceExclusionEMROrg()
    )
then
    insert(new Year2026Mips001SspHospiceExclusionEMROrg());
    controlSet.addPatientEMR($program, $patient, $measure, null, "Evidence of Hospice", "G9687", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

rule 'Year2026.Mips001Ssp.Exclusion.Hospice.EMR.Group'
when
    EncounterDenominator($measure: measure, measure == "Year2026.Mips001Ssp", $program: program, $encounter: clinicalActivity, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $hospice: QdmDatatype() from accumulate(
        Year2026MipsSharedHasHospice($program == program, $h: hospice),
        latestQdmDatatype($h)
    )
    $groupId: String() from $encounter.getGroupExternalIds()
    not(
        exists Year2026Mips001SspHospiceExclusionEMRGroup($groupId == groupId)
    )
then
    insert(new Year2026Mips001SspHospiceExclusionEMRGroup($groupId));
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Evidence of Hospice", "G9687", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

rule 'Year2026.Mips001Ssp.Exclusion.Hospice.EMR.Provider'
when
    EncounterDenominator($measure: measure, measure == "Year2026.Mips001Ssp", $program: program, $encounter: clinicalActivity, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    $hospice: QdmDatatype() from accumulate(
        Year2026MipsSharedHasHospice($program == program, $h: hospice),
        latestQdmDatatype($h)
    )
    not(
        exists Year2026Mips001SspHospiceExclusionEMRProvider($encounter.providerExternalId == providerId)
    )
then
    insert(new Year2026Mips001SspHospiceExclusionEMRProvider($encounter.providerExternalId));
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Hospice", "G9687", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

