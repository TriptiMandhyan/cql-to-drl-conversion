    not (
        exists Year2026Mips001SspPerformanceMetM1371Part1()
        or exists Year2026Mips001SspPerformanceMetM1371Part2()
        or exists Year2026Mips001SspPerformanceMetM1371Part3()
        or exists Year2026Mips001SspPerformanceMetM1372Part1()
        or exists Year2026Mips001SspPerformanceMetM1372Part2()
        or exists Year2026Mips001SspPerformanceMetM1373Part1()
        or exists Year2026Mips001SspPerformanceMetM1373Part2()
        or exists Year2026Mips001SspPerformanceNotMetM1211Part1()
        or exists Year2026Mips001SspPerformanceNotMetM1211Part2()
        or exists Year2026Mips001SspPerformanceNotMetM1211Part3()
    )
    Year2026Mips001SspLastGlycemicStatusRecordedWithoutResult($result: record)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1212", true);
    controlSet.addPatientEMR($program, $patient, $measure, null, "Last Glycemic Status (No Result)", "M1212", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
