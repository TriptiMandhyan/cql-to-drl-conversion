/*
define "Last Glycemic Status Recorded without Result"
  (["Laboratory Test Performed": "VSAC; HBA1C_LABORATORY_TEST"]
          union ["Laboratory Test Performed": "eCQM Direct Reference Codes; GLUCOSE_MANAGEMENT_INDICATOR"]
          union ["Clinical Activity": "VSAC; HBA1C_LABORATORY_TEST"] 
          union ["Clinical Activity": "eCQM Direct Reference Codes; GLUCOSE_MANAGEMENT_INDICATOR"]) GlycemicStatusReading
      with "Date of Last Glycemic Status Assessment" LastDate
      such that (GlycemicStatusReading.result_as_decimal is null or empty 
                  and GlycemicStatusReading.start_date = LastDate.start_date)
  and not exists "Lowest Glycemic Status Assessment Reading on Last Day"
  and not exists "Last Glycemic Status Result Over Limit and Greater 9"
  and not exists "Last Glycemic Status Result Under Limit and Less 7"
  and not exists "Last Glycemic Status Code Indicates Greater 9"
  and not exists "Last Glycemic Status Code Indicates 8 - 9"
  and not exists "Last Glycemic Status Code Indicates 7 - 8"
  and not exists "Last Glycemic Status Code Indicates Less than 7"
*/
rule 'Year2026.Mips001Ssp.LastGlycemicStatusRecordedWithoutResult'
salience 40
when
    $program: Program(rules contains "measure.Mips.2026.Mips001ssp")
    exists ( EncounterDenominator(measure == "Year2026.Mips001Ssp") )
    Year2026Mips001SspLastGlycemicStatusAssessment($lastGlycemicStatusAssessment: record)
    $lastGlycemicStatus: QdmResultDataType(
        withValueSet("VsacYear2026", "HBA1C_LABORATORY_TEST") ||
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "GLUCOSE_MANAGEMENT_INDICATOR"),
        resultAsDecimal == null,
        startDate == $lastGlycemicStatusAssessment.startDate
    )
    and not (
        exists Year2026Mips001SspLowestGlycemicStatusAssessmentReadingOnLastDay()
        or exists Year2026Mips001SspLastGlycemicStatusResultOverLimitAndGreater9()
        or exists Year2026Mips001SspLastGlycemicStatusResultUnderLimitAndLess7()
        or exists Year2026Mips001SspLastGlycemicStatusCodeIndicatesGreater9()
        or exists Year2026Mips001SspLastGlycemicStatusCodeIndicates89()
        or exists Year2026Mips001SspLastGlycemicStatusCodeIndicates78()
        or exists Year2026Mips001SspLastGlycemicStatusCodeIndicatesLessThan7()
    )
    and not (
        exists Year2026Mips001SspLastGlycemicStatusRecordedWithoutResult()
    )
then
    insert(new Year2026Mips001SspLastGlycemicStatusRecordedWithoutResult($lastGlycemicStatus));
end

/*
// Return only 1 set of extended measure results if any denominator exists, we do not need to log the encounter.
// Numerator Performance Met or Not Met should be determined with this precedence and return extended measure result for only first true Numerator definition.
define "Numerator Performance Not Met M1371":  //Precedence 1 First
  *
  * Option ID: M1371
  *
    ("Lowest Glycemic Status Assessment Reading on Last Day" LastGlycemicStatus
            where LastGlycemicStatus.result_as_decimal < 7) GlycemicResultM1371
    or exists "Last Glycemic Status Result Under Limit and Less 7"
    or exists "Last Glycemic Status Code Indicates Less than 7"
  ,
  if exists "Numerator Performance Not Met M1371" return
  ExtendedMeasureResultV2(
      Coalesce(GlycemicResultM1371, "Last Glycemic Status Result Under Limit and Less 7", "Last Glycemic Status Code Indicates Less than 7")
      , 'Last Glycemic Status' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = M1371
  )
*/
rule 'Year2026.Mips001Ssp.Gap.M1371.LowestGlycemicStatusAssessmentReadingOnLastDay'
salience 35
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp")
    $patient: Patient()
    Year2026Mips001SspLowestGlycemicStatusAssessmentReadingOnLastDay($result: record, record.resultAsDecimal < 7)
    and not (
        exists Year2026Mips001SspPerformanceMetM1371Part1()
    )
then
    insert(new Year2026Mips001SspPerformanceMetM1371Part1());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "M1371", true);
    controlSet.addPatientEMR($program, $patient, $measure, null, "Last Glycemic Status", "M1371", PopulationEnum.numerator_performance_not_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

rule 'Year2026.Mips001Ssp.Gap.M1371.LowestGlycemicStatusAssessmentReadingOnLastDay.provider'
salience 35
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp", clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    Year2026Mips001SspLowestGlycemicStatusAssessmentReadingOnLastDay($result: record, record.resultAsDecimal < 7)
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "M1371", true);
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Last Glycemic Status", "M1371", PopulationEnum.numerator_performance_not_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

