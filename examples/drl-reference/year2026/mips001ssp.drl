/*
define "Numerator Performance Met M1211": //Precedence - 4 Fourth
  *
  * Option ID: M1211
  *
    ("Lowest Glycemic Status Assessment Reading on Last Day" LastGlycemicStatus 
            where LastGlycemicStatus.result_as_decimal > 9) GlycemicResultM1211
    or exists "Last Glycemic Status Result Over Limit and Greater 9"
    or exists "Last Glycemic Status Code Indicates Greater 9"
  ,
  if exists "Numerator Performance Met M1211" return
  ExtendedMeasureResultV2(
      Coalesce(GlycemicResultM1211, "Last Glycemic Status Result Over Limit and Greater 9", "Last Glycemic Status Code Indicates Greater 9")
      , 'Last Glycemic Status' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = M1211
  )       
*/
rule 'Year2026.Mips001Ssp.Success.M1211.LowestGlycemicStatusAssessmentReadingOnLastDay'
salience -20
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp")
    $patient: Patient()
    not (
        exists Year2026Mips001SspPerformanceMetM1371Part1()
        or exists Year2026Mips001SspPerformanceMetM1371Part2()
        or exists Year2026Mips001SspPerformanceMetM1371Part3()
        or exists Year2026Mips001SspPerformanceMetM1372Part1()
        or exists Year2026Mips001SspPerformanceMetM1372Part2()
        or exists Year2026Mips001SspPerformanceMetM1373Part1()
        or exists Year2026Mips001SspPerformanceMetM1373Part2()
    )
    Year2026Mips001SspLowestGlycemicStatusAssessmentReadingOnLastDay($result: record, record.resultAsDecimal > 9)
then
    insert(new Year2026Mips001SspPerformanceNotMetM1211Part1());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1211", true);
    controlSet.addPatientEMR($program, $patient, $measure, null, "Last Glycemic Status", "M1211", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

