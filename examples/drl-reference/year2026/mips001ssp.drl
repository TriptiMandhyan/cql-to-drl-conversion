/*
define "Numerator Performance Met M1212": //Precedence - 5 Fifth
  *
  * Option ID: M1212
  *
  exists "Last Glycemic Status Recorded without Result" NoResultRecord 
  or (
      not "Numerator Performance Not Met M1373"
      and not "Numerator Performance Not Met M1372"
      and not "Numerator Performance Not Met M1371"
      and not "Numerator Performance Met M1211"
      and not "Exclusion Required G9988 Palliative Care"
      and not "Exclusion Required G9687 Hospice"
      and not "Denominator Exclusion G2081 SNP/LTI"
      and not "Denominator Exclusion G2090 66+ Frailty + Dementia Med"
      and not "Denominator Exclusion G2091 66+ Frailty and Advanced Illness"
      )
  ,
  if exists "Numerator Performance Met M1212" return
  ExtendedMeasureResultV2(
      NoResultRecord
      , 'Last Glycemic Status (No Result)' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = M1212
      )     
*/
rule 'Year2026.Mips001Ssp.Success.M1212.LastGlycemicStatusRecordedWithoutResult'
salience -35
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips001Ssp")
