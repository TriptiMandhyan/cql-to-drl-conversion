    controlSet.addPatientEMR($program, $patient, $measure, "", "Osteoporosis Screening", "G8399", PopulationEnum.numerator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
end

