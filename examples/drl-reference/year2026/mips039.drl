/*
define "Numerator Performance Not Met G8400".all:
  *
  * Option ID: G8400
  *
   not "Denominator Exclusion"
   and not "Numerator Performance Met G8399"
*/
rule 'Year2026.Mips039.Gap.G8400'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips039")
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G8400");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G8400");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalId, $measure, MeasureStatusValue.GAP, "G8400");
end
