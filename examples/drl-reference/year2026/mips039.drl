rule 'Year2026.Mips039.Success.G8399.EMR.Provider'
salience -100
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips039",
        $encounter.isPresent($encounter.providerExternalId))
    $patient: Patient()
    $latestRecord: QdmDatatype() from accumulate (
