    $result: ClinicalActivity() from accumulate (
        Year2026Mips047Success1123FClinical($clinical: record),
        latestClinicalActivity($clinical)
    )
    and not (
        exists Year2026Mips047Success1123FGroupEMR()
    )
then
    insert (new Year2026Mips047Success1123FGroupEMR());
    for (String groupExternalId : $encounter.groupExternalIds) {
        controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Advanced Directive", "1123F", PopulationEnum.numerator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    }
end

