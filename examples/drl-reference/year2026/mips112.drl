    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Mammogram", "G9899", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.getStart().toString());
end

