rule 'Year2026.Mips112.Exclusion.G9708_Mastectomy_LeftAndRight.Org'
salience -10
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips112', $encounter: clinicalActivity)
    $patient: Patient()
    not (exists Year2026Mips112ExclusionMastectomyLeftAndRightOrg())
    $leftResult: QdmDatatype() from accumulate (
        $left: QdmDatatype(
            withValueSet("VsacYear2026", "STATUS_POST_LEFT_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestQdmDatatype($left)
    )
    $rightResult: QdmDatatype() from accumulate (
        $right: QdmDatatype(
            withValueSet("VsacYear2026", "STATUS_POST_RIGHT_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestQdmDatatype($right)
    )
then
    insert(new Year2026Mips112ExclusionMastectomyLeftAndRightOrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9708");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Left Mastectomy", "G9708", PopulationEnum.denominator_exclusion, $leftResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $leftResult.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Right Mastectomy", "G9708", PopulationEnum.denominator_exclusion, $rightResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $rightResult.startDate.toString());
end

