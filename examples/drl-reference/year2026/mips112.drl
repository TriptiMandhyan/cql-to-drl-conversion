/*
define "Numerator Performance Met G9899":
  
   * Option ID: G9899
   
 ( Last ((((["Clinical Activity": "VSAC; MAMMOGRAPHY"]
            union ["Clinical Activity": "ABLE; MAMMOGRAM"]
            union ["Diagnosis": "ABLE; MAMMOGRAM"]
            union ["Clinical Activity": "ABLE; MAMMOGRAM_CPTII"]) Mamm
                  where Mamm.start_date during Interval[start of "Measurement Period" - 15 months, end of "Measurement Period"])
        union ((["Clinical Activity": "MIPS; 112_PERFORMANCE_MET_G9899"]
                union ["Clinical Activity": "MIPS; 497RATE3_PERFORMANCE_MET_M1302"] )P
                  where P.start_date during Interval[start of "Measurement Period" - 15 months, end of "Measurement Period"])
) G9899) sort by G9899.start_date
) MammogramEvidence
  
  if exists "Numerator Performance Met G9899" return
  ExtendedMeasureResultV2(
      MammogramEvidence
      , 'Mammogram' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9899
  )
*/
rule 'Year2026.Mips112.LastMammogram'
salience 50
when
    $program: Program(rules contains 'measure.Mips.2026.Mips112')
    $result: QdmDatatype() from accumulate (
        $record: QdmDatatype(
            withValueSet("VsacYear2026", "MAMMOGRAPHY") ||
            withValueSet("AbleYear2026", "MAMMOGRAM") ||
            withValueSet("AbleYear2026", "MAMMOGRAM_CPTII") ||
            withValueSet("MipsYear2026", "112_PERFORMANCE_MET_G9899") ||
            withValueSet("MipsYear2026", "497RATE3_PERFORMANCE_MET_M1302"),
            startsDuring($program.measurementPeriod.start.minusMonths(15), $program.measurementPeriod.end)
        ),
        latestQdmDatatype($record)
    )
then
    insert(new Year2026Mips112LastMammogram($result));
end

rule 'Year2026.Mips112.Success.G9899'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips112')
    $patient: Patient()
    exists Year2026Mips112LastMammogram()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "G9899");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "G9899");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.SUCCESS, "G9899");
end

rule 'Year2026.Mips112.Success.G9899.Org.EMR'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips112') 
    exists EncounterDenominator(measure == 'Year2026.Mips112', program == $program)
    $patient: Patient()
    not (exists Year2026Mips112SuccessG9899Org())
    Year2026Mips112LastMammogram($result: record)
then
    insert(new Year2026Mips112SuccessG9899Org());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112', "", "Mammogram", "G9899", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.getStart().toString());
end

rule 'Year2026.Mips112.Success.G9899.Group.EMR'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips112',
        $encounter.isPresent($encounter.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.groupExternalIds
    not (exists Year2026Mips112SuccessG9899Group(groupExternalId == $groupExternalId))
    Year2026Mips112LastMammogram($result: record)
then
