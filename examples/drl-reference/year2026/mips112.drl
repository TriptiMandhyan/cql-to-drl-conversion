end

/**
define "Numerator Performance Not Met G9900":
   *
   * Option ID: G9900
   *
  not "Denominator Exclusion Mastectomy"
  and not "Denominator Exclusion Hospice"
  and not "Denominator Exclusion Palliative Care"
  and not "Denominator Exclusion LTI"
  and not "Denominator Exclusion Frailty and Dementia Medication"
  and not "Denominator Exclusion Frailty and Advanced Illness"
  and not "Numerator Performance Met G9899"
*/
rule 'Year2026.Mips112.Gap.G9900'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips112')
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G9900");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G9900");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "G9900");
end
