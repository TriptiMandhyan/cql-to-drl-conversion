/*
define "Denominator":
  AgeInYearsAt(start of "Measurement Period") >= 41
  and AgeInYearsAt(start of "Measurement Period") < 74
  and "Patient Characteristic Sex" = 'Female'
  and exists(["Clinical Activity": "MIPS; 112_ENCOUNTER"] Encounter
    where Encounter.start_date during "Measurement Period")
    and Encounter.provider_id.hasMeasureMembership = true
     , 
  if exists "Denominator"
  from (    ["Clinical Activity": "MIPS; 112_ENCOUNTER"] Encounter
            where Encounter.start_date during "Measurement Period") MPEncounter
  return
  ExtendedMeasureResultV2(
      MPEncounter
      , 'Denominator Encounter' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator
      , option_id = all
  )
// Here we want to return the denominator encounter record that created the status
// Need to return this per status (providerPatientMeasureStatus, groupPatientMeasureStatus, PatientMeasureStatus)
*/
rule 'Year2026.Mips112Ssp.Denominator'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips112ssp')
    $patient: Patient(
        getAgeInYearsAt($program.measurementPeriod.start) >= 41,
        getAgeInYearsAt($program.measurementPeriod.start) < 74,
        isFemale(),
        withPayerCodeValueInValueSet("AbleYear2026", "MEDICARE_PAYER")
    )
    $mips112Sspencounter: ClinicalActivity(
        withValueSet("MipsYear2026", "112_ENCOUNTER"),
        startsDuring($program.measurementPeriod)
    )
then
    insert(new EncounterDenominator($program, $mips112Sspencounter, 'Year2026.Mips112Ssp'));
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', "", "Denominator Encounter", "G9899", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', "", "Denominator Encounter", "G9900", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', "", "Denominator Encounter", "G9708", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', "", "Denominator Encounter", "G9709", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', "", "Denominator Encounter", "G9992", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', "", "Denominator Encounter", "G9898", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', "", "Denominator Encounter", "G2098", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', "", "Denominator Encounter", "G2099", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());

    if ($mips112Sspencounter.isPresent($mips112Sspencounter.groupExternalIds)) {
        for (String groupExternalId : $mips112Sspencounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', groupExternalId, "Denominator Encounter", "G9899", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', groupExternalId, "Denominator Encounter", "G9900", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', groupExternalId, "Denominator Encounter", "G9708", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', groupExternalId, "Denominator Encounter", "G9709", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', groupExternalId, "Denominator Encounter", "G9992", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', groupExternalId, "Denominator Encounter", "G9898", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', groupExternalId, "Denominator Encounter", "G2098", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', groupExternalId, "Denominator Encounter", "G2099", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
        }
    }

    if ($mips112Sspencounter.isPresent($mips112Sspencounter.providerExternalId)) {
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', $mips112Sspencounter.providerExternalId, "Denominator Encounter", "G9899", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', $mips112Sspencounter.providerExternalId, "Denominator Encounter", "G9900", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', $mips112Sspencounter.providerExternalId, "Denominator Encounter", "G9708", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', $mips112Sspencounter.providerExternalId, "Denominator Encounter", "G9709", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', $mips112Sspencounter.providerExternalId, "Denominator Encounter", "G9992", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', $mips112Sspencounter.providerExternalId, "Denominator Encounter", "G9898", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', $mips112Sspencounter.providerExternalId, "Denominator Encounter", "G2098", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', $mips112Sspencounter.providerExternalId, "Denominator Encounter", "G2099", PopulationEnum.denominator, $mips112Sspencounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips112Sspencounter.startDate.toString());
    }
     
end    

/*
// Definitions
define "Bilateral Mastectomy Evidence":
    ( ["Clinical Activity": "MIPS; 112_HISTORY_OF_MASTECTOMY_G9708"] 
        union ["Clinical Activity": "MIPS; 497RATE3_DENOMINATOR_EXCLUSION_M1280"]
        union ["Clinical Activity": "VSAC; BILATERAL_MASTECTOMY"] 
        union ["Clinical Activity": "VSAC; HISTORY_OF_BILATERAL_MASTECTOMY"]
        union ["Diagnosis": "VSAC; HISTORY_OF_BILATERAL_MASTECTOMY"]
    ) D
    where D.start_date on or before end of "Measurement Period")

define "Left Mastectomy Evidence":
    (   ["Clinical Activity": "VSAC; STATUS_POST_LEFT_MASTECTOMY"]
        union ["Diagnosis": "VSAC; STATUS_POST_LEFT_MASTECTOMY"] 
    )   D
    where D.start_date on or before end of "Measurement Period"

define "Right Mastectomy Evidence":
    (   ["Clinical Activity": "VSAC; STATUS_POST_RIGHT_MASTECTOMY"]
        union ["Diagnosis": "VSAC; STATUS_POST_RIGHT_MASTECTOMY"] 
    )   D
    where D.start_date on or before end of "Measurement Period"

define "Denominator Exclusion Mastectomy":
   *  Option ID: G9708
  exists ("Bilateral Mastectomy Evidence")
  or (exists ("Left Mastectomy Evidence") and exists ("Right Mastectomy Evidence"))
  ,
  if exists "Denominator Exclusion Mastectomy"
  from "Bilateral Mastectomy Evidence" BilateralMastectomy
  return
  ExtendedMeasureResultV2(
      BilateralMastectomy
      , 'Bilateral Mastectomy' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9708
  )
  ,
  if exists "Denominator Exclusion Mastectomy"
     and not exists "Bilateral Mastectomy Evidence"
  from "Left Mastectomy Evidence" LeftMastectomy,
       "Right Mastectomy Evidence" RightMastectomy
  return
  ExtendedMeasureResultV2(
      LeftMastectomy
      , 'Left Mastectomy' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9708
  )
  ,
  ExtendedMeasureResultV2(
      RightMastectomy
      , 'Right Mastectomy' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9708
  ) */

rule 'Year2026.Mips112Ssp.Exclusion.G9708_Mastectomy_BilateralClinical'
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips112Ssp', $encounter: clinicalActivity)
    $patient: Patient()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "112_HISTORY_OF_MASTECTOMY_G9708") ||
        withValueSet("MipsYear2026", "497RATE3_DENOMINATOR_EXCLUSION_M1280") ||
        withValueSet("VsacYear2026", "BILATERAL_MASTECTOMY") ||
        withValueSet("VsacYear2026", "HISTORY_OF_BILATERAL_MASTECTOMY"),
        startsOnOrBefore($program.measurementPeriod.end)
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9708");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9708");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9708");
end

rule 'Year2026.Mips112Ssp.Exclusion.G9708_Mastectomy_BilateralClinical.Org.EMR'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips112Ssp')
    exists EncounterDenominator(measure == 'Year2026.Mips112Ssp', program == $program)
    $patient: Patient()
    not (exists Year2026Mips112SspExclusionMastectomyBilateralOrg())
    $result: QdmDatatype() from accumulate (
        $c: ClinicalActivity(
            withValueSet("MipsYear2026", "112_HISTORY_OF_MASTECTOMY_G9708") ||
            withValueSet("MipsYear2026", "497RATE3_DENOMINATOR_EXCLUSION_M1280") ||
            withValueSet("VsacYear2026", "BILATERAL_MASTECTOMY") ||
            withValueSet("VsacYear2026", "HISTORY_OF_BILATERAL_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestQdmDatatype($c)
    )
then
    insert(new Year2026Mips112SspExclusionMastectomyBilateralOrg());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips112Ssp', "", "Bilateral Mastectomy", "G9708", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

