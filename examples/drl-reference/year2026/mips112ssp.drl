rule 'Year2026.Mips112Ssp.Exclusion.G9708_Mastectomy_LeftAndRight.Org'
salience -10
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips112Ssp', $encounter: clinicalActivity)
    $patient: Patient()
    not (exists Year2026Mips112SspExclusionMastectomyLeftAndRightOrg())
    $leftResult: QdmDatatype() from accumulate (
        $left: QdmDatatype(
            withValueSet("VsacYear2026", "STATUS_POST_LEFT_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestQdmDatatype($left)
    )
    $rightResult: QdmDatatype() from accumulate (
        $right: QdmDatatype(
            withValueSet("VsacYear2026", "STATUS_POST_RIGHT_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestQdmDatatype($right)
    )
then
    insert(new Year2026Mips112SspExclusionMastectomyLeftAndRightOrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9708");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Left Mastectomy", "G9708", PopulationEnum.denominator_exclusion, $leftResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $leftResult.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Right Mastectomy", "G9708", PopulationEnum.denominator_exclusion, $rightResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $rightResult.startDate.toString());
end

rule 'Year2026.Mips112Ssp.Exclusion.G9708_Mastectomy_LeftAndRight.Group'
salience -10
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips112Ssp', $encounter: clinicalActivity,
        $encounter.isPresent($encounter.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.groupExternalIds
    not (exists Year2026Mips112SspExclusionMastectomyLeftAndRightGroup(groupExternalId == $groupExternalId))
    $leftResult: QdmDatatype() from accumulate (
        $left: QdmDatatype(
            withValueSet("VsacYear2026", "STATUS_POST_LEFT_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestQdmDatatype($left)
    )
    $rightResult: QdmDatatype() from accumulate (
        $right: QdmDatatype(
            withValueSet("VsacYear2026", "STATUS_POST_RIGHT_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestQdmDatatype($right)
    )
then
    insert(new Year2026Mips112SspExclusionMastectomyLeftAndRightGroup($groupExternalId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9708");
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Left Mastectomy", "G9708", PopulationEnum.denominator_exclusion, $leftResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $leftResult.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Right Mastectomy", "G9708", PopulationEnum.denominator_exclusion, $rightResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $rightResult.startDate.toString());
end

rule 'Year2026.Mips112Ssp.Exclusion.G9708_Mastectomy_LeftAndRight.Provider'
salience -10
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips112Ssp', $encounter: clinicalActivity,
        $encounter.isPresent($encounter.providerExternalId))
    $patient: Patient()
    not (exists Year2026Mips112SspExclusionMastectomyLeftAndRightProvider(providerExternalId == $encounter.providerExternalId))
    $leftResult: QdmDatatype() from accumulate (
        $left: QdmDatatype(
            withValueSet("VsacYear2026", "STATUS_POST_LEFT_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestQdmDatatype($left)
    )
    $rightResult: QdmDatatype() from accumulate (
        $right: QdmDatatype(
            withValueSet("VsacYear2026", "STATUS_POST_RIGHT_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestQdmDatatype($right)
    )
then
    insert(new Year2026Mips112SspExclusionMastectomyLeftAndRightProvider($encounter.providerExternalId));
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9708");
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Left Mastectomy", "G9708", PopulationEnum.denominator_exclusion, $leftResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $leftResult.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Right Mastectomy", "G9708", PopulationEnum.denominator_exclusion, $rightResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $rightResult.startDate.toString());
end

