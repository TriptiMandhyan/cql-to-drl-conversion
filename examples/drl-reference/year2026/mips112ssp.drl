/*
define "Denominator Exclusion LTI":
    
     * Option ID: G2081
     
    exists (sharedFrailtyLTI."Has Long Term Care with Age Anchor"(start of "Denominator")) LTI
    
    if exists "Has Long Term Care Periods Longer Than 90 Consecutive Days" 
    from "Max Long Term Care Period Length" Period
    return
    ExtendedMeasureResultV2(
        'Long Term Care Period Duration' as name
        , "Max Long Term Care Period Length" as calculated_value
        , calculated_record = true
        , population = Exclusion
        , option_id = G2081
    ) 
    else if exists( ["Clinical Activity": "MIPS; MIPS_LTI_QUALITY_CODES"] LTI
                    where LTI.start_date during "Measurement Period" )  
    ExtendedMeasureResultV2(
        LTI
        , 'Evidence of Long Term Care' as name
        , display_date = start_date
        , calculated_record = false
        , population = Exclusion
        , option_id = G2081
    )
*/
rule 'Year2026.Mips112Ssp.Exclusion.G9898_LTI'
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips112Ssp', $encounter: clinicalActivity)
    $patient: Patient()
    exists queryYear2026MipsSharedHasLongTermCareWithAgeAnchor($program, $encounter.startDate;)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9898");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9898");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9898");
end

