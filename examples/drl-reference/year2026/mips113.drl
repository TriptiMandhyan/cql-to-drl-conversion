global PatientResults controlSet;

import accumulate com.ablehealth.functions.LatestClinicalActivityAccumulateFunction lastClinicalActivity;
import accumulate com.ablehealth.functions.LatestQdmDatatypeAccumulateFunction latestQdmDatatype;

import accumulate com.ablehealth.functions.LatestDiagnosisAccumulateFunction latestDiagnosis;

declare Year2026Mips113PerformanceMetColonoscopy
end

declare Year2026Mips113PerformanceMetFlexSig
end

declare Year2026Mips113PerformanceMetCTColonography
end

declare Year2026Mips113PerformanceMetFecalOccult
end

declare Year2026Mips113PerformanceMetFITDNA
end

declare Year2026Mips113G9901PalliativeEMR
end

declare Year2026Mips113ExclusionHospiceEMR
end

declare Year2026Mips113ExclusionG9711EMR
end

declare Year2026Mips113G9901P1ExclusionEMR
end

declare Year2026Mips113ExclusionFrailtyAndAdvancedIllness
end

declare Year2026Mips113ExclusionFrailtyAndDementiaMedication
end

declare Year2026Mips113ExclusionLTI
end

declare Year2026Mips113ExclusionFrailtyAndAdvancedIllnessAdvancedIllnessDiagnosisEMR
end

declare Year2026Mips113ExclusionFrailtyAndAdvancedIllnessEvidenceOfFrailtyEMR
end

declare Year2026Mips113ExclusionFrailtyAndAdvancedIllnessQualityCodeEMR
end

declare Year2026Mips113ExclusionFrailtyAndAdvancedIllness
end

declare Year2026Mips113ExclusionDementiaMedicationEMR
end

declare Year2026Mips113ExclusionEvidenceOfFrailtyEMR
end
/*
//Populations
define "Denominator":
  exists(["Clinical Activity": "MIPS; 113_ENCOUNTER"] Encounter
    where Encounter.start_date during "Measurement Period")
      and AgeInYearsAt(Encounter.start_date) >= 45
      and AgeInYearsAt(Encounter.start_date) <= 75
      and E.provider_id.hasMeasureMembership = true
*/
rule 'Year2026.Mips113.Denominator'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips113')
    $mips113encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "113_ENCOUNTER"),
        startsDuring($program.measurementPeriod)
    )
    exists Patient(
        getAgeInYearsAt($mips113encounter.startDate) >= 45,
        getAgeInYearsAt($mips113encounter.startDate) <= 75
    )
then
    insert(new EncounterDenominator($program, $mips113encounter, 'Year2026.Mips113'));
end

/*
define "Denominator Exclusion Colorectal Cancer or Total Colectomy":
   *
   * Option ID: G9711
   *
  exists ("Colorectal Cancer or Total Colectomy Evidence")
  ,
  if exists "Denominator Exclusion Colorectal Cancer or Total Colectomy"
  from "Colorectal Cancer or Total Colectomy Evidence" G9711
  return
  ExtendedMeasureResultV2(
      G9711
      , 'Colorectal Cancer or Total Colectomy' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9711
  )

define "Colorectal Cancer or Total Colectomy Evidence":
    (   ["Diagnosis": "VSAC; MALIGNANT_NEOPLASM_OF_COLON"]
        union ["Diagnosis": "VSAC; TOTAL_COLECTOMY"]
        union ["Clinical Activity": "VSAC; TOTAL_COLECTOMY"]
        union ["Clinical Activity": "VSAC; MALIGNANT_NEOPLASM_OF_COLON"]
        union ["Clinical Activity": "MIPS; 113_HISTORY_OF_TOTAL_COLECTOMY_OR_COLORECTAL_CANCER"]
        union ["Clinical Activity": "MIPS; 497RATE4_DENOMINATOR_EXCLUSION_M1295"]
    ) D
    where D.start_date on or before end of "Measurement Period"
*/
rule 'Year2026.Mips113.Exclusion.G9711'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    (
        exists Diagnosis(
            withValueSet("VsacYear2026", "MALIGNANT_NEOPLASM_OF_COLON") ||
            withValueSet("VsacYear2026", "TOTAL_COLECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ) or exists ClinicalActivity(
            withValueSet("VsacYear2026", "TOTAL_COLECTOMY") ||
            withValueSet("VsacYear2026", "MALIGNANT_NEOPLASM_OF_COLON") ||
            withValueSet("MipsYear2026", "113_HISTORY_OF_TOTAL_COLECTOMY_OR_COLORECTAL_CANCER") ||
            withValueSet("MipsYear2026", "497RATE4_DENOMINATOR_EXCLUSION_M1295"),
            startsOnOrBefore($program.measurementPeriod.end)
        )
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9711");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9711");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9711");
end

rule 'Year2026.Mips113.Exclusion.G9711.EMR.Diagnosis'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    $exclusion: Diagnosis() from accumulate(
        $d: Diagnosis(
            withValueSet("VsacYear2026", "MALIGNANT_NEOPLASM_OF_COLON") ||
            withValueSet("VsacYear2026", "TOTAL_COLECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestDiagnosis($d)
    )
    and not(
        exists Year2026Mips113ExclusionG9711EMR()
    )
then
    insert(new Year2026Mips113ExclusionG9711EMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Colorectal Cancer or Total Colectomy", "G9711", PopulationEnum.denominator_exclusion, $exclusion, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $exclusion.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Colorectal Cancer or Total Colectomy", "G9711", PopulationEnum.denominator_exclusion, $exclusion, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $exclusion.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Colorectal Cancer or Total Colectomy", "G9711", PopulationEnum.denominator_exclusion, $exclusion, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $exclusion.startDate.toString());
    }
end

rule 'Year2026.Mips113.Exclusion.G9711.EMR.ClinicalActivity'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    $exclusion: ClinicalActivity() from accumulate(
        $c: ClinicalActivity(
            withValueSet("VsacYear2026", "TOTAL_COLECTOMY") ||
            withValueSet("VsacYear2026", "MALIGNANT_NEOPLASM_OF_COLON") ||
            withValueSet("MipsYear2026", "113_HISTORY_OF_TOTAL_COLECTOMY_OR_COLORECTAL_CANCER") ||
            withValueSet("MipsYear2026", "497RATE4_DENOMINATOR_EXCLUSION_M1295"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        lastClinicalActivity($c)
    )
    and not(
        exists Year2026Mips113ExclusionG9711EMR()
    )
then
    insert(new Year2026Mips113ExclusionG9711EMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Colorectal Cancer or Total Colectomy", "G9711", PopulationEnum.denominator_exclusion, $exclusion, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $exclusion.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Colorectal Cancer or Total Colectomy", "G9711", PopulationEnum.denominator_exclusion, $exclusion, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $exclusion.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Colorectal Cancer or Total Colectomy", "G9711", PopulationEnum.denominator_exclusion, $exclusion, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $exclusion.startDate.toString());
    }
end

/*
define "Denominator Exclusion Hospice":
   *
   * Option ID: G9710
   *
  exists (sharedHospice."Has Hospice") HospiceEvidence
  ,
  if exists "Denominator Exclusion Hospice" return
  ExtendedMeasureResultV2(
      HospiceEvidence
      , 'Evidence of Hospice' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9710
  )
*/
rule 'Year2026.Mips113.Exclusion.Hospice'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    exists queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $hospice;)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9710");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9710");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9710");
end

rule 'Year2026.Mips113.Exclusion.Hospice.EMR'
when
    EncounterDenominator($program: program, $measure: measure, measure == "Year2026.Mips113", $encounter: clinicalActivity)
    $patient: Patient()
    Year2026MipsSharedHasHospice(program == $program, $hospice:hospice)
    and not (
        exists Year2026Mips113ExclusionHospiceEMR()
    )
then
    insert(new Year2026Mips113ExclusionHospiceEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Hospice", "G9710", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Evidence of Hospice", "G9710", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Hospice", "G9710", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
    }
end

