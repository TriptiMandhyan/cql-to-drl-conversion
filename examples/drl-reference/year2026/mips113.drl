/*
define "Numerator Performance Met 3017F":
   *
   * Option ID: 3017F
   *
  exists ("3017F Quality Code Evidence") QualityCodeEvidence
  ,
  if exists "Numerator Performance Met 3017F" return
  ExtendedMeasureResultV2(
      QualityCodeEvidence
      , 'Colorectal Screening Quality Code' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = 3017F
  )

define "3017F Quality Code Evidence":
    Last (
        (   (["Clinical Activity": "MIPS; 113_PERFORMANCE_MET_3017F"] P
                where P.start_date during "Measurement Period"
                and (P.code_modifiers not in {'8P'}
                    or P.code_modifiers is null))
            union (["Clinical Activity": "MIPS; 497RATE4_PERFORMANCE_MET_M1277"] QC
                where QC.start_date during "Measurement Period")
        ) sort by start_date
    )  
*/
rule 'Year2026.Mips113.Success.3017F'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    $perfMet: ClinicalActivity() from accumulate (
        $c: ClinicalActivity(
            (withValueSet("MipsYear2026", "113_PERFORMANCE_MET_3017F") &&
            startsDuring($program.measurementPeriod) &&
            withCodeModifiersNotIn("8P")) ||
            (withValueSet("MipsYear2026", "497RATE4_PERFORMANCE_MET_M1277") &&
            startsDuring($program.measurementPeriod))
        ),
        lastClinicalActivity($c)
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "3017F");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Colorectal Screening Quality Code", "3017F", PopulationEnum.numerator_performance_met, $perfMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $perfMet.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Colorectal Screening Quality Code", "3017F", PopulationEnum.numerator_performance_met, $perfMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $perfMet.startDate.toString());
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.SUCCESS, "3017F");
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Colorectal Screening Quality Code", "3017F", PopulationEnum.numerator_performance_met, $perfMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $perfMet.startDate.toString());
        controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "3017F");
    }
end

/*
define "Numerator Performance Met Colonoscopy":
   *
   * Option ID: performance_met_colonoscopy
   *
  exists ("Colonoscopy") Colonoscopy
  ,
  if exists "Numerator Performance Met Colonoscopy" return
  ExtendedMeasureResultV2(
      Colonoscopy
      , 'Colonoscopy' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = performance_met_colonoscopy
  )

define "Colonoscopy":
    Last (
        (["Clinical Activity": "VSAC; COLONOSCOPY"] P
            where P.start_date during Interval[start of "Measurement Period" - 9 years, end of "Measurement Period"]
        ) sort by start_date
    ) 
*/
rule 'Year2026.Mips113.Success.Colonoscopy'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient() 
    $colonoscopy: ClinicalActivity() from accumulate (
        $c: ClinicalActivity(
            withValueSet("VsacYear2026", "COLONOSCOPY"),
            startsDuring($program.measurementPeriod.start.minusYears(9), $program.measurementPeriod.end)
        ),
        lastClinicalActivity($c)
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "performance_met_colonoscopy");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Colonoscopy", "performance_met_colonoscopy", PopulationEnum.numerator_performance_met, $colonoscopy, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $colonoscopy.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.SUCCESS, "performance_met_colonoscopy");
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Colonoscopy", "performance_met_colonoscopy", PopulationEnum.numerator_performance_met, $colonoscopy, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $colonoscopy.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "performance_met_colonoscopy");
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Colonoscopy", "performance_met_colonoscopy", PopulationEnum.numerator_performance_met, $colonoscopy, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $colonoscopy.startDate.toString());
    }
end

