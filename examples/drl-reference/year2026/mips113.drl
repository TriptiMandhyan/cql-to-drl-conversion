/*

define "Denominator Exclusion LTI":
   *
   * Option ID: G9901
   *
  exists (sharedFrailtyLTI."Has Long Term Care with Age Anchor"(start of "Denominator Encounter")) LTIEvidence
  ,
  if exists "Denominator Exclusion LTI" return
  ExtendedMeasureResultV2(
      LTIEvidence
      , 'Evidence of SNP/LTI' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9901
  )
*/

rule 'Year2026.Mips113.Exclusion.LTI'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    exists queryYear2026MipsSharedHasLongTermCareWithAgeAnchor($program, $encounter.startDate;)
then
    insert (new Year2026Mips113ExclusionLTI());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9901");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9901");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9901");
end

rule 'Year2026.Mips113.Exclusion.LTI.LongTermCarePeriodDuration.EMR'
when
    EncounterDenominator($measure: measure, measure == "Year2026.Mips113", $program: program, $encounter: clinicalActivity)
    $patient: Patient()
    queryYear2026MipsSharedHasLongTermCarePeriodsLongerThan90ConsecutiveDays($program, $encounter.startDate, $consecutiveDays;)
    exists Year2026Mips113ExclusionLTI()
    and not(
        exists Year2026Mips113G9901P1ExclusionEMR()
    )
then
    insert(new Year2026Mips113G9901P1ExclusionEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Long Term Care Period Duration", "G9901", PopulationEnum.denominator_exclusion, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), $consecutiveDays.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Long Term Care Period Duration", "G9901", PopulationEnum.denominator_exclusion, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), $consecutiveDays.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Long Term Care Period Duration", "G9901", PopulationEnum.denominator_exclusion, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), $consecutiveDays.toString());
    }
end

rule 'Year2026.Mips113.Exclusion.G9901.EvidenceOfLongTermCare.EMR'
when
    EncounterDenominator($measure: measure, measure == "Year2026.Mips113", $program: program, $encounter: clinicalActivity)
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 66)
    Year2026MipsSharedFrailtyLtiQualityCodes(program == $program, $clinical: qualityCode)
    exists Year2026Mips113ExclusionLTI()
    and not(
        exists Year2026Mips113G9901P1ExclusionEMR()
    )
then
    insert(new Year2026Mips113G9901P1ExclusionEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Long Term Care", "G9901", PopulationEnum.denominator_exclusion, $clinical, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $clinical.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Evidence of Long Term Care", "G9901", PopulationEnum.denominator_exclusion, $clinical, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $clinical.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Long Term Care", "G9901", PopulationEnum.denominator_exclusion, $clinical, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $clinical.startDate.toString());
    }
end
/*
define "Denominator Exclusion Frailty and Dementia Medication":
   *
   * Option ID: G2100
   *
  exists (sharedFrailtyLTI."Is 66 to 80 with Frailty and Dementia Meds with Age Anchor"(start of "Denominator Encounter"))
  ,
  if exists "Denominator Exclusion Frailty and Dementia Medication"
  from sharedFrailtyLTI."Frailty Exists During Measurement Period" Frailty,
       sharedFrailtyLTI."Dementia Medications In Year Before or During Measurement Period" DementiaMed
  return
  ExtendedMeasureResultV2(
      Frailty
      , 'Evidence of Frailty' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G2100
  )
  ,
  ExtendedMeasureResultV2(
      DementiaMed
      , 'Dementia Medication' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G2100
  )
*/

rule 'Year2026.Mips113.Exclusion.FrailtyAndDementiaMedication'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    exists queryYear2026MipsSharedFrailtyDementiaAge66To80WithAgeAnchor($program, $encounter.startDate;)
then
    insert (new Year2026Mips113ExclusionFrailtyAndDementiaMedication());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G2100");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G2100");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G2100");
end

rule 'Year2026.Mips113.Exclusion.EvidenceOfFrailty.EMR'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 66 && getAgeInYearsAt($encounter.startDate) <= 80)
    exists Year2026Mips113ExclusionFrailtyAndDementiaMedication()
    queryYear2026MipsSharedFrailtyAge66To80WithAgeAnchorFrailtyExists($program, $encounter.startDate, $result;)
    and not(
        exists Year2026Mips113ExclusionEvidenceOfFrailtyEMR()
    )
then
    insert (new Year2026Mips113ExclusionEvidenceOfFrailtyEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Frailty", "G2100", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Evidence of Frailty", "G2100", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Frailty", "G2100", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    }
end

rule 'Year2026.Mips113.Exclusion.DementiaMedication.EMR'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 66 && getAgeInYearsAt($encounter.startDate) <= 80)
    exists Year2026Mips113ExclusionFrailtyAndDementiaMedication()
    queryYear2026MipsSharedFrailtyAge66To80WithAgeAnchorDementiaMedications($program, $encounter.startDate, $result;)
    and not(
        exists Year2026Mips113ExclusionDementiaMedicationEMR()
    )
then
    insert (new Year2026Mips113ExclusionDementiaMedicationEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Dementia Medication", "G2100", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Dementia Medication", "G2100", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Dementia Medication", "G2100", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    }
end

/*
define "Denominator Exclusion Frailty and Advanced Illness":
   *
   * Option ID: G2101
   *
  exists (sharedFrailtyLTI."Is 66 to 80 with Frailty and Advanced Illness with Age Anchor"(start of "Denominator Encounter"))
  ,
  if exists "Denominator Exclusion Frailty and Advanced Illness"
  from sharedFrailtyLTI."Frailty and Advanced Illness Quality Code" QualityCode
  return
  ExtendedMeasureResultV2(
      QualityCode
      , 'Frailty and Advanced Illness Quality Code' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G2101
  )
  ,
  if exists "Denominator Exclusion Frailty and Advanced Illness"
     and not exists sharedFrailtyLTI."Frailty and Advanced Illness Quality Code"
  from sharedFrailtyLTI."Frailty Exists During Measurement Period" Frailty,
       sharedFrailtyLTI."Advanced Illness in Measurement Period or Year Prior" AdvancedIllness
  return
  ExtendedMeasureResultV2(
      Frailty
      , 'Evidence of Frailty' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G2101
  )
  ,
  ExtendedMeasureResultV2(
      AdvancedIllness
      , 'Advanced Illness Diagnosis' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G2101
  ) 
*/

rule 'Year2026.Mips113.Exclusion.FrailtyAndAdvancedIllness'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    exists queryYear2026MipsSharedFrailtyAdvancedIllnessAge66To80WithAgeAnchor($program, $encounter.startDate;)
then
    insert (new Year2026Mips113ExclusionFrailtyAndAdvancedIllness());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G2101");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G2101");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G2101");
end

rule 'Year2026.Mips113.Exclusion.FrailtyAndAdvancedIllness.QualityCode.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    exists Year2026Mips113ExclusionFrailtyAndAdvancedIllness()
    $result: Diagnosis() from accumulate(
        queryYear2026MipsSharedFrailtyAge66To80WithAgeAnchorFrailtyAndAdvancedIllnessQualityCodes($program, $encounter.startDate, $diag;),
        latestDiagnosis($diag)
    )
    and not(
        exists Year2026Mips113ExclusionFrailtyAndAdvancedIllnessQualityCodeEMR()
    )
then
    insert (new Year2026Mips113ExclusionFrailtyAndAdvancedIllnessQualityCodeEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Frailty and Advanced Illness Quality Code", "G2101", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Frailty and Advanced Illness Quality Code", "G2101", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Frailty and Advanced Illness Quality Code", "G2101", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    }
end

rule 'Year2026.Mips113.Exclusion.FrailtyAndAdvancedIllness.EvidenceOfFrailty.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips113')
    $patient: Patient()
    exists Year2026Mips113ExclusionFrailtyAndAdvancedIllness()
    $result: QdmDatatype() from accumulate(
        queryYear2026MipsSharedFrailtyAge66To80WithAgeAnchorFrailtyExists($program, $encounter.startDate, $qdm;),
        latestQdmDatatype($qdm)
    )
    and not(
        exists Year2026Mips113ExclusionFrailtyAndAdvancedIllnessEvidenceOfFrailtyEMR()
    )
then
    insert (new Year2026Mips113ExclusionFrailtyAndAdvancedIllnessEvidenceOfFrailtyEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Frailty", "G2101", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Evidence of Frailty", "G2101", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Frailty", "G2101", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    }
end

