/*
define "Numerator Performance Met-M1221":
   *
   * Option ID: M1221
   *
 ((["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_M1221"] P
      where P.start_date during "Measurement Period")

  union (["Clinical Activity": "ABLE; MIPS117_CPTII_2023F"] CPTII
        where (CPTII.start_date during "Measurement Period"
              and (CPTII.code_modifiers not in {'8P'}
                  or CPTII.code_modifiers isEmpty
                  or CPTII.code_modifiers = null)))

  union((["Clinical Activity": "VSAC; RETINAL_OR_DILATED_EYE_EXAM"]) E
    where E.start_date during "Measurement Period")
    and not exists(["Diagnosis": "VSAC; DIABETIC_RETINOPATHY"] D
      where Interval[D.start_date, D.stop_date] overlaps "Measurement Period"
          )
)DiabeticEyeExamNoRenopathy
  ,
  if exists ( (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_M1221"] P
                    where P.start_date during "Measurement Period")
              union (["Clinical Activity": "ABLE; MIPS117_CPTII_2023F"] CPTII
                    where( CPTII.start_date during "Measurement Period"
                          and (CPTII.code_modifiers not in {'8P'}
                              or CPTII.code_modifiers isEmpty
                              or CPTII.code_modifiers = null))))DilatedExamNoRenopathyCode 
  then return
    ExtendedMeasureResultV2(
       DilatedExamNoRenopathyCode//return 1 record even if multiple exist
        , 'Dilated Eye Exam without Retinopathy Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1221
    )
    else from
    (["Clinical Activity": "VSAC; RETINAL_OR_DILATED_EYE_EXAM"] ) E
          where E.start_date during "Measurement Period"
          and not exists (["Diagnosis": "VSAC; DIABETIC_RETINOPATHY"] D
                      where Interval[D.start_date, D.stop_date] overlaps "Measurement Period")
    return
    ExtendedMeasureResultV2(
      E //return 1 record even if multiple exist
        , 'Retinal Eye Exam no Retinopathy Diagnosis' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1221
    )
*/
