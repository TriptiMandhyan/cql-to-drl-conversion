/*
define "Numerator Performance Met: M1429":
  *
  * Option ID: M1429
  *
exists (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_M1429"] P
          where P.start_date during "Measurement Period")
         
or exists ((["eCQM Direct Reference Codes; LEFT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] LeftEyeExam
                  where LeftEyeExam.start_date during "Measurement Period"
                        and LeftEyeExam.result in ["VSAC; DIABETIC_RETINOPATHY_SEVERITY_LEVEL"]
                        and LeftEyeExam.result not in  ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"])
              and exists (["eCQM Direct Reference Codes; RIGHT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] RightEyeExam
                  where RightEyeExam.start_date during "Measurement Period"
                        and RightEyeExam.result in ["VSAC; DIABETIC_RETINOPATHY_SEVERITY_LEVEL"]
                        and RightEyeExam.result not in  ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"]))

or exists ((["eCQM Direct Reference Codes; LEFT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] LeftEyeExam
                  where LeftEyeExam.start_date during "Measurement Period"
                        and LeftEyeExam.result in ["VSAC; DIABETIC_RETINOPATHY_SEVERITY_LEVEL"]
                        and LeftEyeExam.result not in  ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"])
              and exists (["eCQM Direct Reference Codes; RIGHT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] RightEyeExam
                  where RightEyeExam.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"]
                        and RightEyeExam.result in ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"]))

or exists ((["eCQM Direct Reference Codes; RIGHT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] RightEyeExam
                  where RightEyeExam.start_date during "Measurement Period"
                        and RightEyeExam.result in ["VSAC; DIABETIC_RETINOPATHY_SEVERITY_LEVEL"]
                        and RightEyeExam.result not in  ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"])
              and exists (["eCQM Direct Reference Codes; LEFT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] LeftEyeExam
                  where LeftEyeExam.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"]
                        and LeftEyeExam.result in ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"]))
  ,
  if exists (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_M1429"] P
          where P.start_date during "Measurement Period") RetinalSeverityCode
  then return
  ExtendedMeasureResultV2(  
      RetinalSeverityCode //return 1 record even if multiple exist
        , 'Ophthalmoscope Retinal Exam with Severity Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1429
    )
  // This next part will return the results from all 3 of the 'or' statements above.
  else from ((["eCQM Direct Reference Codes; LEFT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] LeftEyeExam
                  where LeftEyeExam.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"]
                        and LeftEyeExam.result in ["VSAC; DIABETIC_RETINOPATHY_SEVERITY_LEVEL"])
              and exists (["eCQM Direct Reference Codes; RIGHT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] RightEyeExam
                  where RightEyeExam.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"]
                        and RightEyeExam.result in ["VSAC; DIABETIC_RETINOPATHY_SEVERITY_LEVEL"]))
  return(
  ExtendedMeasureResultV2(
      LeftEyeExam //return 1 record even if multiple exist
        , 'Left Eye Diabetic Retinopathy Severity Level by Ophthalmoscopy' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1429
    )
  and return
  ExtendedMeasureResultV2(
      RightEyeExam //return 1 record even if multiple exist
        , 'Right Eye Diabetic Retinopathy Severity Level by Ophthalmoscopy' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1429
    )
)
*/
rule 'Year2026.Mips117.Success.M1429.qualityCode.org'
salience 25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "117_PERFORMANCE_MET_M1429"),
            startsDuring($program.measurementPeriod)
        ),
        latestClinicalActivity($r)
    )
    not (exists Year2026Mips117SucessM1429Org())
then
    insert (new Year2026Mips117SucessM1429Org());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1429");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Ophthalmoscope Retinal Exam with Severity Code", "M1429", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

