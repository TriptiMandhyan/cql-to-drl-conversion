/*
define "Numerator Performance Not Met-2022F-8P,2024F-8P,2026F-8P":
   *
   * Option ID: performance_not_met
   *
        not "Numerator Performance Met: 3072F"
        and not "Numerator Performance Met: 2026F"
        and not "Numerator Performance Met: 2025F"
        and not "Numerator Performance Met: 2024F"
        and not "Numerator Performance Met: M1221"
        and not "Numerator Performance Met: M1220"
        and not "Numerator Performance Met: 2033F"
        and not "Numerator Performance Met: M1429"
        and not "Numerator Performance Met: M1430"
        and not "Denominator Exclusion: Hospice"
        and not "Denominator Exclusion: Palliative Care"
        and not "Denominator Exclusion: LTI"
        and not "Denominator Exclusion: Frailty and Dementia Medication"
        and not "Denominator Exclusion: Frailty and Advanced Illness"
        and not "Denominator Exclusion: M1428-Bilateral Absence of Eyes"
*/
rule 'Year2026.Mips117.Gap.PerformanceNotMet'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117")
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "performance_not_met");
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.getGroupExternalIds()) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.GAP, "performance_not_met");
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)) {
        controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "performance_not_met");
    }
end
