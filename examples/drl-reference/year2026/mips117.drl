rule 'Year2026.Mips117.Candidate.3072F.retinalOrDilatedExamPriorYear'
salience 80
when
    exists EncounterDenominator(measure == "Year2026.Mips117")
    $program: Program(rules contains "measure.Mips.2026.Mips117")
    $r: ClinicalActivity(
        withValueSet("VsacYear2026", "RETINAL_OR_DILATED_EYE_EXAM"),
        startsDuring($program.measurementPeriod.start.minusYears(1), $program.measurementPeriod.end.minusYears(1))
    )
    and not (
        exists Diagnosis(
            withValueSet("VsacYear2026", "DIABETIC_RETINOPATHY"),
            overlaps($program.measurementPeriod.start.minusYears(1), $program.measurementPeriod.end.minusYears(1))
        )
    )
    and not (
        exists ClinicalActivity(
            withValueSet("MipsYear2026", "117_PERFORMANCE_MET_M1220") ||
            withValueSet("AbleYear2026", "MIPS117_CPTII_2022F") ||
            withValueSet("MipsYear2026", "117_PERFORMANCE_MET_2024F") ||
            withValueSet("MipsYear2026", "117_PERFORMANCE_MET_2026F") ||
            withValueSet("MipsYear2026", "117_PERFORMANCE_MET_M1429"),
            startsDuring($program.measurementPeriod.start.minusYears(1), $program.measurementPeriod.end.minusYears(1)),
            (withCodeModifiersNotIn("8P") || CollectionUtils.isEmpty(codeModifiers))
        )
    )
then
    insert(new Year2026Mips117RetinalExamPriorYearCandidate($r));
end

