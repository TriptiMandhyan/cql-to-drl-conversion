/**
define "Numerator Performance Met-2026F":
  *
  * Option ID: 2026F
  *
  exists((["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_2026F"] P
            where P.start_date during "Measurement Period"
                  and (PerformanceMet.code_modifiers not in {'8P'}
                        or PerformanceMet.code_modifiers isEmpty
                        or PerformanceMet.code_modifiers = null))
        union (["Clinical Activity": "ABLE; REMOTE_RETINAL_IMAGING"] Imaging
                where Imaging.start_date during "Measurement Period") //includes CPT code 92227, 92228, 92229
        union (["eCQM Direct Reference Codes; EYE_DIABETIC_RETINOPATHY_SCREENING_AUTONOMOUS_ARTIFICIAL_INTELLIGENCE"] AutonomousExam
                where AutonomousExam.start_date during "Measurement Period"
                      and AutonomousExam.result in ["VSAC; AUTONOMOUS_EYE_EXAM_RESULT_OR_FINDING"]) AutonomousExamPeriod
                      ) RetinalImaging
  ,
  if exists (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_2026F"] P
            where P.start_date during "Measurement Period"
                  and (PerformanceMet.code_modifiers not in {'8P'}
                        or PerformanceMet.code_modifiers isEmpty
                        or PerformanceMet.code_modifiers = null))RetinalImagingCode
  then return
    ExtendedMeasureResultV2(
       RetinalImagingCode//return 1 record even if multiple exist
        , 'Retinal Imaging with Retinopathy Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = 2026F
    )
    else from
    ((["Clinical Activity": "ABLE; REMOTE_RETINAL_IMAGING"] Imaging
                where Imaging.start_date during "Measurement Period")
     union (["eCQM Direct Reference Codes; EYE_DIABETIC_RETINOPATHY_SCREENING_AUTONOMOUS_ARTIFICIAL_INTELLIGENCE"] AutonomousExam
                where AutonomousExam.start_date during "Measurement Period"
                      and AutonomousExam.result in ["VSAC; AUTONOMOUS_EYE_EXAM_RESULT_OR_FINDING"]) AutonomousExamPeriod
                      ) RetinalImagingPeriod
    return
    ExtendedMeasureResultV2(
      RetinalImagingPeriod //return 1 record even if multiple exist
        , 'Retinal Imaging including Autonomous Eye Exam' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = 2026F
    )
*/
