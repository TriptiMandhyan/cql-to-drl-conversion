/*
define "Numerator Performance Met-3072F":
   *
   * Option ID: 3072F
   *
 ((["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_3072F"] P
    where (P.start_date during "Measurement Period"
          and (PerformanceMet.code_modifiers not in {'8P'}
                or PerformanceMet.code_modifiers isEmpty
                or PerformanceMet.code_modifiers = null)))
  
 union ((["Clinical Activity": "VSAC; RETINAL_OR_DILATED_EYE_EXAM"] P
        where P.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"- 1 year])
      and not exists(["Diagnosis": "VSAC; DIABETIC_RETINOPATHY"] D
        where Interval[D.start_date, D.stop_date] overlaps Interval[start of "Measurement Period" - 1 year, end of "Measurement Period" - 1 year])
      and not exists (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_M1220"]
                        union ["Clinical Activity"; "ABLE; MIPS117_CPTII_2022F"] 
                        union ["MIPS; 117_PERFORMANCE_MET_2024F"]
                        union ["MIPS; 117_PERFORMANCE_MET_2026F"]
                        union ["MIPS; 117_PERFORMANCE_MET_M1429"]) RetinopathyQC //making sure there are no quality codes indicating retinopathy in the year prior.
                    where RetinopathyQC.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"- 1 year]
                          and (RetinopathyQC.code_modifiers not in {'8P'}
                                or RetinopathyQC.code_modifiers isEmpty
                                or RetinopathyQC.code_modifiers = null))
  )DiabeticEyeExamNoRenopathyPriorYear
  ,
    if exists (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_3072F"] P
                    where (P.start_date during "Measurement Period"
                          and (PerformanceMet.code_modifiers not in {'8P'}
                                or PerformanceMet.code_modifiers isEmpty
                                or PerformanceMet.code_modifiers = null)))DiabeticExamNoRenopathyCode
  then return
    ExtendedMeasureResultV2(  
        DiabeticExamNoRenopathyCode//return 1 record even if multiple exist
          , 'Diabetic Eye Exam Year Prior without Retinopathy Code' as name
          , display_date = start_date
          , calculated_record = false
          , population = Numerator Performance Met
          , option_id = 3072F
      )
      else from
      (["Clinical Activity": "VSAC; RETINAL_OR_DILATED_EYE_EXAM"] ) E
            where E.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"- 1 year]
            and not exists (["Diagnosis": "VSAC; DIABETIC_RETINOPATHY"] D
                        where Interval[D.start_date, D.stop_date] overlaps Interval[start of "Measurement Period" - 1 year, end of "Measurement Period" - 1 year]) 
      return
      ExtendedMeasureResultV2(
        E //return 1 record even if multiple exist
          , 'Retinal Eye Exam Year Prior no Retinopathy Diagnosis' as name
          , display_date = start_date
          , calculated_record = false
          , population = Numerator Performance Met
          , option_id = 3072F
      )
*/
