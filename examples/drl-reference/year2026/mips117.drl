/**
//Populations

define "Denominator":
  exists("Denominator Encounter") Encounter
  ,
  if exists("Denominator") 
    then 
    return
        ExtendedMeasureResultV2(
            Encounter //return 1 record even if multiple exist
            , 'Denominator Encounter' as name
            , display_date = start_date
            , calculated_record = false
            , population = Denominator
        )
    and from ["Diagnosis": "MIPS; 117_DIABETES"] Diabetes
            with "Denominator" Encounter 
            such that Interval [Diabetes.start_date, Diabetes.stop_date] overlaps Interval[Encounter.start_date, Encounter.stop_date]
    return
        ExtendedMeasureResultV2(
            Diabetes //return 1 record even if multiple exist
            , 'Diabetes Diagnosis' as name
            , display_date = start_date
            , calculated_record = false
            , population = Denominator
        )

define "Denominator Encounter":
  ["Clinical Activity": "MIPS; 117_ENCOUNTER"] Encounter
    where Encounter.start_date during "Measurement Period"
      and AgeInYearsAt(Encounter.start_date) >= 18
      and AgeInYearsAt(Encounter.start_date) <= 75
      and E.provider_id.hasMeasureMembership = true
    with (["Diagnosis": "MIPS; 117_DIABETES"] D
      where Interval[D.start_date,D.stop_date] overlaps Interval[Encounter.start_date, Encounter.stop_date])
*/
rule 'Year2026.Mips117.Denominator'
salience 100
when
    $program: Program(rules contains "measure.Mips.2026.Mips117")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "117_ENCOUNTER"),
        startsDuring($program.measurementPeriod)
    )
    and exists Diagnosis(
        withValueSet("MipsYear2026", "117_DIABETES"),
        overlaps($encounter)
    )
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 18 && getAgeInYearsAt($encounter.startDate) <= 75)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips117"));
    // EMR - Denominator Encounter (org)
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "M1220", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "M1221", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "3072F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "2024F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "2026F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "2033F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "G9714", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "G9994", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "G2105", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "G2106", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "G2107", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "M1428", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "M1429", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "M1430", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Denominator Encounter", "performance_not_met", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());

    // EMR - Denominator Encounter (group)
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.getGroupExternalIds()) {
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "M1220", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "M1221", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "3072F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "2024F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "2026F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "2033F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "G9714", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "G9994", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "G2105", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "G2106", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "G2107", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "M1428", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "M1429", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "M1430", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Denominator Encounter", "performance_not_met", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        }
    }

    // EMR - Denominator Encounter (provider)
    if ($encounter.isPresent($encounter.providerExternalId)) {
        String providerExternalId = $encounter.providerExternalId;
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "M1220", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "M1221", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "3072F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "2024F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "2026F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "2033F", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "G9714", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "G9994", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "G2105", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "G2106", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "G2107", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "M1428", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "M1429", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "M1430", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", providerExternalId, "Denominator Encounter", "performance_not_met", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    }
    
end

rule 'Year2026.Mips117.Denominator.Diagnosis.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117")
    $patient: Patient()
    $d: Diagnosis(
        withValueSet("MipsYear2026", "117_DIABETES"),
        overlaps($encounter)
    )
then
    // EMR - Diabetes Diagnosis (org)
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Diabetes Diagnosis", "M1220", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Diabetes Diagnosis", "M1221", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Diabetes Diagnosis", "3072F", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", "", "Diabetes Diagnosis", "2024F", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
