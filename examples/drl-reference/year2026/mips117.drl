            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Diabetes Diagnosis", "G2105", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Diabetes Diagnosis", "G2106", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Diabetes Diagnosis", "G2107", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Diabetes Diagnosis", "M1428", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Diabetes Diagnosis", "M1429", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Diabetes Diagnosis", "M1430", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
            controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", groupExternalId, "Diabetes Diagnosis", "performance_not_met", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
        }
    }

    // EMR - Diabetes Diagnosis (provider)
    if ($encounter.isPresent($encounter.providerExternalId)) {
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", $encounter.providerExternalId, "Diabetes Diagnosis", "M1220", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", $encounter.providerExternalId, "Diabetes Diagnosis", "M1221", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
