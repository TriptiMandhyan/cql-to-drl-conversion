        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", $encounter.providerExternalId, "Diabetes Diagnosis", "2026F", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips117", $encounter.providerExternalId, "Diabetes Diagnosis", "2033F", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
