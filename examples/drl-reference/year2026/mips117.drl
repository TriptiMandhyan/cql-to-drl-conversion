    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117")
    $patient: Patient()
    $left: ClinicalActivity() from accumulate(
        $r1: ClinicalActivity(
            withValueSet("Ecqm_Direct_Reference_CodesYear2026", "LEFT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"),
            withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NO_APPARENT_RETINOPATHY"),
            startsDuring($program.measurementPeriod.start.minusYears(1), $program.measurementPeriod.end)
        ),
        latestClinicalActivity($r1)
    )
    $right: ClinicalActivity() from accumulate(
        $r2: ClinicalActivity(
            withValueSet("Ecqm_Direct_Reference_CodesYear2026", "RIGHT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"),
            withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NO_APPARENT_RETINOPATHY"),
            startsDuring($program.measurementPeriod.start.minusYears(1), $program.measurementPeriod.end)
        ),
        latestClinicalActivity($r2)
    )
    not (exists Year2026Mips117SucessM1430Org())
then
    insert (new Year2026Mips117SucessM1430Org());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1430");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Left Eye No Apparent Retinopathy by Ophthalmoscopy", "M1430", PopulationEnum.numerator_performance_met, $left, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $left.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Right Eye No Apparent Retinopathy by Ophthalmoscopy", "M1430", PopulationEnum.numerator_performance_met, $right, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $right.startDate.toString());
end

