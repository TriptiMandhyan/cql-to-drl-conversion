query queryYear2026Mips117HasLeftEyeRetinopathy(Program $program, ClinicalActivity $result)
    $result:= ClinicalActivity(
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "LEFT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"),
        withValueSetInResultCodeValue("VsacYear2026", "DIABETIC_RETINOPATHY_SEVERITY_LEVEL"),
        !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NO_APPARENT_RETINOPATHY"),
        startsDuring($program.measurementPeriod)
    )
end

query queryYear2026Mips117HasRightEyeRetinopathy(Program $program, ClinicalActivity $result)
    $result:= ClinicalActivity(
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "RIGHT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"),
        withValueSetInResultCodeValue("VsacYear2026", "DIABETIC_RETINOPATHY_SEVERITY_LEVEL"),
        !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NO_APPARENT_RETINOPATHY"),
        startsDuring($program.measurementPeriod)
    )
end

query queryYear2026Mips117HasLeftEyeNoRetinopathyInYearPrior(Program $program, ClinicalActivity $result)
    $result:= ClinicalActivity(
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "LEFT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"),
        withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NO_APPARENT_RETINOPATHY"),
        startsDuring($program.measurementPeriod.start.minusYears(1), $program.measurementPeriod.end)
    )
end

query queryYear2026Mips117HasRightEyeNoRetinopathyInYearPrior(Program $program, ClinicalActivity $result)
    $result:= ClinicalActivity(
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "RIGHT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"),
        withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NO_APPARENT_RETINOPATHY"),
        startsDuring($program.measurementPeriod.start.minusYears(1), $program.measurementPeriod.end)
    )
end

/*
define "Numerator Performance Met: M1430"
  *
  * Option ID: M1430
  *
exists (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_M1430"] P
          where P.start_date during "Measurement Period")
or exists ((["eCQM Direct Reference Codes; LEFT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] LeftEyeExam
                  where LeftEyeExam.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"]
                        and LeftEyeExam.result in ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"])
          and exists (["eCQM Direct Reference Codes; RIGHT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] RightEyeExam
                  where RightEyeExam.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"]
                        and RightEyeExam.result in ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"]))
,
if exists (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_M1430"] P
          where P.start_date during "Measurement Period") NoRetinopathyCode
then return
ExtendedMeasureResultV2(  
    NoRetinopathyCode//return 1 record even if multiple exist
      , 'Ophthalmoscope Retinal Exam without Retinopathy Code' as name
      , display_date = start_date
      , calculated_record = false
      , population = Numerator Performance Met
      , option_id = M1430
  )
  else from ((["eCQM Direct Reference Codes; LEFT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] LeftEyeExam
                  where LeftEyeExam.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"]
                        and LeftEyeExam.result in ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"])
          and exists (["eCQM Direct Reference Codes; RIGHT_EYE_DIABETIC_RETINOPATHY_SEVERITY_LEVEL_BY_OPHTHALMOSCOPY"] RightEyeExam
                  where RightEyeExam.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"]
                        and RightEyeExam.result in ["eCQM Direct Reference Codes; NO_APPARENT_RETINOPATHY"]))
  return(
  ExtendedMeasureResultV2(
      LeftEyeExam //return 1 record even if multiple exist
        , 'Left Eye No Apparent Retinopathy by Ophthalmoscopy' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1430
    )
  and return
  ExtendedMeasureResultV2(
      RightEyeExam //return 1 record even if multiple exist
        , 'Right Eye No Apparent Retinopathy by Ophthalmoscopy' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1430
    )
  )
*/
