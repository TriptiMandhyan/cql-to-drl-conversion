/*
define "Denominator Exclusion-Hospice":
   *
   * Option ID: G9714
   *
  exists (sharedHospice."Has Hospice")Hospice
    , 
    ExtendedMeasureResultV2(
        Hospice //return 1 record even if multiple exist
        , 'Evidence of Hospice' as name
        , display_date = start_date
        , calculated_record = false
        , population = Exclusion
        , option_id =  G9714
    )
*/
rule 'Year2026.Mips117.Exclusion.hospice.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117")
    $patient: Patient()
    $hospice: QdmDatatype() from accumulate(
        queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $hospiceResult;),
        latestQdmDatatype($hospiceResult)
    )
    not (exists Year2026Mips117ExclusionHospiceOrg())
then
    insert(new Year2026Mips117ExclusionHospiceOrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9714");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Hospice", "G9714", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

rule 'Year2026.Mips117.Exclusion.hospice.group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117", clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    not (exists Year2026Mips117ExclusionHospiceGroup(groupExternalId == $groupExternalId))
    $hospice: QdmDatatype() from accumulate(
        queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $hospiceResult;),
