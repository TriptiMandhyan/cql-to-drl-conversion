/**
define "Numerator Performance Met-M1220":
   *
   * Option ID: M1220
   *

 ( (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_M1220"] P
    where P.start_date during "Measurement Period")

  union (["Clinical Activity": "ABLE; MIPS117_CPTII_2022F"] CPTII
        where( CPTII.start_date during "Measurement Period"
              and (CPTII.code_modifiers not in {'8P'}
                  or CPTII.code_modifiers isEmpty
                  or CPTII.code_modifiers = null)))

  union ((["Clinical Activity": "VSAC; RETINAL_OR_DILATED_EYE_EXAM"]
          where E.start_date during "Measurement Period")
          and exists (["Diagnosis": "VSAC; DIABETIC_RETINOPATHY"] D
                      where Interval[D.start_date, D.stop_date] overlaps "Measurement Period")
  )M1220
  )DilatedExamwithRenopathy 
  ,
  if exists ( (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_M1220"] P
                    where P.start_date during "Measurement Period")
              union (["Clinical Activity": "ABLE; MIPS117_CPTII_2022F"] CPTII
                    where( CPTII.start_date during "Measurement Period"
                          and (CPTII.code_modifiers not in {'8P'}
                              or CPTII.code_modifiers isEmpty
                              or CPTII.code_modifiers = null))))DilatedExamwithRenopathyCode 
  then return
    ExtendedMeasureResultV2(
       DilatedExamwithRenopathyCode//return 1 record even if multiple exist
        , 'Dilated Eye Exam with Retinopathy Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1220
    )
    else from
    (["Clinical Activity": "VSAC; RETINAL_OR_DILATED_EYE_EXAM"] ) E
          where E.start_date during "Measurement Period"
          and exists (["Diagnosis": "VSAC; DIABETIC_RETINOPATHY"] D
                      where Interval[D.start_date, D.stop_date] overlaps "Measurement Period")
    return(
    ExtendedMeasureResultV2(
      E //return 1 record even if multiple exist
        , 'Retinal Eye Exam' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1220
    )
    and return
    ExtendedMeasureResultV2(
      D //return 1 record even if multiple exist
        , 'Diabetic Retinopathy Diagnosis' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1220
    )
)
*/
rule 'Year2026.Mips117.Success.M1220.qualityCode.org'
salience 95
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "117_PERFORMANCE_MET_M1220"),
            startsDuring($program.measurementPeriod)
        ),
        latestClinicalActivity($r)
    )
    not (exists Year2026Mips117SucessM1220Org())
then
    insert (new Year2026Mips117SucessM1220Org());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1220");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Dilated Eye Exam with Retinopathy Code", "M1220", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
