/*
define "Denominator Exclusion-M1428-Bilateral Absence of Eyes":
  *
   * Option ID: G2107
   *
 (( exists (["Clinical Activity": "MIPS; 117_DENOMINATOR_EXCLUSION_M1428"] Exclusion
    where Exclusion.start_date during "Measurement Period")) ExclusionPeriod
  or exists (["Diagnosis": "eCQM Direct Reference Codes; ANOPHTHALMOS_OF_BILATERAL_EYES_DISORDER"] BilateralAbsenceEyes //from eCQM CMS131
        where BilateralAbsenceEyes.start_date on or before day of end of "Measurement Period")) ExclusionBilateralAbsenceEyes
  ,
  return
    ExtendedMeasureResultV2(
       ExclusionBilateralAbsenceEyes//return 1 record even if multiple exist
        , 'Bilateral Absence of Eyes' as name
        , display_date = start_date
        , calculated_record = false
        , population = Exclusion
        , option_id = M1428
    )
*/
