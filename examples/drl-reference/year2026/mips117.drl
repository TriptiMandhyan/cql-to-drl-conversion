   *

 (["Clinical Activity": "MIPS; 117_PERFORMANCE_MET_2024F"] P
    where P.start_date during "Measurement Period"
      and (PerformanceMet.code_modifiers not in {'8P'}
          or PerformanceMet.code_modifiers isEmpty
          or PerformanceMet.code_modifiers = null)) 2024FPeriod
,
return
ExtendedMeasureResultV2(
   2024FPeriod//return 1 record even if multiple exist
