/**
define "Denominator Exclusion-LTI":
   *
   * Option ID: G2105
   *
    exists (sharedFrailtyLTI."Has Long Term Care with Age Anchor"(start of "Denominator Encounter")) // the start of the denominator encounter is AgeInYearsAt anchor
    ,
    if exists ( ["Clinical Activity": "MIPS; MIPS_LTI_QUALITY_CODES"] LTI
            where LTI.start_date during Interval[start of "Intake Period", end of "Measurement Period"] ) LTIPeriod
    then
    return
    ExtendedMeasureResultV2(
        LTIPeriod//return 1 record even if multiple exist
        , 'Long Term Care Quality Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Exclusion
        , option_id =  G2105
    )
    else null
*/
rule 'Year2026.Mips117.Exclusion.LTI'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117")
    $patient: Patient()
    exists queryYear2026MipsSharedHasLongTermCareWithAgeAnchor($program, $encounter.startDate;)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G2105");
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.getGroupExternalIds()) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.EXCLUSION, "G2105");
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)) {
        controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G2105");
    }
end

rule 'Year2026.Mips117.Exclusion.LTI.QualityCode.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117")
    $patient: Patient()
    exists queryYear2026MipsSharedHasLongTermCareWithAgeAnchor($program, $encounter.startDate;)
    $lti: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "MIPS_LTI_QUALITY_CODES"),
            startsDuring($program.measurementPeriod.start.minusMonths(6), $program.measurementPeriod.end)
        ),
        latestClinicalActivity($r)
    )
    not (exists Year2026Mips117ExclusionLtiQualityCodeOrg())
then
    insert(new Year2026Mips117ExclusionLtiQualityCodeOrg());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Long Term Care Quality Code", "G2105", PopulationEnum.denominator_exclusion, $lti, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lti.startDate.toString());
end

