    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips117", clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    not (exists Year2026Mips117Sucess3072FGroup(groupExternalId == $groupExternalId))
    $result: ClinicalActivity() from accumulate(
        Year2026Mips117RetinalExamPriorYearCandidate($r: clinicalActivity),
        latestClinicalActivity($r)
    )
then
    insert (new Year2026Mips117Sucess3072FGroup($groupExternalId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupExternalId, $measure, MeasureStatusValue.SUCCESS, "3072F");
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Retinal Eye Exam Year Prior no Retinopathy Diagnosis", "3072F", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

