    $patient: Patient()
    not (exists Year2026Mips126ExclusionG2178ProviderEmr(providerExternalId == $encounter.providerExternalId))
    $rightResult: Diagnosis() from accumulate (
        $right: Diagnosis(
            withValueSet("AbleYear2026", "RIGHT_FOOT_AMPUTEE"),
            startsBefore($program.measurementPeriod.end)
        ),
        latestDiagnosis($right)
