/*
define "Numerator Performance Not Met G8405":
  *
  * Option ID: G8405
  *
  and not "Denominator Exclusion G2178"
  and not "Denominator Exception G2179"
  and not "Numerator Performance Met G8404"
*/
rule 'Year2026.Mips126.Gap.G8405'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips126')
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G8405");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G8405");
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.GAP, "G8405");
        }
    }
end
