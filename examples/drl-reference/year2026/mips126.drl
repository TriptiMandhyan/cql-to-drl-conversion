    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $encounter.providerExternalId, "Denominator Encounter", "G8404", PopulationEnum.denominator, $clinicalActivity, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $clinicalActivity.startDate.toString());
