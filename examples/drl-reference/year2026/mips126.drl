    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $encounter.providerExternalId, "Denominator Diabetes Diagnosis", "G2178", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
