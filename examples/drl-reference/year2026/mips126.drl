then
    insert(new Year2026Mips126ExclusionG2178ProviderEmr($encounter.providerExternalId));
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Right Lower Extremity Amputation", "G2178", PopulationEnum.denominator_exclusion, $rightResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $rightResult.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Left Lower Extremity Amputation", "G2178", PopulationEnum.denominator_exclusion, $leftResult, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $leftResult.startDate.toString());
end

/*
define "Denominator Exception G2179"
  *
  * Option ID: G2179
  *
  ( ["Clinical Activity": "MIPS; 126_DENOMINATOR_EXCEPTION_G2179"] P
          with "Denominator Encounter" Encounter
          such that P.start_date = Encounter.start_date 
) G2179,
 return
  ExtendedMeasureResultV2(
      G2179 //return 1 even if multiple exceptions exist.
      , 'Denominator Exception G2179' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exception
      , option_id = G2179  
  ) 
*/
rule 'Year2026.Mips126.Exception.G2179'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips126')
    $patient: Patient()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "126_DENOMINATOR_EXCEPTION_G2179"),
        startDate.equals($encounter.startDate)
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCEPTION, "G2179");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCEPTION, "G2179");
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.EXCEPTION, "G2179");
        }
    }
end

rule 'Year2026.Mips126.Exception.G2179.Org.EMR'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips126')
    EncounterDenominator(measure == 'Year2026.Mips126', program == $program, $encounter: clinicalActivity)
    $patient: Patient()
    not (exists Year2026Mips126ExceptionG2179OrgEmr())
    $result: ClinicalActivity() from accumulate (
        $e: ClinicalActivity(
            withValueSet("MipsYear2026", "126_DENOMINATOR_EXCEPTION_G2179"),
            startDate.equals($encounter.startDate)
        ),
        latestClinicalActivity($e)
    )
then
    insert(new Year2026Mips126ExceptionG2179OrgEmr());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', "", "Denominator Exception G2179", "G2179", PopulationEnum.denominator_exception, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

rule 'Year2026.Mips126.Exception.G2179.Group.EMR'
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips126', $encounter: clinicalActivity,
        $encounter.isPresent($encounter.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.groupExternalIds
    not (exists Year2026Mips126ExceptionG2179GroupEmr(groupExternalId == $groupExternalId))
    $result: ClinicalActivity() from accumulate (
        $e: ClinicalActivity(
            withValueSet("MipsYear2026", "126_DENOMINATOR_EXCEPTION_G2179"),
