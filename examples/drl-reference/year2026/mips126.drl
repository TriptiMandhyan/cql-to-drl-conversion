/*
define "Denominator".all:
  exists("Denominator Encounter") Encounter
  ,
  if exists("Denominator") 
  return
  ExtendedMeasureResultV2(
        Encounter
        , 'Denominator Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and from (["Diagnosis": "MIPS; 126_DIABETES"] D
          where Interval[D.start_date, D.stop_date] overlaps Interval["Denominator".start_date, "Denominator".stop_date] ) EncounterDiabetes
  return
  ExtendedMeasureResultV2(
        EncounterDiabetes
        , 'Denominator Diabetes Diagnosis' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
 
 define "Denominator Encounter":
  (["Clinical Activity": "MIPS; 126_ENCOUNTER"] Encounter
  where Encounter.start_date during "Measurement Period"
        and not Encounter.code_modifier in {'GQ', 'GT', 'FQ', '93'}
        and not Encounter.place_of_service in {'02', '10'}
        and AgeInYearsAt(Encounter.start_date) >= 18
        and Encounter.provider_id.hasMeasureMembership = true
  and not exists(["Clinical Activity": "MIPS; TELEHEALTH_ENCOUNTER_HCPCS_M1426"] TelehealthEncounter
          where TelehealthEncounter.start_date = Encounter.start_date)) NonTelehealthEncounter
  with ["Diagnosis": "MIPS; 126_DIABETES"] D
  such that Interval[D.start_date, D.stop_date] overlaps Interval[NonTelehealthEncounter.start_date, NonTelehealthEncounter.stop_date]
*/
rule 'Year2026.Mips126.Denominator'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips126')
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "126_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        withCodeModifiersNotIn('GQ', 'GT', 'FQ', '93'),
        withPlaceOfServiceNotIn('02','10')
    )
    not (exists ClinicalActivity(
        withValueSet("MipsYear2026", "TELEHEALTH_ENCOUNTER_HCPCS_M1426"),
        startDate.equals($encounter.startDate)
    ))
    exists Diagnosis(
        withValueSet("MipsYear2026", "126_DIABETES"),
        overlaps($encounter)
    )
    Patient(getAgeInYearsAt($encounter.startDate) >= 18)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips126"));
end

rule 'Year2026.Mips126.Denominator.Org.EMR'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips126')
    not (exists Year2026Mips126DenominatorOrgEmr())
    $patient: Patient()
    $encounter: ClinicalActivity() from accumulate (
        EncounterDenominator(program == $program, measure == 'Year2026.Mips126', $ca: clinicalActivity),
        latestClinicalActivity($ca)
    )
    $diagnosis: Diagnosis() from accumulate (
        $dx: Diagnosis(
            withValueSet("MipsYear2026", "126_DIABETES"),
            overlaps($encounter)
        ),
        latestDiagnosis($dx)
    )
then
    insert(new Year2026Mips126DenominatorOrgEmr());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', "", "Denominator Encounter", "G2178", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', "", "Denominator Encounter", "G2179", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', "", "Denominator Encounter", "G8404", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', "", "Denominator Encounter", "G8405", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', "", "Denominator Diabetes Diagnosis", "G2178", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', "", "Denominator Diabetes Diagnosis", "G2179", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', "", "Denominator Diabetes Diagnosis", "G8404", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', "", "Denominator Diabetes Diagnosis", "G8405", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
end

rule 'Year2026.Mips126.Denominator.Group.EMR'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips126')
    $patient: Patient()
    EncounterDenominator(program == $program, measure == 'Year2026.Mips126', $encounter: clinicalActivity,
        $encounter.isPresent($encounter.groupExternalIds))
    $groupExternalId: String() from $encounter.groupExternalIds
    not (exists Year2026Mips126DenominatorGroupEmr(groupExternalId == $groupExternalId))
    $clinicalActivity: ClinicalActivity() from accumulate (
        EncounterDenominator(program == $program, measure == 'Year2026.Mips126', $ca: clinicalActivity,
            $ca.isPresent($ca.groupExternalIds), $ca.groupExternalIds contains $groupExternalId),
        latestClinicalActivity($ca)
    )
    $diagnosis: Diagnosis() from accumulate (
        $dx: Diagnosis(
            withValueSet("MipsYear2026", "126_DIABETES"),
            overlaps($clinicalActivity)
        ),
        latestDiagnosis($dx)
    )
then
    insert(new Year2026Mips126DenominatorGroupEmr($groupExternalId));
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $groupExternalId, "Denominator Encounter", "G2178", PopulationEnum.denominator, $clinicalActivity, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $clinicalActivity.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $groupExternalId, "Denominator Encounter", "G2179", PopulationEnum.denominator, $clinicalActivity, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $clinicalActivity.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $groupExternalId, "Denominator Encounter", "G8404", PopulationEnum.denominator, $clinicalActivity, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $clinicalActivity.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $groupExternalId, "Denominator Encounter", "G8405", PopulationEnum.denominator, $clinicalActivity, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $clinicalActivity.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $groupExternalId, "Denominator Diabetes Diagnosis", "G2178", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $groupExternalId, "Denominator Diabetes Diagnosis", "G2179", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $groupExternalId, "Denominator Diabetes Diagnosis", "G8404", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $groupExternalId, "Denominator Diabetes Diagnosis", "G8405", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
end

