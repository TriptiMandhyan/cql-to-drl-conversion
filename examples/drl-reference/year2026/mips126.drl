    not (exists Year2026Mips126ExclusionG2178OrgEmr())
    $result: ClinicalActivity() from accumulate (
        $e: ClinicalActivity(
            withValueSet("MipsYear2026", "126_DENOMINATOR_EXCLUSION_G2178"),
            startsDuring($program.measurementPeriod)
