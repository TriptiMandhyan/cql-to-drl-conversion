        ),
        latestClinicalActivity($e)
    )
then
    insert(new Year2026Mips126ExceptionG2179GroupEmr($groupExternalId));
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Denominator Exception G2179", "G2179", PopulationEnum.denominator_exception, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

rule 'Year2026.Mips126.Exception.G2179.Provider.EMR'
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips126', $encounter: clinicalActivity,
        $encounter.isPresent($encounter.providerExternalId))
    $patient: Patient()
    not (exists Year2026Mips126ExceptionG2179ProviderEmr(providerExternalId == $encounter.providerExternalId))
    $result: ClinicalActivity() from accumulate (
        $e: ClinicalActivity(
            withValueSet("MipsYear2026", "126_DENOMINATOR_EXCEPTION_G2179"),
            startDate.equals($encounter.startDate)
        ),
        latestClinicalActivity($e)
    )
then
    insert(new Year2026Mips126ExceptionG2179ProviderEmr($encounter.providerExternalId));
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Exception G2179", "G2179", PopulationEnum.denominator_exception, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

/*
define "Numerator Performance Met G8404":
  *
  * Option ID: G8404
  *
  (( ["Clinical Activity": "MIPS; 126_PERFORMANCE_MET_G8404"] 
      union ["Clinical Activity": "ABLE; DIABETIC_FOOT_EXAM"]) P
          with "Denominator Encounter" Encounter
          such that P.start_date during Interval[Encounter.start_date - 12 months, Encounter.start_date] 
 ) G8404,
   return
   ExtendedMeasureResultV2(
      G8404 //return 1 even if multiple performance met records exist.
      , 'Evidence of Diabetic Foot Exam' as name
      , display_date = start_date
      , calculated_record = false
      , population = Numerator Performance Met
      , option_id = G8404  
  )    
*/
rule 'Year2026.Mips126.Success.G8404'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips126')
    $patient: Patient()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "126_PERFORMANCE_MET_G8404") ||
        withValueSet("AbleYear2026", "DIABETIC_FOOT_EXAM"),
        startsDuring($encounter.startDate.minusMonths(12), $encounter.startDate)
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "G8404");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "G8404");
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.SUCCESS, "G8404");
        }
    }
end

