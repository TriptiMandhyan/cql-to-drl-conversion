    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips126', $encounter.providerExternalId, "Denominator Diabetes Diagnosis", "G8405", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
end

/**
define "Denominator Exclusion G2178":
  *
  *  Option ID: G2178
  *
((  ["Clinical Activity": "MIPS; 126_DENOMINATOR_EXCLUSION_G2178"] P
            where P.start_date during "Measurement Period"  )
  union ( ["Diagnosis": "ABLE; BILATERAL_AMPUTEE"] D //all diagnositic codes should be in diagnosis
          where D.start_date before end of "Measurement Period" )
  union (["Diagnosis": "ABLE; RIGHT_FOOT_AMPUTEE"] R 
          where R.start_date before end of "Measurement Period"
          and
          ["Diagnosis": "ABLE; LEFT_FOOT_AMPUTEE"] L 
          where L.start_date before end of "Measurement Period")
)
and exists("Denominator")
,
if exists( ["Clinical Activity": "MIPS; 126_DENOMINATOR_EXCLUSION_G2178"] 
            where P.start_date during "Measurement Period"  ) ExclusionCodePeriod
return
ExtendedMeasureResultV2(
      ExclusionCodePeriod //return 1 even if multiple exclusions exist.
      , 'Denominator Exclusion G2178' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exclusion
      , option_id = G2178  
  )
else if exists( ["Diagnosis": "ABLE; BILATERAL_AMPUTEE"] D 
          where D.start_date before end of "Measurement Period" ) BilateralAmputeeDx
return
ExtendedMeasureResultV2(
      BilateralAmputeeDx //return 1 even if multiple exclusions exist.
      , 'Evidence of Bilateral Lower Extremity Amputation' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exclusion
      , option_id = G2178  
  )
else if exists( (["Diagnosis": "ABLE; RIGHT_FOOT_AMPUTEE"] RtAmputeeDx
          where RtAmputeeDx.start_date before end of "Measurement Period")
          and
          (["Diagnosis": "ABLE; LEFT_FOOT_AMPUTEE"] LtAmputeeDx
           where LtAmputeeDx.start_date before end of "Measurement Period") RightFootAmputeeDx
  )
return
ExtendedMeasureResultV2(
      RightFootAmputeeDx //return 1 even if multiple exclusions exist.
      , 'Evidence of Right Lower Extremity Amputation' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exclusion
      , option_id = G2178  
  )
  and return
ExtendedMeasureResultV2(
      LtAmputeeDx //return 1 even if multiple exclusions exist.
      , 'Evidence of Left Lower Extremity Amputation' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exclusion
      , option_id = G2178  
  )
*/
rule 'Year2026.Mips126.Exclusion.G2178'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips126')
    $patient: Patient()
    (
        exists ClinicalActivity(
            withValueSet("MipsYear2026", "126_DENOMINATOR_EXCLUSION_G2178"),
            startsDuring($program.measurementPeriod)
        )
        or
        exists Diagnosis(
            withValueSet("AbleYear2026", "BILATERAL_AMPUTEE"),
            startsBefore($program.measurementPeriod.end)
        )
        or
        (
            exists Diagnosis(
                withValueSet("AbleYear2026", "RIGHT_FOOT_AMPUTEE"),
                startsBefore($program.measurementPeriod.end)
            )
            and
            exists Diagnosis(
                withValueSet("AbleYear2026", "LEFT_FOOT_AMPUTEE"),
                startsBefore($program.measurementPeriod.end)
            )
        )
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G2178");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G2178");
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.EXCLUSION, "G2178");
        }
    }
end

rule 'Year2026.Mips126.Exclusion.G2178.Code.Org.EMR'
when
