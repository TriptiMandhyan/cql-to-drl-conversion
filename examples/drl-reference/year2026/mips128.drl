    controlSet.addPatientEMR($program, $patient, $measure, "", "BMI Not Done For Patient Reasons", "G2181", PopulationEnum.denominator_exception, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

