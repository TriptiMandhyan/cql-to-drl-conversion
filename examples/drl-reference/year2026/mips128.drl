    $patient: Patient()
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    not (exists Year2026Mips128ExclusionPregnancyGroup(groupExternalId == $groupExternalId))
    $result: QdmDatatype() from accumulate(
