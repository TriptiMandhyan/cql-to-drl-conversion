/*
 define "Numerator Performance Met M1293".all:
    *
    * Option ID: G8417
    *
(((["Clinical Activity": "MIPS; 128_PERFORMANCE_MET_G8417"] 
  union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_MET_M1293"]) P
        with "Denominator" Encounter
        such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date])
  union(( ["Clinical Activity": "ABLE; ABOVE_NORMAL_BMI_FOLLOW_UP"]
        union ["Clinical Activity": "VSAC; FOLLOW_UP_FOR_ABOVE_NORMAL_BMI"]
        union ["Diagnosis": "VSAC; FOLLOW_UP_FOR_ABOVE_NORMAL_BMI"]) AboveFU 
            with "Denominator" Encounter
            and with "Last BMI Before Encounter Is High" HighBMIEncounter
            such that( AboveFU.start_date during Interval[HighBMIEncounter.start_date - 12 months, HighBMIEncounter.start_date]
                      and HighBMIEncounter.start_date = Encounter.start_date))
)G8417
  ,
  if exists ((["Clinical Activity": "MIPS; 128_PERFORMANCE_MET_G8417"]
             union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_MET_M1293"]) P
                with "Denominator" Encounter
                such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]) G8417PerformanceMet
  then return
  ExtendedMeasureResultV2(
        G8417PerformanceMet //return 1 record per patient even if multiple exists
        , 'Above Normal BMI with Follow-Up Quality Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = G8417 
    )
  else if exists(( ["Clinical Activity": "ABLE; ABOVE_NORMAL_BMI_FOLLOW_UP"]
        union ["Clinical Activity": "VSAC; FOLLOW_UP_FOR_ABOVE_NORMAL_BMI"]
        union ["Diagnosis": "VSAC; FOLLOW_UP_FOR_ABOVE_NORMAL_BMI"]) AboveFU 
            with "Denominator" Encounter
            and with "Last BMI Before Encounter Is High" HighBMIEncounter
            such that( AboveFU.start_date during Interval[HighBMIEncounter.start_date - 12 months, HighBMIEncounter.start_date]
                      and HighBMIEncounter.start_date = Encounter.start_date) ) PerfMetAboveFU
  then return
  (ExtendedMeasureResultV2(
        PerfMetAboveFU //return 1 record per patient even if multiple exists
        , 'Follow-up for Above Normal BMI' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = G8417 
    )
  and from (LastPerLevel(["Clinical Activity": "eCQM Direct Reference Code; BODY_MASS_INDEX_BMI_RATIO"] BMI // Use LastPerLevel to return statuses for org and each provider_id and group_id associated with a "Last Qualifying Encounter with BMI" Encounter
            with ("Denominator" ) Encounter
            such that BMI.start_date during Interval[Encounter.start_date - 12 months, Encounter.start_date])
          sort by BMI.start_date asc) LastBMI
  return
  ExtendedMeasureResultV2(
        LastBMI //return 1 record per patient even if multiple exists
        , 'Above Normal BMI' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = G8417 
    )
  )

define "Last BMI Before Encounter Is High":
    "Last BMI Before Encounter Result" >= 25
*/
rule 'Year2026.Mips128.Success.G8417.p1.org'
salience 30
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_PERFORMANCE_MET_G8417") ||
            withValueSet("MipsYear2026", "497RATE5_PERFORMANCE_MET_M1293"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    )
    and not (exists Year2026Mips128NumeratorPerformanceMetG8417Emr())
then
    insert(new Year2026Mips128NumeratorPerformanceMetG8417Emr());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "G8417");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Above Normal BMI with Follow-Up Quality Code", "G8417", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

