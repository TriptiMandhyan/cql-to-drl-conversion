/*
define "Denominator Exclusion Hospice or Palliative G9996":
   *
   * Option ID: G9996
   *
    (exists((["Clinical Activity": "MIPS; 128_DENOMINATOR_EXCLUSION_G9996"]
            union ["Clinical Activity": "MIPS; 497RATE5_DENOMINATOR_EXCLUSION_M1307"]) G9996
      where G9996.start_date during "Measurement Period")
    or exists (sharedHospice."Has Hospice")
    or exists (sharedPalliativeCare."Has Palliative Care")) HospicePalliativeExclusion
    ,
    ExtendedMeasureResultV2(
      HospicePalliativeExclusion //return 1 record per patient even if multiple exists
      , 'Evidence of Hospice or Palliative Care' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exclusion
      , option_id = G9996
  )
*/
query queryYear2026Mips128DenominatorExclusionHospiceOrPalliative(Program $program, QdmDatatype $result)
    $result:= ClinicalActivity(
        withValueSet("MipsYear2026", "128_DENOMINATOR_EXCLUSION_G9996") ||
        withValueSet("MipsYear2026", "497RATE5_DENOMINATOR_EXCLUSION_M1307"),
        startsDuring($program.measurementPeriod)
    )
    or queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $result;)
    or queryYear2026MipsSharedPalliativeCareInMeasurementPeriod($program, $result;)
end

