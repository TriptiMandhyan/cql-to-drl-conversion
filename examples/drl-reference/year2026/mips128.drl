/*
define "Denominator".all:
  "Qualifying Encounter" Encounter
  ,
  if exists("Denominator") 
  return
  ExtendedMeasureResultV2(
        Last(Encounter) sort by Encounter.start_date ascending//LastperLevel
        , 'Denominator Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )

define "Qualifying Encounter"
    ["Clinical Activity": "MIPS; 128_ENCOUNTER"] Encounter
      where Encounter.start_date during "Measurement Period"
        and AgeInYearsAt(Encounter.start_date) >= 18
        and not Encounter.code_modifier in {'GQ','GT','95','FQ','93'}
        and not Encounter.place_of_service in {'02','10','12'}
        and Encounter.provider_id.hasMeasureMembership = true
    and not exists((["Clinical Activity": "MIPS; 128_M1431_ENCOUNTERS_CONDUCTED_VIA_TELEHEALTH"]
                   union ["Clinical Activity": "MIPS; 497RATE5_M1426_ENCOUNTERS_CONDUCTED_VIA_TELEHEALTH"])TelehealthEncounter
                      with Encounter
                      such that TelehealthEncounter.start_date during Interval[Encounter.start_date, Encounter.stop_date])

*/
rule 'Year2026.Mips128.Denominator'
salience 70
when
    $program: Program(rules contains "measure.Mips.2026.Mips128")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "128_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        withCodeModifiersNotIn("GQ", "GT", "95", "FQ", "93"),
        withPlaceOfServiceNotIn("02", "10", "12")
    )
    and not(
        exists ClinicalActivity(
            withValueSet("MipsYear2026", "128_M1431_ENCOUNTERS_CONDUCTED_VIA_TELEHEALTH") ||
            withValueSet("MipsYear2026", "497RATE5_M1426_ENCOUNTERS_CONDUCTED_VIA_TELEHEALTH"),
            startsDuring($encounter)
        )
    )
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 18)
then 
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips128"));
end

// EMR rules for last encounter per org/group/provider
rule 'Year2026.Mips128.Denominator.EMR.Org'
salience -10
when
    $program: Program(rules contains "measure.Mips.2026.Mips128")
    $patient: Patient()
    exists EncounterDenominator(program == $program, measure == "Year2026.Mips128")
    $lastEncounter: ClinicalActivity() from accumulate(
        EncounterDenominator($e: clinicalActivity, measure == "Year2026.Mips128"),
        latestClinicalActivity($e)
    )
then
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", "", "Denominator Encounter", "G9997", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", "", "Denominator Encounter", "G9996", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", "", "Denominator Encounter", "G8420", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", "", "Denominator Encounter", "G8417", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", "", "Denominator Encounter", "G8418", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", "", "Denominator Encounter", "G9716", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", "", "Denominator Encounter", "G2181", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", "", "Denominator Encounter", "G8419", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", "", "Denominator Encounter", "G8421", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
end

rule 'Year2026.Mips128.Denominator.EMR.Group'
salience -10
when
    $program: Program(rules contains "measure.Mips.2026.Mips128")
    $patient: Patient()
    EncounterDenominator($encounter: clinicalActivity, program == $program, measure == "Year2026.Mips128", clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    not Year2026Mips128DenominatorEncounterEmrGroup(groupExternalId == $groupExternalId)
    $lastEncounter: ClinicalActivity() from accumulate(
        EncounterDenominator(
            $enc: clinicalActivity, 
            measure == "Year2026.Mips128",
            clinicalActivity.isPresent(clinicalActivity.groupExternalIds),
            $groupExternalId memberOf clinicalActivity.groupExternalIds
        ),
        latestClinicalActivity($enc)
    )
then
    insert(new Year2026Mips128DenominatorEncounterEmrGroup($groupExternalId));
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $groupExternalId, "Denominator Encounter", "G9997", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $groupExternalId, "Denominator Encounter", "G9996", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $groupExternalId, "Denominator Encounter", "G8420", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $groupExternalId, "Denominator Encounter", "G8417", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $groupExternalId, "Denominator Encounter", "G8418", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $groupExternalId, "Denominator Encounter", "G9716", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $groupExternalId, "Denominator Encounter", "G2181", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $groupExternalId, "Denominator Encounter", "G8419", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $groupExternalId, "Denominator Encounter", "G8421", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
end

rule 'Year2026.Mips128.Denominator.EMR.Provider'
salience -10
when
    $program: Program(rules contains "measure.Mips.2026.Mips128")
    $patient: Patient()
    EncounterDenominator($encounter: clinicalActivity, program == $program, measure == "Year2026.Mips128", clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    not Year2026Mips128DenominatorEncounterEmrProvider(providerExternalId == $encounter.providerExternalId)
    $lastEncounter: ClinicalActivity() from accumulate(
        EncounterDenominator(
            $enc: clinicalActivity, 
            measure == "Year2026.Mips128",
            clinicalActivity.isPresent(clinicalActivity.providerExternalId),
            clinicalActivity.providerExternalId == $encounter.providerExternalId
