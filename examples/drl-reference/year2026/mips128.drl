    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $encounter.providerExternalId, "Denominator Encounter", "G9997", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $encounter.providerExternalId, "Denominator Encounter", "G9996", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $encounter.providerExternalId, "Denominator Encounter", "G8420", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $encounter.providerExternalId, "Denominator Encounter", "G8417", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $encounter.providerExternalId, "Denominator Encounter", "G8418", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $encounter.providerExternalId, "Denominator Encounter", "G9716", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $encounter.providerExternalId, "Denominator Encounter", "G2181", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $encounter.providerExternalId, "Denominator Encounter", "G8419", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips128", $encounter.providerExternalId, "Denominator Encounter", "G8421", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
end

/*
define "Denominator Exclusion Pregnancy G9997".all: 
   *
   * Option ID: G9997
   *
  (((["Clinical Activity": "MIPS; 128_DENOMINATOR_EXCLUSION_G9997"] 
    union ["Clinical Activity": "MIPS; 497RATE5_DENOMINATOR_EXCLUSION_M1298"])QC 
            with "Denominator" Encounter
            such that QC.start_date during Interval[start of "Measurement Period", Encounter.start_date])
        or 
    union (["Diagnosis": "VSAC; PREGNANCY"] Preg
              with "Denominator" Encounter
              such that(( Interval[Preg.start_date, Preg.stop_date] overlaps Interval[start of "Measurement Period", Encounter.start_date]
                            and Preg.stop_ date is not null or empty)
                        or Preg.start_date during Interval[start of "Measurement Period", Encounter.start_date]))
        )G9997
        ,
        ExtendedMeasureResultV2(
          G9997 //return 1 record per patient even if multiple exists
          , 'Evidence of Pregnancy' as name
          , display_date = start_date
          , calculated_record = false
          , population = Denominator Exclusion
          , option_id = G9997 
      )
*/
query queryYear2026Mips128DenominatorExclusionPregnancyG9997(Program $program, ClinicalActivity $encounter, QdmDatatype $result)
    $result:= ClinicalActivity(
        withValueSet("MipsYear2026", "128_DENOMINATOR_EXCLUSION_G9997") ||
        withValueSet("MipsYear2026", "497RATE5_DENOMINATOR_EXCLUSION_M1298"),
        startsDuring($program.measurementPeriod.start, $encounter.startDate)
    )
    or $result:= Diagnosis(
        withValueSet("VsacYear2026", "PREGNANCY"),
        overlaps($program.measurementPeriod.start, $encounter.startDate),
        stopDate != null  
    )
    or $result:= Diagnosis(
        withValueSet("VsacYear2026", "PREGNANCY"),
        startsDuring($program.measurementPeriod.start, $encounter.startDate)
    )
end

rule 'Year2026.Mips128.Exclusion.pregnancy.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    $result: QdmDatatype() from accumulate(
        queryYear2026Mips128DenominatorExclusionPregnancyG9997($program, $encounter, $r;),
        latestQdmDatatype($r)
    )
    not (exists Year2026Mips128ExclusionPregnancyOrg())
then
    insert(new Year2026Mips128ExclusionPregnancyOrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9997");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Pregnancy", "G9997", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

