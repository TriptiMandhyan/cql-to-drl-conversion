    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Normal BMI Quality Code", "G8420", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
