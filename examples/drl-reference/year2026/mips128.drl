        latestQdmDatatype($r)
    )
then
    insert(new Year2026Mips128ExclusionPregnancyGroup($groupExternalId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9997");
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Evidence of Pregnancy", "G9997", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

