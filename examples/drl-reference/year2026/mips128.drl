/*
define "Last Qualifying Encounter with BMI": 
    Last("Qualifying Encounter" Encounter
        with ["Clinical Activity": "eCQM Direct Reference Code; BODY_MASS_INDEX_BMI_RATIO"] BMI
        such that BMI.start_date during Interval[Encounter.start_date - 12 months, Encounter.start_date]
                  and BMI.result is not null or empty )                

define "Last BMI Before Encounter".all  
// Use LastPerLevel to return statuses for org and each provider_id and group_id associated with a "Last Qualifying Encounter with BMI" Encounter
    (LastPerLevel(["Clinical Activity": "eCQM Direct Reference Code; BODY_MASS_INDEX_BMI_RATIO"] BMI
      with ("Last Qualifying Encounter with BMI" ) Encounter
        such that BMI.start_date during Interval[Encounter.start_date - 12 months, Encounter.start_date])
      sort by BMI.start_date asc) LastBMI
from "Last BMI Before Encounter"
return LastBMI.start_date
return LastBMI.result  
return Encounter.provider_id if Encounter.provider_id is not null or empty
return Encounter.group_id if Encounter.group_id is not null or empty
*/
rule 'Year2026.Mips128.QualifyingEncounterWithBMI'
salience 50
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == "Year2026.Mips128")
    $patient: Patient()
    and exists ClinicalActivity(
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "BODY_MASS_INDEX_BMI_RATIO"),
        startsDuring($encounter.startDate.minusMonths(12), $encounter.startDate)
    )
then
    insert(new Year2026Mips128QualifyingEncounterWithBMI($encounter));
end

rule 'Year2026.Mips128.LastBMIBeforeEncounter.Org'
salience 40
when
    $program: Program(rules contains "measure.Mips.2026.Mips128")
    $patient: Patient()
    $latestEncounter: ClinicalActivity() from accumulate (
        Year2026Mips128QualifyingEncounterWithBMI($c: record),
        latestClinicalActivity($c)
    )
    $latestBmi: ClinicalActivity() from accumulate (
        $c: ClinicalActivity(
            withValueSet("Ecqm_Direct_Reference_CodesYear2026", "BODY_MASS_INDEX_BMI_RATIO"),
            startsDuring($latestEncounter.startDate.minusMonths(12), $latestEncounter.startDate)
        ),
        latestClinicalActivity($c)
    )
then
    insert(new Year2026Mips128LastBMIBeforeEncounterOrg($latestEncounter.startDate, $latestBmi.resultAsDecimal, $latestBmi));
end

rule 'Year2026.Mips128.LastBMIBeforeEncounter.Group'
salience 40
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128", clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    $latestEncounter: ClinicalActivity() from accumulate (
        Year2026Mips128QualifyingEncounterWithBMI(
            $c: record,
            $c.isPresent($c.groupExternalIds),
            $groupExternalId memberOf $c.groupExternalIds
        ),
        latestClinicalActivity($c)
    )
    $latestBmi: ClinicalActivity() from accumulate (
        $c: ClinicalActivity(
            withValueSet("Ecqm_Direct_Reference_CodesYear2026", "BODY_MASS_INDEX_BMI_RATIO"),
            startsDuring($latestEncounter.startDate.minusMonths(12), $latestEncounter.startDate)
        ),
        latestClinicalActivity($c)
    )
then
    insert(new Year2026Mips128LastBMIBeforeEncounterGroup($latestEncounter.startDate, $latestBmi.resultAsDecimal, $latestBmi, $groupExternalId));
end

rule 'Year2026.Mips128.LastBMIBeforeEncounter.Provider'
salience 40
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128", clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    $latestEncounter: ClinicalActivity() from accumulate (
        Year2026Mips128QualifyingEncounterWithBMI(
            $c: record,
            $c.isPresent($c.providerExternalId),
            $encounter.providerExternalId == $c.providerExternalId
        ),
        latestClinicalActivity($c)
    )
    $latestBmi: ClinicalActivity() from accumulate (
        $c: ClinicalActivity(
            withValueSet("Ecqm_Direct_Reference_CodesYear2026", "BODY_MASS_INDEX_BMI_RATIO"),
            startsDuring($latestEncounter.startDate.minusMonths(12), $latestEncounter.startDate)
        ),
        latestClinicalActivity($c)
    )
then
    insert(new Year2026Mips128LastBMIBeforeEncounterProvider($latestEncounter.startDate, $latestBmi.resultAsDecimal, $latestBmi, $encounter.providerExternalId));
end

/*
define "Numerator Performance Met G8420".org:
   *
   * Option ID: G8420
   *
((((["Clinical Activity": "MIPS; 128_PERFORMANCE_MET_G8420"]
  union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_MET_M1296"]) P
    with "Denominator" Encounter
    such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date])c
  and not exists("Last Qualifying Encounter with BMI".org LastEncounterBMI
                  where LastEncounterBMI after Encounter.start_date) G8420
union "Last BMI Before Encounter Is Normal".org)LastBMINormal) 
  ,
  if exists ((["Clinical Activity": "MIPS; 128_PERFORMANCE_MET_G8420"]
             union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_MET_M1296"]) P
                with "Denominator" Encounter
                such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date])
              and not exists("Last Qualifying Encounter with BMI".org LastEncounterBMI
                  where LastEncounterBMI after Encounter.start_date) G8420
  then return
  ExtendedMeasureResultV2(
        G8420 //return 1 record per patient even if multiple exists
        , 'Normal BMI Quality Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = G8420 
    )
  else if exists("Last BMI Before Encounter Is Normal".org)LastBMINormal
  then return
  ExtendedMeasureResultV2(
        LastBMINormal //return 1 record per patient even if multiple exists
        , 'Normal BMI' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = G8420 
    )

define "Last BMI Before Encounter Is Normal":
    "Last BMI Before Encounter Result" >= 18.5
    and "Last BMI Before Encounter Result" < 25

Note: CQL outputs EMR for both branches (G8420 quality code and normal BMI), so keep both.
*/
rule 'Year2026.Mips128.Success.G8420.p1.Org'
salience 30
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_PERFORMANCE_MET_G8420") ||
            withValueSet("MipsYear2026", "497RATE5_PERFORMANCE_MET_M1296"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    )
    and not (exists Year2026Mips128LastBMIBeforeEncounterOrg(encounterStartDate.isAfter($encounter.startDate)))
    and not (exists Year2026Mips128G8420OrgEmr())
then
    insert (new Year2026Mips128G8420OrgEmr());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "G8420");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Normal BMI Quality Code", "G8420", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());

end

rule 'Year2026.Mips128.Success.G8420.p2.Org'
salience 40
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    Year2026Mips128LastBMIBeforeEncounterOrg(
        encounterStartDate == $encounter.startDate,
        $bmi: bmi,
        bmiResult >= 18.5,
