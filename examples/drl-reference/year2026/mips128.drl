/*
define "Denominator Exception G9716".org:
   *
   * Option ID: G9716
   *
((["Clinical Activity": "MIPS; 128_DENOMINATOR_EXCEPTION_G9716"] 
  union ["Clinical Activity": "MIPS; 497RATE5_DENOMINATOR_EXCEPTION_M1286"]) P
    with "Denominator" Encounter
    such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]
  and not exists ("Last Qualifying Encounter with BMI".org BMIEncounter
                   where BMIEncounter.start_date after Encounter.start_date))G9716Org
 ,
 return
 ExtendedMeasureResultV2(
      G9716Org //return 1 record per patient even if multiple exists
      , 'Abnormal BMI Follow-up Not Indicated' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exception
      , option_id = G9716 
  )
*/
rule 'Year2026.Mips128.Exception.G9716.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_DENOMINATOR_EXCEPTION_G9716")  ||
            withValueSet("MipsYear2026", "497RATE5_DENOMINATOR_EXCEPTION_M1286"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    )
    and not (exists Year2026Mips128LastBMIBeforeEncounterOrg(encounterStartDate.isAfter($encounter.startDate)))
    and not (exists Year2026Mips128DenominatorExceptionG9716Emr())
then
    insert(new Year2026Mips128DenominatorExceptionG9716Emr());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCEPTION, "G9716");    
    controlSet.addPatientEMR($program, $patient, $measure, "", "Abnormal BMI Follow-up Not Indicated", "G9716", PopulationEnum.denominator_exception, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

/*
define "Denominator Exception G9716".group:
   *
   * Option ID: G9716
   *
((["Clinical Activity": "MIPS; 128_DENOMINATOR_EXCEPTION_G9716"]
  union ["Clinical Activity": "MIPS; 497RATE5_DENOMINATOR_EXCEPTION_M1286"]) P
    with "Denominator" Encounter
    such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]
  and not exists ("Last Qualifying Encounter with BMI".group BMIEncounter 
                  where BMIEncounter.group_id = Encounter.group_id
                        and BMIEncounter.start_date after Encounter.start_date )) G9716Group
  ,
  return
  ExtendedMeasureResultV2(
      G9716Group //return 1 record per patient even if multiple exists
      , 'Abnormal BMI Follow-up Not Indicated' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exception
      , option_id = G9716 
  )
*/
rule 'Year2026.Mips128.Exception.G9716.group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128", clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_DENOMINATOR_EXCEPTION_G9716") ||
            withValueSet("MipsYear2026", "497RATE5_DENOMINATOR_EXCEPTION_M1286"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    ) and not (
        exists Year2026Mips128LastBMIBeforeEncounterGroup(
            groupExternalId == $groupExternalId,
            encounterStartDate.isAfter($encounter.startDate)
        )
    )
then
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupExternalId, $measure, MeasureStatusValue.EXCEPTION, "G9716");
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Abnormal BMI Follow-up Not Indicated", "G9716", PopulationEnum.denominator_exception, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

/*
define "Denominator Exception G9716".provider:
   *
   * Option ID: G9716
   *
((["Clinical Activity": "MIPS; 128_DENOMINATOR_EXCEPTION_G9716"]
  union ["Clinical Activity": "MIPS; 497RATE5_DENOMINATOR_EXCEPTION_M1286"]) P
    with "Denominator" Encounter
    such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]
  and not exists ("Last Qualifying Encounter with BMI" BMIEncounter 
                  where BMIEncounter.provider_id = Encounter.provider_id
                        and BMIENcounter.start_date after Encounter.start_date)) G9716Provider
  ,
  return
  ExtendedMeasureResultV2(
      G9716Provider //return 1 record per patient even if multiple exists
      , 'Abnormal BMI Follow-up Not Indicated' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exception
      , option_id = G9716 
  )
*/
rule 'Year2026.Mips128.Exception.G9716.provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_DENOMINATOR_EXCEPTION_G9716")  ||
            withValueSet("MipsYear2026", "497RATE5_DENOMINATOR_EXCEPTION_M1286"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    ) and not (
        exists Year2026Mips128LastBMIBeforeEncounterProvider(
            providerExternalId == $encounter.providerExternalId,
            encounterStartDate.isAfter($encounter.startDate)
        )
    )
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCEPTION, "G9716");
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Abnormal BMI Follow-up Not Indicated", "G9716", PopulationEnum.denominator_exception, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

/*
define "Denominator Exception G2181".org:
   *
   * Option ID: G2181
   * 
((["Clinical Activity": "MIPS; 128_DENOMINATOR_EXCEPTION_G2181"] 
  union ["Clinical Activity": "MIPS; 497RATE5_DENOMINATOR_EXCEPTION_M1297"]) P
    with "Denominator" Encounter
    such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]
  and not exists ("Last Qualifying Encounter with BMI".org BMIEncounter
                   where BMIEncounter.start_date after Encounter.start_date))G2181Org
  ,
  return
  ExtendedMeasureResultV2(
      G2181Org //return 1 record per patient even if multiple exists
      , 'BMI Not Done For Patient Reasons as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exception
      , option_id = G2181 
  )
*/
rule 'Year2026.Mips128.Exception.G2181.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_DENOMINATOR_EXCEPTION_G2181") ||
            withValueSet("MipsYear2026", "497RATE5_DENOMINATOR_EXCEPTION_M1297"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    )
    and not (exists Year2026Mips128LastBMIBeforeEncounterOrg(encounterStartDate.isAfter($encounter.startDate)))
    and not (exists Year2026Mips128DenominatorExceptionG2181Emr())
