/*
define "Numerator Performance Not Met G8419":
   *
   * Option ID: G8419
   *
   exists((["Clinical Activity": "MIPS; 128_PERFORMANCE_NOT_MET_G8419"]
        union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_NOT_MET_M1276"]) P
         with "Denominator" Encounter
         such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]
        union P
          with "Denominator" Encounter
          such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]) G8419Encounter
   or exists("Last BMI Before Encounter Is High")
   or exists("Last BMI Before Encounter Is Low") 
  ,
  if exists((["Clinical Activity": "MIPS; 128_PERFORMANCE_NOT_MET_G8419"]
        union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_NOT_MET_M1276"]) P
          with "Denominator" Encounter
          such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]) G8419Encounter
  then return
  ExtendedMeasureResultV2(
        G8419Encounter //return 1 record per patient even if multiple exists
        , 'Abnormal BMI without Follow-up Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Not Met
        , option_id = G8419 
    )
  else if exists("Last BMI Before Encounter Is High") HighBMIEncounter
  then return
  ExtendedMeasureResultV2(
        HighBMIEncounter //return 1 record per patient even if multiple exists
        , 'High BMI without Follow-up' as name //will return the last high BMI for each org/group/provider depending on Denominator encounter
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Not Met
        , option_id = G8419 
    )
  else if exists("Last BMI Before Encounter Is Low") LowBMIEncounter
  then return
  ExtendedMeasureResultV2(
        LowBMI //return 1 record per patient even if multiple exists
        , 'Low BMI without Follow-up' as name //will return the last BMI for each org/group/provider depending on Denominator encounter
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Not Met
        , option_id = G8419 
    )

   
define "Last BMI Before Encounter Is High":
    "Last BMI Before Encounter Result" >= 25

define "Last BMI Before Encounter Is Low": 
    "Last BMI Before Encounter Result" < 18.5
*/
rule 'Year2026.Mips128.Gap.G8419.p1.all'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_PERFORMANCE_NOT_MET_G8419") ||
            withValueSet("MipsYear2026", "497RATE5_PERFORMANCE_NOT_MET_M1276"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    )
then
    insert(new Year2026Mips128PerformanceNotMetG8419());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G8419");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Abnormal BMI without Follow-up Code", "G8419", PopulationEnum.numerator_performance_not_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.getGroupExternalIds()) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.GAP, "G8419");
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Abnormal BMI without Follow-up Code", "G8419", PopulationEnum.numerator_performance_not_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)) {
        controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G8419");
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Abnormal BMI without Follow-up Code", "G8419", PopulationEnum.numerator_performance_not_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    }
end

rule 'Year2026.Mips128.Gap.G8419.p2.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    Year2026Mips128LastBMIBeforeEncounterOrg(
        encounterStartDate == $encounter.startDate,
        $bmi: bmi,
        $bmiResult: bmiResult,
        bmiResult >= 25 ||
        bmiResult < 18.5
    )
then
    insert(new Year2026Mips128PerformanceNotMetG8419());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G8419");
    String evidenceLabel = $bmiResult >= 25 ? "High BMI without Follow-up" : "Low BMI without Follow-up";
    controlSet.addPatientEMR($program, $patient, $measure, "", evidenceLabel, "G8419", PopulationEnum.numerator_performance_not_met, $bmi, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $bmi.startDate.toString());
end

rule 'Year2026.Mips128.Gap.G8419.p2.group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128", clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    Year2026Mips128LastBMIBeforeEncounterGroup(
        encounterStartDate == $encounter.startDate,
        $bmi: bmi,
        $bmiResult: bmiResult,
        bmiResult >= 25 ||
        bmiResult < 18.5,
        groupExternalId == $groupExternalId
    )
then
    insert(new Year2026Mips128PerformanceNotMetG8419());
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupExternalId, $measure, MeasureStatusValue.GAP, "G8419");
    String evidenceLabel = $bmiResult >= 25 ? "High BMI without Follow-up" : "Low BMI without Follow-up";
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, evidenceLabel, "G8419", PopulationEnum.numerator_performance_not_met, $bmi, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $bmi.startDate.toString());
end

rule 'Year2026.Mips128.Gap.G8419.p2.provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    Year2026Mips128LastBMIBeforeEncounterProvider(
        encounterStartDate == $encounter.startDate,
        $bmi: bmi,
        $bmiResult: bmiResult,
        bmiResult >= 25 ||
        bmiResult < 18.5
    )
then
    insert(new Year2026Mips128PerformanceNotMetG8419());
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G8419");
    String evidenceLabel = $bmiResult >= 25 ? "High BMI without Follow-up" : "Low BMI without Follow-up";
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, evidenceLabel, "G8419", PopulationEnum.numerator_performance_not_met, $bmi, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $bmi.startDate.toString());
end

/*
define "Numerator Performance Not Met G8421".all:
  *
  * Option ID: G8421
  *
  not "Denominator Exclusion Pregnancy G9997"
  and not "Denominator Exclusion Hospice or Palliative"
  and not "Numerator Performance Met G8420"
  and not "Numerator Performance Met G8417"
  and not "Numerator Performance Met G8418"
  and not "Denominator Exception G9716"
  and not "Denominator Exception G2181"
  and not "Numerator Performance Not Met G8419"

*/
rule 'Year2026.Mips128.Gap.G8421'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips128")
    $patient: Patient()
    not (
        exists Year2026Mips128PerformanceNotMetG8419()
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G8421");
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.getGroupExternalIds()) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.GAP, "G8421");
        }
    }
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G8421");
end