    such that AdolescentScreen.start_datetime = MostRecentAdolescentDay.start_datetime 
    return MostRecentAdolescentDay.group_id
*/
rule 'Year2026.Mips134Ssp.PositiveAdolescentScreeningExists.Group'
salience 25
when
