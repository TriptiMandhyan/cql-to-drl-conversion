salience 120
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == "Year2026.Mips134Ssp")
    $last: QdmResultDataType() from accumulate (
        queryYear2026Mips134SspAdultScreeningOrg($encounter, $result;),
