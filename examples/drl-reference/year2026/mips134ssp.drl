    controlSet.addPatientEMR($program, $patient, $measure, "", "Most Recent Adult Screening", "G8433", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Most Recent Adult Screening", "G8511", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
