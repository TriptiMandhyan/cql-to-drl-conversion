/**
define "Denominator Encounter":
    ["Clinical Activity": "MIPS; 134_ENCOUNTER"] Encounter
      where Encounter.start_date during "Measurement Period"
        and Encounter.provider_id.hasMeasureMembership = true
            and AgeInYearsAt(start of "Measurement Period") >= 12
*/
rule 'Year2026.Mips134Ssp.Denominator'
salience 150
when
    $program: Program(rules contains "measure.Mips.2026.Mips134ssp")
    Patient(getAgeInYearsAt($program.measurementPeriod.start) >= 12)
    $mips134sspencounter: ClinicalActivity(
        withValueSet("MipsYear2026", "134_ENCOUNTER"),
        startsDuring($program.measurementPeriod)
    )
then
    insert(new EncounterDenominator($program, $mips134sspencounter, 'Year2026.Mips134Ssp'));
end

rule 'Year2026.Mips134Ssp.FindGroups'
salience 150
when
    $program: Program(rules contains "measure.Mips.2026.Mips134ssp")
    Patient(getAgeInYearsAt($program.measurementPeriod.start) >= 12)
    $mips134sspencounter: ClinicalActivity(
        withValueSet("MipsYear2026", "134_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        isPresent(groupExternalIds)
    )
    $groupId: String() from $mips134sspencounter.groupExternalIds
    not Year2026Mips134SspGroups(
        groupExternalId == $groupId
    )
then
    insert(new Year2026Mips134SspGroups($groupId));
end

rule 'Year2026.Mips134Ssp.FindProviders'
salience 150
when
    $program: Program(rules contains "measure.Mips.2026.Mips134ssp")
    Patient(getAgeInYearsAt($program.measurementPeriod.start) >= 12)
    $mips134sspencounter: ClinicalActivity(
        withValueSet("MipsYear2026", "134_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        isPresent(providerExternalId)
    ) and not ( 
        exists Year2026Mips134SspProviders(
            providerExternalId.equals($mips134sspencounter.providerExternalId)
        )
    )
then
    insert(new Year2026Mips134SspProviders($mips134sspencounter.providerExternalId));
end


/**
define "Latest Denominator Encounter".org  
    if exists "Medicare Payer"
    from    (   "Most Recent Adolescent Screening Day".org
                union "Most Recent Adult Screening Day".org  ) Screening
    return Encounter.start_date
// This definition returns the Denominator Encounter.start_date from the "Most Recent Adolescent/Adult Screening Day" not the screening.start_datetime

define "Medicare Payer"
    "Patient"
    where Patient.payer_code_type, payer_code_value in ["ABLE; MEDICARE_PAYER"]
*/
rule 'Year2026.Mips134Ssp.LatestDenominatorEncounter.Org'
salience 50
when
    $program: Program(rules contains "measure.Mips.2026.Mips134ssp")
    Patient(withPayerCodeValueInValueSet("AbleYear2026", "MEDICARE_PAYER"))
    (
        Year2026Mips134SspMostRecentAdolescentScreeningOrg($encounter: encounter, encounter != null) or
        Year2026Mips134SspMostRecentAdultScreeningOrg($encounter: encounter, encounter != null)
    )
then
    insert(new Year2026Mips134SspLatestDenominatorEncounterOrg($encounter));
end

/**
define "Latest Denominator Encounter".group  
    if exists "Medicare Payer"
    from    (   "Most Recent Adolescent Screening Day".provider
                union "Most Recent Adult Screening Day".provider  ) Screening
    return Encounter.start_date, Encounter.group_id
// This definition returns the Denominator Encounter.start_date from the "Most Recent Adolescent/Adult Screening Day" not the screening.start_datetime

define "Medicare Payer"
    "Patient"
    where Patient.payer_code_type, payer_code_value in ["ABLE; MEDICARE_PAYER"]
*/
rule 'Year2026.Mips134Ssp.LatestDenominatorEncounter.group'
salience 50
when
    $program: Program(rules contains "measure.Mips.2026.Mips134ssp")
    Patient(withPayerCodeValueInValueSet("AbleYear2026", "MEDICARE_PAYER"))
    Year2026Mips134SspGroups($groupExternalId: groupExternalId, $groupExternalId != null)
    (
        Year2026Mips134SspMostRecentAdolescentScreeningGroup(
            $encounter: encounter,
            encounter != null,
            $encounter.getGroupExternalIds() != null,
            $encounter.getGroupExternalIds().contains($groupExternalId)
        )
        or Year2026Mips134SspMostRecentAdultScreeningGroup(
            $encounter: encounter,
            encounter != null,
            $encounter.getGroupExternalIds() != null,
            $encounter.getGroupExternalIds().contains($groupExternalId)
        )
    )
then
    insert(new Year2026Mips134SspLatestDenominatorEncounterGroup($encounter));
end

/**
define "Latest Denominator Encounter".provider  
    if exists "Medicare Payer"
    from    (   "Most Recent Adolescent Screening Day".provider
                union "Most Recent Adult Screening Day".provider  ) Screening
    return Encounter.start_date, Encounter.provider_id
// This definition returns the Denominator Encounter.start_date from the "Most Recent Adolescent/Adult Screening Day" not the screening.start_datetime

define "Medicare Payer"
    "Patient"
    where Patient.payer_code_type, payer_code_value in ["ABLE; MEDICARE_PAYER"]
*/
rule 'Year2026.Mips134Ssp.LatestDenominatorEncounter.provider'
salience 50
when
    $program: Program(rules contains "measure.Mips.2026.Mips134ssp")
    Patient(withPayerCodeValueInValueSet("AbleYear2026", "MEDICARE_PAYER"))
    Year2026Mips134SspProviders($providerExternalId: providerExternalId)
    (
        Year2026Mips134SspMostRecentAdolescentScreeningProvider($encounter: encounter, encounter != null, encounter.providerExternalId == $providerExternalId) or
        Year2026Mips134SspMostRecentAdultScreeningProvider($encounter: encounter, encounter != null, encounter.providerExternalId == $providerExternalId)
    )
then
    insert(new Year2026Mips134SspLatestDenominatorEncounterProvider($encounter));
end

/*
define "Denominator Exclusion - G9717".all:
   *
   * Option ID: G9717
   *
  exists(   ["Clinical Activity": "MIPS; 134_DENOMINATOR_EXCLUSION_G9717"] P
            with ("Denominator Encounter") Encounter
            such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date])
  or exists(    "Excluded Diagnosis" ExcludeDiag
                with    ("Denominator Encounter") Encounter
                such that   ExcludeDiag.start_date before Encounter.start_date  )  
        
define "Excluded Diagnosis":
    ["Diagnosis": "MIPS; 134_BIPOLAR"]
*/
rule 'Year2026.Mips134Ssp.Exclusion.exclusion'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips134Ssp')
    $patient: Patient()
    exists (
        ClinicalActivity(
            withValueSet("MipsYear2026", "134_DENOMINATOR_EXCLUSION_G9717"),
            startsDuring($encounter)
        )
        or Diagnosis(
            withValueSet("MipsYear2026", "134_BIPOLAR"),
            startsBefore($encounter.startDate)
        )
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9717");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9717");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9717");
end

/**
define "Most Recent Adolescent Screening Day".org
    Last(   (   "Any Numerator Quality Code" NQC
                    with ("Denominator Encounter") Encounter
                    such that   NCQ.start_date during Interval[Encounter.start_date, Encounter.stop_date]
                                and  AgeInYearsAt(Encounter.start_date < 18) )
                union ( ("Denominator Encounter") Encounter
                        with  "Excluded Diagnosis" ExcludeDiags         // If a patient is creened -> positive -> diagnosed with bipolar -> seen again -> they will flow through to the exclusion pop
                        such that   ExcludeDiag.start_date before Encounter.start_date
                                    AND AgeInYearsAt(Encounter.start_date < 18) )   
                union ( "Adolescent Screening" AdolescentScreen
                        with ("Denominator Encounter") Encounter
                        such that ( AdolescentScreen.start_date during Interval[Encounter.start_date - 14 days, Encounter.start_date]
                                    and AdolescentScreen.result is not null
                                    and AgeInYearsAt(Encounter.start_date < 18  )   )   )
            )   LastAdolescentScreenOrCode
   sort by LastAdolescentScreenOrCode.start_datetime
   return   LastAdolescentScreenOrCode.start_datetime
            , Encounter.start_date
    ,
    ExtendedMeasureResultV2(
        Screening //return 1 record even if multiple exist
        , 'Most Recent Adolescent Screening' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all
    )

define "Excluded Diagnosis":
    ["Diagnosis": "MIPS; 134_BIPOLAR"]

define "Any Numerator Quality Code"
    ["Clinical Activity": "MIPS; 134_PERFORMANCE_NOT_MET_G8511"]
    union ["Clinical Activity": "MIPS; 134_DENOMINATOR_EXCEPTION_G8433"]
    union ["Clinical Activity": "MIPS; 134_PERFORMANCE_MET_G8510"]
    union ["Clinical Activity": "MIPS; 134_DENOMINATOR_EXCLUSION_G9717"] 
    union ["Clinical Activity": "MIPS; 134_PERFORMANCE_MET_G8431"] 

define "Adolescent Screening":
    ["Clinical Activity": "eCQM Direct Reference Codes; ADOLESCENT_DEPRESSION_SCREENING_ASSESSMENT"]
    union ["Clinical Activity": "ABLE; ADOLESCENT_DEPRESSION_SCREENING"]
    union ["Clinical Activity": "VSAC; PHQ_9_AND_PHQ_9M_TOOLS"]
    union ["Clinical Activity": "MIPS; 134_PHQ2"]
    union ["Clinical Activity": "ABLE; EDINBURGH_POSTNATAL_DEPRESSION_SCALE"]
*/
query queryYear2026Mips134SspAdolescentScreeningOrg(ClinicalActivity $encounter, QdmResultDataType $result)
    $result:= QdmResultDataType(
        withValueSet("MipsYear2026", "134_PERFORMANCE_NOT_MET_G8511") ||
        withValueSet("MipsYear2026", "134_DENOMINATOR_EXCEPTION_G8433") ||
        withValueSet("MipsYear2026", "134_PERFORMANCE_MET_G8510") ||
        withValueSet("MipsYear2026", "134_DENOMINATOR_EXCLUSION_G9717") ||
        withValueSet("MipsYear2026", "134_PERFORMANCE_MET_G8431"),
        startsDuring($encounter)
    ) 
    or $result:= QdmResultDataType(
        withValueSet("MipsYear2026", "134_BIPOLAR"),
        startsBefore($encounter.startDate)
    )
    or $result:= QdmResultDataType(
        withValueSet("AbleYear2026", "ADOLESCENT_DEPRESSION_SCREENING") ||
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "ADOLESCENT_DEPRESSION_SCREENING_ASSESSMENT") ||
        withValueSet("VsacYear2026", "PHQ_9_AND_PHQ_9M_TOOLS") ||
        withValueSet("MipsYear2026", "134_PHQ2") ||
        withValueSet("AbleYear2026", "EDINBURGH_POSTNATAL_DEPRESSION_SCALE"),
        startsDuring($encounter.startDate.minusDays(14), $encounter.startDate),
        result != null
    )
end

rule 'Year2026.Mips134Ssp.MostRecentAdolescentScreening.Org'
salience 120
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips134Ssp")
    $last: QdmResultDataType () from accumulate (
        queryYear2026Mips134SspAdolescentScreeningOrg($encounter, $result;),
        latestQdmResultDataType($result)
    )
    and Patient(
        getAgeInYearsAt($encounter.startDate) < 18
    )
then
    insert(new Year2026Mips134SspMostRecentAdolescentScreeningCalculationOrg($last, $encounter));
end

rule 'Year2026.Mips134Ssp.MostRecentAdolescentScreening.LatestEncounter.Org'
salience 75
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips134Ssp')
    $patient: Patient()
    $latestRecord: QdmResultDataType () from accumulate (
        Year2026Mips134SspMostRecentAdolescentScreeningCalculationOrg($c: record),
        latestQdmResultDataType($c)
    )
    Year2026Mips134SspMostRecentAdolescentScreeningCalculationOrg(record.equals($latestRecord), $encounter: encounter)
then
    insert(new Year2026Mips134SspMostRecentAdolescentScreeningOrg($latestRecord, $encounter));
    controlSet.addPatientEMR($program, $patient, $measure, "", "Most Recent Adolescent Screening", "G8431", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Most Recent Adolescent Screening", "G8510", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Most Recent Adolescent Screening", "G8433", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Most Recent Adolescent Screening", "G8511", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Most Recent Adolescent Screening", "G9717", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Most Recent Adolescent Screening", "G8432", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
end

/**
define "Most Recent Adolescent Screening Day".group
    Last(   (   "Any Numerator Quality Code" NQC
                    with ("Denominator Encounter") Encounter
                    such that   NCQ.start_date during Interval[Encounter.start_date, Encounter.stop_date]
                                and  AgeInYearsAt(Encounter.start_date < 18) 
                                and Encounter.group_id is not null or empty)
                union ( ("Denominator Encounter") Encounter
                        with  "Excluded Diagnosis" ExcludeDiags         // If a patient is creened -> positive -> diagnosed with bipolar -> seen again -> they will flow through to the exclusion pop
                        such that   ExcludeDiag.start_date before Encounter.start_date
                                    AND AgeInYearsAt(Encounter.start_date < 18) 
                                    and Encounter.group_id is not null or empty)   
                union ( "Adolescent Screening" AdolescentScreen
                        with ("Denominator Encounter") Encounter
                        such that ( AdolescentScreen.start_date during Interval[Encounter.start_date - 14 days, Encounter.start_date]
                                    and AdolescentScreen.result is not null
                                    and AgeInYearsAt(Encounter.start_date < 18  ) 
                                    and Encounter.group_id is not null or empty  )   )
            )   LastAdolescentScreenOrCode
   sort by LastAdolescentScreenOrCode.start_datetime
   return   LastAdolescentScreenOrCode.start_datetime,
            , Encounter.group_id as "Most Recent Adolescent Screening Day".group.group_id
            , Encounter.start_date
    ,
    ExtendedMeasureResultV2(
        Screening //return 1 record even if multiple exist
        , 'Most Recent Adolescent Screening' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all
    )

*/
query queryYear2026Mips134SspAdolescentScreeningGroup(ClinicalActivity $encounter, QdmResultDataType $result)
    $result:= QdmResultDataType(
        withValueSet("MipsYear2026", "134_PERFORMANCE_NOT_MET_G8511") ||
        withValueSet("MipsYear2026", "134_DENOMINATOR_EXCEPTION_G8433") ||
        withValueSet("MipsYear2026", "134_PERFORMANCE_MET_G8510") ||
        withValueSet("MipsYear2026", "134_DENOMINATOR_EXCLUSION_G9717") ||
        withValueSet("MipsYear2026", "134_PERFORMANCE_MET_G8431"),
        startsDuring($encounter),
        isPresent($encounter.groupExternalIds)
    )
    or $result:= QdmResultDataType(
        withValueSet("MipsYear2026", "134_BIPOLAR"),
        startsBefore($encounter.startDate),
        isPresent($encounter.groupExternalIds)
    )
    or $result:= QdmResultDataType(
        withValueSet("AbleYear2026", "ADOLESCENT_DEPRESSION_SCREENING") ||
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "ADOLESCENT_DEPRESSION_SCREENING_ASSESSMENT") ||
        withValueSet("VsacYear2026", "PHQ_9_AND_PHQ_9M_TOOLS") ||
        withValueSet("MipsYear2026", "134_PHQ2") ||
        withValueSet("AbleYear2026", "EDINBURGH_POSTNATAL_DEPRESSION_SCALE"),
        startsDuring($encounter.startDate.minusDays(14), $encounter.startDate),
        result != null,
        isPresent($encounter.groupExternalIds)
    )
end

rule 'Year2026.Mips134Ssp.MostRecentAdolescentScreening.Group'
salience 120
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips134Ssp")
    $last: QdmResultDataType() from accumulate (
        queryYear2026Mips134SspAdolescentScreeningGroup($encounter, $result;),
        latestQdmResultDataType($result)
    )
    and Patient(
        getAgeInYearsAt($encounter.startDate) < 18
    )
then
    insert(new Year2026Mips134SspMostRecentAdolescentScreeningCalculationGroup($last, $encounter));
end

rule 'Year2026.Mips134Ssp.MostRecentAdolescentScreening.LatestEncounter.Group'
salience 75
when
    $program: Program(rules contains "measure.Mips.2026.Mips134ssp")
    $patient: Patient()
    Year2026Mips134SspGroups($groupExternalId: groupExternalId, $groupExternalId != null)
    $latestRecord: QdmResultDataType() from accumulate (
        Year2026Mips134SspMostRecentAdolescentScreeningCalculationGroup(
            $c: record,
            $encounter: encounter != null,
            $encounter.getGroupExternalIds() != null,
            $encounter.getGroupExternalIds().contains($groupExternalId)
        ),
        latestQdmResultDataType($c)
    )
    Year2026Mips134SspMostRecentAdolescentScreeningCalculationGroup(record.equals($latestRecord), $encounter: encounter)
then
    insert(new Year2026Mips134SspMostRecentAdolescentScreeningGroup($latestRecord, $encounter));
    for (String groupExternalId : $encounter.groupExternalIds) {
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adolescent Screening", "G8431", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adolescent Screening", "G8510", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adolescent Screening", "G8433", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adolescent Screening", "G8511", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adolescent Screening", "G9717", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adolescent Screening", "G8432", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    }
end

/**
define "Most Recent Adolescent Screening Day".provider
    Last    (   (   "Any Numerator Quality Code" NQC
                    with ("Denominator Encounter") Encounter
                    such that   NCQ.start_date during Interval[Encounter.start_date, Encounter.stop_date]
                                and  AgeInYearsAt(Encounter.start_date < 18) 
                                and Encounter.provider_id is not null or empty  )
                union ( ("Denominator Encounter") Encounter
                        with  "Excluded Diagnosis" ExcludeDiags        // If a patient is creened -> positive -> diagnosed with bipolar -> seen again -> they will flow through to the exclusion pop
                        such that   ExcludeDiag.start_date before Encounter.start_date
                                    and AgeInYearsAt(Encounter.start_date < 18) 
                                    and Encounter.provider_id is not null or empty  )   
                union ( "Adolescent Screening" AdolescentScreen
                        with ("Denominator Encounter") Encounter
                        such that ( AdolescentScreen.start_date during Interval[Encounter.start_date - 14 days, Encounter.start_date]
                                    and AdolescentScreen.result is not null
                                    and AgeInYearsAt(Encounter.start_date < 18  ) 
                                    and Encounter.provider_id is not null or empty )   )
            )   LastAdolescentScreenOrCode
   sort by LastAdolescentScreenOrCode.start_datetime
   return   LastAdolescentScreenOrCode.start_datetime
            , Encounter.provider_id as "Most Recent Adolescent Screening Day".provider.provider_id
            , Encounter.start_date
    ,
    ExtendedMeasureResultV2(
        Screening //return 1 record even if multiple exist
        , 'Most Recent Adolescent Screening' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all
    )

*/
query queryYear2026Mips134SspAdolescentScreeningProvider(ClinicalActivity $encounter, QdmResultDataType $result)
    $result:= QdmResultDataType(
        withValueSet("MipsYear2026", "134_PERFORMANCE_NOT_MET_G8511") ||
        withValueSet("MipsYear2026", "134_DENOMINATOR_EXCEPTION_G8433") ||
        withValueSet("MipsYear2026", "134_PERFORMANCE_MET_G8510") ||
        withValueSet("MipsYear2026", "134_DENOMINATOR_EXCLUSION_G9717") ||
        withValueSet("MipsYear2026", "134_PERFORMANCE_MET_G8431"),
        startsDuring($encounter),
        isPresent($encounter.providerExternalId)
    ) 
    or $result:= QdmResultDataType(
        withValueSet("MipsYear2026", "134_BIPOLAR"),
        startsBefore($encounter.startDate),
        isPresent($encounter.providerExternalId)
    )
    or $result:= QdmResultDataType(
        withValueSet("AbleYear2026", "ADOLESCENT_DEPRESSION_SCREENING") ||
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "ADOLESCENT_DEPRESSION_SCREENING_ASSESSMENT") ||
        withValueSet("VsacYear2026", "PHQ_9_AND_PHQ_9M_TOOLS") ||
        withValueSet("MipsYear2026", "134_PHQ2") ||
        withValueSet("AbleYear2026", "EDINBURGH_POSTNATAL_DEPRESSION_SCALE"),
        startsDuring($encounter.startDate.minusDays(14), $encounter.startDate),
        result != null,
        isPresent($encounter.providerExternalId)
    )
end

rule 'Year2026.Mips134Ssp.MostRecentAdolescentScreening.Provider'
salience 120
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips134Ssp")
    $last: QdmResultDataType() from accumulate (
        queryYear2026Mips134SspAdolescentScreeningProvider($encounter, $result;),
        latestQdmResultDataType($result)
    )
    and Patient(
        getAgeInYearsAt($encounter.startDate) < 18
    )
then
    insert(new Year2026Mips134SspMostRecentAdolescentScreeningCalculationProvider($last, $encounter));
end

rule 'Year2026.Mips134Ssp.MostRecentAdolescentScreening.LatestEncounter.Provider'
salience 75
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips134Ssp')
    $patient: Patient()
    Year2026Mips134SspProviders($providerExternalId: providerExternalId)
    $latestRecord: QdmResultDataType() from accumulate (
        Year2026Mips134SspMostRecentAdolescentScreeningCalculationProvider($c: record, encounter.providerExternalId == $providerExternalId),
        latestQdmResultDataType($c)
    )
    Year2026Mips134SspMostRecentAdolescentScreeningCalculationProvider(record.equals($latestRecord), $encounter: encounter)
then
    insert(new Year2026Mips134SspMostRecentAdolescentScreeningProvider($latestRecord, $encounter));
    controlSet.addPatientEMR($program, $patient, $measure, $providerExternalId, "Most Recent Adolescent Screening", "G8431", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $providerExternalId, "Most Recent Adolescent Screening", "G8510", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $providerExternalId, "Most Recent Adolescent Screening", "G8433", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $providerExternalId, "Most Recent Adolescent Screening", "G8511", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $providerExternalId, "Most Recent Adolescent Screening", "G9717", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $providerExternalId, "Most Recent Adolescent Screening", "G8432", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
end

/**
define "Most Recent Adult Screening DAY".org
    Last(   (   (   "Any Numerator Quality Code" NQC
                    with ("Denominator Encounter") Encounter
                    such that   NQC.start_date during Interval[Encounter.start_date, Encounter.stop_date] 
                                and AgeInYearsAt(Encounter.start_date >= 18)    )
                union ( ("Denominator Encounter") Encounter
                        with   "Excluded Diagnosis" ExcludeDiag             // If a patient is creened -> positive -> diagnosed with bipolar -> seen again -> they will flow through to the exclusion pop
                        such that   ExcludeDiag.start_date before Encounter.start_date
                                    AND AgeInYearsAt(Encounter.start_date >= 18) )   
                union ( "Adult Screening" AdultScreen
                        with ("Denominator Encounter") Encounter
                        such that ( AdultScreen.start_date during Interval[Encounter.start_date - 14 days, Encounter.start_date]
                                    and AdultScreen.result is not null
                                    and AgeInYearsAt(Encounter.start_date >= 18)    )   )
            ) LastAdultScreenOrCode
    sort by LastAdultScreenOrCode.start_datetime
    return  LastAdultScreenOrCode.start_datetime
            , Encounter.start_date // for use in Latest Denominator Encounter
    ,
    ExtendedMeasureResultV2(
        Screening //return 1 record even if multiple exist
        , 'Most Recent Adult Screening' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all
    )
                    
define "Excluded Diagnosis":
    ["Diagnosis": "MIPS; 134_BIPOLAR"]

define "Any Numerator Quality Code"
    ["Clinical Activity": "MIPS; 134_PERFORMANCE_NOT_MET_G8511"]
    union ["Clinical Activity": "MIPS; 134_DENOMINATOR_EXCEPTION_G8433"]
    union ["Clinical Activity": "MIPS; 134_PERFORMANCE_MET_G8510"]
    union ["Clinical Activity": "MIPS; 134_DENOMINATOR_EXCLUSION_G9717"] 
    union ["Clinical Activity": "MIPS; 134_PERFORMANCE_MET_G8431"]

define "Adult Screening"
    ["Clinical Activity": "eCQM Direct Reference Codes; ADULT_DEPRESSION_SCREENING_ASSESSMENT"]
    union ["Clinical Activity": "ABLE; ADULT_DEPRESSION_SCREENING"]
    union ["Clinical Activity": "ABLE; PHQ_9_TOOL_ADULT"]
    union ["Clinical Activity": "MIPS; 134_PHQ2"]
    union ["Clinical Activity": "ABLE; GERIATRIC_DEPRESSION_SCALE_SHORT_VERSION"]
    union ["Clinical Activity": "ABLE; GERIATRIC_DEPRESSION_SCALE_PANEL_TOTAL"]
    union ["Clinical Activity": "ABLE; EDINBURGH_POSTNATAL_DEPRESSION_SCALE"]
*/
query queryYear2026Mips134SspAdultScreeningOrg(ClinicalActivity $encounter, QdmResultDataType $result)
    $result:= QdmResultDataType(
        withValueSet("MipsYear2026", "134_PERFORMANCE_NOT_MET_G8511") ||
        withValueSet("MipsYear2026", "134_DENOMINATOR_EXCEPTION_G8433") ||
        withValueSet("MipsYear2026", "134_PERFORMANCE_MET_G8510") ||
        withValueSet("MipsYear2026", "134_DENOMINATOR_EXCLUSION_G9717") ||
        withValueSet("MipsYear2026", "134_PERFORMANCE_MET_G8431"),
        startsDuring($encounter)
    )
    or $result:= QdmResultDataType(
        withValueSet("MipsYear2026", "134_BIPOLAR"),
        startsBefore($encounter.startDate)
    )
    or $result:= QdmResultDataType(
        withValueSet("AbleYear2026", "ADULT_DEPRESSION_SCREENING") ||
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "ADULT_DEPRESSION_SCREENING_ASSESSMENT") ||
        withValueSet("AbleYear2026", "GERIATRIC_DEPRESSION_SCALE_SHORT_VERSION") ||
        withValueSet("AbleYear2026", "GERIATRIC_DEPRESSION_SCALE_PANEL_TOTAL") ||
        withValueSet("AbleYear2026", "EDINBURGH_POSTNATAL_DEPRESSION_SCALE") ||
        withValueSet("AbleYear2026", "PHQ_9_TOOL_ADULT") ||
        withValueSet("MipsYear2026", "134_PHQ2"),
        startsDuring($encounter.startDate.minusDays(14), $encounter.startDate),
        result != null
    )
end

