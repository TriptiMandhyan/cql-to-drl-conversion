/**
define "Positive Adult Screening Exists on Most Recent Day".org:
    exists "Adult Screening Interpreted as Positive on Most Recent Day".org
    or exists ( ("Adult Screening Positive by Score on Most Recent Day".org) AdultPositiveScoreScreening
                and not exists ("Adult Screening Interpreted as Negative on Most Recent Day".org )AdultNegativeInterpretationScreening
                such that AdultPositiveScoreScreening.start_datetime =  AdultNegativeInterpretationScreening.start_datetime )

define "Adult Screening Interpreted as Positive on Most Recent Day".org:
    "Adult Screening" AdultScreen
    where ( AdultScreen.result = 'positive'
            or AdultScreen.result in ["eCQM Direct Reference Codes; DEPRESSION_SCREENING_POSITIVE_FINDING"] ))
    with ("Most Recent Adult Screening DAY".org) MostRecentAdultDay
    such that AdultScreen.start_datetime = MostRecentAdultDay.start_datetime        

define "Adult Screening Positive by Score on Most Recent Day".org:
    (   (   ["Clinical Activity": "ABLE; PHQ_9_TOOL_ADULT"] PHQ9
            where PHQ9.result >= 5  )
        union ( ["Clinical Activity": "MIPS; 134_PHQ2"] PHQ2
                where PHQ2.result >= 3    )
        union ( ["Clinical ACtivity": "ABLE; EDINBURGH_POSTNATAL_DEPRESSION_SCALE"] EPDS
                where EPDS.result >= 9    )
        union ( ["Clinical Activity": "ABLE; GERIATRIC_DEPRESSION_SCALE_SHORT_VERSION"] GDSshort
                where GDSshort.result > 5 ) 
        union ( ["Clinical Activity": "ABLE; GERIATRIC_DEPRESSION_SCALE_PANEL_TOTAL"] GDSlong
                where GDSlong.result > 9  ) 
    ) AdultPositveScoreScreening
    with ("Most Recent Adult Screening DAY".org) MostRecentAdultDay
    such that AdultPositveScoreScreening.start_datetime = MostRecentAdultDay.start_datetime 
 
define "Adult Screening Interpreted as Negative on Most Recent Day".org:
   ("Adult Screening" AdultScreen
    where ( AdultScreen.result = 'negative'
            or AdultScreen.result in ["eCQM Direct Reference Codes; DEPRESSION_SCREENING_NEGATIVE_FINDING"] ))
    with ("Most Recent Adult Screening DAY".org) MostRecentAdultDay
    such that AdultScreen.start_datetime = MostRecentAdultDay.start_datetime 
*/
rule 'Year2026.Mips134Ssp.PositiveAdultScreeningExists.Org'
salience 25
when
    Year2026Mips134SspMostRecentAdultScreeningOrg($latestRecord: latestRecord)
    (
        //When there are same dates for the most recent date, it is needed to make sure to check if exists the correct one.
        $screening: ClinicalActivity(
            withValueSet("AbleYear2026", "ADULT_DEPRESSION_SCREENING") ||
            withValueSet("Ecqm_Direct_Reference_CodesYear2026", "ADULT_DEPRESSION_SCREENING_ASSESSMENT") ||
            withValueSet("AbleYear2026", "GERIATRIC_DEPRESSION_SCALE_SHORT_VERSION") ||
            withValueSet("AbleYear2026", "GERIATRIC_DEPRESSION_SCALE_PANEL_TOTAL") ||
            withValueSet("AbleYear2026", "EDINBURGH_POSTNATAL_DEPRESSION_SCALE") ||
            withValueSet("AbleYear2026", "PHQ_9_TOOL_ADULT") ||
            withValueSet("MipsYear2026", "134_PHQ2"),
            startDate == $latestRecord.startDate,
            (result == 'positive' ||
                withValueSetInResult("Ecqm_Direct_Reference_CodesYear2026", "DEPRESSION_SCREENING_POSITIVE_FINDING"))
        )
        or (
            (
                $screening: ClinicalActivity(
                    withValueSet("AbleYear2026", "PHQ_9_TOOL_ADULT"),
                    startDatetime == $latestRecord.startDatetime,
                    resultAsDecimal >= 5
                ) 
                or $screening: ClinicalActivity(
                    withValueSet("MipsYear2026","134_PHQ2"),
                    startDatetime == $latestRecord.startDatetime,
                    resultAsDecimal >= 3
                )  
                or $screening: ClinicalActivity(
                    withValueSet("AbleYear2026","EDINBURGH_POSTNATAL_DEPRESSION_SCALE"),
                    startDatetime == $latestRecord.startDatetime,
                    resultAsDecimal >= 9
                ) 
                or $screening: ClinicalActivity(
                    withValueSet("AbleYear2026","GERIATRIC_DEPRESSION_SCALE_SHORT_VERSION"),
                    startDatetime == $latestRecord.startDatetime,
                    resultAsDecimal > 5
                ) 
                or $screening: ClinicalActivity(
                    withValueSet("AbleYear2026","GERIATRIC_DEPRESSION_SCALE_PANEL_TOTAL"),
                    startDatetime == $latestRecord.startDatetime,
                    resultAsDecimal > 9
                )
            ) and not (
                exists ClinicalActivity (
                    withValueSet("AbleYear2026", "ADULT_DEPRESSION_SCREENING") ||
                    withValueSet("Ecqm_Direct_Reference_CodesYear2026", "ADULT_DEPRESSION_SCREENING_ASSESSMENT") ||
                    withValueSet("AbleYear2026", "GERIATRIC_DEPRESSION_SCALE_SHORT_VERSION") ||
                    withValueSet("AbleYear2026", "GERIATRIC_DEPRESSION_SCALE_PANEL_TOTAL") ||
                    withValueSet("AbleYear2026", "EDINBURGH_POSTNATAL_DEPRESSION_SCALE") ||
                    withValueSet("AbleYear2026", "PHQ_9_TOOL_ADULT") ||
                    withValueSet("MipsYear2026", "134_PHQ2"),
                    startDate == $latestRecord.startDate,
                    (result == 'negative' ||
                        withValueSetInResult("Ecqm_Direct_Reference_CodesYear2026", "DEPRESSION_SCREENING_NEGATIVE_FINDING"))
                )
            )
        )
    )
then
    insert(new Year2026Mips134SspPositiveAdultScreeningExistsOrg($screening));
end


