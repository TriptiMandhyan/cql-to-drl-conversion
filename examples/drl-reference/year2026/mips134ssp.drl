/**
define "Numerator Performance Met - G8431".org:
  *
  * Option ID: G8431
  *
    (   ["Clinical Activity": "MIPS; 134_PERFORMANCE_MET_G8431"] G8431
        with ("Latest Denominator Encounter".org) Encounter
        such that   (   (   Encounter.stop_date is not null or empty
                            and G8431.start_date during Interval[Encounter.start_date, Encounter.stop_date] )   
                        or  (   Encounter.stop_date is null or empty
                                and P.start_date = Encounter.start_date )                        
                    )
    ) P1
    union "Positive Adolescent Screening and Follow-up Exist".org P2
    union "Positive Adult Screening and Follow-up Exist".org P3
    ,
    ExtendedMeasureResultV2(
        Num //return 1 record even if multiple exist
        , 'Numerator Performance Met G8431' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator
        , option_id = G8431
    )

 define "Positive Adolescent Screening and Follow-Up Exist".org:
    "Adolescent Follow-Up Exists".org
    and exists ("Positive Adolescent Screening Exists on Most Recent Day".org)

define "Positive Adult Screening and Follow-Up Exist".org:
    "Adult Follow-Up Exists".org
    and exists ("Positive Adult Screening Exists on Most Recent Day".org)
*/
rule 'Year2026.Mips134Ssp.Success.G8431.Org.P1.Patient&Emr'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips134Ssp')
    $patient: Patient()
    not(exists Year2026Mips134SspSucessG8431Org())
