/**
define "Numerator Performance Not Met: G8432":
   *
   * Option ID: G8432
   *
  not "Denominator Exclusion - G9717"
  and not "Numerator Performance Met - G8431"
  and not "Numerator Performance Met - G8510"
  and not "Denominator Exception - G8433"
  and not "Numerator Performance Not Met - G8511"
*/
rule 'Year2026.Mips134Ssp.Gap.G8432'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips134Ssp')
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G8432");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G8432");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "G8432");
end

// Definitions 

/**
define "Positive Adolescent Screening Exists on Most Recent Day".org:
    exists "Adolescent Screening Interpreted as Positive on Most Recent Day".org
    or exists ( ("Adolescent Screening Positive by Score on Most Recent Day".org) AdolescentPositiveScoreScreening
                and not exists ("Adolescent Screening Interpreted as Negative on Most Recent Day".org) AdolescentNegativeInterpretationScreening
                such that AdolescentPositiveScoreScreening.start_datetime = AdolescentNegativeInterpretationScreening.start_datetime )

define "Adolescent Screening Interpreted as Positive on Most Recent Day".org:
    "Adolescent Screening" AdolescentScreen
    where ( AdolescentScreen.result = 'positive'
            or AdolescentScreen.result in ["eCQM Direct Reference Codes; DEPRESSION_SCREENING_POSITIVE_FINDING"] )
    with ("Most Recent Adolescent Screening Day".org)MostRecentAdolescentDay
    such that AdolescentScreen.start_datetime = MostRecentAdolescentDay.start_datetime
              
define "Adolescent Screening Positive by Score on Most Recent Day".org:
    (   (   ["Clinical Activity": "VSAC; PHQ_9_AND_PHQ_9M_TOOLS"] PHQ9
            where PHQ9.result >= 5    )
    union ( ["Clinical Activity": "MIPS; 134_PHQ2"] PHQ2
            where PHQ2.result >= 3    )
    union ( ["Clinical Activity": "ABLE; EDINBURGH_POSTNATAL_DEPRESSION_SCALE"] EPDS
            where EPDS.result >= 9    )
    ) AdolescentPositveScoreScreeningScore 
    with ("Most Recent Adolescent Screening Day".org) MostRecentAdolescentDay
    such that AdolescentPositveScoreScreeningScore.start_datetime = MostRecentAdolescentDay.start_datetime   

define "Adolescent Screening Interpreted as Negative on Most Recent Day".org:
    "Adolescent Screening" AdolescentScreen
    where ( AdolescentScreen.result = 'negative'
            or AdolescentScreen.result in ["eCQM Direct Reference Codes; DEPRESSION_SCREENING_NEGATIVE_FINDING"] )
    with ("Most Recent Adolescent Screening DAY".org) MostRecentAdolescentDay
    such that AdolescentScreen.start_datetime = MostRecentAdolescentDay.start_datetime   
*/
rule 'Year2026.Mips134Ssp.PositiveAdolescentScreeningExists.Org'
salience 25
when
    Year2026Mips134SspMostRecentAdolescentScreeningOrg($latestRecord: latestRecord)
    (
        //When there are same dates for the most recent date, it is needed to make sure to check if exists the correct one.
        $screening: ClinicalActivity(
            withValueSet("AbleYear2026", "ADOLESCENT_DEPRESSION_SCREENING") ||
            withValueSet("Ecqm_Direct_Reference_CodesYear2026", "ADOLESCENT_DEPRESSION_SCREENING_ASSESSMENT") ||
            withValueSet("VsacYear2026", "PHQ_9_AND_PHQ_9M_TOOLS") ||
            withValueSet("MipsYear2026", "134_PHQ2") ||
            withValueSet("AbleYear2026", "EDINBURGH_POSTNATAL_DEPRESSION_SCALE"),
            startDate == $latestRecord.startDate,
            (result == 'positive' || 
                withValueSetInResult("Ecqm_Direct_Reference_CodesYear2026", "DEPRESSION_SCREENING_POSITIVE_FINDING"))
        )
        //Adolescent Screening Positive by Score on Most Recent Day
        or (
            (
                $screening: ClinicalActivity(
                    withValueSet("VsacYear2026", "PHQ_9_AND_PHQ_9M_TOOLS"),
                    startDatetime == $latestRecord.startDatetime,
                    resultAsDecimal >= 5
                ) or $screening: ClinicalActivity(
                    withValueSet("MipsYear2026","134_PHQ2"),
                    startDatetime == $latestRecord.startDatetime,
                    resultAsDecimal >= 3
                ) or $screening: ClinicalActivity(
                    withValueSet("AbleYear2026","EDINBURGH_POSTNATAL_DEPRESSION_SCALE"),
                    startDatetime == $latestRecord.startDatetime,
                    resultAsDecimal >= 9
                )
            ) and not (
                exists ClinicalActivity(
                    withValueSet("AbleYear2026", "ADOLESCENT_DEPRESSION_SCREENING") ||
                    withValueSet("Ecqm_Direct_Reference_CodesYear2026", "ADOLESCENT_DEPRESSION_SCREENING_ASSESSMENT") ||
                    withValueSet("VsacYear2026", "PHQ_9_AND_PHQ_9M_TOOLS") ||
                    withValueSet("MipsYear2026", "134_PHQ2") ||
                    withValueSet("AbleYear2026", "EDINBURGH_POSTNATAL_DEPRESSION_SCALE"),
                    startDate == $latestRecord.startDate,
                    (result == 'negative' || 
                        withValueSetInResult("Ecqm_Direct_Reference_CodesYear2026", "DEPRESSION_SCREENING_NEGATIVE_FINDING"))
                )
            )
        )
    )
then
    insert(new Year2026Mips134SspPositiveAdolescentScreeningExistsOrg($screening));
end

/**
define "Positive Adolescent Screening Exists on Most Recent Day".group:
    exists "Adolescent Screening Interpreted as Positive on Most Recent Day".group
    or exists ( ("Adolescent Screening Positive by Score on Most Recent Day".group) AdolescentPositiveScoreScreening
                and not exists ("Adolescent Screening Interpreted as Negative on Most Recent Day".group) AdolescentNegativeInterpretationScreening
                such that AdolescentPositiveScoreScreening.start_datetime = AdolescentNegativeInterpretationScreening.start_datetime)

define "Adolescent Screening Interpreted as Positive on Most Recent Day".group:
    "Adolescent Screening" AdolescentScreen
    where ( AdolescentScreen.result = 'positive'
