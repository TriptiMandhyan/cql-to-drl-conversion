    exists Year2026Mips134SspLatestDenominatorEncounterProvider(encounter.equals($encounter))
    $exception: ClinicalActivity() from accumulate(
        $c: ClinicalActivity(
            withValueSet("MipsYear2026", "134_DENOMINATOR_EXCEPTION_G8433"),
            ($encounter.stopDate != null && startsDuring($encounter)) ||
            ($encounter.stopDate == null && $encounter.startDate == startDate)
        ),
        latestClinicalActivity($c)
    )
then
    insert(new Year2026Mips134SspExceptionG8433Provider($encounter));
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCEPTION, "G8433");
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Exception G8433", "G8433", PopulationEnum.denominator_exception, $exception, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $exception.startDate.toString());
end

/**
define "Numerator Performance Not Met - G8511".org:
   *
   * Option ID: G8511
   *
    (   ["Clinical Activity": "MIPS; 134_PERFORMANCE_NOT_MET_G8511"] G8511
        with ("Latest Denominator Encounter".org) Encounter
        such that   (   (   Encounter.stop_date is not null or empty
                            and G8511.start_date during Interval[Encounter.start_date, Encounter.stop_date] )   
                        or  (   Encounter.stop_date is null or empty
                                and G8511.start_date = Encounter.start_date )                        
                    )
    ) P1
    union "Positive Adolescent Screening Exists on Most Recent Day".org    P2
    union "Positive Adult Screening Exists on Most Recent Day".org P3

    ,
    ExtendedMeasureResultV2(
        Num //return 1 record even if multiple exist
        , 'Numerator Performance Not Met G8511' as name
        , display_date = start_date
        , calculated_record = false
        , population = Performance Not Met
        , option_id = G8511
    )
*/

rule 'Year2026.Mips134Ssp.Gap.G8511.Org.Patient&Emr'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips134Ssp')
    $patient: Patient()
    not(exists Year2026Mips134SspGapG8511Org())
    exists Year2026Mips134SspLatestDenominatorEncounterOrg(encounter.equals($encounter))
    and (
        $gap: ClinicalActivity() from accumulate(
            $c: ClinicalActivity(
                withValueSet("MipsYear2026", "134_PERFORMANCE_NOT_MET_G8511"),
                ($encounter.stopDate != null && startsDuring($encounter)) ||
                ($encounter.stopDate == null && $encounter.startDate == startDate)
            ),
            latestClinicalActivity($c)
        )
        or $gap: ClinicalActivity() from accumulate(
            Year2026Mips134SspPositiveAdolescentScreeningExistsOrg($c: screening),
            latestClinicalActivity($c)
        )
        or $gap: ClinicalActivity() from accumulate(
            Year2026Mips134SspPositiveAdultScreeningExistsOrg($c: screening),
            latestClinicalActivity($c)
        )
    )
then
    insert(new Year2026Mips134SspGapG8511Org());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G8511");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Numerator Performance Not Met G8511", "G8511", PopulationEnum.numerator_performance_not_met, $gap, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $gap.startDate.toString());
end


/**
define "Numerator Performance Not Met - G8511".group:
  *
  * Option ID: G8511
  *
    (   ["Clinical Activity": "MIPS; 134_PERFORMANCE_NOT_MET_G8511"] G8511
        with ("Latest Denominator Encounter".group) Encounter
        such that   (   (   Encounter.stop_date is not null or empty
                            and G8511.start_date during Interval[Encounter.start_date, Encounter.stop_date] )   
                        or  (   Encounter.stop_date is null or empty
                                and G8511.start_date = Encounter.start_date )                        
                    )
    ) P1
    union "Positive Adolescent Screening Exists on Most Recent Day".group    P2
    union "Positive Adult Screening Exists on Most Recent Day".group P3

    ,
    ExtendedMeasureResultV2(
        Num //return 1 record even if multiple exist
        , 'Numerator Performance Not Met G8511' as name
        , display_date = start_date
        , calculated_record = false
        , population = Performance Not Met
        , option_id = G8511
    )
*/
rule 'Year2026.Mips134Ssp.Gap.G8511.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips134Ssp')
    $patient: Patient()
    not(exists Year2026Mips134SspGapG8511Group(encounter == $encounter))
    exists Year2026Mips134SspLatestDenominatorEncounterGroup(encounter.equals($encounter))
    and (
        $gap: ClinicalActivity() from accumulate(
            $c: ClinicalActivity(
                withValueSet("MipsYear2026", "134_PERFORMANCE_NOT_MET_G8511"),
                ($encounter.stopDate != null && startsDuring($encounter)) ||
                ($encounter.stopDate == null && $encounter.startDate == startDate)
            ),
            latestClinicalActivity($c)
        )
        or $gap: ClinicalActivity() from accumulate(
            Year2026Mips134SspPositiveAdolescentScreeningExistsGroup($encounter == encounter, $c: screening),
            latestClinicalActivity($c)
        )
        or $gap: ClinicalActivity() from accumulate(
            Year2026Mips134SspPositiveAdultScreeningExistsGroup($encounter == encounter, $c: screening),
            latestClinicalActivity($c)
        )
    )
then
    insert(new Year2026Mips134SspGapG8511Group($encounter));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "G8511");
    for (String groupExternalId : $encounter.groupExternalIds) {
        controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Numerator Performance Not Met G8511", "G8511", PopulationEnum.numerator_performance_not_met, $gap, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $gap.startDate.toString());
    }
end

/**
