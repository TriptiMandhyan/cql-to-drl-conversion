/**
//this is the same for org/group/provider, the only thing that changes between each attribution is the parameter that receives the encounter
define "Adolescent Follow-Up Exists".org:
    (   "Adolescent Follow-Up Procedure" P
        with ("Latest Denominator Encounter".org) Encounter
        such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date + 2 days]  )
    union ( "Adolescent Follow-Up Medication" M
            with ("Latest Denominator Encounter".org) Encounter
            such that Interval[M.start_date, M.stop_date] overlaps Interval[Encounter.start_date, Encounter.stop_date + 2 days] )
        
define "Adolescent Follow-Up Procedure":
    ["Clinical Activity": "VSAC; FOLLOW_UP_FOR_ADOLESCENT_DEPRESSION"]
    union ["Clinical Activity": "VSAC; REFERRAL_FOR_ADOLESCENT_DEPRESSION"]

  define "Adolescent Follow-Up Medication"
    ["Medication": "VSAC; ADOLESCENT_DEPRESSION_MEDICATIONS"]
*/
query queryYear2026Mips134SspAdolescentFollowUpExists(ClinicalActivity $encounter, QdmDatatype $followUp)
    (
        $followUp:= ClinicalActivity(
            withValueSet("VsacYear2026", "FOLLOW_UP_FOR_ADOLESCENT_DEPRESSION") ||
            withValueSet("VsacYear2026", "REFERRAL_FOR_ADOLESCENT_DEPRESSION"),
            startsDuring($encounter)
        ) 
        or $followUp:= Medication(
            withValueSet("VsacYear2026", "ADOLESCENT_DEPRESSION_MEDICATIONS"),
            overlaps($encounter)
        )
    )
end

/**
//this is the same for org/group/provider, the only thing that changes between each attribution is the parameter that receives the encounter
define "Adult Follow-Up Exists".org:
    (   "Adult Follow-Up Procedure" P
        with ("Latest Denominator Encounter".org) Encounter
        such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date + 2 days]  )
    union ( "Adult Follow-Up Medication" M
            with ("Latest Denominator Encounter".org) Encounter
            such that Interval[M.start_date, M.stop_date] overlaps Interval[Encounter.start_date, Encounter.stop_date + 2 days] )
        
define "Adult Follow-Up Procedure":
    ["Clinical Activity": "VSAC; FOLLOW_UP_FOR_ADULT_DEPRESSION"]
    union ["Clinical Activity": "VSAC; REFERRAL_FOR_ADULT_DEPRESSION"]

define "Adult Follow-Up Medication"
    ["Medication": "VSAC; ADULT_DEPRESSION_MEDICATIONS"]
*/
query queryYear2026Mips134SspAdultFollowUpExists(ClinicalActivity $encounter, QdmDatatype $followUp)
    (
        $followUp:= ClinicalActivity(
            withValueSet("VsacYear2026", "FOLLOW_UP_FOR_ADULT_DEPRESSION") ||
            withValueSet("VsacYear2026", "REFERRAL_FOR_ADULT_DEPRESSION"), 
            startsDuring($encounter)
        )
        or $followUp:= Medication(
            withValueSet("VsacYear2026", "ADULT_DEPRESSION_MEDICATIONS"),
            overlaps($encounter)
        )
    )
end