    controlSet.addPatientEMR($program, $patient, $measure, "", "Most Recent Adult Screening", "G8432", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
