rule 'Year2026.Mips134Ssp.MostRecentAdultScreening.LatestEncounter.Group'
salience 75
when
    $program: Program(rules contains "measure.Mips.2026.Mips134ssp")
    $patient: Patient()
    Year2026Mips134SspGroups($groupExternalId: groupExternalId, $groupExternalId != null)
    $latestRecord: QdmResultDataType() from accumulate (
        Year2026Mips134SspMostRecentAdultScreeningCalculationGroup(
            $c: record,
            $encounter: encounter != null,
            $encounter.getGroupExternalIds() != null,
            $encounter.getGroupExternalIds().contains($groupExternalId)
        ),
        latestQdmResultDataType($c)
    )
    Year2026Mips134SspMostRecentAdultScreeningCalculationGroup(record.equals($latestRecord), $encounter: encounter)
then
    insert(new Year2026Mips134SspMostRecentAdultScreeningGroup($latestRecord, $encounter));
    for (String groupExternalId : $encounter.groupExternalIds) {
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adult Screening", "G8431", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adult Screening", "G8510", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adult Screening", "G8433", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adult Screening", "G8511", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adult Screening", "G9717", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
        controlSet.addPatientEMR($program, $patient, "Year2026.Mips134Ssp", $groupExternalId, "Most Recent Adult Screening", "G8432", PopulationEnum.denominator, $latestRecord, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $latestRecord.startDate.toString());
    }
end

