when
    Year2026Mips217Denominator($program: program, $encounter: encounter, $startDate: startDate, $stopDate: stopDate, $measure: measure == "Year2026.Mips217")
    $patient: Patient()
    $earliestG9727: ClinicalActivity() from accumulate(
        $p: ClinicalActivity(
            withValueSet("MipsYear2026", "217_PATIENT_INABILITY_G9727"),
            startsDuring($startDate, $stopDate)
        ),
        earliestClinicalActivity($p)
    )
then 
    controlSet.addEncounterMeasureStatus($program, $encounter, $measure, MeasureStatusValue.EXCLUSION, "G9727");
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips217", $encounter, "Evidence of Patient Inability G9727", "G9727", PopulationEnum.denominator_exclusion, $earliestG9727, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $earliestG9727.startDate.toString());
end

/*
define "Numerator Performance Met G8647":
  // Option ID: G8647
  (   first(  ["Clinical Activity": "MIPS; 217_PERFORMANCE_MET_G8647"] P
                with "Denominator Episode" Episode
                such that P.start_date during Interval[Episode.start_date, Episode.stop_date]
        ) PerformanceMet sort by PerformanceMet.start_date ascending 
    ) firstPerformanceMet
    ,
    if exists "Numerator Performance Met G8647" return
    ExtendedMeasureResultV2(
      firstPerformanceMet
      , 'Evidence of Performance Met G8647' as name
      , display_date = start_date
      , calculated_record = false
      , population = Numerator Performance Met
      , option_id = G8647
    )
*/
rule 'Year2026.Mips217.Success.G8647'
when
