            withValueSet("MipsYear2026", "217_PERFORMANCE_MET_G8647"),
            startsDuring($startDate, $stopDate)
        ),
        earliestClinicalActivity($r)
    )
then
    controlSet.addEncounterMeasureStatus($program, $encounter, $measure, MeasureStatusValue.SUCCESS, "G8647");
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips217", $encounter, "Evidence of Performance Met G8647", "G8647", PopulationEnum.numerator_performance_met, $earliestG8647, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $earliestG8647.startDate.toString());
end

