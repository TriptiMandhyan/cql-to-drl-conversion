/*
define "Numerator Performance Not Met G8648":
  // Option ID: G8648
    (   first(  ["Clinical Activity": "MIPS; 217_PERFORMANCE_NOT_MET_G8648"] P
                with "Denominator Episode" Episode
                such that P.start_date during Interval[Episode.start_date, Episode.stop_date]
        ) PerformanceNotMet sort by PerformanceNotMet.start_date ascending 
    ) firstPerformanceNotMet
    ,
    if exists "Numerator Performance Not Met G8648" return
    ExtendedMeasureResultV2(
      firstPerformanceNotMet
      , 'Evidence of Performance Not Met G8648' as name
      , display_date = start_date
      , calculated_record = false
      , population = Numerator Performance Not Met
      , option_id = G8648
    )
*/
rule 'Year2026.Mips217.Gap.G8648'
when
    Year2026Mips217Denominator($program: program, $encounter: encounter, $startDate: startDate, $stopDate: stopDate, $measure: measure == "Year2026.Mips217")
    $patient: Patient()
    $earliestG8648: ClinicalActivity() from accumulate(
