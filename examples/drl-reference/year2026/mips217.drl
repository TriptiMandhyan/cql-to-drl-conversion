            withValueSet("MipsYear2026", "217_PERFORMANCE_NOT_MET_G8648"),
            startsDuring($startDate, $stopDate)
        ),
        earliestClinicalActivity($r)
    )
then
    controlSet.addEncounterMeasureStatus($program, $encounter, $measure, MeasureStatusValue.GAP, "G8648");
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips217", $encounter, "Evidence of Performance Not Met G8648", "G8648", PopulationEnum.numerator_performance_not_met, $earliestG8648, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $earliestG8648.startDate.toString());
end

/*
define "Numerator Performance Not Met G8650":
  // Option ID: G8650
  not "Denominator Exclusion Patient Diagnosis of Neuro Condition M1107"
  and not "Denominator Exclusion Patient Inability G9727"
  and not "Numerator Performance Met G8647"
  and not "Denominator Exception Care Not Indicated M1108"
  and not "Denominator Exception Patient Discharged Medical Event M1109"
  and not "Denominator Exception Patient Self Discharge M1110"
  and not "Denominator Exception Patient Refused G9726"
  and not "Numerator Performance Not Met G8648"

*/
rule 'Year2026.Mips217.Gap.G8650'
when
    Year2026Mips217Denominator($program: program, $encounter: encounter, $measure: measure == "Year2026.Mips217")
then
    controlSet.addEncounterMeasureStatus($program, $encounter, $measure, MeasureStatusValue.GAP, "G8650");
end
