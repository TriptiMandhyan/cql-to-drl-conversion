package com.ablehealth.measure.mips.year2026;

import com.ablehealth.model.*
import com.ablehealth.payloads.*;
import com.ablehealth.results.*;
import com.ablehealth.enums.extendedmeaures.*;
import java.time.LocalDate;
import accumulate com.ablehealth.functions.EarliestClinicalActivityAccumulateFunction earliestClinicalActivity;
import accumulate com.ablehealth.functions.LatestClinicalActivityAccumulateFunction latestClinicalActivity;

global PatientResults controlSet;

declare Year2026Mips218Denominator
    program: Program
    encounter: ClinicalActivity
    startDate: LocalDate
    stopDate: LocalDate
    measure: String
end

/*define "Denomintor Encounter"  same as given in cql file
["Clinical Activity": "MIPS; 218_MIPS_218_ENCOUNTER"] Eval
 where Eval.start_date during "Measurement Period"
       and AgeInYearsAt(Encounter1.start_date) >= 14
    with ["Diagnosis": "MIPS; 218_HIP_IMPAIRMENT"] Hip
    such that Interval[Hip.start_date, Hip.stop_date] overlaps Interval[Eval.start_date, Eval.stop_date]*/

/*
 define "Denominator Discharge": // use provider.id/group.id on Denominator Discharge for attribution
  ["Clinical Activity": "MIPS; 218_DISCHARGE_DOCUMENTED_M1010"] Encounter2
  where   Encounter2.start_date during "Measurement Period"
      and Encounter2.provider_id.hasMeasureMembership = true
  with ["Diagnosis": "MIPS; 218_HIP_IMPAIRMENT"] Hip
  such that Interval[Hip.start_date, Hip.stop_date] overlaps Interval[Encounter2.start_date, Encounter2.stop_date]

  define "Denominator":
  "Denominator Encounter" E
  with "Denominator Discharge" D
  where   E.start_date < D.start_date
  // Ensure no other discharge exists between this encounter and discharge
      and not exists (    "Denominator Discharge" D2
                where   D2.start_date > E.start_date
                    and D2.start_date < D.start_date    )
    // Ensure no other encounter exists between this encounter and discharge
      and not exists (    "Denominator Encounter" E2
                where   E2.start_date > E.start_date
                    and E2.start_date < D.start_date    )
  return Interval[E.start_date, D.stop_date] as "Denominator Episode"
// Evaluate all Denominator Encounters
// Match each discharge with the most recent encounter that occurred before it
// Create attribution from Denominator Encounter definition. Carry forward interval to numerator definitions
*/

rule 'Year2026.Mips218.Denominator'
when
    $program: Program(rules contains "measure.Mips.2026.Mips218")
    $patient: Patient()
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "218_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 14
    )
    and exists Diagnosis(
        withValueSet("MipsYear2026", "218_HIP_IMPAIRMENT"),
        overlaps($encounter)
    )
    $discharge: ClinicalActivity() from accumulate(
        $d: ClinicalActivity(
            withValueSet("MipsYear2026", "218_DISCHARGE_DOCUMENTED_M1010"),
            startsDuring($program.measurementPeriod),
            startDate >= $encounter.startDate
        ),
        earliestClinicalActivity($d)
    )
    and exists Diagnosis(
        withValueSet("MipsYear2026", "218_HIP_IMPAIRMENT"),
        overlaps($discharge)
    )
    not (
        exists (    
            $encounter2 : ClinicalActivity(
                withValueSet("MipsYear2026", "218_ENCOUNTER"),
                startsDuring($program.measurementPeriod),
                $patient.getAgeInYearsAt(startDate) >= 14,
                startDate > $encounter.startDate,     
                startDate < $discharge.startDate
                //startsDuring($encounter.startDate, $discharge.startDate)
            ) 
            and exists Diagnosis(
                withValueSet("MipsYear2026", "218_HIP_IMPAIRMENT"),
                overlaps($encounter2)
            )
        )
    )   
then
    insert(new Year2026Mips218Denominator($program, $discharge, $encounter.startDate, $discharge.stopDate, "Year2026.Mips218"));
    
    String calculatedValue = "[" + $encounter.startDate + ", " + $discharge.stopDate + "]";
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $discharge, "Denominator Episode", "M1112", PopulationEnum.denominator, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), calculatedValue);
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $discharge, "Denominator Episode", "G9729", PopulationEnum.denominator, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), calculatedValue);
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $discharge, "Denominator Episode", "M1113", PopulationEnum.denominator, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), calculatedValue);
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $discharge, "Denominator Episode", "M1114", PopulationEnum.denominator, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), calculatedValue);
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $discharge, "Denominator Episode", "M1115", PopulationEnum.denominator, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), calculatedValue);
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $discharge, "Denominator Episode", "G9728", PopulationEnum.denominator, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), calculatedValue);
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $discharge, "Denominator Episode", "G8651", PopulationEnum.denominator, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), calculatedValue);
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $discharge, "Denominator Episode", "G8652", PopulationEnum.denominator, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), calculatedValue);
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $discharge, "Denominator Episode", "G8654", PopulationEnum.denominator, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), calculatedValue);
end

/*define "Denominator Exclusion Patient Diagnosis of Neuro Condition M1112":
// Option ID: M1112 
    (   first(  ["Clinical Activity": "MIPS; 218_NEURO_DIAGNOSIS_M1112"] P
        with "Denominator Episode" Episode
        such that P.start_date during Interval[Episode.start_date, Episode.stop_date]
        ) NeuroDiagnosis sort by NeuroDiagnosis.start_date ascending
    ) firstNeuroDiagnosis
    ,
    if exists "Denominator Exclusion Patient Diagnosis of Neuro Condition M1112" return
    ExtendedMeasureResultV2(
      firstNeuroDiagnosis
      , 'Evidence of Neuro Diagnosis M1112' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exclusion
      , option_id = M1112
    ) */

rule 'Year2026.Mips218.Denominator.Exclusion.M1112'
when
    Year2026Mips218Denominator($program: program, $encounter: encounter, $startDate: startDate, $stopDate: stopDate, $measure: measure == "Year2026.Mips218")
    $patient: Patient()
    $firstNeuroDiagnosis: ClinicalActivity() from accumulate(
        $c: ClinicalActivity(
            withValueSet("MipsYear2026", "218_NEURO_DIAGNOSIS_M1112"),
            startsDuring($startDate, $stopDate)
        ),
        earliestClinicalActivity($c)
    )
then
    controlSet.addEncounterMeasureStatus($program, $encounter, $measure, MeasureStatusValue.EXCLUSION, "M1112");
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $encounter, "Evidence of Neuro Diagnosis M1112", "M1112", PopulationEnum.denominator_exclusion, $firstNeuroDiagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $firstNeuroDiagnosis.startDate.toString());
end

