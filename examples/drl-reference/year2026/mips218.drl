/*define "Numerator Performance Not Met G8652":
// Option ID: G8652 
    (   first(  ["Clinical Activity": "MIPS; 218_PERFORMANCE_NOT_MET_G8652"] P
        with "Denominator Episode" Episode
        such that P.start_date during Interval[Episode.start_date, Episode.stop_date]
        ) PerformanceNotMet sort by PerformanceNotMet.start_date ascending
    ) firstPerformanceNotMet
    ,
    if exists "Numerator Performance Not Met G8652" return
    ExtendedMeasureResultV2(
      firstPerformanceNotMet
      , 'Evidence of Performance Not Met G8652' as name
      , display_date = start_date
      , calculated_record = false
      , population = Numerator Performance Not Met
      , option_id = G8652
    ) */

rule 'Year2026.Mips218.Gap.G8652'
when
    Year2026Mips218Denominator($program: program, $encounter: encounter, $startDate: startDate, $stopDate: stopDate, $measure: measure == "Year2026.Mips218")
    $patient: Patient()
    $firstPerformanceNotMet: ClinicalActivity() from accumulate(
