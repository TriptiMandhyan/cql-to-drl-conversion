        earliestClinicalActivity($c)
    )
then
    controlSet.addEncounterMeasureStatus($program, $encounter, $measure, MeasureStatusValue.GAP, "G8652");
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $encounter, "Evidence of Performance Not Met G8652", "G8652", PopulationEnum.numerator_performance_not_met, $firstPerformanceNotMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $firstPerformanceNotMet.startDate.toString());
end

/*define "Numerator Performance Not Met G8654":
  // Option ID: G8654
  and not "Denominator Exception Care Not Indicated M1113"
  and not "Denominator Exception Patient Discharged Medical Event M1114"
  and not "Denominator Exception Patient Self Discharge M1115"
  and not "Denominator Exception Patient Refused G9728"
  and not "Numerator Performance Not Met G8652"

*/

rule 'Year2026.Mips218.Gap.G8654'
when
    Year2026Mips218Denominator($program: program, $encounter: encounter, $startDate: startDate, $stopDate: stopDate, $measure: measure == "Year2026.Mips218")
    not (exists ClinicalActivity(withValueSet("MipsYear2026", "218_DENOMINATOR_EXCEPTION_M1113"), startsDuring($startDate, $stopDate)))
    not (exists ClinicalActivity(withValueSet("MipsYear2026", "218_DENOMINATOR_EXCEPTION_M1114"), startsDuring($startDate, $stopDate)))
    not (exists ClinicalActivity(withValueSet("MipsYear2026", "218_DENOMINATOR_EXCEPTION_M1115"), startsDuring($startDate, $stopDate)))
    not (exists ClinicalActivity(withValueSet("MipsYear2026", "218_DENOMINATOR_EXCEPTION_G9728"), startsDuring($startDate, $stopDate)))
    not (exists ClinicalActivity(withValueSet("MipsYear2026", "218_PERFORMANCE_NOT_MET_G8652"), startsDuring($startDate, $stopDate)))
then
    controlSet.addEncounterMeasureStatus($program, $encounter, $measure, MeasureStatusValue.GAP, "G8654");
end