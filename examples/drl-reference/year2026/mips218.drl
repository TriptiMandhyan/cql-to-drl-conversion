        earliestClinicalActivity($c)
    )
then
    controlSet.addEncounterMeasureStatus($program, $encounter, $measure, MeasureStatusValue.SUCCESS, "G8651");
    controlSet.addEncounterEMR($program, $patient, "Year2026.Mips218", $encounter, "Evidence of Performance Met G8651", "G8651", PopulationEnum.numerator_performance_met, $firstPerformanceMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $firstPerformanceMet.startDate.toString());
end

