/*define "Numerator Performance Met G8651":
// Option ID: G8651 
    (   first(  ["Clinical Activity": "MIPS; 218_PERFORMANCE_MET_G8651"] P
        with "Denominator Episode" Episode
        such that P.start_date during Interval[Episode.start_date, Episode.stop_date]
