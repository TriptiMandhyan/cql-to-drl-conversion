rule 'Year2026.Mips226Rate1.Denominator.Group.PreventiveEncounter'
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate1")
    $patient: Patient()
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        groupExternalIds != null
    )
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate1", EncounterDenominatorType.GROUP));
end

rule 'Year2026.Mips226Rate1.Denominator.Group.EncounterPair'
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate1")
    $patient: Patient()
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        groupExternalIds != null
    )
    $groupId: String() from $encounter.getGroupExternalIds()
    not(ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        groupExternalIds != null && groupExternalIds.contains($groupId)
    ))
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        startDate != $encounter.startDate,
        groupExternalIds != null && groupExternalIds.contains($groupId)
    )
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate1", EncounterDenominatorType.GROUP));
end

rule 'Year2026.Mips226Rate1.Denominator.EMR.Group.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips226Rate1', type == EncounterDenominatorType.GROUP)
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    $preventive: ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        groupExternalIds != null && groupExternalIds.contains($groupId)
    )
    not(exists Year2026Mips226Rate1DenominatorEMRGroup(groupId == $groupId))
then
    insert(new Year2026Mips226Rate1DenominatorEMRGroup($groupId));
    String[] optionIds = new String[]{"M1159", "G9902", "G9903", "G9905"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $preventive, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $preventive.startDate.toString());
    }
end

