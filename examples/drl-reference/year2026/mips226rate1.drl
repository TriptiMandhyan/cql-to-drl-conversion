/**
define "Numerator Performance Met-G9902".org:
  * Option ID: G9902
   (226shared."Last Screening in Measurement Year is Tobacco User".org
  and exists("Denominator".org)) UserOrg
  ,
  return
  ExtendedMeasureResultV2(
        UserOrg
        , 'Last Screening Indicates Tobacco User' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = G9902   
    )
*/
rule 'Year2026.Mips226Rate1.Success.G9902.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips226Rate1", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not(exists Year2026Mips226Rate1G9902SuccessOrg())
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod($user: user)
    and not(
        exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriod(nonUser.startsOnOrAfter($user.startDate))
    )
then
    insert(new Year2026Mips226Rate1G9902SuccessOrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "G9902");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Last Screening Indicates Tobacco User", "G9902", PopulationEnum.numerator_performance_met, $user, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $user.startDate.toString());
end

/**
define "Numerator Performance Met-G9902".group:
  
   * Option ID: G9902
   
 (226shared."Last Screening in Measurement Year is Tobacco User".group User 
  and exists("Denominator".group) Denom 
             where Denom.group_id = User.group_id) UserGroup
  ,
  return
  ExtendedMeasureResultV2(
        UserGroup 
        , 'Last Screening Indicates Tobacco User' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = G9902   
    )
*/
rule 'Year2026.Mips226Rate1.Success.G9902.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips226Rate1", type == EncounterDenominatorType.GROUP)
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    not(exists Year2026Mips226Rate1G9902SuccessGroup(groupId == $groupId))
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodGroup($user: user, groupId == $groupId)
    and not(
        exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriodGroup(groupId == $groupId, nonUser.startsOnOrAfter($user.startDate))
    )
then
    insert(new Year2026Mips226Rate1G9902SuccessGroup($groupId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.SUCCESS, "G9902");
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Last Screening Indicates Tobacco User", "G9902", PopulationEnum.numerator_performance_met, $user, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $user.startDate.toString());
end

