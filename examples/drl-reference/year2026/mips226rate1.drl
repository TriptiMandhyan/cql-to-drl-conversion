package com.ablehealth.measure.mips.year2026;

import com.ablehealth.model.*
import com.ablehealth.payloads.*;
import com.ablehealth.results.*;
import com.ablehealth.enums.extendedmeaures.*;

global PatientResults controlSet;

declare Year2026Mips226Rate1DenominatorEMROrg
end

declare Year2026Mips226Rate1DenominatorEMRGroup
    groupId: String
end

declare Year2026Mips226Rate1DenominatorEMRProvider
    providerId: String
end

declare Year2026Mips226Rate1ExclusionHospiceOrg
end

declare Year2026Mips226Rate1ExclusionHospiceGroup
    groupId: String
end

declare Year2026Mips226Rate1ExclusionHospiceProvider
    providerId: String
end

declare Year2026Mips226Rate1G9902SuccessOrg
end

declare Year2026Mips226Rate1G9902SuccessGroup
    groupId: String
end

declare Year2026Mips226Rate1G9902SuccessProvider
    providerId: String
end

declare Year2026Mips226Rate1G9903SuccessOrg
end

declare Year2026Mips226Rate1G9903SuccessGroup
    groupId: String
end

declare Year2026Mips226Rate1G9903SuccessProvider
    providerId: String
end

declare Year2026Mips226Rate1G9905GapOrg
end

declare Year2026Mips226Rate1G9905GapGroup
    groupId: String
end

declare Year2026Mips226Rate1G9905GapProvider
    providerId: String
end

/**
define "Denominator".org:
  exists(226shared."226 Encounter") First 
    and exists(226shared."226 Encounter" ) Second
      where First.start_date != Second.start_date
  or exists(226shared."226 Preventive Encounter") PrevEnc
  ,
  if exists("Denominator".org)
  and exists("Denominator Preventive Encounter") PrevEnc
  return
  ExtendedMeasureResultV2(
        PrevEnc // return 1 record for each qualifying preventive encounter, even if multiple records exist
        , 'Denominator Preventive Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  else from ( "Denominator Encounter" First
              with  "Denominator Encounter" Second 
              such that First.start_date != Second.start_date )
  return(
  ExtendedMeasureResultV2(
        First 
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        Second
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
)
*/
rule 'Year2026.Mips226Rate1.Denominator.Org.PreventiveEncounter'
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate1")
    $patient: Patient()
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12
    )
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate1", EncounterDenominatorType.ORG));
end

rule 'Year2026.Mips226Rate1.Denominator.Org.EncounterPair'
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate1")
    $patient: Patient()
    not(ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12
    ))
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12
    )
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        startDate != $encounter.startDate
    )
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate1", EncounterDenominatorType.ORG));
end

rule 'Year2026.Mips226Rate1.Denominator.EMR.Org.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips226Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $preventive: ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12
    )
    not(exists Year2026Mips226Rate1DenominatorEMROrg())
then
    insert(new Year2026Mips226Rate1DenominatorEMROrg());
    String[] optionIds = new String[]{"M1159", "G9902", "G9903", "G9905"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $preventive, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $preventive.startDate.toString());
    }
end

rule 'Year2026.Mips226Rate1.Denominator.EMR.Org.EncounterPair'
salience -25
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips226Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not(ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12
    ))
    $e1: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12
    )
    $e2: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        startDate != $e1.startDate
    )
    not(exists Year2026Mips226Rate1DenominatorEMROrg())
then
    insert(new Year2026Mips226Rate1DenominatorEMROrg());
    String[] optionIds = new String[]{"M1159", "G9902", "G9903", "G9905"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 1", optionId, PopulationEnum.denominator, $e1, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e1.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 2", optionId, PopulationEnum.denominator, $e2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e2.startDate.toString());
    }
end

/**
define "Denominator".group:
  exists(226shared."226 Encounter") FirstGroup
    and exists(226shared."226 Encounter" ) SecondGroup 
      where FirstGroup.start_date != SecondGroup.start_date
        and FirstGroup.group_id = SecondGroup.group_id
  or exists(226shared."226 Preventive Encounter") PrevEncGroup  
  ,
  if exists("Denominator".group)
  and exists("Denominator Preventive Encounter".group) PrevEncGroup
  return
  ExtendedMeasureResultV2(
        PrevEncGroup // return 1 record for each qualifying preventive encounter, even if multiple records exist
        , 'Denominator Preventive Encounter' as name
