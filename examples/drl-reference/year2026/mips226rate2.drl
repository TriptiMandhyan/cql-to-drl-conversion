    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Last Screening Indicates Tobacco User", optionId, PopulationEnum.denominator, $user, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $user.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter 1", optionId, PopulationEnum.denominator, $first, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $first.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter 2", optionId, PopulationEnum.denominator, $second, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $second.startDate.toString());
