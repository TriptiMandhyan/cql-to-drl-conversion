    )
    $second: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        startDate != $first.startDate,
        groupExternalIds != null, groupExternalIds.contains($groupId)
    )
    not(exists Year2026Mips226Rate2DenominatorEMRGroup(groupId == $groupId))
then
    insert(new Year2026Mips226Rate2DenominatorEMRGroup($groupId));
