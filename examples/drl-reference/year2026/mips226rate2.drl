/**
define "Numerator Performance Met-G9906".org:
   *
   * Option ID: G9906
   *
(exists(226shared."Tobacco Use Intervention Occurred")
    and exists("Denominator".org)) TobaccoUseIntervention
  ,
  return
  ExtendedMeasureResultV2(
        TobaccoUseIntervention // return 1 record for each qualifying user, even if multiple records exist
        , 'Tobacco Use Intervention' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = G9906   
    )

define "Tobacco Interval":
    Interval[start of "Measurement Period" - 6 months, end of "Measurement Period"]
*/
rule 'Year2026.Mips226Rate2.Success.G9906.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $enc: encounterable, $measure: measure, measure == "Year2026.Mips226Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not(exists Year2026Mips226Rate2G9906EMROrg())
    //'Last Screening in Measurement Year is Tobacco User'
    $user: Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod($userQdm: user)
    not(
        exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriod(nonUser.startsAfter($userQdm.startDate))
    )
    $intervention: QdmDatatype() from accumulate(
        Year2026Mips226SharedTobaccoUse(measure == $measure, $qdm: qdmDataType),
        latestQdmDataType($qdm)
    )
then
    insert(new Year2026Mips226Rate2G9906EMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "G9906");
    // EMR - Tobacco User and Intervention
    controlSet.addPatientEMR($program, $patient, $measure, "", "Last Screening Indicates Tobacco User", "G9906", PopulationEnum.numerator_performance_met, $userQdm, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $userQdm.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Tobacco Use Intervention", "G9906", PopulationEnum.numerator_performance_met, $intervention, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $intervention.startDate.toString());
end

