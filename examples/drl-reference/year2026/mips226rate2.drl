package com.ablehealth.measure.mips.year2026;

import com.ablehealth.model.*
import com.ablehealth.payloads.*;
import com.ablehealth.results.*;

import com.ablehealth.enums.extendedmeaures.*;
import accumulate com.ablehealth.functions.LatestClinicalActivityAccumulateFunction latestClinicalActivity;
import accumulate com.ablehealth.functions.LatestQdmDatatypeAccumulateFunction latestQdmDataType;

global PatientResults controlSet;

declare Year2026Mips226Rate2DenominatorEMROrg
end
declare Year2026Mips226Rate2DenominatorEMRGroup
    groupId: String
end
declare Year2026Mips226Rate2DenominatorEMRProvider
    providerId: String
end
declare Year2026Mips226Rate2G9906EMROrg
end
declare Year2026Mips226Rate2G9906EMRGroup
    groupId: String
end
declare Year2026Mips226Rate2G9906EMRProvider
    providerId: String
end
declare Year2026Mips226Rate2ExclusionHospiceEMROrg
end
declare Year2026Mips226Rate2ExclusionHospiceEMRGroup
    groupId: String
end
declare Year2026Mips226Rate2ExclusionHospiceEMRProvider
    providerId: String
end

/**
define "Denominator".org:
    exists (226shared."Last Screening in Measurement Year is Tobacco User".org) User
    and exists( (   226shared."226 Encounter" First
                    with 226shared."226 Encounter" Second 
                    such that First.start_date != Second.start_date )
                union 226shared."226 Preventive Encounter") PrevEnc
  ,
  if exists("Denominator".org)
  return
  ExtendedMeasureResultV2(
        User // return 1 record for each qualifying user, even if multiple records exist 
        , 'Last Screening Indicates Tobacco User' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and if exists("Denominator Preventive Encounter".org) PrevEnc
  return
  ExtendedMeasureResultV2(
        PrevEnc // return 1 record for each qualifying preventive encounter, even if multiple records exist
        , 'Denominator Preventive Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  else from ( "Denominator Encounter" First
              with  "Denominator Encounter" Second 
              such that First.start_date != Second.start_date )
  return(
  ExtendedMeasureResultV2(
        First 
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        Second
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
)

define "Last Screening in Measurement Year is Tobacco User"
    exists  "Most Recent Tobacco User Diagnosis, Screening, or Quality Code" User
            where User.start_date during "Measurement Period"
    and not exists (    "Most Recent Tobacco Non-User Diagnosis, Screening, or Quality Code" Nonuser
                        where ( Nonuser.start_date after User.start_date 
                                and Nonuser.start_date during "Measurement Period"  )

define "226 Encounter":
  ["Clinical Activity": "MIPS; 226_ENCOUNTER"] Encounter
    where Encounter.start_date during "Measurement Period"
      and AgeInYearsAt(Encounter.start_date) >= 12
      and Encounter.provider_id.hasMeasureMembership = true

define "226 Preventive Encounter":
  ["Clinical Activity": "MIPS; 226_PREVENTIVE_ENCOUNTER"] Encounter
    where Encounter.start_date during "Measurement Period"
      and AgeInYearsAt(Encounter.start_date) >= 12
      and Encounter.provider_id.hasMeasureMembership = true
*/
rule 'Year2026.Mips226Rate2.Denominator.Org'
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate2")
    $patient: Patient()
    (
        $encounter: ClinicalActivity(
            withValueSet("MipsYear2026", "226_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12
        ) and exists ClinicalActivity(
            withValueSet("MipsYear2026", "226_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12,
            startDate != $encounter.startDate
        )
    ) or (
        $encounter: ClinicalActivity(
            withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12
        )
    )
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate2", EncounterDenominatorType.ORG));
end

// EMR for Denominator Org - Last Screening Indicates Tobacco User + Preventive Encounter
rule 'Year2026.Mips226Rate2.Denominator.Org.EMR.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips226Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod($user: user)
    not(exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriod(nonUser.startsAfter($user.startDate)))
    $prevEnc: ClinicalActivity() from accumulate(
        $enc: ClinicalActivity(
            withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12
        ),
        latestClinicalActivity($enc)
    )
    not(exists Year2026Mips226Rate2DenominatorEMROrg())
then
    insert(new Year2026Mips226Rate2DenominatorEMROrg());
    String[] optionIds = new String[]{"M1159", "G9906", "G9908"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Last Screening Indicates Tobacco User", optionId, PopulationEnum.denominator, $user, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $user.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $prevEnc, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $prevEnc.startDate.toString());
    }
end

// EMR for Denominator Org - Last Screening Indicates Tobacco User + Two Encounters
rule 'Year2026.Mips226Rate2.Denominator.Org.EMR.TwoEncounters'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips226Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod($user: user)
    not(exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriod(nonUser.startsAfter($user.startDate)))
    not(exists ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"), 
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12))
    $first: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12
    )
    $second: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        startDate != $first.startDate
    )
    not(exists Year2026Mips226Rate2DenominatorEMROrg())
then
    insert(new Year2026Mips226Rate2DenominatorEMROrg());
    String[] optionIds = new String[]{"M1159", "G9906", "G9908"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Last Screening Indicates Tobacco User", optionId, PopulationEnum.denominator, $user, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $user.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 1", optionId, PopulationEnum.denominator, $first, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $first.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 2", optionId, PopulationEnum.denominator, $second, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $second.startDate.toString());
    }
end

/**
define "Denominator".group:
    exists (226shared."Last Screening in Measurement Year is Tobacco User".group UserGroup
                with 226shared."226 Encounter" FirstGroup
                      and 226shared."226 Encounter" SecondGroup 
                such that  ( FirstGroup.start_date != SecondGroup.start_date
                            and FirstGroup.group_id = SecondGroup.group_id = UserGroup.group_id )
    )
    or exists( 226shared."Last Screening in Measurement Year is Tobacco User".group UserGroup
                with 226shared."226 Preventive Encounter" PrevEncGroup 
                such that PrevEncGroup.group_id = UserGroup.group_id )  
  ,
  if exists("Denominator".group)
  return
  ExtendedMeasureResultV2(
        UserGroup // return 1 record for each qualifying user, even if multiple records exist 
        , 'Last Screening Indicates Tobacco User' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and if exists("Denominator Preventive Encounter") PrevEncGroup
  return
  ExtendedMeasureResultV2(
        PrevEncGroup // return 1 record for each qualifying preventive encounter, even if multiple records exist
        , 'Denominator Preventive Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  else from ( "Denominator Encounter" FirstGroup
              with  "Denominator Encounter" SecondGroup 
              such that FirstGroup.start_date != SecondGroup.start_date
                        and FirstGroup.group_id = SecondGroup.group_id  )
  return(
  ExtendedMeasureResultV2(
        FirstGroup 
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        SecondGroup
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
)
*/
rule 'Year2026.Mips226Rate2.Denominator.Group.PreventiveEncounter'
salience 20
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate2")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        groupExternalIds != null
    )
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 12)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate2", EncounterDenominatorType.GROUP));
end

rule 'Year2026.Mips226Rate2.Denominator.Group.TwoEncounters'
salience 20
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate2")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        groupExternalIds != null
    )
    $groupId: String() from $encounter.getGroupExternalIds()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $encounter.startDate != startDate,
        groupExternalIds != null, groupExternalIds.contains($groupId)
    )
    not(exists EncounterDenominator(clinicalActivity == $encounter, type == EncounterDenominatorType.GROUP, measure == "Year2026.Mips226Rate2"))
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 12)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate2", EncounterDenominatorType.GROUP));
end

// EMR for Denominator Group - Last Screening Indicates Tobacco User + Preventive Encounter
rule 'Year2026.Mips226Rate2.Denominator.Group.EMR.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips226Rate2", type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    exists Year2026Mips226SharedEncounterDenominatorGroup(groupId == $groupId)
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodGroup(groupId == $groupId, $user: user)
    not(exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriodGroup(groupId == $groupId, nonUser.startsAfter($user.startDate)))
    $prevEnc: ClinicalActivity() from accumulate(
        $enc: ClinicalActivity(
            withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12,
            groupExternalIds != null, groupExternalIds.contains($groupId)
        ),
        latestClinicalActivity($enc)
    )
    not(exists Year2026Mips226Rate2DenominatorEMRGroup(groupId == $groupId))
then
    insert(new Year2026Mips226Rate2DenominatorEMRGroup($groupId));
    String[] optionIds = new String[]{"M1159", "G9906", "G9908"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Last Screening Indicates Tobacco User", optionId, PopulationEnum.denominator, $user, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $user.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $prevEnc, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $prevEnc.startDate.toString());
    }
end

// EMR for Denominator Group - Last Screening Indicates Tobacco User + Two Encounters
rule 'Year2026.Mips226Rate2.Denominator.Group.EMR.TwoEncounters'
salience -25
when
