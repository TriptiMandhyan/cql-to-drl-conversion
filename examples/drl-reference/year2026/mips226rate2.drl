/**
define "Numerator Performance Not Met-G9908".org:
  *
  * Option ID: G9908
  *
  exists("Denominator".org)
   and not "Numerator Performance Met-G9906"
   and not "Denominator Exclusion-M1159 Hospice" 
*/
rule 'Year2026.Mips226Rate2.Gap.G9908.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips226Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    // "Last Screening in Measurement Year is Tobacco User"
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod($user: user)
    not(
        exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriod(nonUser.startsAfter($user.startDate))
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G9908");
end

