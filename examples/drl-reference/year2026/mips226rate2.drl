end

/**
define "Denominator".provider:
    exists (226shared."Last Screening in Measurement Year is Tobacco User".group UserProvider
                with 226shared."226 Encounter" FirstProvider
                      and 226shared."226 Encounter" SecondProvider 
                such that  ( FirstProvider.start_date != SecondProvider.start_date
                            and FirstProvider.provider_id = SecondProvider.provider_id = UserProvider.provider_id )
    )
    or exists( 226shared."Last Screening in Measurement Year is Tobacco User".group UserProvider
                with 226shared."226 Preventive Encounter" PrevEncProvider 
                such that PrevEncProvider.provider_id = UserProvider.provider_id )  
  ,
  if exists("Denominator".provider)
  return
  ExtendedMeasureResultV2(
        UserProvider // return 1 record for each qualifying user, even if multiple records exist 
        , 'Last Screening Indicates Tobacco User' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and if exists("Denominator Preventive Encounter") PrevEncProvider
  return
  ExtendedMeasureResultV2(
        PrevEncProvider // return 1 record for each qualifying preventive encounter, even if multiple records exist
        , 'Denominator Preventive Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  else from ( "Denominator Encounter" FirstProvider
              with  "Denominator Encounter" SecondProvider 
              such that FirstProvider.start_date != SecondProvider.start_date
                        and FirstProvider.provider_id = SecondProvider.provider_id  )
  return(
  ExtendedMeasureResultV2(
        FirstProvider 
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        SecondProvider
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
)
*/
rule 'Year2026.Mips226Rate2.Denominator.Provider.PreventiveEncounter'
salience 20
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate2")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        providerExternalId != null
    )
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 12)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate2", EncounterDenominatorType.PROVIDER));
end

rule 'Year2026.Mips226Rate2.Denominator.Provider.TwoEncounters'
salience 20
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate2")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        providerExternalId != null
    )
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $encounter.startDate != startDate,
        providerExternalId != null && providerExternalId.equals($encounter.providerExternalId)
    )
    not(exists EncounterDenominator(clinicalActivity == $encounter, type == EncounterDenominatorType.PROVIDER, measure == "Year2026.Mips226Rate2"))
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 12)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate2", EncounterDenominatorType.PROVIDER));
end

// EMR for Denominator Provider - Last Screening Indicates Tobacco User + Preventive Encounter
rule 'Year2026.Mips226Rate2.Denominator.Provider.EMR.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips226Rate2", type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodProvider(providerId == $encounter.providerExternalId, $user: user)
    not(exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriodProvider(providerId == $encounter.providerExternalId, nonUser.startsAfter($user.startDate)))
    $prevEnc: ClinicalActivity() from accumulate(
        $enc: ClinicalActivity(
            withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12,
            providerExternalId == $encounter.providerExternalId
        ),
        latestClinicalActivity($enc)
    )
    not(exists Year2026Mips226Rate2DenominatorEMRProvider(providerId == $encounter.providerExternalId))
then
    insert(new Year2026Mips226Rate2DenominatorEMRProvider($encounter.providerExternalId));
    String[] optionIds = new String[]{"M1159", "G9906", "G9908"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Last Screening Indicates Tobacco User", optionId, PopulationEnum.denominator, $user, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $user.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $prevEnc, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $prevEnc.startDate.toString());
    }
end

// EMR for Denominator Provider - Last Screening Indicates Tobacco User + Two Encounters
rule 'Year2026.Mips226Rate2.Denominator.Provider.EMR.TwoEncounters'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips226Rate2", type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodProvider(providerId == $encounter.providerExternalId, $user: user)
    not(exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriodProvider(providerId == $encounter.providerExternalId, nonUser.startsAfter($user.startDate)))
    not(exists ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        providerExternalId != null && providerExternalId.equals($encounter.providerExternalId)
    ))
    $first: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        providerExternalId == $encounter.providerExternalId
    )
    $second: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        startDate != $first.startDate,
        providerExternalId == $encounter.providerExternalId
    )
    not(exists Year2026Mips226Rate2DenominatorEMRProvider(providerId == $encounter.providerExternalId))
then
    insert(new Year2026Mips226Rate2DenominatorEMRProvider($encounter.providerExternalId));
    String[] optionIds = new String[]{"M1159", "G9906", "G9908"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Last Screening Indicates Tobacco User", optionId, PopulationEnum.denominator, $user, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $user.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter 1", optionId, PopulationEnum.denominator, $first, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $first.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter 2", optionId, PopulationEnum.denominator, $second, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $second.startDate.toString());
    }
end

/**
define "Denominator Exclusion-M1159 Hospice".org  
  *
  * Option ID: M1159
  *
(exists sharedHospice."Has Hospice"  
  and exists("Denominator".org)) Hospice
  ,
  return
  ExtendedMeasureResultV2(
        Hospice // return 1 record for each qualifying user, even if multiple records exist
        , 'Evidence of Hospice' as name 
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = M1159   
    ) 
*/
rule 'Year2026.Mips226Rate2.Exclusion.Hospice.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips226Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    Year2026MipsSharedHasHospice($program == program, $hospice: hospice)
    // "Last Screening in Measurement Year is Tobacco User"
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod($user: user)
    not(
        exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriod(nonUser.startsAfter($user.startDate))
    )
    not(exists Year2026Mips226Rate2ExclusionHospiceEMROrg())
then
    insert(new Year2026Mips226Rate2ExclusionHospiceEMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1159");
    // EMR - Evidence of Hospice
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Hospice", "M1159", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

/**
define "Denominator Exclusion-M1159 Hospice".group
  *
  * Option ID: M1159
  *
(exists sharedHospice."Has Hospice"  
  and exists("Denominator".group)) HospiceGroup
  ,
  return
  ExtendedMeasureResultV2(
        HospiceGroup // return 1 record for each qualifying user, even if multiple records exist
        , 'Evidence of Hospice' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = M1159   
    ) 
*/
rule 'Year2026.Mips226Rate2.Exclusion.Hospice.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips226Rate2", type == EncounterDenominatorType.GROUP)
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    Year2026MipsSharedHasHospice($program == program, $hospice: hospice)
    // "Last Screening in Measurement Year is Tobacco User".group
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodGroup(groupId == $groupId, $user: user)
    not(
        exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriodGroup(groupId == $groupId, nonUser.startsAfter($user.startDate))
    )
    not(exists Year2026Mips226Rate2ExclusionHospiceEMRGroup(groupId == $groupId))
then
    insert(new Year2026Mips226Rate2ExclusionHospiceEMRGroup($groupId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.EXCLUSION, "M1159");
    // EMR - Evidence of Hospice
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Evidence of Hospice", "M1159", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

