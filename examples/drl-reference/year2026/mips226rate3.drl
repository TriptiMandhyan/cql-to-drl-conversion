/*
define "Numerator Performance Not Met-G0029".org:
  *
  * Option ID: G0029
  *
  exists("Denominator".org)
   and not "Numerator Performance Met-G0030"
   and not "Numerator Performance Met-1036F"
   and not "Denominator Exclusion-M1159 Hospice"
*/
rule 'Year2026.Mips226Rate3.Gap.G0029.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.ORG)
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G0029");
end

