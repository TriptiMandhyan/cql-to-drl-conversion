rule 'Year2026.Mips226Rate3.Denominator.Provider'
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate3")
    $patient: Patient()
    (
        $encounter: ClinicalActivity(
            withValueSet("MipsYear2026", "226_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12
        ) and exists ClinicalActivity(
            withValueSet("MipsYear2026", "226_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12,
            startDate != $encounter.startDate,
            providerExternalId != null && providerExternalId.equals($encounter.providerExternalId)
        )
    ) or (
        $encounter: ClinicalActivity(
            withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12
        )
    )
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate3", EncounterDenominatorType.PROVIDER));
end

// EMR for Denominator Provider - Preventive Encounter
rule 'Year2026.Mips226Rate3.Denominator.Provider.EMR.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    $prevEnc: ClinicalActivity() from accumulate(
        $enc: ClinicalActivity(
            withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12,
            providerExternalId == $encounter.providerExternalId
        ),
        latestClinicalActivity($enc)
    )
    not(exists Year2026Mips226Rate3DenominatorEMRProvider(providerId == $encounter.providerExternalId))
then
    insert(new Year2026Mips226Rate3DenominatorEMRProvider($encounter.providerExternalId));
    String[] optionIds = new String[]{"M1159", "G0030", "1036F", "G0029"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $prevEnc, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $prevEnc.startDate.toString());
    }
end

