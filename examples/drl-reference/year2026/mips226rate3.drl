    ))
    $first: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        providerExternalId == $encounter.providerExternalId
    )
    $second: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        startDate != $first.startDate,
        providerExternalId == $encounter.providerExternalId
    )
    not(exists Year2026Mips226Rate3DenominatorEMRProvider(providerId == $encounter.providerExternalId))
then
    insert(new Year2026Mips226Rate3DenominatorEMRProvider($encounter.providerExternalId));
    String[] optionIds = new String[]{"M1159", "G0030", "1036F", "G0029"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter 1", optionId, PopulationEnum.denominator, $first, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $first.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter 2", optionId, PopulationEnum.denominator, $second, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $second.startDate.toString());
    }
end

/**
define "Denominator Exclusion-M1159 Hospice".org  
  *
  * Option ID: M1159
  *
(exists sharedHospice."Has Hospice"  
  and exists("Denominator".org)) Hospice
  ,
  return
  ExtendedMeasureResultV2(
        Hospice 
        , 'Evidence of Hospice' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = M1159   
   
*/
rule 'Year2026.Mips226Rate3.Exclusion.Hospice.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    Year2026MipsSharedHasHospice($program == program, $hospice: hospice)
    not(exists Year2026Mips226Rate3ExclusionHospiceEMROrg())
then
    insert(new Year2026Mips226Rate3ExclusionHospiceEMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1159");
    // EMR - Evidence of Hospice
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Hospice", "M1159", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

/**
define "Denominator Exclusion-M1159 Hospice".group
  *
  * Option ID: M1159
  *
(exists sharedHospice."Has Hospice"  
  and exists("Denominator".group)) HospiceGroup
  ,
  return
  ExtendedMeasureResultV2(
        HospiceGroup
        , 'Evidence of Hospice' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = M1159   
    ) 
*/
rule 'Year2026.Mips226Rate3.Exclusion.Hospice.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.GROUP)
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    Year2026MipsSharedHasHospice($program == program, $hospice: hospice)
    not(exists Year2026Mips226Rate3ExclusionHospiceEMRGroup(groupId == $groupId))
then
    insert(new Year2026Mips226Rate3ExclusionHospiceEMRGroup($groupId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.EXCLUSION, "M1159");
    // EMR - Evidence of Hospice
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Evidence of Hospice", "M1159", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

/**
define "Denominator Exclusion-M1159 Hospice".provider 
  *
  * Option ID: M1159
  *
(exists sharedHospice."Has Hospice"  
  and exists("Denominator".provider)) HospiceProvider
  ,
  return
  ExtendedMeasureResultV2(
        HospiceProvider
        , 'Evidence of Hospice' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = M1159   
    )  
*/
rule 'Year2026.Mips226Rate3.Exclusion.Hospice.Provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.PROVIDER)
    $patient: Patient()
    Year2026MipsSharedHasHospice($program == program, $hospice: hospice)
    not(exists Year2026Mips226Rate3ExclusionHospiceEMRProvider(providerId == $encounter.providerExternalId))
then
    insert(new Year2026Mips226Rate3ExclusionHospiceEMRProvider($encounter.providerExternalId));
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "M1159");
    // EMR - Evidence of Hospice
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Hospice", "M1159", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

/*
define "Last Denominator Encounter".group
    last(   "226 Encounter" Encounter
            union "226 Preventive Encounter" PreventiveEncounter
            where Encounter.group_id = PreventiveEncounter.group_id ) DenominatorEncounterGroup
    sort by DenominatorEncounterGroup.start_date asc

define "Last Denominator Encounter".provider
    last(   "226 Encounter" Encounter
            union "226 Preventive Encounter" PreventiveEncounter
            where Encounter.provider_id = PreventiveEncounter.provider_id ) DenominatorEncounterProvider
    sort by DenominatorEncounterProvider.start_date asc
*/
/**
define "Numerator Performance Met-G0030".org:
   *
   * Option ID: G0030
   *
exists(226shared."Last Screening in Measurement Year is Tobacco User") User
and exists(226shared."Tobacco Use Intervention Occurred") Intervention 
and exists("Denominator".org)
,
  return
  ExtendedMeasureResultV2(
        User 
        , 'Last Screening Indicates Tobacco User' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = G0030   
    )
  and return
  ExtendedMeasureResultV2(
        Intervention // return 1 record for each qualifying intervention, even if multiple records exist
        , 'Tobacco Use Intervention' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = G0030   
    )

define "Last Screening in Measurement Year is Tobacco User"
    exists  "Most Recent Tobacco User Diagnosis, Screening, or Quality Code" User
            where User.start_date during "Measurement Period"
    and not exists (    "Most Recent Tobacco Non-User Diagnosis, Screening, or Quality Code" Nonuser
                        where ( Nonuser.start_date after User.start_date 
                                and Nonuser.start_date during "Measurement Period"  )
                    )

define "Tobacco Interval":
    Interval[start of "Measurement Period" - 6 months, end of "Measurement Period"]
*/
rule 'Year2026.Mips226Rate3.Success.G0030.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $enc: encounterable, $measure: measure, measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not(exists Year2026Mips226Rate3G0030EMROrg())
    //"Last Screening in Measurement Year is Tobacco User"
    $user: Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod($userQdm: user)
    not(
        exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriod(nonUser.startsAfter($userQdm.startDate))
    )
    $intervention: QdmDatatype() from accumulate(
        Year2026Mips226SharedTobaccoUse(measure == $measure, $qdm: qdmDataType),
        latestQdmDataType($qdm)
    )
then
    insert(new Year2026Mips226Rate3G0030EMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "G0030");
    // EMR - Tobacco User and Intervention
    controlSet.addPatientEMR($program, $patient, $measure, "", "Last Screening Indicates Tobacco User", "G0030", PopulationEnum.numerator_performance_met, $userQdm, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $userQdm.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Tobacco Use Intervention", "G0030", PopulationEnum.numerator_performance_met, $intervention, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $intervention.startDate.toString());
end

/**
define "Numerator Performance Met-G0030".group:
   *
   * Option ID: G0030
   *
exists(226shared."Last Screening in Measurement Year is Tobacco User".group) UserGroup
and exists(226shared."Tobacco Use Intervention Occurred") InterventionGroup 
and exists("Denominator".group
           where "Denominator".group_id = UserGroup.group_id)
,
  return
  ExtendedMeasureResultV2(
        UserGroup 
        , 'Last Screening Indicates Tobacco User' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = G0030   
    )
  and return
  ExtendedMeasureResultV2(
        InterventionGroup // return 1 record for each qualifying intervention, even if multiple records exist
        , 'Tobacco Use Intervention' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = G0030   
    )
*/
rule 'Year2026.Mips226Rate3.Success.G0030.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $enc: encounterable, $measure: measure, measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.GROUP)
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    exists Year2026Mips226SharedEncounterDenominatorGroup(groupId == $groupId)
    not(exists Year2026Mips226Rate3G0030EMRGroup(groupId == $groupId))
    //"Last Screening in Measurement Year is Tobacco User"
    Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodGroup(groupId == $groupId, $user: user)
    not(
        exists Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriodGroup(groupId == $groupId, nonUser.startsAfter($user.startDate))
    )
    $intervention: QdmDatatype() from accumulate(
        Year2026Mips226SharedTobaccoUse(measure == $measure, $qdm: qdmDataType),
        latestQdmDataType($qdm)
    )
then
    insert(new Year2026Mips226Rate3G0030EMRGroup($groupId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.SUCCESS, "G0030");
    // EMR - Tobacco User and Intervention
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Last Screening Indicates Tobacco User", "G0030", PopulationEnum.numerator_performance_met, $user, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $user.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Tobacco Use Intervention", "G0030", PopulationEnum.numerator_performance_met, $intervention, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $intervention.startDate.toString());
end

