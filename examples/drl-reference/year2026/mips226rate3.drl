package com.ablehealth.measure.mips.year2026;

import com.ablehealth.model.*
import com.ablehealth.payloads.*;
import com.ablehealth.results.*;

import com.ablehealth.enums.extendedmeaures.*;
import accumulate com.ablehealth.functions.LatestClinicalActivityAccumulateFunction latestClinicalActivity;
import accumulate com.ablehealth.functions.LatestQdmDatatypeAccumulateFunction latestQdmDataType;

global PatientResults controlSet;

declare Year2026Mips226Rate3DenominatorEMROrg
end
declare Year2026Mips226Rate3DenominatorEMRGroup
    groupId: String
end
declare Year2026Mips226Rate3DenominatorEMRProvider
    providerId: String
end
declare Year2026Mips226Rate3G0030EMRGroup
    groupId: String
end
declare Year2026Mips226Rate31036FEMRGroup
    groupId: String
end
declare Year2026Mips226Rate3G0030EMRProvider
    providerId: String
end
declare Year2026Mips226Rate31036FEMRProvider
    providerId: String
end
declare Year2026Mips226Rate3ExclusionHospiceEMROrg
end
declare Year2026Mips226Rate3ExclusionHospiceEMRGroup
    groupId: String
end
declare Year2026Mips226Rate3ExclusionHospiceEMRProvider
    providerId: String
end
declare Year2026Mips226Rate3G0030EMROrg
end
declare Year2026Mips226Rate31036FEMROrg
end
/**
define "Denominator".org:
  exists(226shared."226 Encounter") First 
    and exists(226shared."226 Encounter" ) Second
      where First.start_date != Second.start_date
  or exists(226shared."226 Preventive Encounter") PrevEnc
  ,
  if exists("Denominator".org)
  and exists("Denominator Preventive Encounter") PrevEnc
  return
  ExtendedMeasureResultV2(
        PrevEnc // return 1 record for each qualifying preventive encounter, even if multiple records exist
        , 'Denominator Preventive Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  else from ( "Denominator Encounter" First
              with  "Denominator Encounter" Second 
              such that First.start_date != Second.start_date )
  return(
  ExtendedMeasureResultV2(
        First 
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        Second
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
)

define "226 Encounter":
  ["Clinical Activity": "MIPS; 226_ENCOUNTER"] Encounter
    where Encounter.start_date during "Measurement Period"
      and AgeInYearsAt(Encounter.start_date) >= 12
      and Encounter.provider_id.hasMeasureMembership = true

define "226 Preventive Encounter":
  ["Clinical Activity": "MIPS; 226_PREVENTIVE_ENCOUNTER"] Encounter
    where Encounter.start_date during "Measurement Period"
      and AgeInYearsAt(Encounter.start_date) >= 12
      and Encounter.provider_id.hasMeasureMembership = true
*/
rule 'Year2026.Mips226Rate3.Denominator.Org'
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate3")
    $patient: Patient()
    (
        $encounter: ClinicalActivity(
            withValueSet("MipsYear2026", "226_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12
        ) and exists ClinicalActivity(
            withValueSet("MipsYear2026", "226_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12,
            startDate != $encounter.startDate
        )
    ) or  (
        $encounter: ClinicalActivity(
            withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12
        )
    )
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate3", EncounterDenominatorType.ORG));
end

// EMR for Denominator Org - Preventive Encounter
rule 'Year2026.Mips226Rate3.Denominator.Org.EMR.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $prevEnc: ClinicalActivity() from accumulate(
        $enc: ClinicalActivity(
            withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12
        ),
        latestClinicalActivity($enc)
    )
    not(exists Year2026Mips226Rate3DenominatorEMROrg())
then
    insert(new Year2026Mips226Rate3DenominatorEMROrg());
    String[] optionIds = new String[]{"M1159", "G0030", "1036F", "G0029"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $prevEnc, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $prevEnc.startDate.toString());
    }
end

// EMR for Denominator Org - Two Encounters
rule 'Year2026.Mips226Rate3.Denominator.Org.EMR.TwoEncounters'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not(exists ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"), 
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12))
    $first: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12
    )
    $second: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 12,
        startDate != $first.startDate
    )
    not(exists Year2026Mips226Rate3DenominatorEMROrg())
then
    insert(new Year2026Mips226Rate3DenominatorEMROrg());
    String[] optionIds = new String[]{"M1159", "G0030", "1036F", "G0029"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 1", optionId, PopulationEnum.denominator, $first, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $first.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 2", optionId, PopulationEnum.denominator, $second, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $second.startDate.toString());
    }
end

/**
define "Denominator".group:
  exists((226shared."226 Encounter") FirstGroup
    and exists(226shared."226 Encounter" ) SecondGroup 
      where FirstGroup.start_date != SecondGroup.start_date
        and FirstGroup.group_id = SecondGroup.group_id)
  or exists(226shared."226 Preventive Encounter") PrevEncGroup  
  ,
  if exists("Denominator".group)
  and exists("Denominator Preventive Encounter") PrevEncGroup
  return
  ExtendedMeasureResultV2(
        PrevEncGroup // return 1 record for each qualifying preventive encounter, even if multiple records exist
        , 'Denominator Preventive Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  else from ( "Denominator Encounter" FirstGroup
              with  "Denominator Encounter" SecondGroup 
              such that FirstGroup.start_date != SecondGroup.start_date
                        and FirstGroup.group_id = SecondGroup.group_id  )
  return(
  ExtendedMeasureResultV2(
        FirstGroup 
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        SecondGroup
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
)
*/
rule 'Year2026.Mips226Rate3.Denominator.Group.PreventiveEncounter'
salience 20
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate3")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        groupExternalIds != null
    )
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 12)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate3", EncounterDenominatorType.GROUP));
end

rule 'Year2026.Mips226Rate3.Denominator.Group.TwoEncounters'
salience 20
when
    $program: Program(rules contains "measure.Mips.2026.Mips226Rate3")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        groupExternalIds != null
    )
    $groupId: String() from $encounter.getGroupExternalIds()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $encounter.startDate != startDate,
        groupExternalIds != null, groupExternalIds.contains($groupId)
    )
    not(exists EncounterDenominator(clinicalActivity == $encounter, type == EncounterDenominatorType.GROUP, measure == "Year2026.Mips226Rate3"))
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 12)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips226Rate3", EncounterDenominatorType.GROUP));
end

// EMR for Denominator Group - Preventive Encounter
rule 'Year2026.Mips226Rate3.Denominator.Group.EMR.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    exists Year2026Mips226SharedEncounterDenominatorGroup(groupId == $groupId)
    $prevEnc: ClinicalActivity() from accumulate(
        $enc: ClinicalActivity(
            withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 12,
            groupExternalIds != null, groupExternalIds.contains($groupId)
        ),
        latestClinicalActivity($enc)
    )
    not(exists Year2026Mips226Rate3DenominatorEMRGroup(groupId == $groupId))
then
    insert(new Year2026Mips226Rate3DenominatorEMRGroup($groupId));
    String[] optionIds = new String[]{"M1159", "G0030", "1036F", "G0029"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $prevEnc, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $prevEnc.startDate.toString());
    }
end

