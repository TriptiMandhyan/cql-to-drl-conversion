/**
define "Numerator Performance Met-1036F".org:
   *
   * Option ID: 1036F
   *
exists(226shared."Last Screening in Measurement Year is Tobacco Non-User") NonUser    
and exists("Denominator".org)
,
  return
  ExtendedMeasureResultV2(
        NonUser 
        , 'Last Screening Indicates Tobacco Non-User' as name
        , display_date = start_date
        , calculated_record = false
        , population = performance_met
        , option_id = 1036F   
    )

define "Last Screening in Measurement Year is Tobacco Non-User"
    exists  "Most Recent Tobacco Non-User Diagnosis, Screening, or Quality Code" Nonuser
            where Nonuser.start_date during "Measurement Period"
    and not exists (    "Most Recent Tobacco User Diagnosis, Screening, or Quality Code" User
                        where ( User.start_date after Nonuser.start_date 
                                and User.start_date during "Measurement Period" )
                    )
*/
rule 'Year2026.Mips226Rate3.Success.1036F.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $enc: encounterable, $measure: measure, measure == "Year2026.Mips226Rate3", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not(exists Year2026Mips226Rate31036FEMROrg())
    //Last Screening in Measurement Year is Tobacco Non-User
    $nonUser: Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriod($nonUserQdm: nonUser)
    not(
        exists Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod(user.startsAfter($nonUserQdm.startDate))
    )
then
    insert(new Year2026Mips226Rate31036FEMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "1036F");
    // EMR - Tobacco Non-User
    controlSet.addPatientEMR($program, $patient, $measure, "", "Last Screening Indicates Tobacco Non-User", "1036F", PopulationEnum.numerator_performance_met, $nonUserQdm, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $nonUserQdm.startDate.toString());
end

