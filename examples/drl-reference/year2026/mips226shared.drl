        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $qdmDatatype: ClinicalActivity(
        withValueSet("VsacYear2026", "TOBACCO_USE_SCREENING"),
        withValueSetInResultCodeValue("VsacYear2026", "TOBACCO_NON_USER")
    )
then
    insert(new Year2026Mips226SharedMostRecentTobaccoUseScreening($qdmDatatype));
    insert(new Year2026Mips226SharedTobaccoNonUser($qdmDatatype));
