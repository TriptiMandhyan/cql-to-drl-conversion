/*
For Extended Measure Results reporting only (e.g., "Last Tobacco Screening Date", "Last Tobacco Screening Code Value")
Finds the last screening result (user or non-user) during the period
(Note: Numerator logic for "Last Screening in Measurement Year is Tobacco User/Non-User" is implemented in rate files)
*/
rule 'Year2026.Mips226Shared.LastTobaccoScreen'
when
    Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $lastScreenResult: QdmDatatype() from accumulate (
        Year2026Mips226SharedMostRecentTobaccoScreenStartsDuringPeriod($qdmDataType: qdmDataType),
        latestQdmDataType($qdmDataType)
    )
then
    insert(new Year2026Mips226SharedLastTobaccoScreenStartsDuringPeriod($lastScreenResult));
end

/*
For Extended Measure Results reporting only (e.g., "Last Tobacco Screen Result")
Finds the last screening result code from tobacco use screening activities during measurement period
(Note: Numerator logic for "Last Screening in Measurement Year is Tobacco User/Non-User" is implemented in rate files)
*/
rule 'Year2026.Mips226Shared.LastScreenResult'
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $lastScreenResult: QdmResultDataType() from accumulate (
        Year2026Mips226SharedMostRecentTobaccoUseScreening(
            $qdmResultDataType: qdmResultDataType,
            qdmResultDataType.startsDuring($program.measurementPeriod)),
        latestQdmResultDataType($qdmResultDataType)
    )
then
    insert(new Year2026Mips226SharedLastScreenResultStartsDuringPeriod($lastScreenResult));
end

/*
Part of "Tobacco Use Intervention Occurred"
(["Clinical Activity": "MIPS; 226_RATE2_PERFORMANCE_MET_G9906"] 
 union ["Clinical Activity": "MIPS; 226_RATE3_PERFORMANCE_MET_G0030"]
 union ["Clinical Activity": "MIPS; 497RATE6B_PERFORMANCE_MET_M1301"]
 union ["Clinical Activity": "MIPS; 497RATE6C_PERFORMANCE_MET_M1310"])P
    where P.start_date during "Measurement Period"
*/
rule 'Year2026.Mips226Shared.TobaccoUse.QualityCodes'
salience 40
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $tobaccoUse: ClinicalActivity (
        withValueSet("MipsYear2026", "226_RATE2_PERFORMANCE_MET_G9906") ||
        withValueSet("MipsYear2026", "226_RATE3_PERFORMANCE_MET_G0030") ||
        withValueSet("MipsYear2026", "497RATE6B_PERFORMANCE_MET_M1301") ||
        withValueSet("MipsYear2026", "497RATE6C_PERFORMANCE_MET_M1310"),
        startsDuring($program.measurementPeriod)
    )
then
    if (($tobaccoUse.withValueSet("MipsYear2026", "226_RATE2_PERFORMANCE_MET_G9906") ||
         $tobaccoUse.withValueSet("MipsYear2026", "497RATE6B_PERFORMANCE_MET_M1301") ||
         $tobaccoUse.withValueSet("MipsYear2026", "497RATE6C_PERFORMANCE_MET_M1310")) && $program.rules.contains("measure.Mips.2026.Mips226Rate2")){
        insert(new Year2026Mips226SharedTobaccoUse($tobaccoUse, "Year2026.Mips226Rate2"));
    }
    if (($tobaccoUse.withValueSet("MipsYear2026", "226_RATE3_PERFORMANCE_MET_G0030") ||
         $tobaccoUse.withValueSet("MipsYear2026", "497RATE6B_PERFORMANCE_MET_M1301") ||
         $tobaccoUse.withValueSet("MipsYear2026", "497RATE6C_PERFORMANCE_MET_M1310")) && $program.rules.contains("measure.Mips.2026.Mips226Rate3")){
        insert(new Year2026Mips226SharedTobaccoUse($tobaccoUse, "Year2026.Mips226Rate3"));
    }
end

/*
Part of "Tobacco Use Intervention Occurred"
["Clinical Activity": "VSAC; TOBACCO_USE_CESSATION_COUNSELING"] I
    where I.start_date during "Tobacco Counseling Interval"

define "Tobacco Counseling Interval":
    Interval[start of "Measurement Period" - 6 months, end of "Measurement Period"]
*/
rule 'Year2026.Mips226Shared.TobaccoUse.TOBACCO_USE_CESSATION_COUNSELING'
salience 40
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $tobaccoUse: ClinicalActivity (
        withValueSet("VsacYear2026", "TOBACCO_USE_CESSATION_COUNSELING"),
        startsDuring($program.measurementPeriod.start.minusMonths(6), $program.measurementPeriod.end)
    )
then
    if ($program.rules.contains("measure.Mips.2026.Mips226Rate2")){
        insert(new Year2026Mips226SharedTobaccoUse($tobaccoUse, "Year2026.Mips226Rate2"));
    }
    if ($program.rules.contains("measure.Mips.2026.Mips226Rate3")){
        insert(new Year2026Mips226SharedTobaccoUse($tobaccoUse, "Year2026.Mips226Rate3"));
    }
end

/*
Part of "Tobacco Use Intervention Occurred"
["Diagnosis": "Able; TOBACCO_USE_CESSATION_INTERVENTION_DIAGNOSES"] D
    where D.start_date during "Tobacco Counseling Interval"
*/
rule 'Year2026.Mips226Shared.TobaccoUse.TOBACCO_USE_CESSATION_INTERVENTION_DIAGNOSES'
salience 40
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $tobaccoUse: Diagnosis(
        withValueSet("AbleYear2026", "TOBACCO_USE_CESSATION_INTERVENTION_DIAGNOSES"),
        startsDuring($program.measurementPeriod.start.minusMonths(6), $program.measurementPeriod.end)
    )
then
    if ($program.rules.contains("measure.Mips.2026.Mips226Rate2")){
        insert(new Year2026Mips226SharedTobaccoUse($tobaccoUse, "Year2026.Mips226Rate2"));
    }
    if ($program.rules.contains("measure.Mips.2026.Mips226Rate3")){
        insert(new Year2026Mips226SharedTobaccoUse($tobaccoUse, "Year2026.Mips226Rate3"));
    }
end

/*
Part of "Tobacco Use Intervention Occurred"
["Medication": "Able; TOBACCO_USE_CESSATION_PHARMACOTHERAPY_WITH_NDC"] M
    where Interval[M.start_date, M.stop_date] overlaps "Tobacco Counseling Interval"
*/
rule 'Year2026.Mips226Shared.TobaccoUse.TOBACCO_USE_CESSATION_PHARMACOTHERAPY_WITH_NDC'
salience 40
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $tobaccoUse: Medication(
        withValueSet("AbleYear2026", "TOBACCO_USE_CESSATION_PHARMACOTHERAPY_WITH_NDC"),
        overlaps($program.measurementPeriod.start.minusMonths(6), $program.measurementPeriod.end)
    )
then
    if ($program.rules.contains("measure.Mips.2026.Mips226Rate2")){
        insert(new Year2026Mips226SharedTobaccoUse($tobaccoUse, "Year2026.Mips226Rate2"));
    }
    if ($program.rules.contains("measure.Mips.2026.Mips226Rate3")){
        insert(new Year2026Mips226SharedTobaccoUse($tobaccoUse, "Year2026.Mips226Rate3"));
    }
end