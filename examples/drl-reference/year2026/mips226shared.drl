package com.ablehealth.measure.mips.year2026;

import com.ablehealth.model.*
import com.ablehealth.payloads.*;
import com.ablehealth.results.*;

import accumulate com.ablehealth.functions.LatestClinicalActivityAccumulateFunction latestClinicalActivity;
import accumulate com.ablehealth.functions.LatestQdmDatatypeAccumulateFunction latestQdmDataType;
import accumulate com.ablehealth.functions.LatestQdmResultDatatypeAccumulateFunction latestQdmResultDataType;
import com.ablehealth.enums.extendedmeaures.*;

global PatientResults controlSet;

declare Year2026Mips226SharedEncounterDenominatorGroup
    groupId: String
end

declare Year2026Mips226SharedMostRecentDenominatorEncounterOrg
    record: ClinicalActivity
end

declare Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod
    user: QdmDatatype
end

declare Year2026Mips226SharedTobaccoUser
    qdmDataType: QdmDatatype
end

declare Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriod
    nonUser: QdmDatatype
end

declare Year2026Mips226SharedTobaccoNonUser
    qdmDataType: QdmDatatype
end

declare Year2026Mips226SharedMostRecentTobaccoScreenStartsDuringPeriod
    qdmDataType: QdmDatatype
end

declare Year2026Mips226SharedMostRecentTobaccoUseScreening
    qdmResultDataType: QdmResultDataType
end

declare Year2026Mips226SharedLastScreenResultStartsDuringPeriod
    qdmResultDataType: QdmResultDataType
end

declare Year2026Mips226SharedLastTobaccoScreenStartsDuringPeriod
    qdmDataType: QdmDatatype
end

declare Year2026Mips226SharedTobaccoUse
    qdmDataType: QdmDatatype
    measure: String
end

declare Year2026Mips226SharedMostRecentDenominatorEncounterGroup
    record: ClinicalActivity
    groupId: String
end

declare Year2026Mips226SharedMostRecentDenominatorEncounterProvider
    record: ClinicalActivity
    providerId: String
end

declare Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodGroup
    user: QdmDatatype
    groupId: String
end

declare Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriodGroup
    nonUser: QdmDatatype
    groupId: String
end

declare Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodProvider
    user: QdmDatatype
    providerId: String
end

declare Year2026Mips226SharedMostRecentTobaccoNonUserStartsDuringPeriodProvider
    nonUser: QdmDatatype
    providerId: String
end

/*
define "Last Denominator Encounter".group
    last(   "226 Encounter" Encounter
            union "226 Preventive Encounter" PreventiveEncounter
            where Encounter.group_id = PreventiveEncounter.group_id ) DenominatorEncounterGroup
    sort by DenominatorEncounterGroup.start_date asc
*/
rule 'Year2026.Mips226Shared.Denominator.Group.PreventiveEncounter.Marker'
salience 19
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        groupExternalIds != null
    )
    $groupId: String() from $encounter.getGroupExternalIds()
    not(exists Year2026Mips226SharedEncounterDenominatorGroup(groupId == $groupId))
then
    insert(new Year2026Mips226SharedEncounterDenominatorGroup($groupId));
end

rule 'Year2026.Mips226Shared.Denominator.Group.TwoEncounters.Marker'
salience 19
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        groupExternalIds != null
    )
    $groupId: String() from $encounter.getGroupExternalIds()
    not(exists Year2026Mips226SharedEncounterDenominatorGroup(groupId == $groupId))
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "226_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $encounter.startDate != startDate,
        groupExternalIds != null, groupExternalIds.contains($groupId)
    )
then
    insert(new Year2026Mips226SharedEncounterDenominatorGroup($groupId));
end

/*
define "Last Denominator Encounter".org
    last(   "226 Encounter"
            union "226 Preventive Encounter" ) DenominatorEncounter
    sort by DenominatorEncounter.start_date asc

define "Tobacco Screening Interval".org
    Interval[start of "Measurement Period", LastDenominatorEncounter.org.start_date]
*/
rule 'Year2026.Mips226Shared.MostRecentDenominatorEncounterOrg'
salience 18
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    // CQL: last( "226 Encounter" union "226 Preventive Encounter" ) — uses ALL encounters, not just the qualifying one
    exists EncounterDenominator(
        (measure == "Year2026.Mips226Rate1" || measure == "Year2026.Mips226Rate2" || measure == "Year2026.Mips226Rate3"),
        type == EncounterDenominatorType.ORG
    )
    $mostRecentEncounter: ClinicalActivity() from accumulate (
        $enc: ClinicalActivity(
            withValueSet("MipsYear2026", "226_ENCOUNTER") || withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod)
        ),
        latestClinicalActivity($enc)
    )
    not Year2026Mips226SharedMostRecentDenominatorEncounterOrg()
then
    insert(new Year2026Mips226SharedMostRecentDenominatorEncounterOrg($mostRecentEncounter));
end

/*
define "Last Denominator Encounter".group
    last(   "226 Encounter" Encounter
            union "226 Preventive Encounter" PreventiveEncounter
            where Encounter.group_id = PreventiveEncounter.group_id ) DenominatorEncounterGroup
    sort by DenominatorEncounterGroup.start_date asc

define "Tobacco Screening Interval".group
    Interval[start of "Measurement Period", LastDenominatorEncounter.group.start_date]
*/
rule 'Year2026.Mips226Shared.MostRecentDenominatorEncounterGroup'
salience 15
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    EncounterDenominator($encounter: clinicalActivity,
        (measure == "Year2026.Mips226Rate1" || measure == "Year2026.Mips226Rate2" || measure == "Year2026.Mips226Rate3"),
        type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $groupId: String() from $encounter.getGroupExternalIds()
    exists Year2026Mips226SharedEncounterDenominatorGroup(groupId == $groupId)
    // CQL: last( "226 Encounter" union "226 Preventive Encounter" where group_id matches ) — all encounters in the group
    $mostRecentEncounter: ClinicalActivity() from accumulate (
        $enc: ClinicalActivity(
            withValueSet("MipsYear2026", "226_ENCOUNTER") || withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            groupExternalIds != null, groupExternalIds.contains($groupId)
        ),
        latestClinicalActivity($enc)
    )
    not Year2026Mips226SharedMostRecentDenominatorEncounterGroup(groupId == $groupId)
then
    insert(new Year2026Mips226SharedMostRecentDenominatorEncounterGroup($mostRecentEncounter, $groupId));
end

/*
define "Last Denominator Encounter".provider
    last(   "226 Encounter" Encounter
            union "226 Preventive Encounter" PreventiveEncounter
            where Encounter.provider_id = PreventiveEncounter.provider_id ) DenominatorEncounterProvider
    sort by DenominatorEncounterProvider.start_date asc

define "Tobacco Screening Interval".provider
    Interval[start of "Measurement Period", LastDenominatorEncounter.provider.start_date]
*/
rule 'Year2026.Mips226Shared.MostRecentDenominatorEncounterProvider'
salience 15
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    EncounterDenominator($providerId: clinicalActivity.providerExternalId,
        (measure == "Year2026.Mips226Rate1" || measure == "Year2026.Mips226Rate2" || measure == "Year2026.Mips226Rate3"),
        type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    // CQL: last( "226 Encounter" union "226 Preventive Encounter" where provider_id matches ) — all encounters for this provider
    $mostRecentEncounter: ClinicalActivity() from accumulate (
        $enc: ClinicalActivity(
            withValueSet("MipsYear2026", "226_ENCOUNTER") || withValueSet("MipsYear2026", "226_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            providerExternalId == $providerId
        ),
        latestClinicalActivity($enc)
    )
    not Year2026Mips226SharedMostRecentDenominatorEncounterProvider(providerId == $providerId)
then
    insert(new Year2026Mips226SharedMostRecentDenominatorEncounterProvider($mostRecentEncounter, $providerId));
end

/*
Part of "Most Recent Tobacco User Diagnosis, Screening, or Quality Code"
Implements: ["Diagnosis": "VSAC; TOBACCO_USER"]
*/
rule 'Year2026.Mips226Shared.TobaccoUser.Diagnosis'
salience 30
when
    Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $qdmDatatype: Diagnosis(
        withValueSet("VsacYear2026", "TOBACCO_USER")
    )
then
    insert(new Year2026Mips226SharedTobaccoUser($qdmDatatype));
end

/*
Part of "Most Recent Tobacco User Diagnosis, Screening, or Quality Code"
Implements: ["Clinical Activity": "VSAC; TOBACCO_USER"]

define "Quality Codes Indicating Tobacco User"
    ["Clinical Activity": "MIPS; 226_RATE1_PERFORMANCE_MET_G9902"]
    union ["Clinical Activity": "MIPS; 226_RATE2_PERFORMANCE_MET_G9906"]
    union ["Clinical Activity": "MIPS; 226_RATE3_PERFORMANCE_MET_G0030"]
    union ["Clinical Activity": "MIPS; 497RATE6A_PERFORMANCE_MET_M1283"]
    union ["Clinical Activity": "MIPS; 497RATE6B_PERFORMANCE_MET_M1301"]
    union ["Clinical Activity": "MIPS; 497RATE6C_PERFORMANCE_MET_M1310"]
*/
rule 'Year2026.Mips226Shared.TobaccoUser.ClinicalActivities'
salience 30
when
    Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $qdmDatatype: ClinicalActivity(
        withValueSet("VsacYear2026", "TOBACCO_USER") ||
        withValueSet("MipsYear2026", "226_RATE1_PERFORMANCE_MET_G9902") ||
        withValueSet("MipsYear2026", "226_RATE2_PERFORMANCE_MET_G9906") ||
        withValueSet("MipsYear2026", "226_RATE3_PERFORMANCE_MET_G0030") ||
        withValueSet("MipsYear2026", "497RATE6A_PERFORMANCE_MET_M1283") ||
        withValueSet("MipsYear2026", "497RATE6B_PERFORMANCE_MET_M1301") ||
        withValueSet("MipsYear2026", "497RATE6C_PERFORMANCE_MET_M1310")
    )
then
    insert(new Year2026Mips226SharedTobaccoUser($qdmDatatype));
end

/*
define "Tobacco Use Screening Indicates Tobacco User":
    ["Clinical Activity": "VSAC; TOBACCO_USE_SCREENING"] TobaccoUseScreening
    where   ( TobaccoUseScreening.result_code_type, TobaccoUseScreening.result_code_value in ["Diagnosis": "VSAC; TOBACCO_USER"]  )
*/
rule 'Year2026.Mips226Shared.TobaccoUser.TobaccoScreening'
salience 30
when
    Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    $qdmDatatype: ClinicalActivity(
        withValueSet("VsacYear2026", "TOBACCO_USE_SCREENING"),
        withValueSetInResultCodeValue("VsacYear2026", "TOBACCO_USER")
    )
then
    insert(new Year2026Mips226SharedTobaccoUser($qdmDatatype));
    insert(new Year2026Mips226SharedMostRecentTobaccoUseScreening($qdmDatatype));
end

