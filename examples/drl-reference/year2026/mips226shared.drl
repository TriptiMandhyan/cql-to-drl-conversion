/*
define "Most Recent Tobacco User Diagnosis, Screening, or Quality Code".org:
    Last (   ["Diagnosis": "VSAC; TOBACCO_USER"]
            union ["Clinical Activity": "VSAC; TOBACCO_USER"]
            union "Tobacco Use Screening Indicates Tobacco User"
            union "Quality Codes Indicating Tobacco User"   ) Screen 
    sort by Screen.start_datetime asc
    where Screen.start_datetime during "Tobacco Screening Interval".org
*/
rule 'Year2026.Mips226Shared.MostRecentTobaccoUser.Org'
salience 16
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    Year2026Mips226SharedMostRecentDenominatorEncounterOrg($lastEncounter: record)
    not Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod()
    $latestTobaccoUser: QdmDatatype() from accumulate (
        Year2026Mips226SharedTobaccoUser(
            $qdmDataType: qdmDataType,
            qdmDataType.startsDuring($program.measurementPeriod),
            qdmDataType.startsOnOrBefore($lastEncounter.startDate)),
        latestQdmDataType($qdmDataType)
    )
then
    insert(new Year2026Mips226SharedMostRecentTobaccoScreenStartsDuringPeriod($latestTobaccoUser));
    insert(new Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriod($latestTobaccoUser));
end

/*
define "Most Recent Tobacco User Diagnosis, Screening, or Quality Code".group:
    (Last (   ["Diagnosis": "VSAC; TOBACCO_USER"]
            union ["Clinical Activity": "VSAC; TOBACCO_USER"]
            union "Tobacco Use Screening Indicates Tobacco User"
            union "Quality Codes Indicating Tobacco User"   ) Screen 
    sort by Screen.start_datetime asc
    where Screen.start_datetime during "Tobacco Screening Interval".group) LastScreenGroup
        return "Tobacco Screening Interval".group_id as LastScreenGroup.group_id
*/
rule 'Year2026.Mips226Shared.MostRecentTobaccoUser.Group'
salience 14
when
    $program: Program(
        rules contains "measure.Mips.2026.Mips226Rate1" ||
        rules contains "measure.Mips.2026.Mips226Rate2" ||
        rules contains "measure.Mips.2026.Mips226Rate3"
    )
    Year2026Mips226SharedMostRecentDenominatorEncounterGroup($groupId: groupId, $lastEncounter: record)
    not Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodGroup(groupId == $groupId)
    $latestTobaccoUser: QdmDatatype() from accumulate (
        Year2026Mips226SharedTobaccoUser(
            $qdmDataType: qdmDataType,
            qdmDataType.startsDuring($program.measurementPeriod),
            qdmDataType.startsOnOrBefore($lastEncounter.startDate)),
        latestQdmDataType($qdmDataType)
    )
then
    insert(new Year2026Mips226SharedMostRecentTobaccoUserStartsDuringPeriodGroup($latestTobaccoUser, $groupId));
end

/*
define "Most Recent Tobacco User Diagnosis, Screening, or Quality Code".provider:
    (Last (   ["Diagnosis": "VSAC; TOBACCO_USER"]
            union ["Clinical Activity": "VSAC; TOBACCO_USER"]
            union "Tobacco Use Screening Indicates Tobacco User"
            union "Quality Codes Indicating Tobacco User"   ) Screen 
    sort by Screen.start_datetime asc
    where Screen.start_datetime during "Tobacco Screening Interval".provider) LastScreenProvider
        return "Tobacco Screening Interval".provider_id as LastScreenProvider.provider_id
*/
rule 'Year2026.Mips226Shared.MostRecentTobaccoUser.Provider'
