/*
define "Denominator Exclusion G9910 Over 66 + Long Term Care":
   *
   * Option ID: G9910
   *
    exists(FrailtyLTI."Has Long Term Care with Age Anchor"(start of "Denominator Encounter")) LongTermCareEvidence
    ,
    if exists ( ["Clinical Activity": "MIPS; MIPS_LTI_QUALITY_CODES"] LTI
            where LTI.start_date during "MeasurementPeriod" ) LTIPeriod
    then
    return
    ExtendedMeasureResultV2(
        LTIPeriod//return 1 record even if multiple exist
        , 'Long Term Care Quality Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Exclusion
        , option_id = 'G9910'
    )
    else 
    if exists FrailtyLTI."Has Long Term Care Periods Longer Than 90 Consecutive Days"
    from FrailtyLTI."Max Long Term Care Period Length" LTCDuration
    return
    ExtendedMeasureResultV2(
        LTCDuration
        , 'Long Term Care Period Duration' as name
        , display_date = start_date
        , calculated_record = true
        , population = Exclusion
        , option_id = 'G9910'
    )
*/
rule 'Year2026.Mips236ssp.Exclusion.G9910_Over66LongTermCare'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    exists queryYear2026MipsSharedHasLongTermCareWithAgeAnchor($program, $encounter.startDate;)
then
    insert (new Year2026Mips236sspExclusionLTI());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, 'G9910');
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, 'G9910');
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9910");
end

rule 'Year2026.Mips236ssp.Exclusion.G9910.LongTermCarePeriodDuration.Org.EMR'
when
    EncounterDenominator($measure: measure, measure == "Year2026.Mips236ssp", $program: program, $encounter: clinicalActivity)
    $patient: Patient()
    queryYear2026MipsSharedHasLongTermCarePeriodsLongerThan90ConsecutiveDays($program, $encounter.startDate, $consecutiveDays;)
    exists Year2026Mips236sspExclusionLTI()
    and not(
        exists Year2026Mips236sspG9910P1ExclusionOrgEMR()
