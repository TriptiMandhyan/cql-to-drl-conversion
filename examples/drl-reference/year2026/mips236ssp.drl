    $patient: Patient()
    exists Year2026Mips236sspExclusionFrailtyAndAdvancedIllness()
    $result: QdmDatatype() from accumulate(
        queryYear2026MipsSharedFrailtyAge66To80WithAgeAnchorAdvancedIllness($program, $encounter.startDate, $qdm;),
        latestQdmDatatype($qdm)
    )
    and not (
        exists Year2026Mips236sspExclusionG2116AdvancedIllnessDiagnosisProviderEMR()
    )
then
    insert(new Year2026Mips236sspExclusionG2116AdvancedIllnessDiagnosisProviderEMR());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Advanced Illness Diagnosis", "G2116", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

/*
define "Denominator Exclusion G2118 81 and Older + Frailty"
  *
  * Option ID: G2118
  *
   exists( FrailtyLTI."Is 81 and Older with Frailty with Age Anchor"(start of "Denominator Encounter")) // the start of the denominator encounter is AgeInYearsAt anchor
*/
rule 'Year2026.Mips236ssp.Exclusion.G2118_Over_80_Frailty'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    exists queryYear2026MipsSharedIs81AndOlderWithFrailtyWithAgeAnchor($program, $encounter.startDate, $result;)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, 'G2118');
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, 'G2118');
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G2118");
end

rule 'Year2026.Mips236ssp.Exclusion.G2118_Over_80_Frailty.Org.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    queryYear2026MipsSharedIs81AndOlderWithFrailtyWithAgeAnchor($program, $encounter.startDate, $result;)
    and not (
        exists Year2026Mips236sspExclusionG2118FrailtyOrgEMR()
    )
then
    insert(new Year2026Mips236sspExclusionG2118FrailtyOrgEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Frailty", "G2118", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

rule 'Year2026.Mips236ssp.Exclusion.G2118_Over_80_Frailty.Group.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp',
        $encounter.isPresent($encounter.groupExternalIds))
    $patient: Patient()
    queryYear2026MipsSharedIs81AndOlderWithFrailtyWithAgeAnchor($program, $encounter.startDate, $result;)
    and not (
        exists Year2026Mips236sspExclusionG2118FrailtyGroupEMR()
    )
then
    insert(new Year2026Mips236sspExclusionG2118FrailtyGroupEMR());
    for (String groupExternalId : $encounter.groupExternalIds) {
        controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Evidence of Frailty", "G2118", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    }
end


rule 'Year2026.Mips236ssp.Exclusion.G2118_Over_80_Frailty.Provider.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp',
        $encounter.isPresent($encounter.providerExternalId))
    $patient: Patient()
    queryYear2026MipsSharedIs81AndOlderWithFrailtyWithAgeAnchor($program, $encounter.startDate, $result;)
    and not (
        exists Year2026Mips236sspExclusionG2118FrailtyProviderEMR()
    )
then
    insert(new Year2026Mips236sspExclusionG2118FrailtyProviderEMR());
    for (String groupExternalId : $encounter.groupExternalIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Frailty", "G2118", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    }
end

/*
define "Numerator Performance Met G8752 and G8754":
  *
  * Option ID: G8752-G8754
  *
  "Normal Most Recent Systolic Blood Pressure Exists"
  and "Normal Most Recent Diastolic Blood Pressure Exists"

define "Normal Most Recent Systolic Blood Pressure Exists":
  exists("Most Recent Systolic Blood Pressure Reading" BPReading
    where BloodPressure.result_as_decimal < 140)
  or exists("Most Recent Systolic Blood Pressure" BloodPressure
    where BloodPressure.code_value in "MIPS; 236_PERFORMANCE_MET_G8752")

define "Normal Most Recent Diastolic Blood Pressure Exists":
  exists("Most Recent Diastolic Blood Pressure Reading" BPReading
    where BPReading.result_as_decimal < 90)
  or exists("Most Recent Diastolic Blood Pressure" BloodPressure
    where BloodPressure.code_value in "MIPS; 236_PERFORMANCE_MET_G8754")
*/
rule 'Year2026.Mips236ssp.Success.G8752-G8754'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    (
        (
            exists Year2026Mips236sspMostRecentSystolicBloodPressureReading(encounter.resultAsDecimal < 140)
            or exists Year2026Mips236sspMostRecentSystolicBloodPressure(encounter.withValueSet("MipsYear2026", "236_PERFORMANCE_MET_G8752"))
        ) and (
            exists Year2026Mips236sspMostRecentDiastolicBloodPressureReading(encounter.resultAsDecimal < 90)
            or exists Year2026Mips236sspMostRecentDiastolicBloodPressure(encounter.withValueSet("MipsYear2026", "236_PERFORMANCE_MET_G8754"))
        )
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, 'G8752-G8754');
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, 'G8752-G8754');
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.SUCCESS, "G8752-G8754");
end

/*
define "Numerator Performance Not Met G8753 and G8754":
  *
  * Option ID: G8753-G8754
  *
   "Abnormal Most Recent Systolic Blood Pressure Exists"
   and "Normal Most Recent Diastolic Blood Pressure Exists"

define "Abnormal Most Recent Systolic Blood Pressure Exists":
  exists("Most Recent Systolic Blood Pressure Reading" BPReading
    where BloodPressure.result_as_decimal >= 140)
  or exists("Most Recent Systolic Blood Pressure" BloodPressure
    where BloodPressure.code_value in "MIPS; 236_PERFORMANCE_NOT_MET_G8753")

define "Normal Most Recent Diastolic Blood Pressure Exists":
  exists("Most Recent Diastolic Blood Pressure Reading" BPReading
    where BPReading.result_as_decimal < 90)
  or exists("Most Recent Diastolic Blood Pressure" BloodPressure
    where BloodPressure.code_value in "MIPS; 236_PERFORMANCE_MET_G8754")
*/
rule 'Year2026.Mips236ssp.Gap.G8753-G8754'
salience 10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    (
        (
            exists Year2026Mips236sspMostRecentSystolicBloodPressureReading(encounter.resultAsDecimal >= 140)
            or exists Year2026Mips236sspMostRecentSystolicBloodPressure(encounter.withValueSet("MipsYear2026", "236_PERFORMANCE_NOT_MET_G8753"))
        ) and (
            exists Year2026Mips236sspMostRecentDiastolicBloodPressureReading(encounter.resultAsDecimal < 90)
            or exists Year2026Mips236sspMostRecentDiastolicBloodPressure(encounter.withValueSet("MipsYear2026", "236_PERFORMANCE_MET_G8754"))
        )
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, 'G8753-G8754');
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, 'G8753-G8754');
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "G8753-G8754");
end

/*
define "Numerator Performance Not Met G8752 and G8755":
  *
