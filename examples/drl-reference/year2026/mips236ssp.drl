/*
define "Numerator Performance Not Met G8756":
  *
  * Option ID: G8756
  *
  not "Denominator Exclusion Hospice"
  and not "Denominator Exclusion G0031 Palliative Care"
  and not "Denominator Exclusion G9231 ESRD or Pregnancy"
  and not "Denominator Exclusion G9910 Over 66 + Long Term Care"
  and not "Denominator Exclusion G2115 66-80 + Frailty + Dementia Med"
  and not "Denominator Exclusion G2116 66-80 + Frailty + Advanced Illness"
  and not "Denominator Exclusion G2118 Over 80 + Frailty"
  and not "Numerator Performance Met: G8752 and G8754"
  and not "Numerator Performance Not Met: G8752 and G8755"
  and not "Numerator Performance Not Met: G8753 and G8754"
  and not "Numerator Performance Not Met: G8753 and G8755"
*/
rule 'Year2026.Mips236ssp.Gap.G8756'
salience -5
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, 'G8756');
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, 'G8756');
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "G8756");
end

// 
// Helping facts & queries 
//

/*
define "Last Blood Pressure Day"     
  last((("Qualifying Diastolic Blood Pressure" DBP
          return DBP.start_date)
        intersect
        ("Qualifying Systolic Blood Pressure" SBP
          return SBP.start_date)
          )BP  )sort by BP.start_date asc
          
define "Qualifying Systolic Blood Pressure"
  "Systolic Blood Pressure" BloodPressure
        where BloodPressure.start_date during "Measurement Period"
        and not exists (  "Inpatient Encounter or ED Visit" Encounter
                          where (   (   BloodPressure.start_date during Interval[Encounter.start_date, Encounter.stop_date] 
                                        and Encounter.stop_date is not null or empty    )   
                                    or BloodPressure.start_date = Encounter.start_date  )
                                    )  
        and not exists ( ["Clinical Activity": "ABLE; PROCEDURE_REQUIRING_CHANGE_DIET_OR_MEDICATION"] Procedure
                          where Procedure.start_date = BloodPressure.start_date)

define "Qualifying Diastolic Blood Pressure"
  "Diastolic Blood Pressure" BloodPressure
        where BloodPressure.start_date during "Measurement Period"
        and not exists (  "Inpatient Encounter or ED Visit" Encounter
                          where (   (   BloodPressure.start_date during Interval[Encounter.start_date, Encounter.stop_date] 
                                        and Encounter.stop_date is not null or empty    )   
                                    or BloodPressure.start_date = Encounter.start_date  )
                                    ) 
        and not exists ( ["Clinical Activity": "ABLE; PROCEDURE_REQUIRING_CHANGE_DIET_OR_MEDICATION"] Procedure
                          where Procedure.start_date = BloodPressure.start_date)          

define "Systolic Blood Pressure":
  ["Clinical Activity": "eCQM Direct Reference Codes; SYSTOLIC_BLOOD_PRESSURE"]
  union ["Clinical Activity": "MIPS; 236_PERFORMANCE_MET_G8752"]
  union ["Clinical Activity": "MIPS; 236_PERFORMANCE_NOT_MET_G8753"]

define "Diastolic Blood Pressure":
  ["Clinical Activity": "eCQM Direct Reference Codes; DIASTOLIC_BLOOD_PRESSURE"]
  union ["Clinical Activity": "MIPS; 236_PERFORMANCE_MET_G8754"]
  union ["Clinical Activity": "MIPS; 236_PERFORMANCE_NOT_MET_G8755"]

define "Inpatient Encounter or ED Visit":
  ["Clinical Activity": "VSAC; ENCOUNTER_INPATIENT"]
  union ["Clinical Activity": "VSAC; EMERGENCY_DEPARTMENT_EVALUATION_AND_MANAGEMENT_VISIT"]
  union ["Clinical Activity": "ABLE; ACUTE_INPATIENT_STAY"]
*/
// Note: This query is used to calculate the  the start dates where both the systolic and diastolic exist.
// It returns the systolic, but it could be any.
query queryYear2026Mips236sspBloodPressureDay(Program $program, ClinicalActivity $bloodPressureDay)
    //"Systolic Blood Pressure"
    $bloodPressureDay:= ClinicalActivity(
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "SYSTOLIC_BLOOD_PRESSURE") ||
        withValueSet("MipsYear2026", "236_PERFORMANCE_MET_G8752") ||
        withValueSet("MipsYear2026", "236_PERFORMANCE_NOT_MET_G8753"),
        startsDuring($program.measurementPeriod)
    )
    //"Diastolic Blood Pressure" (matches systolic blood pressure start date)
    and exists ClinicalActivity(
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "DIASTOLIC_BLOOD_PRESSURE") ||
        withValueSet("MipsYear2026", "236_PERFORMANCE_MET_G8754") ||
        withValueSet("MipsYear2026", "236_PERFORMANCE_NOT_MET_G8755"),
        startsDuring($program.measurementPeriod),
        $bloodPressureDay.startDate == startDate
    )
    //"Inpatient Encounter or ED Visit"
    and not (
        exists ClinicalActivity(
            withValueSet("VsacYear2026", "ENCOUNTER_INPATIENT") ||
            withValueSet("VsacYear2026", "EMERGENCY_DEPARTMENT_EVALUATION_AND_MANAGEMENT_VISIT") ||
            withValueSet("AbleYear2026", "ACUTE_INPATIENT_STAY"),
            (stopDate != null && $bloodPressureDay.startsDuring(this)) ||
            startDate == $bloodPressureDay.startDate
        )
    )
    and not(
        exists ClinicalActivity(
            withValueSet("AbleYear2026", "PROCEDURE_REQUIRING_CHANGE_DIET_OR_MEDICATION"),
            startDate == $bloodPressureDay.startDate
        )
    )
end

rule 'Year2026.Mips236ssp.LastBloodPressureDay'
salience 30
when
    $program: Program(rules contains 'measure.Mips.2026.Mips236ssp')
    $lastBloodPressureDay: ClinicalActivity() from accumulate (
        queryYear2026Mips236sspBloodPressureDay($program, $bloodPressureDay;),
        latestClinicalActivity($bloodPressureDay)
    )
then
    insert(new Year2026Mips236sspLastBloodPressureDay($lastBloodPressureDay.startDate));
end

/*
define "Most Recent Systolic Blood Pressure"  
   "Qualifying Systolic Blood Pressure" SBP
        with "Last Blood Pressure Day" MostRecentBPDay
        such that SBP.start date = MostRecentBPDay.start_date

define "Qualifying Systolic Blood Pressure"
  "Systolic Blood Pressure" BloodPressure
        where BloodPressure.start_date during "Measurement Period"
        and not exists (  "Inpatient Encounter or ED Visit" Encounter
                          where (   (   BloodPressure.start_date during Interval[Encounter.start_date, Encounter.stop_date] 
                                        and Encounter.stop_date is not null or empty    )   
                                    or BloodPressure.start_date = Encounter.start_date  )
                                    )  
        and not exists ( ["Clinical Activity": "ABLE; PROCEDURE_REQUIRING_CHANGE_DIET_OR_MEDICATION"] Procedure
                          where Procedure.start_date = BloodPressure.start_date)

define "Systolic Blood Pressure":
  ["Clinical Activity": "eCQM Direct Reference Codes; SYSTOLIC_BLOOD_PRESSURE"]
  union ["Clinical Activity": "MIPS; 236_PERFORMANCE_MET_G8752"]
  union ["Clinical Activity": "MIPS; 236_PERFORMANCE_NOT_MET_G8753"]

define "Inpatient Encounter or ED Visit":
  ["Clinical Activity": "VSAC; ENCOUNTER_INPATIENT"]
  union ["Clinical Activity": "VSAC; EMERGENCY_DEPARTMENT_EVALUATION_AND_MANAGEMENT_VISIT"]
  union ["Clinical Activity": "ABLE; ACUTE_INPATIENT_STAY"]
*/
rule 'Year2026.Mips236ssp.MostRecentSystolicBloodPressure'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips236ssp')
    //"Systolic Blood Pressure"
    $systolicBloodPressure: ClinicalActivity(
        withValueSet("Ecqm_Direct_Reference_CodesYear2026", "SYSTOLIC_BLOOD_PRESSURE") ||
        withValueSet("MipsYear2026", "236_PERFORMANCE_MET_G8752") ||
        withValueSet("MipsYear2026", "236_PERFORMANCE_NOT_MET_G8753"),
        startsDuring($program.measurementPeriod)
    )
    and exists Year2026Mips236sspLastBloodPressureDay(date.equals($systolicBloodPressure.startDate))
    //"Inpatient Encounter or ED Visit"
    and not (
        exists ClinicalActivity(
            withValueSet("VsacYear2026", "ENCOUNTER_INPATIENT") ||
            withValueSet("VsacYear2026", "EMERGENCY_DEPARTMENT_EVALUATION_AND_MANAGEMENT_VISIT") ||
            withValueSet("AbleYear2026", "ACUTE_INPATIENT_STAY"),
            (stopDate != null && $systolicBloodPressure.startsDuring(this)) ||
            startDate == $systolicBloodPressure.startDate
        )
    )
    and not(
        exists ClinicalActivity(
            withValueSet("AbleYear2026","PROCEDURE_REQUIRING_CHANGE_DIET_OR_MEDICATION"),
            startDate == $systolicBloodPressure.startDate
        )
    )
then
    insert(new Year2026Mips236sspMostRecentSystolicBloodPressure($systolicBloodPressure));
end

/*
define "Most Recent Systolic Blood Pressure Reading"  //use lowest DBP on last day
  first(("Most Recent Systolic Blood Pressure" RecentSBP
        where RecentSBP.code_value in"eCQM Direct Reference Codes; SYSTOLIC_BLOOD_PRESSURE" 
              and RecentSBP.result is not null or empty) RecentSBPReading
           ) sort by RecentSBPReading.result_as_decimal asc 
*/
rule 'Year2026.Mips236ssp.MostRecentSystolicBloodPressureReading'
salience 15
when
    $program: Program(rules contains 'measure.Mips.2026.Mips236ssp')
    $mostRecentSystolicReading: ClinicalActivity() from accumulate (
        Year2026Mips236sspMostRecentSystolicBloodPressure(
            $systolicBloodPressure: encounter,
            encounter.resultAsDecimal != null,
            encounter.withValueSet("Ecqm_Direct_Reference_CodesYear2026", "SYSTOLIC_BLOOD_PRESSURE")
        ),
        latestClinicalActivityWithLowestResult($systolicBloodPressure)
    )
then
    insert(new Year2026Mips236sspMostRecentSystolicBloodPressureReading($mostRecentSystolicReading));
end

/*
define "Most Recent Diastolic Blood Pressure" 
  "Qualifying Diastolic Blood Pressure" DBP
        with "Last Blood Pressure Day" MostRecentBPDay
        such that DBP.start date = MostRecentBPDay.start_date

define "Qualifying Diastolic Blood Pressure"
