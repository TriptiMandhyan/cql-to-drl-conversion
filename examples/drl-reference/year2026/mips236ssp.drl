        controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Diastolic BP Used for Numerator Calculation", "G8752-G8754", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
