/*
define "Extended Measure Result - Numerator SBP Quality Code":
    ("Most Recent Systolic Blood Pressure" SBP
        where SBP.code_value in "MIPS; 236_PERFORMANCE_MET_G8752"
           or SBP.code_value in "MIPS; 236_PERFORMANCE_NOT_MET_G8753") SBPGCode
    where exists "Denominator"
    ,
    ExtendedMeasureResultV2(
        SBPGCode
        , 'Systolic BP Quality Code Used for Numerator Calculation' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all
