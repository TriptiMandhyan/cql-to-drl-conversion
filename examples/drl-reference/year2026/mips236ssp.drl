when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    exists Year2026Mips236sspExclusionG9231()
    $result: ClinicalActivity() from accumulate (
