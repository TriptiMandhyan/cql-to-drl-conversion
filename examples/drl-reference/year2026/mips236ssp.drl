end

/*
define "Most Recent Diastolic Blood Pressure Reading"  //use lowest DBP on last day
  first(("Most Recent Diastolic Blood Pressure" RecentDBP
        where RecentDBP.code_value in"eCQM Direct Reference Codes; DIASTOLIC_BLOOD_PRESSURE" 
              and RecentDBP.result is not null or empty) RecentDBPReading
           ) sort by RecentDBPReading.result_as_decimal asc
*/
rule 'Year2026.Mips236ssp.MostRecentDiastolicBloodPressureReading'
salience 15
when
    $program: Program(rules contains 'measure.Mips.2026.Mips236ssp')
    $mostRecentDiastolicReading: ClinicalActivity() from accumulate (
        Year2026Mips236sspMostRecentDiastolicBloodPressure(
            $diastolicBloodPressure: encounter,
            encounter.resultAsDecimal != null,
            encounter.withValueSet("Ecqm_Direct_Reference_CodesYear2026", "DIASTOLIC_BLOOD_PRESSURE")
        ),
        latestClinicalActivityWithLowestResult($diastolicBloodPressure)
    )
then
    insert(new Year2026Mips236sspMostRecentDiastolicBloodPressureReading($mostRecentDiastolicReading));
end

