/*
define "Denominator Exclusion G2115 66-80 + Frailty + Dementia Med":
   *
   * Option ID: G2115
   *
   exists(FrailtyLTI."Is 66 to 80 with Frailty and Dementia Meds with Age Anchor"(start of "Denominator Encounter"))
   ,
   from FrailtyLTI."Dementia Medications In Year Before or During Measurement Period" DementiaMed
   return
   ExtendedMeasureResultV2(
       DementiaMed
       , 'Dementia Medication' as name
       , display_date = start_date
       , calculated_record = false
       , population = Exclusion
       , option_id = G2115
   )
   and from FrailtyLTI."Frailty Exists During Measurement Period" FrailtyEvidence
   return
   ExtendedMeasureResultV2(
       FrailtyEvidence
       , 'Evidence of Frailty' as name
       , display_date = start_date
       , calculated_record = false
       , population = Exclusion
       , option_id = G2115
   )
*/
rule 'Year2026.Mips236ssp.Exclusion.G2115_66_80_FrailtyAndDementiaMed'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    exists queryYear2026MipsSharedFrailtyDementiaAge66To80WithAgeAnchor($program, $encounter.startDate;)
then
    insert (new Year2026Mips236sspExclusionFrailtyAndDementiaMedication());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, 'G2115');
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, 'G2115');
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G2115");
end

