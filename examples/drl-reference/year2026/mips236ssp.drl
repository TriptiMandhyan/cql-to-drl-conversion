/*
define "Denominator":
    exists( "Denominator Encounter" Encounter
            with ["Diagnosis": "MIPS; 236_HYPERTENSION"] Diagnosis
            // diagnosis of essential hypertension starting before and continuing into, or starting during the first six months of the M.P.
            such that   Interval[Hypertension.start_date, Hypertension.stop_date] overlaps Interval[start of "Measurement Period", end of "Measurement Period" - 6 months]
                        and (   Hypertension.start_date during Interval[start of "Measurement Period" - 12 months, end of "Measurement Period" - 6 months]
                                or Hypertension.author_date during Interval[start of "Measurement Period" - 12 months, end of "Measurement Period" - 6 months]  ) )
  and exists("Medicare Payer")
  ,
  from ("Denominator Encounter") Encounter
    with ["Diagnosis": "MIPS; 236_HYPERTENSION"] Hypertension
    such that Interval[Hypertension.start_date, Hypertension.stop_date] overlaps Interval[start of "Measurement Period", end of "Measurement Period" - 6 months]
          and Hypertension.start_date during Interval[start of "Measurement Period" - 12 months, end of "Measurement Period" - 6 months]
  return
  ExtendedMeasureResultV2(
      Encounter
      , 'Denominator Encounter' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator
      , option_id = all
  )
  and return
  ExtendedMeasureResultV2(
      Hypertension
      , 'Hypertension Diagnosis' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator
      , option_id = all
  )

define "Denominator Encounter":
  ["Clinical Activity": "MIPS; 236_ENCOUNTER"] Encounter
    where Encounter.start_date during "Measurement Period"
      and AgeInYearsAt(Encounter.start_date) >= 18
      and AgeInYearsAt(Encounter.start_date) < 85
      and Encounter.provider_id.hasMeasureMembership = true

define "Medicare Payer"
    "Patient"
    where Patient.payer_code_type, payer_code_value in ["ABLE; MEDICARE_PAYER"]
*/
rule 'Year2026.Mips236ssp.Denominator'
salience 40
when
    $program: Program(rules contains 'measure.Mips.2026.Mips236ssp')
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "236_ENCOUNTER"),
        startsDuring($program.measurementPeriod)
    )
    exists (
        Patient(
            getAgeInYearsAt($encounter.startDate) >= 18 &&
            getAgeInYearsAt($encounter.startDate) < 85,
            withPayerCodeValueInValueSet("AbleYear2026", "MEDICARE_PAYER")
        )
        and Diagnosis(
            withValueSet("MipsYear2026", "236_HYPERTENSION"),
            overlaps($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(6)),
            (startsDuring($program.measurementPeriod.start.minusMonths(12), $program.measurementPeriod.end.minusMonths(6)) ||
            authoredDuring($program.measurementPeriod.start.minusMonths(12), $program.measurementPeriod.end.minusMonths(6)))
        )
    )
then
    insert(new EncounterDenominator($program, $encounter, 'Year2026.Mips236ssp'));
end

rule 'Year2026.Mips236ssp.Denominator.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    $diagnosis: Diagnosis() from accumulate (
        $d:= Diagnosis(
            withValueSet("MipsYear2026", "236_HYPERTENSION"),
            overlaps($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(6)),
            startsDuring($program.measurementPeriod.start.minusMonths(12), $program.measurementPeriod.end.minusMonths(6))
        ),
        latestDiagnosis($d)
    )
    and not (
        exists Year2026Mips236sspDenominatorOrgEMR()
    )
then
    insert(new Year2026Mips236sspDenominatorOrgEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G9740", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G0031", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G9231", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G9910", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G2115", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G2116", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G2118", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G8752-G8754", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G8753-G8754", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G8752-G8755", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G8753-G8755", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G8756", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G9740", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G0031", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G9231", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G9910", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G2115", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G2116", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G2118", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G8752-G8754", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G8753-G8754", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G8752-G8755", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G8753-G8755", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Hypertension Diagnosis", "G8756", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
end

rule 'Year2026.Mips236ssp.Denominator.Group.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp',
    $encounter.isPresent($encounter.groupExternalIds))
    $patient: Patient()
    $diagnosis: Diagnosis() from accumulate (
        $d:= Diagnosis(
            withValueSet("MipsYear2026", "236_HYPERTENSION"),
            overlaps($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(6)),
            (startsDuring($program.measurementPeriod.start.minusMonths(12), $program.measurementPeriod.end.minusMonths(6)) ||
            authoredDuring($program.measurementPeriod.start.minusMonths(12), $program.measurementPeriod.end.minusMonths(6)))
        ),
        latestDiagnosis($d)
    )
    and not (
        exists Year2026Mips236sspDenominatorGroupEMR()
    )
then
    insert(new Year2026Mips236sspDenominatorGroupEMR());
    for (String groupExternalId : $encounter.groupExternalIds) {
        controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Denominator Encounter", "G9740", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Denominator Encounter", "G0031", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
