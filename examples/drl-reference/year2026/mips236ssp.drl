/*
define "Extended Measure Result - Numerator DBP Reading":
    ("Most Recent Diastolic Blood Pressure Reading") DBPReading
    where exists "Denominator"
    ,
    ExtendedMeasureResultV2(
        DBPReading
        , 'Diastolic BP Used for Numerator Calculation' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all
    )
*/
rule 'Year2026.Mips236ssp.EMR.NumeratorDBPReading.Org'
salience -10
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    Year2026Mips236sspMostRecentDiastolicBloodPressureReading($dbp:encounter, encounter.resultAsDecimal < 90)
    and not (
        exists Year2026Mips236sspEMRNumeratorSBPReadingOrg()
    )
then
    insert(new Year2026Mips236sspEMRNumeratorSBPReadingOrg());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G9740", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G0031", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G9231", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G9910", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G2115", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G2116", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G2118", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G8752-G8754", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G8753-G8754", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G8752-G8755", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G8753-G8755", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Diastolic BP Used for Numerator Calculation", "G8756", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
end

