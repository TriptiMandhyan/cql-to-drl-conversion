        controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Diastolic BP Used for Numerator Calculation", "G8752-G8755", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Diastolic BP Used for Numerator Calculation", "G8753-G8755", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Diastolic BP Used for Numerator Calculation", "G8756", PopulationEnum.denominator, $dbp, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $dbp.startDate.toString());
    }
end

