/*
define "Denominator Exclusion G9231 ESRD or Pregnancy":
    *
    * Option ID: G9231
    *
  exists(["Clinical Activity": "MIPS; 236_DENOMINATOR_EXCLUSION_G9231_ESRD_OR_PREGNANCY"] I
    where I.start_date during "Measurement Period")
  or exists("Excluded Diagnoses" Dx
    where Interval[Dx.start_date, Dx.stop_date] overlaps "Measurement Period")
  or exists("Excluded Procedures" P
    where P.start_date on or before end of "Measurement Period")
  or exists(["Diagnosis": "VSAC; Pregnancy"] Preg
    where (Interval[Preg.start_date, Preg.stop_date] overlaps "Measurement Period"
          and Preg.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"]))
  ,
  if exists (["Clinical Activity": "MIPS; 236_DENOMINATOR_EXCLUSION_G9231_ESRD_OR_PREGNANCY"] I
    where I.start_date during "Measurement Period") ESRDPregnancyQC
  then
  return
  ExtendedMeasureResultV2(
      ESRDPregnancyQC
      , 'ESRD or Pregnancy Quality Code' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9231
  )
  else if exists ("Excluded Diagnoses" Dx
    where Interval[Dx.start_date, Dx.stop_date] overlaps "Measurement Period") ESRDDiagnosis
  then
  return
  ExtendedMeasureResultV2(
      ESRDDiagnosis
      , 'ESRD Diagnosis' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9231
  )
  else if exists ("Excluded Procedures" P
    where P.start_date on or before end of "Measurement Period") ESRDProcedure
  then
  return
  ExtendedMeasureResultV2(
      ESRDProcedure
      , 'ESRD Procedure' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9231
  )
  else if exists (["Diagnosis": "VSAC; Pregnancy"] Preg
    where (Interval[Preg.start_date, Preg.stop_date] overlaps "Measurement Period"
          and Preg.start_date during Interval[start of "Measurement Period" - 1 year, end of "Measurement Period"])) PregnancyDiagnosis
  then
  return
  ExtendedMeasureResultV2(
      PregnancyDiagnosis
      , 'Pregnancy Diagnosis' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9231
  )

define "Excluded Diagnoses":
  ["Diagnosis": "VSAC; END_STAGE_RENAL_DISEASE"]
  union ["Diagnosis": "VSAC; CHRONIC_KIDNEY_DISEASE_STAGE_5"]
  union ["Diagnosis": "VSAC; KIDNEY_TRANSPLANT_RECIPIENT"]

define "Excluded Procedures":
["Clinical Activity": "VSAC; ESRD_MONTHLY_OUTPATIENT_SERVICES"]
  union ["Clinical Activity": "VSAC; KIDNEY_TRANSPLANT"]
  union ["Clinical Activity": "VSAC; DIALYSIS_SERVICES"]
*/
rule 'Year2026.Mips236ssp.Exclusion.G9231_ESRD_or_Pregnancy'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips236ssp')
    $patient: Patient()
    (
        exists ClinicalActivity(
            withValueSet("MipsYear2026", "236_DENOMINATOR_EXCLUSION_G9231_ESRD_OR_PREGNANCY"),
            startsDuring($program.measurementPeriod)
        ) 
        or exists Diagnosis(
            withValueSet("VsacYear2026", "END_STAGE_RENAL_DISEASE") || 
            withValueSet("VsacYear2026", "CHRONIC_KIDNEY_DISEASE_STAGE_5") ||
            withValueSet("VsacYear2026", "KIDNEY_TRANSPLANT_RECIPIENT"),
            overlaps($program.measurementPeriod)
        ) 
        or exists ClinicalActivity(
            withValueSet("VsacYear2026", "ESRD_MONTHLY_OUTPATIENT_SERVICES") ||
            withValueSet("VsacYear2026", "KIDNEY_TRANSPLANT") ||
            withValueSet("VsacYear2026", "DIALYSIS_SERVICES"),
            startsOnOrBefore($program.measurementPeriod.end)
        ) 
        or exists Diagnosis(
            withValueSet("VsacYear2026", "PREGNANCY"),
            overlaps($program.measurementPeriod),
            startsDuring($program.measurementPeriod.start.minusYears(1), $program.measurementPeriod.end)
        )
    )
then
    insert (new Year2026Mips236sspExclusionG9231());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, 'G9231');
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, 'G9231');
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9231");
end

