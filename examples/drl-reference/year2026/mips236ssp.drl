                                        and Encounter.stop_date is not null or empty    )   
                                    or BloodPressure.start_date = Encounter.start_date  )
                                    ) 
        and not exists ( ["Clinical Activity": "ABLE; PROCEDURE_REQUIRING_CHANGE_DIET_OR_MEDICATION"] Procedure
                          where Procedure.start_date = BloodPressure.start_date)                        

define "Diastolic Blood Pressure":
  ["Clinical Activity": "eCQM Direct Reference Codes; DIASTOLIC_BLOOD_PRESSURE"]
