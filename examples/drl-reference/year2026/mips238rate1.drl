    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "Nonbenzodiazepine Hypnotic 2", "G9367", PopulationEnum.numerator_performance_met, $pairMed2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $pairMed2.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "Nonbenzodiazepine Hypnotic Cumulative Medication Duration", "G9367", PopulationEnum.numerator_performance_met, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), String.valueOf($durationDays.longValue()), SupplementalInfoEnum.CALCULATED_VALUE_TYPE.displayName(), ElementValueType.LONG.displayName());
