    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Evidence of Palliative Care", "G0034", PopulationEnum.denominator_exclusion, $palliative, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $palliative.startDate.toString());
end

rule 'Year2026.Mips238Rate1.Exclusion.G0034_PalliativeCare.Provider.EMR'
when
    EncounterDenominator($program: program, $measure: measure, measure == "Year2026.Mips238Rate1", $encounter: clinicalActivity,
        $encounter.isPresent($encounter.providerExternalId))
    $patient: Patient()
    $palliative: QdmDatatype() from accumulate(
