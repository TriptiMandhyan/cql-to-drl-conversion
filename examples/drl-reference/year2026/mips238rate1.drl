rule 'Year2026.Mips238Rate1.SameHighRiskMedicationsOrderedOnDifferentDays.GROUP'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == 'Year2026.Mips238Rate1')
    queryYear2026Mips238Rate1GroupMedicationListEvidenceCandidate($program, $encounter, $pairMed1, $pairMed2;)
    and not (
        exists Year2026Mips238Rate1MedicationListGroup(
            !Collections.disjoint(encounter.groupExternalIds, $encounter.groupExternalIds)
        )
    )
then
    insert(new Year2026Mips238Rate1MedicationListGroup($encounter, $pairMed1, $pairMed2));
end

