    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "DESICCATED_THYROID_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_NONBENZODIAZEPINE_HYPNOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_SKELETAL_MUSCLE_RELAXANTS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_PAIN_MEDICATIONS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "GUANFACINE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "MEGESTROL_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "MEPERIDINE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
end

