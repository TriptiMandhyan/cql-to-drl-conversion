rule 'Year2026.Mips238Rate1.Success.G9367.Org.EMR.Digoxin'
salience -14
when
    $patient: Patient()
    EncounterDenominator($program: program, measure == 'Year2026.Mips238Rate1')
    not (exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
