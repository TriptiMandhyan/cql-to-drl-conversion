    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "Digoxin Order 2", "G9367", PopulationEnum.numerator_performance_met, $med2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $med2.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "Digoxin Average Daily Dose", "G9367", PopulationEnum.numerator_performance_met, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), String.valueOf($dose.doubleValue()), SupplementalInfoEnum.CALCULATED_VALUE_TYPE.displayName(), ElementValueType.DECIMAL.displayName());
