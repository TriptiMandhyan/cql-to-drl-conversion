rule 'Year2026.Mips238Rate1.Success.G9367.org'
when
    $patient: Patient()
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == 'Year2026.Mips238Rate1')
    and exists (
        exists ClinicalActivity(
            withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
            startsDuring($program.measurementPeriod)
        )
        or exists(
            //"Medication List".org
            Year2026Mips238Rate1MedicationListOrg()
        )
        or exists(
            //"Two High Risk Medications With Prolonged Duration Anti-Infectives".org
            Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesOrgEvidence()
        )
        or exists(
            //"Two High Risk Medications With Prolonged Duration Hypnotics".org
            Year2026Mips238Rate1TwoHighRiskMedicationHypnoticsOrgEvidence()
        )
        or exists(
            //"High Risk Medications with Average Daily Dose Criteria Digoxin".org
            Year2026Mips238Rate1AverageDailyDoseDigoxinOrgEvidence()
        )
        or exists(
            //"High Risk Medications with Average Daily Dose Criteria Doxepin".org
            Year2026Mips238Rate1AverageDailyDoseDoxepinOrgEvidence()
        )
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, 'Year2026.Mips238Rate1', MeasureStatusValue.SUCCESS, "G9367");
end

rule 'Year2026.Mips238Rate1.Success.G9367.Org.EMR.QualityCode'
salience -10
when
    $patient: Patient()
    EncounterDenominator($program: program, measure == 'Year2026.Mips238Rate1')
    $qualityCode: ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
        startsDuring($program.measurementPeriod)
    )
    and not (exists Year2026Mips238Rate1SuccessG9367OrgEMR())
then
    insert(new Year2026Mips238Rate1SuccessG9367OrgEMR());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "Performance Met Quality Code", "G9367", PopulationEnum.numerator_performance_met, $qualityCode, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $qualityCode.startDate.toString());
end

rule 'Year2026.Mips238Rate1.Success.G9367.Org.EMR.MedicationList'
salience -11
when
    $patient: Patient()
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == 'Year2026.Mips238Rate1')
    not (exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
        startsDuring($program.measurementPeriod)
    ))
    Year2026Mips238Rate1MedicationListOrg($med1: med1, $med2: med2)
    and not (exists Year2026Mips238Rate1SuccessG9367OrgEMR())
then
    insert(new Year2026Mips238Rate1SuccessG9367OrgEMR());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "High Risk Medication Order 1", "G9367", PopulationEnum.numerator_performance_met, $med1, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $med1.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "High Risk Medication Order 2", "G9367", PopulationEnum.numerator_performance_met, $med2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $med2.startDate.toString());
end

rule 'Year2026.Mips238Rate1.Success.G9367.Org.EMR.AntiInfectives'
salience -12
when
    $patient: Patient()
    EncounterDenominator($program: program, measure == 'Year2026.Mips238Rate1')
    not (exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
        startsDuring($program.measurementPeriod)
    ))
    exists Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesOrgEvidence()
    queryYear2026Mips238SharedMedicationMoreThanOneOrg($program, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    $durationDays: Number() from accumulate(
        $m: Medication(
            withValueSet("AbleYear2026", "POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"),
            startsDuring($program.measurementPeriod)
        );
        sum($m.totalDaysSupplied($program.measurementPeriodEndDate))
    )
    and not (exists Year2026Mips238Rate1SuccessG9367OrgEMR())
then
    insert(new Year2026Mips238Rate1SuccessG9367OrgEMR());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "Anti-Infective Medication 1", "G9367", PopulationEnum.numerator_performance_met, $pairMed1, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $pairMed1.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "Anti-Infective Medication 2", "G9367", PopulationEnum.numerator_performance_met, $pairMed2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $pairMed2.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "Anti-Infective Cumulative Medication Duration", "G9367", PopulationEnum.numerator_performance_met, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), String.valueOf($durationDays.longValue()), SupplementalInfoEnum.CALCULATED_VALUE_TYPE.displayName(), ElementValueType.LONG.displayName());
end

rule 'Year2026.Mips238Rate1.Success.G9367.Org.EMR.Hypnotics'
salience -13
when
    $patient: Patient()
    EncounterDenominator($program: program, measure == 'Year2026.Mips238Rate1')
    not (exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
        startsDuring($program.measurementPeriod)
    ))
    exists Year2026Mips238Rate1TwoHighRiskMedicationHypnoticsOrgEvidence()
    queryYear2026Mips238SharedMedicationMoreThanOneOrg($program, "AbleYear2026", "POTENTIALLY_HARMFUL_NONBENZODIAZEPINE_HYPNOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    $durationDays: Number() from accumulate(
