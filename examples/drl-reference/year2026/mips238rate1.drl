/*
define "Two High Risk Medications With Prolonged Duration Anti-Infectives".group:
        (   "Cumulative Medication Duration".group("AntiInfectives During Measurement Period") >= 90) Duration
        and exists("AntiInfectives".group) AntiInfect
        such that Duration.group_id = AntiInfect.group_id

define function "Cumulative Medication Duration".group("Medication List"<"Medication">):
	Sum((collapse(Medication.relevantPeriod)) CumulativeDosages
			return all duration in days of CumulativeDosages, Medication.group_id
	)

define "AntiInfectives During Measurement Period":
	["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"] AntiInfectives
		where AntiInfectives.Interval[start_date, end_date] during "Measurement Period"

define "AntiInfectives".group:
    exists("More Than One Order".group(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"]))
*/
rule 'Year2026.Mips238Rate1.HighRiskMedications.group.AntiInfectivesEvidence'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == 'Year2026.Mips238Rate1')
    not Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesGroupEvidence(
        !Collections.disjoint(encounter.groupExternalIds, $encounter.groupExternalIds)
    )
    //"AntiInfectives".group
    queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    //"Cumulative Medication Duration".group("AntiInfectives During Measurement Period")>= 90
    and accumulate(
        $m: Medication(
            withValueSet("AbleYear2026", "POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"),
            startsDuring($program.measurementPeriod),
            !Collections.disjoint(groupExternalIds, $encounter.groupExternalIds)
        );
        $totalDays: sum($m.totalDaysSupplied($program.measurementPeriodEndDate));
        $totalDays >= 90
    )
then
    insert(new Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesGroupEvidence($encounter));
end

/*
define "Hypnotics During Measurement Period":
	["Medication": "ABLE; POTENTIALLY_HARMFUL_NONBENZODIAZEPINE_HYPNOTICS_FOR_OLDER_ADULTS_MAP_NDC"] Hypnotics
