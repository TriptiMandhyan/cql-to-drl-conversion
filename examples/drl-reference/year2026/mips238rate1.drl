  )
  else if "Two High Risk Medications With Prolonged Duration Anti-Infectives".org
  from (  first("AntiInfectives During Measurement Period" sort by start_date asc) Med1
          , last("AntiInfectives During Measurement Period" sort by start_date asc) Med2
          , "Cumulative Medication Duration".org("AntiInfectives During Measurement Period") Duration  )
  return
