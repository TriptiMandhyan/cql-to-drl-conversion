    not Year2026Mips238Rate1AverageDailyDoseDoxepinProviderEvidence(encounter.providerExternalId == $encounter.providerExternalId)
    queryYear2026Mips238Rate1ProviderDoxepinEvidenceCandidate($program, $encounter, $med1, $med2, $medResult, $dose;)
then
    insert(new Year2026Mips238Rate1AverageDailyDoseDoxepinProviderEvidence($encounter, $med1, $med2, $dose));
end

/*
define function Average Daily Dose(Medication "Medication"):
    MedicationOrder Order
    let MedicationStrength: "MedicationStrengthPerUnit"(Medication.code_description),
    return ( ( Medication.quantity * MedicationStrength ) / Medication.days_supplied    ) 
*/
query queryYear2026Mips238Rate1AverageDailyDoseOrg(Program $program, String $valueSet, Number $multiplier, Number $limitOfMgPerDay, Medication $medResult, Number $doseResult)
    $medResult := Medication(
        withValueSet("AbleYear2026", $valueSet),
        startsDuring($program.measurementPeriod),
        stopDate != null,
        quantityAsInteger != null,
        dispensed == true
    )
    and $doseResult := Number() from ((($medResult.quantityAsInteger *
        $multiplier.doubleValue()
    ) / ($medResult.daysSupplied != null ? $medResult.daysSupplied.doubleValue() : ($medResult.totalDaysSupplied($program.measurementPeriodEndDate).doubleValue() + ($medResult.stopDate.isAfter($program.measurementPeriodEndDate) ? 0.0 : 1.0)))))
    and eval($doseResult.doubleValue() > $limitOfMgPerDay.doubleValue())
end

query queryYear2026Mips238Rate1AverageDailyDoseProvider(Program $program, ClinicalActivity $encounter, String $valueSet, Number $multiplier, Number $limitOfMgPerDay, Medication $medResult, Number $doseResult)
    $medResult := Medication(
        withValueSet("AbleYear2026", $valueSet),
        startsDuring($program.measurementPeriod),
        stopDate != null,
        quantityAsInteger != null,
        dispensed == true,
        !Strings.isNullOrEmpty(providerExternalId),
        providerExternalId == $encounter.providerExternalId
    )
    and $doseResult := Number() from ((($medResult.quantityAsInteger *
        $multiplier.doubleValue()
    ) / ($medResult.daysSupplied != null ? $medResult.daysSupplied.doubleValue() : ($medResult.totalDaysSupplied($program.measurementPeriodEndDate).doubleValue() + ($medResult.stopDate.isAfter($program.measurementPeriodEndDate) ? 0.0 : 1.0)))))
    and eval($doseResult.doubleValue() > $limitOfMgPerDay.doubleValue())
end

query queryYear2026Mips238Rate1AverageDailyDoseGroup(Program $program, String $groupExternalId, String $valueSet, Number $multiplier, Number $limitOfMgPerDay, Medication $medResult, Number $doseResult)
    $medResult := Medication(
        withValueSet("AbleYear2026", $valueSet),
        startsDuring($program.measurementPeriod),
        stopDate != null,
        quantityAsInteger != null,
        dispensed == true,
        groupExternalIds contains $groupExternalId
    )
    and $doseResult := Number() from ((($medResult.quantityAsInteger *
        $multiplier.doubleValue()
    ) / ($medResult.daysSupplied != null ? $medResult.daysSupplied.doubleValue() : ($medResult.totalDaysSupplied($program.measurementPeriodEndDate).doubleValue() + ($medResult.stopDate.isAfter($program.measurementPeriodEndDate) ? 0.0 : 1.0)))))
    and eval($doseResult.doubleValue() > $limitOfMgPerDay.doubleValue())
end

/*
define "Numerator Performance Met G9367".org:
 Option ID: G9367 
	"Denominator Encounter".all
	and (   exists( "Same High Risk Medications Ordered on Different Days".org ) medlist
	        or "Two High Risk Medications With Prolonged Duration Anti-Infectives".org
	        or "Two High Risk Medications With Prolonged Duration Hypnotics".org
	        or "High Risk Medications with Average Daily Dose Criteria Digoxin".org
	        or "High Risk Medications with Average Daily Dose Criteria Doxepin".org
  	        or exists(	["Clinical Activity": "MIPS; 238_PERFORMANCE_MET_G9367"] P
    		        	where P.start_date during "Measurement Period"  )   )
  ,
  if exists(  ["Clinical Activity": "MIPS; 238_PERFORMANCE_MET_G9367"] P
              where P.start_date during "Measurement Period"  ) QualityCode
  return
  ExtendedMeasureResultV2(
      QualityCode
      , 'Performance Met Quality Code' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  else if exists ( "Same High Risk Medications Ordered on Different Days".org ) medlist
  return
  ExtendedMeasureResultV2(
      medlist.med1
