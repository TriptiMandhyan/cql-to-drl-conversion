rule 'Year2026.Mips238Rate1.SameHighRiskMedicationsOrderedOnDifferentDays.ORG'
when
    EncounterDenominator($program: program, measure == 'Year2026.Mips238Rate1')
    not Year2026Mips238Rate1MedicationListOrg()
    queryYear2026Mips238Rate1OrgMedicationListEvidenceCandidate($program, $pairMed1, $pairMed2;)
then
    insert(new Year2026Mips238Rate1MedicationListOrg($pairMed1, $pairMed2));
end

