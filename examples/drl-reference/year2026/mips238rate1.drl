        exists Year2026Mips238Rate1MedicationListProvider(
            encounter.providerExternalId == $encounter.providerExternalId
        )
    )
then
    insert(new Year2026Mips238Rate1MedicationListProvider($encounter, $pairMed1, $pairMed2));
end


/*
case
    when code_value in valueset "ABLE; DIGOXIN_0_05_MG_ML_ORAL_SOLUTION_MAP_NDC" then 0.05 'mg/mL'
    when code_value in valueset "ABLE; DIGOXIN_0_0625_MG_ORAL_TABLET_MAP_NDC" then 0.0625 'mg'
    when code_value in valueset "ABLE; 1_ML_DIGOXIN_0_1_MG_ML_INJECTION_MAP_NDC" then 0.1 'mg/mL'
    when code_value in valueset "ABLE; DIGOXIN_0_125_MG_ORAL_TABLET_MAP_NDC" then 0.125 'mg'
    when code_value in valueset "ABLE; DIGOXIN_0_1875_MG_ORAL_TABLET_MAP_NDC" then 0.1875 'mg'
    when code_value in valueset "ABLE; DIGOXIN_0_25_MG_ORAL_TABLET_MAP_NDC" then 0.25 'mg'
    when code_value in valueset "ABLE; 2_ML_DIGOXIN_0_25_MG_ML_INJECTION_MAP_NDC" then 0.25 'mg/mL' 
    else null 
end
*/
/*
New Numerator Definition
The goal of the following functions is to calculate the average daily dose for each prescription event. 
To calculate average daily dose, multiply the quantity of pills prescribed by the dose of each pill 
and divide by the days supply. For example, a prescription for the 30-days supply of digoxin containing 15 pills,
0.25 mg each pill, has an average daily dose of 0.125 mg. To calculate average daily dose for elixirs
and concentrates, multiply the volume prescribed by daily dose and divide by the days supply. Do not round 
when calculating average daily dose.

define "Digoxin Ordered":
    ["Medication": "ABLE; DIGOXIN_MEDICATIONS_MAP_NDC"] DigoxinOrdered
    where DigoxinOrdered.start_date during "Measurement Period"

define "Doxepin Ordered":
    ["Medication": "ABLE; DOXEPIN_MEDICATIONS_MAP_NDC"] DoxepinOrdered
    where DoxepinOrdered.start_date during "Measurement Period"

define "High Risk Medications with Average Daily Dose Criteria Digoxin".org:
    "More Than One Order".org( "Digoxin Ordered" ) pair
    with "Digoxin Ordered" DigoxinOrder
        such that "Average Daily Dose"(DigoxinOrder) > 0.125 'mg/d'
    return { med1: pair.med1, med2: pair.med2, dose: Max("Average Daily Dose"(DigoxinOrder)) }

define "High Risk Medications with Average Daily Dose Criteria Doxepin".org:
    "More Than One Order".org( "Doxepin Ordered" ) pair
    with "Doxepin Ordered" DoxepinOrder
        such that "Average Daily Dose"(DoxepinOrder) > 6 'mg/d'
    return { med1: pair.med1, med2: pair.med2, dose: Max("Doxepin Ordered" DoxepinOrder return "Average Daily Dose"(DoxepinOrder)) } 

define function Average Daily Dose(Medication "Medication"):
MedicationOrder Order
  let MedicationStrength: "MedicationStrengthPerUnit"(Medication.code_description),
  return coalesce( ( Medication.days_supplied * MedicationStrength ) / Medication.quantity ) 

define function MedicationStrengthPerUnit(code_description):
    case
        when code_value in valueset "ABLE; DIGOXIN_0_05_MG_ML_ORAL_SOLUTION_MAP_NDC" then 0.05 'mg/mL'
        when code_value in valueset "ABLE; DIGOXIN_0_0625_MG_ORAL_TABLET_MAP_NDC" then 0.0625 'mg'
        when code_value in valueset "ABLE; 1_ML_DIGOXIN_0_1_MG_ML_INJECTION_MAP_NDC" then 0.1 'mg/mL'
        when code_value in valueset "ABLE; DIGOXIN_0_125_MG_ORAL_TABLET_MAP_NDC" then 0.125 'mg'
        when code_value in valueset "ABLE; DIGOXIN_0_1875_MG_ORAL_TABLET_MAP_NDC" then 0.1875 'mg'
        when code_value in valueset "ABLE; DIGOXIN_0_25_MG_ORAL_TABLET_MAP_NDC" then 0.25 'mg'
        when code_value in valueset "ABLE; 2_ML_DIGOXIN_0_25_MG_ML_INJECTION_MAP_NDC" then 0.25 'mg/mL'
        when code_value in valueset "ABLE; DOXEPIN_3_MG_ORAL_TABLET_MAP_NDC" then 3 'mg'
        when code_value in valueset "ABLE; DOXEPIN_6_MG_ORAL_TABLET_MAP_NDC" then 6 'mg'
        when code_value in valueset "ABLE; DOXEPIN_10_MG_ORAL_CAPSULE_MAP_NDC" then 10 'mg'
        when code_value in valueset "ABLE; DOXEPIN_10_MG_ML_ORAL_SOLUTION_MAP_NDC" then 10 'mg/mL'
        when code_value in valueset "ABLE; DOXEPIN_25_MG_ORAL_CAPSULE_MAP_NDC" then 25 'mg'
        when code_value in valueset "ABLE; DOXEPIN_50_MG_ORAL_CAPSULE_MAP_NDC" then 50 'mg'
        when code_value in valueset "ABLE; DOXEPIN_75_MG_ORAL_CAPSULE_MAP_NDC" then 75 'mg'
        when code_value in valueset "ABLE; DOXEPIN_100_MG_ORAL_CAPSULE_MAP_NDC" then 100 'mg'
        when code_value in valueset "ABLE; DOXEPIN_150_MG_ORAL_CAPSULE_MAP_NDC" then 150 'mg' 
        else null 
    end
*/
query queryYear2026Mips238Rate1OrgDigoxinEvidenceCandidate(Program $program, Medication $pairMed1, Medication $pairMed2, Medication $medResult, Number $doseResult)
    ( queryYear2026Mips238SharedMedicationMoreThanOneOrg($program, "AbleYear2026", "DIGOXIN_0_05_MG_ML_ORAL_SOLUTION_MAP_NDC", $pairMed1, $pairMed2;) and queryYear2026Mips238Rate1AverageDailyDoseOrg($program, "DIGOXIN_0_05_MG_ML_ORAL_SOLUTION_MAP_NDC", 0.05, 0.125, $medResult, $doseResult;) )
