rule 'Year2026.Mips238Rate1.Success.G9367.Group.EMR.AntiInfectives'
salience -12
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate1')
    $patient: Patient()
    $groupId: String() from $encounter.groupExternalIds
