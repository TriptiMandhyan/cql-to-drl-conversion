    controlSet.addPatientEMR($program, $patient, $measure, $providerId, "Nonbenzodiazepine Hypnotic 2", "G9367", PopulationEnum.numerator_performance_met, $pairMed2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $pairMed2.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $providerId, "Nonbenzodiazepine Hypnotic Cumulative Medication Duration", "G9367", PopulationEnum.numerator_performance_met, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), String.valueOf($durationDays.longValue()), SupplementalInfoEnum.CALCULATED_VALUE_TYPE.displayName(), ElementValueType.LONG.displayName());
end

rule 'Year2026.Mips238Rate1.Success.G9367.Provider.EMR.Digoxin'
salience -14
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate1',
        $encounter.isPresent($encounter.providerExternalId))
    $patient: Patient()
    $providerId: String() from $encounter.providerExternalId
    not (exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
        startsDuring($program.measurementPeriod),
        !Strings.isNullOrEmpty(providerExternalId),
        providerExternalId == $encounter.providerExternalId
    ))
    $doseEvidence: Year2026Mips238Rate1AverageDailyDoseDigoxinProviderEvidence(
        encounter.providerExternalId == $encounter.providerExternalId,
        $med1: med1,
        $med2: med2,
        $dose: dose
    )
    and not (exists Year2026Mips238Rate1SuccessG9367ProviderEMR(providerId == $providerId))
then
    insert(new Year2026Mips238Rate1SuccessG9367ProviderEMR($providerId));
    controlSet.addPatientEMR($program, $patient, $measure, $providerId, "Digoxin Order 1", "G9367", PopulationEnum.numerator_performance_met, $med1, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $med1.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $providerId, "Digoxin Order 2", "G9367", PopulationEnum.numerator_performance_met, $med2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $med2.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $providerId, "Digoxin Average Daily Dose", "G9367", PopulationEnum.numerator_performance_met, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), String.valueOf($dose.doubleValue()), SupplementalInfoEnum.CALCULATED_VALUE_TYPE.displayName(), ElementValueType.DECIMAL.displayName());
end

