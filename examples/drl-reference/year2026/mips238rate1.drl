    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "MEPROBAMATE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ESTROGENS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
