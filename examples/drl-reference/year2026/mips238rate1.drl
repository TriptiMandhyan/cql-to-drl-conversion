/*
define "Two High Risk Medications With Prolonged Duration Anti-Infectives".provider:
        (   "Cumulative Medication Duration".provider("AntiInfectives During Measurement Period") >= 90) Duration
        and exists("AntiInfectives".provider) AntiInfect
        such that Duration.provider_id = AntiInfect.provider_id

define function "Cumulative Medication Duration".provider("Medication List"<"Medication">):
	Sum((collapse(Medication.relevantPeriod)) CumulativeDosages
			return all duration in days of CumulativeDosages, Medication.provider_id
	)

define "AntiInfectives During Measurement Period":
	["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"] AntiInfectives
		where AntiInfectives.Interval[start_date, end_date] during "Measurement Period"

define "AntiInfectives".provider:
    exists("More Than One Order".provider(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"]))
*/
rule 'Year2026.Mips238Rate1.HighRiskMedications.provider.AntiInfectivesEvidence'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == 'Year2026.Mips238Rate1')
    not Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesProviderEvidence(
        encounter.providerExternalId == $encounter.providerExternalId
    )
    //"AntiInfectives".provider
    queryYear2026Mips238SharedMedicationMoreThanOneProvider($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    //"Cumulative Medication Duration".provider("AntiInfectives During Measurement Period")>= 90
    and accumulate(
        $m: Medication(
            withValueSet("AbleYear2026", "POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"),
            startsDuring($program.measurementPeriod),
            !Strings.isNullOrEmpty(providerExternalId),
            providerExternalId == $encounter.providerExternalId
        );
        $totalDays: sum($m.totalDaysSupplied($program.measurementPeriodEndDate));
        $totalDays >= 90
    )
then
    insert(new Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesProviderEvidence($encounter));
end

