rule 'Year2026.Mips238Rate1.Success.G9367.group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate1')
    $patient: Patient()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
        startsDuring($program.measurementPeriod),
        !Collections.disjoint(groupExternalIds, $encounter.groupExternalIds)
    )
    or exists(
        // "Same High Risk Medications Ordered on Different Days".group
        Year2026Mips238Rate1MedicationListGroup(
            !Collections.disjoint(encounter.groupExternalIds, $encounter.groupExternalIds)
        )
    )
    or exists(
        //"Two High Risk Medications With Prolonged Duration Anti-Infectives".group
        Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesGroupEvidence(
            !Collections.disjoint(encounter.groupExternalIds, $encounter.groupExternalIds)
        )
    )
    or exists(
        //"Two High Risk Medications With Prolonged Duration Hypnotics".group
        Year2026Mips238Rate1TwoHighRiskMedicationHypnoticsGroupEvidence(
            !Collections.disjoint(encounter.groupExternalIds, $encounter.groupExternalIds)
        )
    )
    or exists(
        //"High Risk Medications with Average Daily Dose Criteria Digoxin".group
        Year2026Mips238Rate1AverageDailyDoseDigoxinGroupEvidence(
            !Collections.disjoint(encounter.groupExternalIds, $encounter.groupExternalIds)
        )
    )
    or exists(
        //"High Risk Medications with Average Daily Dose Criteria Doxepin".group
        Year2026Mips238Rate1AverageDailyDoseDoxepinGroupEvidence(
            !Collections.disjoint(encounter.groupExternalIds, $encounter.groupExternalIds)
        )
    )
then
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.SUCCESS, "G9367");
end

