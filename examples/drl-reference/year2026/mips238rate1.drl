    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "DIPYRIDAMOLE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "NIFEDIPINE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
