      Med2
      , 'Nonbenzodiazepine Hypnotic 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      Duration
      , 'Nonbenzodiazepine Hypnotic Cumulative Medication Duration' as name
      , calculated_record = true
      , population = Performance Met
      , option_id = G9367
  )
  else if exists ( "High Risk Medications with Average Daily Dose Criteria Digoxin".org ) DigoxinCriteria
  return
  ExtendedMeasureResultV2(
      DigoxinCriteria.med1
      , 'Digoxin Order 1' as name
      , display_date = start_date
