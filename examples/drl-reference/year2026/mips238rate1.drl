    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Palliative Care", "G0034", PopulationEnum.denominator_exclusion, $palliative, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $palliative.startDate.toString());
end

/*
define function "Cumulative Medication Duration".org("Medication List"<"Medication">):
    Sum((collapse(Medication.relevantPeriod)) CumulativeDosages)
    return all duration in days of CumulativeDosages

define "AntiInfectives During Measurement Period":
    ["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"] AntiInfectives
    where AntiInfectives.Interval[start_date, end_date] during "Measurement Period"

define "AntiInfectives".org:
    exists("More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"]))

define "Two High Risk Medications With Prolonged Duration Anti-Infectives".org:
    "Cumulative Medication Duration".org("AntiInfectives During Measurement Period") >= 90
    and exists "AntiInfectives".org    
*/
rule 'Year2026.Mips238Rate1.HighRiskMedications.ORG.AntiInfectivesEvidence'
when
    EncounterDenominator($program: program, measure == 'Year2026.Mips238Rate1')
    not Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesOrgEvidence()
    //"AntiInfectives".org
    queryYear2026Mips238SharedMedicationMoreThanOneOrg($program, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    //"Cumulative Medication Duration".org("AntiInfectives During Measurement Period")>= 90
    and accumulate(
        $m: Medication(
            withValueSet("AbleYear2026", "POTENTIALLY_HARMFUL_ANTIINFECTIVES_FOR_OLDER_ADULTS_MAP_NDC"),
            startsDuring($program.measurementPeriod)
        );
        $totalDays: sum($m.totalDaysSupplied($program.measurementPeriodEndDate));
        $totalDays >= 90
    )
then
    insert(new Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesOrgEvidence());
end

