/*define "Numerator Performance Met G9367".provider:
 Option ID: G9367 
    (   "Denominator Encounter".all Encounter
	    and exists "Same High Risk Medications Ordered on Different Days".provider medlist
		    such that Encounter.provider_id = medlist.provider_id )
    or  (   "Denominator Encounter".all Encounter
	        and exists "Two High Risk Medications With Prolonged Duration Anti-Infectives".provider Med
		        such that Encounter.provider_id = Med.provider_id )
    or  (   "Denominator Encounter".all Encounter
	        and exists "Two High Risk Medications With Prolonged Duration Hypnotics".provider Med
		        such that Encounter.provider_id = Med.provider_id )
    or  (   "Denominator Encounter".all Encounter
    	    and exists "High Risk Medications with Average Daily Dose Criteria Digoxin".provider Dose
		        such that Encounter.provider_id = Dose.med1.provider_id  )
    or  (   "Denominator Encounter".all Encounter
    	    and exists "High Risk Medications with Average Daily Dose Criteria Doxepin".provider Dose
		        such that Encounter.provider_id = Dose.med1.provider_id  )
    or  (   "Denominator Encounter".all Encounter
  	        and exists( (   ["Clinical Activity": "MIPS; 238_PERFORMANCE_MET_G9367"] P
    			            where P.start_date during "Measurement Period"  )
				such that Encounter.provider_id = P.provider_id	)   )
  ,
  if exists(  ["Clinical Activity": "MIPS; 238_PERFORMANCE_MET_G9367"] P
              where P.start_date during "Measurement Period"  ) QualityCode
  return
  ExtendedMeasureResultV2(
      QualityCode
      , 'Performance Met Quality Code' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  else if exists ( "Same High Risk Medications Ordered on Different Days".provider ) medlist
  return
  ExtendedMeasureResultV2(
      medlist.med1
      , 'High Risk Medication Order 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      medlist.med2
      , 'High Risk Medication Order 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  else if "Two High Risk Medications With Prolonged Duration Anti-Infectives".provider
  from (  first("AntiInfectives During Measurement Period" sort by start_date asc) Med1
          , last("AntiInfectives During Measurement Period" sort by start_date asc) Med2
          , "Cumulative Medication Duration".provider("AntiInfectives During Measurement Period") Duration  )
  return
  ExtendedMeasureResultV2(
      Med1
      , 'Anti-Infective Medication 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      Med2
      , 'Anti-Infective Medication 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      Duration
      , 'Anti-Infective Cumulative Medication Duration' as name
      , calculated_record = true
      , population = Performance Met
      , option_id = G9367
  )
  else if "Two High Risk Medications With Prolonged Duration Hypnotics".provider
  from (  first("Hypnotics During Measurement Period" sort by start_date asc) Med1
          , last("Hypnotics During Measurement Period" sort by start_date asc) Med2
          , "Cumulative Medication Duration".provider("Hypnotics During Measurement Period") Duration  )
  return
  ExtendedMeasureResultV2(
      Med1
      , 'Nonbenzodiazepine Hypnotic 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      Med2
      , 'Nonbenzodiazepine Hypnotic 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      Duration
      , 'Nonbenzodiazepine Hypnotic Cumulative Medication Duration' as name
      , calculated_record = true
      , population = Performance Met
      , option_id = G9367
  )
  else if exists ( "High Risk Medications with Average Daily Dose Criteria Digoxin".provider ) DigoxinCriteria
  return
  ExtendedMeasureResultV2(
      DigoxinCriteria.med1
      , 'Digoxin Order 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      DigoxinCriteria.med2
      , 'Digoxin Order 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      DigoxinCriteria.dose
      , 'Digoxin Average Daily Dose' as name
      , calculated_record = true
      , population = Performance Met
      , option_id = G9367
  )
  else if exists ( "High Risk Medications with Average Daily Dose Criteria Doxepin".provider ) DoxepinCriteria
  return
  ExtendedMeasureResultV2(
      DoxepinCriteria.med1
      , 'Doxepin Order 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      DoxepinCriteria.med2
      , 'Doxepin Order 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = G9367
  )
  ,
  ExtendedMeasureResultV2(
      DoxepinCriteria.dose
      , 'Doxepin Average Daily Dose' as name
      , calculated_record = true
      , population = Performance Met
      , option_id = G9367
  ) */
rule 'Year2026.Mips238Rate1.Success.G9367.provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate1')
    $patient: Patient()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
        startsDuring($program.measurementPeriod),
        !Strings.isNullOrEmpty(providerExternalId),
        providerExternalId == $encounter.providerExternalId
    )
    or exists(
        //"Medication List".provider
        Year2026Mips238Rate1MedicationListProvider(
            encounter.providerExternalId == $encounter.providerExternalId
        )
    )
   
    or exists(
        //"Two High Risk Medications With Prolonged Duration Anti-Infectives".provider
        Year2026Mips238Rate1TwoHighRiskMedicationAntiInfectivesProviderEvidence(
            encounter.providerExternalId == $encounter.providerExternalId
        )
    )
    or exists(
        //"Two High Risk Medications With Prolonged Duration Hypnotics".provider
        Year2026Mips238Rate1TwoHighRiskMedicationHypnoticsProviderEvidence(
            encounter.providerExternalId == $encounter.providerExternalId
        )
    )
    or exists(
        //"High Risk Medications with Average Daily Dose Criteria Digoxin".provider
        Year2026Mips238Rate1AverageDailyDoseDigoxinProviderEvidence(
            encounter.providerExternalId == $encounter.providerExternalId
        )
    )
    or exists(
        //"High Risk Medications with Average Daily Dose Criteria Doxepin".provider
        Year2026Mips238Rate1AverageDailyDoseDoxepinProviderEvidence(
            encounter.providerExternalId == $encounter.providerExternalId
        )
    )
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "G9367");
end

