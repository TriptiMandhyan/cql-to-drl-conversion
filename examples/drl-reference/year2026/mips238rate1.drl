/*
define function "More Than One Order".org("Medication List"<"Medication">): 
    "Medication" MedOrder_1
    with "Medication" MedOrder_2
    such that ( MedOrder_1.start_date 1 day or more after MedOrder_2.start_date
                and MedOrder_1.start_date during "Measurement Period"
                and MedOrder_2.start_date during "Measurement Period"   )
    return { med1: MedOrder_1, med2: MedOrder_2 }
    
define "Same High Risk Medications Ordered on Different Days".org:
    "More Than One Order"(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIHISTAMINES_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIPARKINSONIAN_AGENTS_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_GASTROINTESTINAL_ANTISPASMODICS_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; DIPYRIDAMOLE_MEDICATIONS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; NIFEDIPINE_MEDICATIONS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIDEPRESSANTS_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_BARBITURATES_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; ERGOLOID_MESYLATES_USP_1_MG_ORAL_TABLET_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; MEPROBAMATE_MEDICATIONS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_ESTROGENS_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_SULFONYLUREAS_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; DESICCATED_THYROID_MEDICATIONS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_NONBENZODIAZEPINE_HYPNOTICS_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_SKELETAL_MUSCLE_RELAXANTS_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_PAIN_MEDICATIONS_FOR_OLDER_ADULTS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; GUANFACINE_MEDICATIONS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; MEGESTROL_MEDICATIONS_MAP_NDC"])
    union "More Than One Order".org(["Medication": "ABLE; MEPERIDINE_MEDICATIONS_MAP_NDC"])
*/
query queryYear2026Mips238Rate1OrgMedicationListEvidenceCandidate(Program $program, Medication $pairMed1, Medication $pairMed2)
    queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_ANTIHISTAMINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPARKINSONIAN_AGENTS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_GASTROINTESTINAL_ANTISPASMODICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "DIPYRIDAMOLE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "NIFEDIPINE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_ANTIDEPRESSANTS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_BARBITURATES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "ERGOLOID_MESYLATES_USP_1_MG_ORAL_TABLET_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "MEPROBAMATE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_ESTROGENS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_SULFONYLUREAS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "DESICCATED_THYROID_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_NONBENZODIAZEPINE_HYPNOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_SKELETAL_MUSCLE_RELAXANTS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_PAIN_MEDICATIONS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "GUANFACINE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "MEGESTROL_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "MEPERIDINE_MEDICATIONS_MAP_NDC", $pairMed1, $pairMed2;)
end

query queryYear2026Mips238Rate1GroupMedicationListEvidenceCandidate(Program $program, ClinicalActivity $encounter, Medication $pairMed1, Medication $pairMed2)
    queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIHISTAMINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
    or queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPARKINSONIAN_AGENTS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
