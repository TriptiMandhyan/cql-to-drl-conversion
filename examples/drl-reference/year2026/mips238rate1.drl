      , calculated_record = true
      , population = Performance Met
      , option_id = G9367
  )
  else if "Two High Risk Medications With Prolonged Duration Hypnotics".org
  from (  first("Hypnotics During Measurement Period" sort by start_date asc) Med1
          , last("Hypnotics During Measurement Period" sort by start_date asc) Med2
