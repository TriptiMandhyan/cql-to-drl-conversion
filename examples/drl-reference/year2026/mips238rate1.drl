/*
define "Denominator Exclusion G9741 Hospice".all:
 Option ID: G9741 
   "Denominator".all
 	and exists(sharedHospice."Has Hospice") HospiceEvidence
  ,
  if exists "Denominator Exclusion G9741 Hospice".all return
  ExtendedMeasureResultV2(
      HospiceEvidence
      , 'Evidence of Hospice' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9741
  )
*/
rule 'Year2026.Mips238Rate1.Exclusion.G9741_Hospice.Org.EMR'
when
    EncounterDenominator($program: program, measure == 'Year2026.Mips238Rate1')
    $patient: Patient()
    $hospice: QdmDatatype() from accumulate(
        queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $hospiceResult;),
        latestQdmDatatype($hospiceResult)
    )
    not (exists Year2026Mips238Rate1ExclusionHospiceOrg())
then
    insert(new Year2026Mips238Rate1ExclusionHospiceOrg());
    controlSet.addPatientMeasureStatus($program, $patient, 'Year2026.Mips238Rate1', MeasureStatusValue.EXCLUSION, "G9741");
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips238Rate1', "", "Evidence of Hospice", "G9741", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

rule 'Year2026.Mips238Rate1.Exclusion.G9741_Hospice.Group.EMR'
when
    EncounterDenominator($program: program, $measure: measure, measure == "Year2026.Mips238Rate1", $encounter: clinicalActivity,
        $encounter.isPresent($encounter.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.groupExternalIds
    not (exists Year2026Mips238Rate1ExclusionHospiceGroup(groupExternalId == $groupExternalId))
    $hospice: QdmDatatype() from accumulate(
        queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $hospiceResult;),
        latestQdmDatatype($hospiceResult)
    )
then
    insert(new Year2026Mips238Rate1ExclusionHospiceGroup($groupExternalId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9741");
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Evidence of Hospice", "G9741", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

rule 'Year2026.Mips238Rate1.Exclusion.G9741_Hospice.Provider.EMR'
when
    EncounterDenominator($program: program, $measure: measure, measure == "Year2026.Mips238Rate1", $encounter: clinicalActivity,
        $encounter.isPresent($encounter.providerExternalId))
    $patient: Patient()
    $hospice: QdmDatatype() from accumulate(
        queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $hospiceResult;),
        latestQdmDatatype($hospiceResult)
    )
    not (exists Year2026Mips238Rate1ExclusionHospiceProvider(providerExternalId == $encounter.providerExternalId))
then
    insert(new Year2026Mips238Rate1ExclusionHospiceProvider($encounter.providerExternalId));
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9741");
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Hospice", "G9741", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

/*
define "Denominator Exclusion G0034 Palliative Care".all:
 Option ID: G0034 
   "Denominator".all
 	and exists(sharedPalliativeCare."Has Palliative Care") PalliativeEvidence
  ,
  if exists "Denominator Exclusion G0034 Palliative Care".all return
  ExtendedMeasureResultV2(
      PalliativeEvidence
      , 'Evidence of Palliative Care' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G0034
  )
*/
