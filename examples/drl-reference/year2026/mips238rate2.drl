/**
define "Numerator Performance Not Met G0032".org:
* Option ID: G0032 *
   (   "Denominator".all Encounter
	    and exists("More than One Antipsychotic With Appropriate Diagnosis".org) AO
	    and not exists("More than One Benzodiazepine Order".org) BO
	)
	or (    "Denominator".all Encounter
	        and exists( ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0032"] P
    					where P.start_date during "Measurement Period"  )
	        and not exists( ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0033"] P2
    					where P2.start_date during "Measurement Period"  )   )
  ,
  if exists(  ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0032"] P
              where P.start_date during "Measurement Period"  ) QualityCode
  return
  ExtendedMeasureResultV2(
      QualityCode
      , 'Performance Not Met Quality Code' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032
  )
  else if exists ( "More than One Antipsychotic Order".org ) AntiOrder
  return
  ExtendedMeasureResultV2(
      AntiOrder.med1
      , 'Antipsychotic Order 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032
  )
  ,
  ExtendedMeasureResultV2(
      AntiOrder.med2
      , 'Antipsychotic Order 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032
  )
*/
rule 'Year2026.Mips238Rate2.Gap.G0032.org'
when
    $program: Program()
    $patient: Patient()
    exists (EncounterDenominator(measure == 'Year2026.Mips238Rate2'))
    and exists (
        //define "More than One POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC With Appropriate Diagnosis".org"
        (
            exists queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
            and exists Year2026Mips238Rate2SchizophreniaOrBipolar()
            and not (
                exists queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed3, $pairMed4;)
            )
        )
        or (
            exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0032"),
                startsDuring($program.measurementPeriod)
            )
            and not (exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0033"),
                startsDuring($program.measurementPeriod)
            ))
        )
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, 'Year2026.Mips238Rate2', MeasureStatusValue.GAP, "G0032");
end

