define "More than One Benzodiazepine With Appropriate Diagnosis".group:
    exists "More than One Benzodiazepine Order".group
    and exists  "Seizure, REM, Sleep Disorder, Withdrawal, GAD on or between Jan 1 year prior to MY up to IPSD"

define "More than One Benzodiazepine Order".group:
    exists "More Than One of Same Medication Order".group(["Medication": "ABLE; POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"])

define "More than One Antipsychotic With Appropriate Diagnosis".group:  
    exists "More than One Antipsychotic Order".group
    and exists "Schizophrenia or Bipolar on or between Jan 1 year prior to MY up to IPSD"

define "More than One Antipsychotic Order".group:
    exists "More Than One of Same Medication Order".group(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC"])
*/
rule 'Year2026.Mips238Rate2.Gap.G0032G0033.group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    (
        ( // medication-based branch
            //exists ("More than One POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC With Appropriate Diagnosis")
            exists queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
            and exists Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGAD()
            //"More than One POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC With Appropriate Diagnosis
            and exists queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed3, $pairMed4;)
            and exists Year2026Mips238Rate2SchizophreniaOrBipolar()
        )
        or
        ( // clinical-activity branch: both QC32 and QC33 exist during measurement period with matching group IDs
            exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0032"),
                startsDuring($program.measurementPeriod),
                !Collections.disjoint(groupExternalIds, $encounter.groupExternalIds)
            )
            and exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0033"),
                startsDuring($program.measurementPeriod),
                !Collections.disjoint(groupExternalIds, $encounter.groupExternalIds)
            )
        )
    )
then
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "G0032_G0033");
end

