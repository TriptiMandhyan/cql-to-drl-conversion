            exists Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGAD()
        )
    )
    or (
        //exists "More than One POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC Order".group)
        exists queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
        and not(
