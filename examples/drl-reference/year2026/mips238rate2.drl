            startsDuring($program.measurementPeriod),
            !Strings.isNullOrEmpty(providerExternalId),
            providerExternalId == $encounter.providerExternalId
        ),
        latestMedication($med)
    )
    and exists Year2026Mips238Rate2GapG0033ProviderEMR()
then
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Benzodiazepine Order 2", "G0033", PopulationEnum.numerator_performance_not_met, $benzoMed, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $benzoMed.startDate.toString());
end


/*
define "Numerator Performance Not Met G0032 and G0033".org: 
* Option ID: G0032_G0033   *

    "Denominator".all Encounter
    ( exists (  ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0032"] P1
                where P1.start_date during "Measurement Period" )
        and exists (  ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0033"] P2
                    where P2.start_date during "Measurement Period" )   
    ) BothQualityCodes
	or (    exists "More than One Benzodiazepine With Appropriate Diagnosis".org
	        and exists "More than One Antipsychotic With Appropriate Diagnosis".org )
  ,
  if exists(  ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0032"] P
              where P.start_date during "Measurement Period"  ) QC32
      and exists(  ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0033"] P2
              where P2.start_date during "Measurement Period"  ) QC33
  return
  ExtendedMeasureResultV2(
      QC32
      , 'Performance Not Met Quality Code G0032' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
