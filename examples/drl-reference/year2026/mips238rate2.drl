define "More than One Benzodiazepine With Appropriate Diagnosis".org:
    exists "More than One Benzodiazepine Order".org
    and exists  "Seizure, REM, Sleep Disorder, Withdrawal, GAD on or between Jan 1 year prior to MY up to IPSD"

define "More than One Benzodiazepine Order".org:
    "More Than One of Same Medication Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"])
define "More than One Antipsychotic With Appropriate Diagnosis".org:    
    exists "More than One Antipsychotic Order".org
    and exists "Schizophrenia or Bipolar on or between Jan 1 year prior to MY up to IPSD"

define "More than One Antipsychotic Order".org:
    "More Than One of Same Medication Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC"])
*/
rule 'Year2026.Mips238Rate2.Gap.G0032G0033.org'
when
    $program: Program()
    $patient: Patient()
    exists (EncounterDenominator(measure == 'Year2026.Mips238Rate2'))
    and (
        ( // medication-based branch
            exists queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
            and exists Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGAD()
            and exists queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed3, $pairMed4;)
            and exists Year2026Mips238Rate2SchizophreniaOrBipolar()
        )
        or
        ( // clinical-activity branch: both QC32 and QC33 exist during measurement period
            exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0032"),
                startsDuring($program.measurementPeriod)
            )
            and exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0033"),
                startsDuring($program.measurementPeriod)
            )
        )
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, 'Year2026.Mips238Rate2', MeasureStatusValue.GAP, "G0032_G0033");
end

