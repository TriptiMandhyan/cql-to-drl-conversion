/*
define "Numerator Performance Not Met G0032".group:
* Option ID: G0032 *
   (   "Denominator".all Encounter
	    and exists("More than One Antipsychotic With Appropriate Diagnosis".group) AO
		    such that Encounter.group_id = AO.group_id
	    and not exists( "More than One Benzodiazepine Order".group ) BO
			    such that Encounter.group_id = BO.group_id
	)
	or (    "Denominator".all Encounter
	        and exists( ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0032"] P
    					where   P.start_date during "Measurement Period"
							    and Encounter.group_id = P.group_id )
	        and not exists( ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0033"] P2
    					where   P2.start_date during "Measurement Period"
							    and Encounter.group_id = P2.group_id )   )
  ,
  if exists(  ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0032"] P
              where P.start_date during "Measurement Period"  ) QualityCode
  return
  ExtendedMeasureResultV2(
      QualityCode
      , 'Performance Not Met Quality Code' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032
  )
  else if exists ( "More than One Antipsychotic Order".group ) AntiOrder
  return
  ExtendedMeasureResultV2(
      AntiOrder.med1
      , 'Antipsychotic Order 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032
  )
  ,
  ExtendedMeasureResultV2(
      AntiOrder.med2
      , 'Antipsychotic Order 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032
  )

define "More than One Antipsychotic With Appropriate Diagnosis".group:  
    exists "More than One Antipsychotic Order".group
    and exists "Schizophrenia or Bipolar on or between Jan 1 year prior to MY up to IPSD"

define "More than One Antipsychotic Order".group:
    exists "More Than One of Same Medication Order".group(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC"])

define "More than One Benzodiazepine Order".group:
    exists "More Than One of Same Medication Order".group(["Medication": "ABLE; POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"])
*/
rule 'Year2026.Mips238Rate2.Gap.G0032.group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    //define "More than One POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC With Appropriate Diagnosis".group"
    (
        exists queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
        and exists Year2026Mips238Rate2SchizophreniaOrBipolar()
        and not (
            //"More than One POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC Order".group
            exists queryYear2026Mips238SharedMedicationMoreThanOneGroup($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed3, $pairMed4;)
        )
    )
    or (
        exists ClinicalActivity(
            withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0032"),
            startsDuring($program.measurementPeriod),
            !Collections.disjoint(groupExternalIds, $encounter.groupExternalIds)
        )
        and not (exists ClinicalActivity(
            withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0033"),
            startsDuring($program.measurementPeriod),
            !Collections.disjoint(groupExternalIds, $encounter.groupExternalIds)
        ))
    )
then
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "G0032");
end

