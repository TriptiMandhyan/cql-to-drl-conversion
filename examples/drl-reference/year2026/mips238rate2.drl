        and exists( ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0033"] P2
                    where   P2.start_date during "Measurement Period"
                            and Encounter.provider_id = P2.provider_id )
    )
	or (    exists("More than One Benzodiazepine With Appropriate Diagnosis".provider) BO
	            such that Encounter.provider_id = BO.provider_id
	        and exists("More than One Antipsychotic With Appropriate Diagnosis".provider) AO
	            such that Encounter.provider_id = AO.provider_id )
  ,
  if exists(  ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0032"] P
              where P.start_date during "Measurement Period"  ) QC32
      and exists(  ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0033"] P2
              where P2.start_date during "Measurement Period"  ) QC33
  return
  ExtendedMeasureResultV2(
      QC32
      , 'Performance Not Met Quality Code G0032' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032_G0033
  )
  ,
  ExtendedMeasureResultV2(
      QC33
      , 'Performance Not Met Quality Code G0033' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032_G0033
  )
  else if exists (  exists("More than One Benzodiazepine With Appropriate Diagnosis".provider) BO
	                such that Encounter.provider_id = BO.provider_id
	                and exists("More than One Antipsychotic With Appropriate Diagnosis".provider) AO
	                    such that Encounter.provider_id = AO.provider_id )
  return
  ExtendedMeasureResultV2(
      BenzoOrder.med1
      , 'Benzodiazepine Order 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032_G0033
  )
  ,
  ExtendedMeasureResultV2(
      BenzoOrder.med2
      , 'Benzodiazepine Order 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032_G0033
  )
  ,
  ExtendedMeasureResultV2(
      AntiOrder.med1
      , 'Antipsychotic Order 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032_G0033
  )
  ,
  ExtendedMeasureResultV2(
      AntiOrder.med2
      , 'Antipsychotic Order 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0032_G0033
  )


define "More than One Benzodiazepine With Appropriate Diagnosis".provider:
    exists "More than One Benzodiazepine Order".provider
    and exists  "Seizure, REM, Sleep Disorder, Withdrawal, GAD on or between Jan 1 year prior to MY up to IPSD"

define "More than One Benzodiazepine Order".provider:
    exists "More Than One of Same Medication Order".provider(["Medication": "ABLE; POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"])

define "More than One Antipsychotic With Appropriate Diagnosis".provider:
    exists "More than One Antipsychotic Order".provider
    and exists "Schizophrenia or Bipolar on or between Jan 1 year prior to MY up to IPSD"

define "More than One Antipsychotic Order".provider:
    exists "More Than One of Same Medication Order".provider(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC"])
*/
rule 'Year2026.Mips238Rate2.Gap.G0032G0033.provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    (
        ( // medication-based branch
            //exists ("More than One POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC With Appropriate Diagnosis")
            exists queryYear2026Mips238SharedMedicationMoreThanOneProvider($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
            and exists Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGAD()
            //"More than One POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC With Appropriate Diagnosis
            and exists queryYear2026Mips238SharedMedicationMoreThanOneProvider($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed3, $pairMed4;)
            and exists Year2026Mips238Rate2SchizophreniaOrBipolar()
        )
        or
        ( // clinical-activity branch: both QC32 and QC33 exist during measurement period with matching provider IDs
            exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0032"),
                startsDuring($program.measurementPeriod),
                !Strings.isNullOrEmpty(providerExternalId),
                providerExternalId == $encounter.providerExternalId
            )
            and exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0033"),
                startsDuring($program.measurementPeriod),
                !Strings.isNullOrEmpty(providerExternalId),
                providerExternalId == $encounter.providerExternalId
            )
        )
    )
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G0032_G0033");
end

rule 'Year2026.Mips238Rate2.Gap.G0032G0033.Provider.EMR.G0032'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    $qc32: ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0032"),
        startsDuring($program.measurementPeriod),
        !Strings.isNullOrEmpty(providerExternalId),
        providerExternalId == $encounter.providerExternalId
    )
    and exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0033"),
        startsDuring($program.measurementPeriod),
        !Strings.isNullOrEmpty(providerExternalId),
        providerExternalId == $encounter.providerExternalId
    )
    and not (
        exists Year2026Mips238Rate2GapG0032G0033ProviderEMR()
    )
then
    insert (new Year2026Mips238Rate2GapG0032G0033ProviderEMR());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Performance Not Met Quality Code G0032", "G0032_G0033", PopulationEnum.numerator_performance_not_met, $qc32, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $qc32.startDate.toString());
end

rule 'Year2026.Mips238Rate2.Gap.G0032G0033.Provider.EMR.G0033'
salience -11
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0032"),
        startsDuring($program.measurementPeriod),
        !Strings.isNullOrEmpty(providerExternalId),
        providerExternalId == $encounter.providerExternalId
    )
    and $qc33: ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0033"),
        startsDuring($program.measurementPeriod),
        !Strings.isNullOrEmpty(providerExternalId),
        providerExternalId == $encounter.providerExternalId
    )
    and exists Year2026Mips238Rate2GapG0032G0033ProviderEMR()
then
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Performance Not Met Quality Code G0033", "G0032_G0033", PopulationEnum.numerator_performance_not_met, $qc33, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $qc33.startDate.toString());
end

rule 'Year2026.Mips238Rate2.Gap.G0032G0033.Provider.Medication.EMR.Benzo1'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    not (exists ClinicalActivity(
        withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0032"),
        startsDuring($program.measurementPeriod),
        !Strings.isNullOrEmpty(providerExternalId),
        providerExternalId == $encounter.providerExternalId
    ))
    $benzoMed: Medication() from accumulate (
        $med: Medication(
            withValueSet("AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"),
            startsDuring($program.measurementPeriod),
            !Strings.isNullOrEmpty(providerExternalId),
            providerExternalId == $encounter.providerExternalId
        ),
        earliestMedication($med)
    )
    and not (
        exists Year2026Mips238Rate2GapG0032G0033ProviderEMR()
    )
then
    insert (new Year2026Mips238Rate2GapG0032G0033ProviderEMR());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Benzodiazepine Order 1", "G0032_G0033", PopulationEnum.numerator_performance_not_met, $benzoMed, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $benzoMed.startDate.toString());
end

