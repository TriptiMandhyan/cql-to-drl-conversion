/*
define "Seizure, REM, Sleep Disorder, Withdrawal, GAD on or between Jan 1 year prior to MY up to IPSD"
    (   ["Diagnosis": "VSAC; SEIZURE_DISORDER"]
        union ["Diagnosis":  "VSAC; REM_SLEEP_BEHAVIOR_DISORDER"]
        union ["Diagnosis": "VSAC; BENZODIAZEPINE_WITHDRAWAL"]
        union ["Diagnosis":  "VSAC; ALCOHOL_WITHDRAWAL"]
        union ["Diagnosis": " VSAC; GENERALIZED_ANXIETY_DISORDER"] ) Disorder
    with "First Benzodiazepine Medication Ordered" Rx
    such that Disorder.start_date during Interval [start of "Measurement Period" - 1 year, Rx.start_date]
,
    if exists ( "Seizure, REM, Sleep Disorder, Withdrawal, GAD on or between Jan 1 year prior to MY up to IPSD" ) Diagnosis
    return
    ExtendedMeasureResultV2(
        Diagnosis
        , 'Seizure, REM, Sleep Disorder, Withdrawal, or GAD Diagnosis' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all
    )

define "First Benzodiazepine Medication Ordered":
    first(  ["Medication": "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"] BenzodiazepineMedication
            where BenzodiazepineMedication.start_date during "Measurement Period"   )   sort by BenzodiazepineMedication.start_date asc
    return BenzodiazepineMedication.start_date
               
*/
rule 'Year2026.Mips238Rate2.SeizureREMSleepDisorderWithdrawalGAD'
salience 20
when
    exists (EncounterDenominator(measure == 'Year2026.Mips238Rate2'))
    $program: Program()
    //define "First POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC Medication Ordered"
    $firstMed: Medication() from accumulate (
        $med: Medication(
            withValueSet("AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"),
            startsDuring($program.measurementPeriod)
        ),
        earliestMedication($med)
    )
    and exists Diagnosis(
        withValueSet("VsacYear2026", "SEIZURE_DISORDER") ||
        withValueSet("VsacYear2026", "REM_SLEEP_BEHAVIOR_DISORDER") ||
        withValueSet("VsacYear2026", "BENZODIAZEPINE_WITHDRAWAL") ||
        withValueSet("VsacYear2026", "ALCOHOL_WITHDRAWAL") ||
        withValueSet("VsacYear2026", "GENERALIZED_ANXIETY_DISORDER"),
        startsDuring($program.measurementPeriod.start.minusYears(1), $firstMed.startDate)
    )
then
    insert(new Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGAD());
end

