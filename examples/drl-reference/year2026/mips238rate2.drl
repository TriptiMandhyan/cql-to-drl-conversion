/*
define "Numerator Performance Not Met G0033".org:
* Option ID: G0033 *
    (   "Denominator".all Encounter
	    and exists("More than One Benzodiazepine With Appropriate Diagnosis".org)
		and not	exists( "More than One Antipsychotic Order".org )	
	)
	or (    "Denominator".all Encounter
	        and exists( ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0033"] P
    					where P.start_date during "Measurement Period"	)
	        and not exists( ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0032"] P2
    					where P2.start_date during "Measurement Period"	)   )
  ,
  if exists(  ["Clinical Activity": "MIPS; 238_PERFORMANCE_NOT_MET_G0033"] P
              where P.start_date during "Measurement Period"  ) QualityCode
  return
  ExtendedMeasureResultV2(
      QualityCode
      , 'Performance Not Met Quality Code' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0033
  )
  else if exists ( "More than One Benzodiazepine Order".org ) BenzoOrder
  return
  ExtendedMeasureResultV2(
      BenzoOrder.med1
      , 'Benzodiazepine Order 1' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0033
  )
  ,
  ExtendedMeasureResultV2(
      BenzoOrder.med2
      , 'Benzodiazepine Order 2' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Not Met
      , option_id = G0033
  )

define "More than One Benzodiazepine With Appropriate Diagnosis"org:
    exists "More than One Benzodiazepine Order".org
    and exists  "Seizure, REM, Sleep Disorder, Withdrawal, GAD on or between Jan 1 year prior to MY up to IPSD"

define "More than One Benzodiazepine Order".org:
    exists "More Than One of Same Medication Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"])

define "More than One Antipsychotic Order".org:
    exists "More Than One of Same Medication Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC"])
*/
rule 'Year2026.Mips238Rate2.Gap.G0033.org'
when
    $program: Program()
    $patient: Patient()
    exists (EncounterDenominator(measure == 'Year2026.Mips238Rate2'))
    and exists (
        (
            //exists ("More than One POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC With Appropriate Diagnosis".org)
            exists queryYear2026Mips238SharedMedicationMoreThanOneOrg($program, "AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
            //"Seizure, REM, Sleep Disorder, Withdrawal, GAD on or between Jan 1 year prior to MY up to IPSD"
            and exists Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGAD()
            and not (
                //"More than One POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC Order".org
                exists queryYear2026Mips238SharedMedicationMoreThanOneOrg($program, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed3, $pairMed4;)
            )
        )
        or (
            exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0033"),
                startsDuring($program.measurementPeriod)
            )
            and not (exists ClinicalActivity(
                withValueSet("MipsYear2026", "238_PERFORMANCE_NOT_MET_G0032"),
                startsDuring($program.measurementPeriod)
            ))
        )
    )  
then
    controlSet.addPatientMeasureStatus($program, $patient, 'Year2026.Mips238Rate2', MeasureStatusValue.GAP, "G0033");
end

