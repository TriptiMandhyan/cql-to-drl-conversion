        !Collections.disjoint(groupExternalIds, $encounter.groupExternalIds)
    )
    or (
        //exists "More than One POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC Order".group
