define "More than One Benzodiazepine Order".org:
    exists "More Than One of Same Medication Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"])

define "More than One Antipsychotic Order".org:
    exists "More Than One of Same Medication Order".org(["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC"])
*/
rule 'Year2026.Mips238Rate2.Success.G9367.org'
when
    $program: Program()
    $patient: Patient()
    exists (EncounterDenominator(measure == 'Year2026.Mips238Rate2'))
    and exists (
	    ClinicalActivity(
            withValueSet("MipsYear2026", "238_PERFORMANCE_MET_G9367"),
            startsDuring($program.measurementPeriod)
        )
        or (
            //exists "More than One POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC Order".org
            exists queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
            and not(
                //and not exists "Seizure, REM, Sleep Disorder, Withdrawal, GAD on or between Jan 1 year prior to MY up to IPSD"
                exists Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGAD()
            )
        )
        or (
            //exists "More than One POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC Order".org
            exists queryYear2026Mips238SharedMedicationMoreThanOneOrg($program,"AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
            and not(
                //and not exists "Schizophrenia or Bipolar on or between Jan 1 year prior to MY up to IPSD"
                exists Year2026Mips238Rate2SchizophreniaOrBipolar()
            ) 
        )
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, 'Year2026.Mips238Rate2', MeasureStatusValue.SUCCESS, "G9367");
end

