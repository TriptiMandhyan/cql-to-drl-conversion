/*
define "Schizophrenia or Bipolar on or between Jan 1 year prior to MY up to IPSD"
    (   ["Diagnosis": "MIPS; 238_SCHIZOPHRENIA"]
        union ["Diagnosis": "VSAC; SCHIZOPHRENIA_OR_PSYCHOTIC_DISORDER"]
        union ["Diagnosis": "VSAC; BIPOLAR_DISORDER"]   ) Disorder
    with (  (   "First Antipsychotic Medication Ordered"    ) Rx    )
    such that Disorder.start_date during Interval [start of "Measurement Period" - 1 year, Rx.start_date]
 ,
 if exists ( "Schizophrenia or Bipolar on or between Jan 1 year prior to MY up to IPSD" ) Diagnosis
    return
    ExtendedMeasureResultV2(
        Diagnosis
        , 'Schizophrenia or Bipolar Diagnosis' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all
    )

define "First Antipsychotic Medication Ordered":
    first(  ["Medication": "ABLE; POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC"] AntipsychoticMedication
            where AntipsychoticMedication.start_date during "Measurement Period"    )   sort by AntipsychoticMedication.start_date asc
    return AntipsychoticMedication.start_date
*/
rule 'Year2026.Mips238Rate2.SchizophreniaOrBipolar'
salience 20
when
    exists (EncounterDenominator(measure == 'Year2026.Mips238Rate2'))
    $program: Program()
    //define "First POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC Medication Ordered"
    $firstMed: Medication() from accumulate (
        $med: Medication(
            withValueSet("AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC"),
            startsDuring($program.measurementPeriod)
        ),
        earliestMedication($med)
    )
    and exists Diagnosis(
        withValueSet("MipsYear2026", "238_SCHIZOPHRENIA") ||
        withValueSet("VsacYear2026", "SCHIZOPHRENIA_OR_PSYCHOTIC_DISORDER") ||
        withValueSet("VsacYear2026", "BIPOLAR_DISORDER"),
        startsDuring($program.measurementPeriod.start.minusYears(1), $firstMed.startDate)
    )
then
    insert(new Year2026Mips238Rate2SchizophreniaOrBipolar());
end

rule 'Year2026.Mips238Rate2.SchizophreniaOrBipolar.Org.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    exists Year2026Mips238Rate2SchizophreniaOrBipolar()
    $firstMed: Medication() from accumulate (
        $med: Medication(
            withValueSet("AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC"),
            startsDuring($program.measurementPeriod)
        ),
        earliestMedication($med)
    )
    $diagnosis: Diagnosis(
        withValueSet("MipsYear2026", "238_SCHIZOPHRENIA") ||
        withValueSet("VsacYear2026", "SCHIZOPHRENIA_OR_PSYCHOTIC_DISORDER") ||
        withValueSet("VsacYear2026", "BIPOLAR_DISORDER"),
        startsDuring($program.measurementPeriod.start.minusYears(1), $firstMed.startDate)
    )
    and not (exists Year2026Mips238Rate2SchizophreniaOrBipolarOrgEMR())
then
    insert(new Year2026Mips238Rate2SchizophreniaOrBipolarOrgEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Schizophrenia or Bipolar Diagnosis", "G9367", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Schizophrenia or Bipolar Diagnosis", "G0032", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Schizophrenia or Bipolar Diagnosis", "G9368", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
