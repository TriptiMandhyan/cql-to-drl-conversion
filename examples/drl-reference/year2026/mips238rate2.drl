    $firstMed: Medication() from accumulate (
        $med: Medication(
            withValueSet("AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC"),
            startsDuring($program.measurementPeriod)
        ),
        earliestMedication($med)
    )
    $diagnosis: Diagnosis(
        withValueSet("VsacYear2026", "SEIZURE_DISORDER") ||
        withValueSet("VsacYear2026", "REM_SLEEP_BEHAVIOR_DISORDER") ||
        withValueSet("VsacYear2026", "BENZODIAZEPINE_WITHDRAWAL") ||
        withValueSet("VsacYear2026", "ALCOHOL_WITHDRAWAL") ||
        withValueSet("VsacYear2026", "GENERALIZED_ANXIETY_DISORDER"),
        startsDuring($program.measurementPeriod.start.minusYears(1), $firstMed.startDate)
    )
    and not (exists Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGADProviderEMR())
then
    insert(new Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGADProviderEMR());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Seizure, REM, Sleep Disorder, Withdrawal, or GAD Diagnosis", "G9367", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Seizure, REM, Sleep Disorder, Withdrawal, or GAD Diagnosis", "G0033", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Seizure, REM, Sleep Disorder, Withdrawal, or GAD Diagnosis", "G9368", PopulationEnum.denominator, $diagnosis, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $diagnosis.startDate.toString());
end

