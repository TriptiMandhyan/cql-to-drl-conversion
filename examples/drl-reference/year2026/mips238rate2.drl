/*
define "Denominator Exclusion G9741 Hospice":
   *
   * Option ID: G9741
   *
   "Denominator".all
 	and exists(sharedHospice."Has Hospice") HospiceEvidence
  ,
  if exists "Denominator Exclusion G9741 Hospice" return
  ExtendedMeasureResultV2(
      HospiceEvidence
      , 'Evidence of Hospice' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = G9741
  )
*/
rule 'Year2026.Mips238Rate2.Exclusion.Hospice'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    exists queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $hospice;)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "G9741");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "G9741");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "G9741");
end

rule 'Year2026.Mips238Rate2.Exclusion.Hospice.Org.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    $hospice: QdmDatatype() from accumulate (
        queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $result;),
        latestQdmDataType($result)
    )
    and not (
        exists Year2026Mips238Rate2ExclusionHospiceOrgEMR()
    )
then
    insert (new Year2026Mips238Rate2ExclusionHospiceOrgEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Hospice", "G9741", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

rule 'Year2026.Mips238Rate2.Exclusion.Hospice.Group.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    $hospice: QdmDatatype() from accumulate (
        queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $result;),
        latestQdmDataType($result)
    )
    $groupId: String() from $encounter.groupExternalIds
    and not (
        exists Year2026Mips238Rate2ExclusionHospiceGroupEMR(groupId == $groupId)
    )
then
    insert (new Year2026Mips238Rate2ExclusionHospiceGroupEMR($groupId));
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Evidence of Hospice", "G9741", PopulationEnum.denominator_exclusion, $hospice, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hospice.startDate.toString());
end

