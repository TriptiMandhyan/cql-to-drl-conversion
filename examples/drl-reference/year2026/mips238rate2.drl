/*
define "Numerator Performance Not Met G9368".org:
    * Option ID: G9368 *
    "Denominator".all
    and not exists "Denominator Exclusion G9741 Hospice"
    and not exists "Denominator Exclusion G0034 Palliative Care"
    and not exists "Numerator Performance Met G9367"
    and not exists "Numerator Performance Not Met G0032".org
    and not exists "Numerator Performance Not Met G0033".org    
    and not exists "Numerator Performance Not Met G0032 and G0033".org

Note: Org, Group and Provider will share the same rule, since the EncounterDenominator is for all. Group/Provider 
statuses will be updated in their rules.
*/
rule 'Year2026.Mips238Rate2.Gap.G9368.Default'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G9368");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G9368");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "G9368");
end

rule 'Year2026.Mips238Rate2.Gap.G9368.Default.Org.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    and not (
        exists Year2026Mips238Rate2GapG9368OrgEMR()
    )
then
    insert (new Year2026Mips238Rate2GapG9368OrgEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "No Documented Evidence of Performance Met or Performance Not Met", "G9368", PopulationEnum.numerator_performance_not_met, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
end

rule 'Year2026.Mips238Rate2.Gap.G9368.Default.Group.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    $groupId: String() from $encounter.groupExternalIds
    and not (
        exists Year2026Mips238Rate2GapG9368GroupEMR(groupId == $groupId)
    )
then
    insert (new Year2026Mips238Rate2GapG9368GroupEMR($groupId));
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "No Documented Evidence of Performance Met or Performance Not Met", "G9368", PopulationEnum.numerator_performance_not_met, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
end

rule 'Year2026.Mips238Rate2.Gap.G9368.Default.Provider.EMR'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure:measure == 'Year2026.Mips238Rate2')
    $patient: Patient()
    and not (
        exists Year2026Mips238Rate2GapG9368ProviderEMR()
    )
then
    insert (new Year2026Mips238Rate2GapG9368ProviderEMR());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "No Documented Evidence of Performance Met or Performance Not Met", "G9368", PopulationEnum.numerator_performance_not_met, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
end