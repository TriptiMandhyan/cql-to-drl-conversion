    or (
        //exists "More than One POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC Order".provider
        exists queryYear2026Mips238SharedMedicationMoreThanOneProvider($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_BENZODIAZEPINES_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
        and not(
            //and not exists "Seizure, REM, Sleep Disorder, Withdrawal, GAD on or between Jan 1 year prior to MY up to IPSD"
            exists Year2026Mips238Rate2SeizureREMSleepDisorderWithdrawalGAD()
        )
    )
    or (
        //exists "More than One POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC Order".provider
        exists queryYear2026Mips238SharedMedicationMoreThanOneProvider($program, $encounter, "AbleYear2026", "POTENTIALLY_HARMFUL_ANTIPSYCHOTICS_FOR_OLDER_ADULTS_MAP_NDC", $pairMed1, $pairMed2;)
        and not(
            //and not exists "Schizophrenia or Bipolar on or between Jan 1 year prior to MY up to IPSD"
            exists Year2026Mips238Rate2SchizophreniaOrBipolar()
        ) 
    ) 
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "G9367");
end

