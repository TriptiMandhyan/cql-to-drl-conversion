rule 'Year2026.Mips370Rate2.Exclusion.hospice_palliative_care.Provider.EMR'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips370Rate2", type == EncounterDenominatorType.PROVIDER)
    $patient: Patient()
    $record: QdmDatatype() from accumulate (
        queryMips370Shared2026HospiceOrPalliativeCare($program, $encounter, $result;),
        latestQdmDataType($result)
    )
    and not (
        exists Year2026Mips370Rate2ExclusionM1450ProviderEMR()
    )
then
    insert (new Year2026Mips370Rate2ExclusionM1450ProviderEMR());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Hospice or Palliative Care", "M1450", PopulationEnum.denominator_exclusion, $record, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $record.startDate.toString());
end

/*
define "PHQ-9 Clinical".org:
  Last ((["Clinical Activity": "VSAC; PHQ_9_AND_PHQ_9M_TOOLS"]) PHQ9
          where PHQ9 during "Followup Assessment Period".org)
      sort by PHQ9.start_date asc

define "Followup Assessment Period".org:
  ("Earliest Index Visit".org) Index
  return Interval[Index.start_date + 12 months - 60 days, Index.start_date + 12 months + 60 days]
*/
rule 'Year2026.Mips370Rate2.PHQ9Clinical'
salience 10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == 'Year2026.Mips370Rate2')
    $latestRecord: ClinicalActivity() from accumulate (
        $c: ClinicalActivity(
            withValueSet("VsacYear2026", "PHQ_9_AND_PHQ_9M_TOOLS"),
            startsDuring($encounter.startDate.plusMonths(12).minusDays(60), $encounter.startDate.plusMonths(12).plusDays(60))
        ),
        lastClinicalActivity($c)
    )
then
    insert(new Year2026Mips370Rate2PHQ9Clinical($encounter, $latestRecord));
end

/*
define "Numerator Performance Met G9509".org:
   *
   * Option ID: G9509
   *
  ( "Depression Remission by Result".org
        union "Depression Remission by Quality Code".org)
   and exists("Denominator".org) 
   ,
   if exists( "Depression Remission by Result".org)
   then from ("Depression Remission by Result".org) PHQ<5org
   return
   ExtendedMeasureResultV2(
        last(PHQ<5org)sort by start_date asc//return the most recent record
        , 'Remission PHQ9' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = G9509
   ) 
   else from ("Depression Remission by Quality Code".org) QCorg
   return 
    ExtendedMeasureResultV2(
          QCorg //return 1 record even if multiple exist
          , 'Remission Indicated by Quality Code' as name
          , display_date = start_date
          , calculated_record = false
          , population = Numerator Performance Met
          , option_id = G9509
    )

define "Depression Remission by Result".org
  ("PHQ-9 Clinical".org) PHQ9
        where PHQ9.result < 5

define "Followup Assessment Period".org:
  ("Earliest Index Visit".org) Index
  return Interval[Index.start_date + 12 months - 60 days, Index.start_date + 12 months + 60 days]
*/
rule 'Year2026.Mips370Rate2.Success.DepressionRemissionByResult.G9509.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips370Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    Year2026Mips370Rate2PHQ9Clinical(encounter == $encounter, $phq9: phq9, phq9.resultAsDecimal < 5)
    and not (
        exists Year2026Mips370Rate2SuccessDepressionRemissionByResultG9509Org()
    )
then
    insert (new Year2026Mips370Rate2SuccessDepressionRemissionByResultG9509Org());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "G9509");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Remission PHQ9", "G9509", PopulationEnum.numerator_performance_met, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    
end

/*
define "Depression Remission by Quality Code".org
   ("PHQ-9 < 5 Quality Code") PMQualityCode
                  and not exists (("PHQ-9 Clinical".org) PHQ9
                      where (PHQ9.result >= 5 
                            and PHQ9. start_date after PMQualityCode.start_date))
                  and not exists ("PHQ-9 >= 5 Quality Code" PNMQualityCode
                      where PNMQualityCode.start_date after PMQualityCode.start_date)

define "PHQ-9 < 5 Quality Code":
   ["Clinical Activity": "MIPS; 370_PERFORMANCE_MET_G9509"] PMQualityCode
      where PMQualityCode during "Measurement Period"

define "PHQ-9 >= 5 Quality Code":
  ["Clinical Activity": "MIPS; 370_PERFORMANCE_NOT_MET_G9510"] PNMQualityCode 
      where PNMQualityCode during "Measurement Period"
*/
query queryYear2026Mips370Rate2DepressionRemissionByQualityCode(Program $program, ClinicalActivity $encounter, ClinicalActivity $pMQualityCode)
    //define "PHQ-9 < 5 Quality Code"
    $pMQualityCode:= ClinicalActivity(
        withValueSet("MipsYear2026", "370_PERFORMANCE_MET_G9509"),
        startsDuring($program.measurementPeriod)
    )
    and not(
        //define "PHQ-9 Clinical"
        exists Year2026Mips370Rate2PHQ9Clinical(
            encounter == $encounter, 
            phq9.resultAsDecimal >= 5, 
            phq9.startsAfter($pMQualityCode.startDate)
        )
    )
    and not(
        //define "PHQ-9 >= 5 Quality Code"
        exists ClinicalActivity(
            withValueSet("MipsYear2026", "370_PERFORMANCE_NOT_MET_G9510"),
            startsDuring($program.measurementPeriod),
            startsAfter($pMQualityCode.startDate)
        )
    )
end

rule 'Year2026.Mips370Rate2.Success.DepressionRemissionByQualityCode.G9509.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips370Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $record: QdmDatatype() from accumulate (
        queryYear2026Mips370Rate2DepressionRemissionByQualityCode($program, $encounter, $result;),
        latestQdmDataType($result)
    )
    and not(
        exists Year2026Mips370Rate2SuccessDepressionRemissionByQualityCodeG9509Org()
    )
then
    insert (new Year2026Mips370Rate2SuccessDepressionRemissionByQualityCodeG9509Org());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "G9509");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Remission Indicated by Quality Code", "G9509", PopulationEnum.numerator_performance_met, $record, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $record.startDate.toString()); 
end

/*
define "Numerator Performance Met G9509".group:
   *
   * Option ID: G9509
   *
  ( "Depression Remission by Result".group
        union "Depression Remission by Quality Code".group) 
   and exists("Denominator".group) 
   ,
   if exists( "Depression Remission by Result".group)
   then from ( "Depression Remission by Result".group) PHQ<5group
   return
   ExtendedMeasureResultV2(
        last(PHQ<5group)sort by start_date asc//return the most recent record
        , 'Remission PHQ9' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = G9509
   ) 
   else if exists ("Depression Remission by Quality Code".group QCGroup
                    with"Denominator".group DenominatorGroup
                    such that DenominatorGroup.group_id = QCGroup.group_id)
   then from ("Depression Remission by Quality Code".group) QCgroup
   return 
    ExtendedMeasureResultV2(
          QCGroup //return 1 record even if multiple exist
          , 'Remission Indicated by Quality Code' as name
          , display_date = start_date
          , calculated_record = false
          , population = Numerator Performance Met
          , option_id = G9509
    )
*/
rule 'Year2026.Mips370Rate2.Success.DepressionRemissionByResult.G9509.Group'
when
    Year2026Mips370Rate2EncounterGroupDenominator($program: program, $encounter: index, $groupId: groupId, $measure: measure, measure == "Year2026.Mips370Rate2")
    $patient: Patient()
    Year2026Mips370Rate2PHQ9Clinical(encounter == $encounter, $phq9: phq9, phq9.resultAsDecimal < 5)
    and not (
        exists Year2026Mips370Rate2SuccessDepressionRemissionByResultG9509Group($groupId == groupId)
    )
then
    insert (new Year2026Mips370Rate2SuccessDepressionRemissionByResultG9509Group($groupId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.SUCCESS, "G9509");
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Remission PHQ9", "G9509", PopulationEnum.numerator_performance_met, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString()); 
end

