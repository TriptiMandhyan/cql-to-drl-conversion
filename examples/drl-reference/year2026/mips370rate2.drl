/*
define "Numerator Performance Not Met G9510".org:
   *
   * Option ID: G9510
   *
  not "Exclusion Required Bipolar Disorder".org
  and not "Exclusion Required Personality Disorder".org
  and not "Exclusion Required Schizophrenia".org
  and not "Exclusion Required Pervasive Developmental Disorder".org
  and not "Exclusion Required Death".org
  and not "Exclusion Hospice or Palliative Care".org
  and not "Numerator Performance Met G9509".org
*/
rule 'Year2026.Mips370Rate2.Gap.G9510.Org'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips370Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G9510");
end

rule 'Year2026.Mips370Rate2.Gap.G9510.Group'
salience -10
when
    Year2026Mips370Rate2EncounterGroupDenominator($program: program, $encounter: index, $groupId: groupId, $measure: measure, measure == "Year2026.Mips370Rate2")
    $patient: Patient()
then
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.GAP, "G9510");
