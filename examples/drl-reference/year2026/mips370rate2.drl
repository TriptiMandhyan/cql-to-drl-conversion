rule 'Year2026.Mips370Rate2.Denominator.Group'
salience 5
when
    $program: Program(rules contains 'measure.Mips.2026.Mips370Rate2')
    $patient: Patient()
    Year2026Mips370Rate2IndexVisitGroup(
        $index: index, 
        $groupId: groupId,
        $patient.getAgeInYearsAt($index.startDate) >= 18
    )
then
    insert(new Year2026Mips370Rate2EncounterGroupDenominator($program, $index, "Year2026.Mips370Rate2", $groupId)); 
end

rule 'Year2026.Mips370Rate2.Denominator.EMR.Group'
salience -10
when
    Year2026Mips370Rate2EncounterGroupDenominator($program: program, $encounter: index, $groupId: groupId, $measure: measure, measure == "Year2026.Mips370Rate2")
    $patient: Patient()
    and Year2026Mips370Rate2IndexVisitGroup(
        $phq9: phq9,
        index == $encounter
    )
    $d: Diagnosis() from accumulate (
        $result:= Diagnosis(
            withValueSet("MipsYear2026", "370_DEPRESSION_OR_DYSTHMIA"),
            overlaps($encounter)
        ),
        latestDiagnosis($result)
    )
    and not (
        exists Year2026Mips370Rate2DenominatorEMRGroup(
             $encounter == encounter,
             $groupId == groupId
        )
    )
then
    insert (new Year2026Mips370Rate2DenominatorEMRGroup($encounter, $groupId));
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter", "M1447", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter", "M1448", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter", "M1449", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter", "M1451", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter", "M1446", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter", "M1450", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter", "G9509", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter", "G9510", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Index PHQ-9", "M1447", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Index PHQ-9", "M1448", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Index PHQ-9", "M1449", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Index PHQ-9", "M1451", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Index PHQ-9", "M1446", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Index PHQ-9", "M1450", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Index PHQ-9", "G9509", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Index PHQ-9", "G9510", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Depression or Dysthymia Diagnosis", "M1447", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Depression or Dysthymia Diagnosis", "M1448", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Depression or Dysthymia Diagnosis", "M1449", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Depression or Dysthymia Diagnosis", "M1451", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Depression or Dysthymia Diagnosis", "M1446", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Depression or Dysthymia Diagnosis", "M1450", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Depression or Dysthymia Diagnosis", "G9509", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Depression or Dysthymia Diagnosis", "G9510", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
