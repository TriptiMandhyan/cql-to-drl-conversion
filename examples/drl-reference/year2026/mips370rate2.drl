/*
define "Exclusion Required Bipolar Disorder".org:
  * Option ID: M1447 *
  exists( ["Diagnosis": "MIPS; 370_BIPOLAR_DISORDER"] D
                where D.start_date before end of "Measure Assessment Period".org 
          union ["Clinical Activity": "MIPS; 370_DENOMINATOR_EXCLUSION_M1447_BIPOLAR"] QC
                where QC.start_date during "Measurement Period" ) BipolarExclOrg
    and exists("Denominator".org)  
    ,  
    ExtendedMeasureResultV2(
        BipolarExclOrg//return 1 record even if multiple exist
        , 'Bipolar Disorder' as name
        , display_date = start_date
        , calculated_record = false
        , population = Exclusion
        , option_id = M1447
    )
          
define "Measure Assessment Period".org:
  ("Earliest Index Visit".org) Index
  return Interval[Index.start_date, Index.start_date + 14 months]  
*/
rule 'Year2026.Mips370Rate2.Exclusion.M1447.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips370Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    and exists queryYear2026Mips370SharedExclusionBipolar($program, $encounter, $result;)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1447");
end

rule 'Year2026.Mips370Rate2.Exclusion.M1447.Org.EMR'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips370Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $record: QdmDatatype() from accumulate (
        queryYear2026Mips370SharedExclusionBipolar($program, $encounter, $result;),
        latestQdmDataType($result)
    )
    and not (
        exists Year2026Mips370Rate2ExclusionM1447OrgEMR()
    )
then
    insert (new Year2026Mips370Rate2ExclusionM1447OrgEMR());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Bipolar Disorder", "M1447", PopulationEnum.denominator_exclusion, $record, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $record.startDate.toString());
end

