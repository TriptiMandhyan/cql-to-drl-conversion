/*
define "Denominator".provider
  (( "Earliest Index Visit".provider) Encounter
      and AgeInYearsAt(Encounter.start_date) >= 18) EncounterProvider
 ,
 if exists("Denominator".provider)
 (from "Denominator".provider
 return
 ,
 ExtendedMeasureResultV2(
    EncounterProvider //return 1 record even if multiple exist
    , 'Denominator Encounter' as name
    , display_date = start_date
    , calculated_record = false
    , population = Denominator
    , option_id = all
 )
 and from ("PHQ-9 >9" PHQ9
            with ("Denominator".provider) EncounterProvider
            such that "PHQ-9 >9".start_date during Interval[EncounterProvider.start_date - 7 days, EncounterProvider.start_date])IndexPHQ9
  return
  , 
  ExtendedMeasureResultV2(
      IndexPHQ9
      , 'Index PHQ-9' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator
      , option_id = all
  )
  and from( ["Diagnosis": "MIPS; 370_DEPRESSION_OR_DYSTHMIA"] Diagnosis
            with ("Denominator".provider) EncounterProvider
            such that Interval[Diagnosis.start_date, Diagnosis.stop_date] overlaps Interval[EncounterProvider.start_date, EncounterProvider.stop_date] ) EncounterDepressionDiagnosisProvider
  return
  ,
  ExtendedMeasureResultV2(
      EncounterDepressionDiagnosisProvider//return 1 record even if multiple exist
      , 'Depression or Dysthymia Diagnosis' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator
      , option_id = all
  )
)  
*/
rule 'Year2026.Mips370Rate2.Denominator.Provider'
salience 5
when
    $program: Program(rules contains 'measure.Mips.2026.Mips370Rate2')
    $patient: Patient()
    Year2026Mips370Rate2EarliestIndexVisitProvider(
        $phq9: phq9,
        $index: index, 
        $patient.getAgeInYearsAt($index.startDate) >= 18 
    )
then
    insert(new EncounterDenominator($program, $index, "Year2026.Mips370Rate2", EncounterDenominatorType.PROVIDER)); 
end

rule 'Year2026.Mips370Rate2.Denominator.EMR.Provider'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips370Rate2", type == EncounterDenominatorType.PROVIDER)
    $patient: Patient()
    and Year2026Mips370Rate2EarliestIndexVisitProvider(
        $phq9: phq9,
        index == $encounter
    )
    and $d: Diagnosis() from accumulate (
        $result:= Diagnosis(
            withValueSet("MipsYear2026", "370_DEPRESSION_OR_DYSTHMIA"),
            overlaps($encounter)
        ),
        latestDiagnosis($result)
    )
    and not (
        exists Year2026Mips370Rate2DenominatorEMRProvider()
    )
then
    insert (new Year2026Mips370Rate2DenominatorEMRProvider());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter", "M1447", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter", "M1448", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter", "M1449", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter", "M1451", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter", "M1446", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter", "M1450", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter", "G9509", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter", "G9510", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Index PHQ-9", "M1447", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Index PHQ-9", "M1448", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Index PHQ-9", "M1449", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Index PHQ-9", "M1451", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Index PHQ-9", "M1446", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Index PHQ-9", "M1450", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Index PHQ-9", "G9509", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Index PHQ-9", "G9510", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Depression or Dysthymia Diagnosis", "M1447", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Depression or Dysthymia Diagnosis", "M1448", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Depression or Dysthymia Diagnosis", "M1449", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Depression or Dysthymia Diagnosis", "M1451", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Depression or Dysthymia Diagnosis", "M1446", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Depression or Dysthymia Diagnosis", "M1450", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Depression or Dysthymia Diagnosis", "G9509", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Depression or Dysthymia Diagnosis", "G9510", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
