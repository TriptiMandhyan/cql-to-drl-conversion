declare Year2026Mips370Rate2EncounterGroupDenominator
    program: Program
    index: ClinicalActivity
    measure: String
    groupId: String
end
/*
define "Index Visit Result":
   "Denominator Encounter" E
      with "PHQ-9 > 9" A
      such that A.start_date during Interval [E.start_date - 7 days, E.start_date]

define "Denominator Encounter":
  ["Clinical Activity": "MIPS; 370_RATE2_ENCOUNTER"] Encounter
    where Encounter.start_date during "Index Period"
      and Encounter.provider_id.hasMeasureMembership = true
    with ["Diagnosis": "MIPS; 370_DEPRESSION_OR_DYSTHMIA"] D
      such that Interval[D.start_date, D.stop_date] overlaps Interval[Encounter.start_date, Encounter.stop_date]
      
define "PHQ-9 > 9":
  ( ["Clinical Activity": "VSAC; PHQ_9_AND_PHQ_9M_TOOLS"] A
          where ( A.start_date starts during "Index Period"
                  and A.result > 9  )
          )

define "Index Period":
  Interval[start of "Measurement Period" - 14 months, end of "Measurement Period" - 14 months]
*/
rule 'Year2026.Mips370Rate2.IndexVisitResult'
salience 50
when
    $program: Program(rules contains 'measure.Mips.2026.Mips370Rate2')
    $encounter:= ClinicalActivity(
        withValueSet("MipsYear2026", "370_RATE2_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start.minusMonths(14), $program.measurementPeriod.end.minusMonths(14))
    )
    and exists Diagnosis(
        withValueSet("MipsYear2026", "370_DEPRESSION_OR_DYSTHMIA"),
        overlaps($encounter)
    )
    and $phq9: ClinicalActivity(
        withValueSet("VsacYear2026", "PHQ_9_AND_PHQ_9M_TOOLS"),
        startsDuring($program.measurementPeriod.start.minusMonths(14), $program.measurementPeriod.end.minusMonths(14)),
        resultAsDecimal > 9,
        startsDuring($encounter.startDate.minusDays(7), $encounter.startDate)
    )
then
    insert(new Year2026Mips370Rate2IndexVisit($encounter, $phq9));
end

/*
define "Index Visit Quality Code"
  "Denominator Encounter" E
    with ["Clinical Activity": "MIPS; 370_PHQ_9_9_DURING_IDENTIFICATION_PERIOD"] P
    such that P.start_date = E.start_date 
    
define "Denominator Encounter":
  ["Clinical Activity": "MIPS; 370_RATE2_ENCOUNTER"] Encounter
    where Encounter.start_date during "Index Period"
      and Encounter.provider_id.hasMeasureMembership = true
    with ["Diagnosis": "MIPS; 370_DEPRESSION_OR_DYSTHMIA"] D
      such that Interval[D.start_date, D.stop_date] overlaps Interval[Encounter.start_date, Encounter.stop_date]
      
define "Index Period":
  Interval[start of "Measurement Period" - 14 months, end of "Measurement Period" - 14 months]
*/
rule 'Year2026.Mips370Rate2.IndexVisitQualityCode'
salience 50
when
    $program: Program(rules contains 'measure.Mips.2026.Mips370Rate2')
    $encounter:= ClinicalActivity(
        withValueSet("MipsYear2026", "370_RATE2_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start.minusMonths(14), $program.measurementPeriod.end.minusMonths(14))
    )
    and exists Diagnosis(
        withValueSet("MipsYear2026","370_DEPRESSION_OR_DYSTHMIA"),
        overlaps($encounter)
    )
    and $phq9: ClinicalActivity(
        withValueSet("MipsYear2026", "370_PHQ_9_9_DURING_IDENTIFICATION_PERIOD"),
        $encounter.startDate == startDate
    )
then
    insert(new Year2026Mips370Rate2IndexVisit($encounter, $phq9));
end

/*
define "Earliest Index Visit".org
  First (("Index Visit Result"
          union "Index Visit Quality Code") Encounter
    )sort by Encounter.start_date asc
*/
rule 'Year2026.Mips370Rate2.EarliestIndexVisit.Org'
salience 10
when
    $program: Program(rules contains 'measure.Mips.2026.Mips370Rate2')
    Year2026Mips370Rate2IndexVisit(
        $index: index,
        $phq9: phq9
    )
    and not (
        exists Year2026Mips370Rate2IndexVisit(index.startDate.isBefore($index.startDate))
    )
then
    insert(new Year2026Mips370Rate2EarliestIndexVisitOrg($index, $phq9));
end

/*
define "Earliest Index Visit".group  
  First ((("Index Visit Result" E1
          union "Index Visit Quality Code" E2)
          where  E1.group_id = E2.group_id) EncounterGroup
    )sort by EncounterGroup.start_date asc
*/
rule 'Year2026.Mips370Rate2.IndexVisit.SplitByGroup.Part1'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips370Rate2')
    $indexVisits : java.util.List(size>0) from accumulate(
        $v: Year2026Mips370Rate2IndexVisit(
            index.isPresent(index.groupExternalIds)
        ),
        collectList($v)
    )
then
    java.util.List<Year2026Mips370Rate2IndexVisit> visits =
        $indexVisits.stream()
            .map(o -> (Year2026Mips370Rate2IndexVisit) o)
            .toList();
            
    for (Year2026Mips370Rate2IndexVisit visit : visits) {
        for (String groupExternalId : visit.getIndex().groupExternalIds) {
            insert(new Year2026Mips370Rate2IndexVisitByGroup(visit.getIndex(), visit.getPhq9(), groupExternalId));
        }
    }
end

rule 'Year2026.Mips370Rate2.IndexVisit.Group.Part2'
salience 10
when
    $program: Program(rules contains 'measure.Mips.2026.Mips370Rate2')
    Year2026Mips370Rate2IndexVisitByGroup(
        $index: index,
        $phq9: phq9,
        $gid : groupId
    )
    and not (
        exists Year2026Mips370Rate2IndexVisitByGroup(
            groupId == $gid,
            index.startDate < $index.startDate
        )
    )
    and not (
        exists Year2026Mips370Rate2IndexVisitGroup(
            groupId == $gid
        )
    )
then
    insert(new Year2026Mips370Rate2IndexVisitGroup($index, $phq9, $gid));
end

/*
define "Earliest Index Visit".provider  
  First ((("Index Visit Result" E1
          union "Index Visit Quality Code" E2)
          where  E1.provider_id = E2.provider_id) EncounterProvider
    )sort by EncounterProvider.start_date asc
*/
rule 'Year2026.Mips370Rate2.EarliestIndexVisit.Provider'
salience 10
when
    $program: Program(rules contains 'measure.Mips.2026.Mips370Rate2')
    Year2026Mips370Rate2IndexVisit(
        $index: index,
        $phq9: phq9,
        !Strings.isNullOrEmpty(index.providerExternalId)
    )
    and not (                                           
        exists Year2026Mips370Rate2IndexVisit(
            index.startDate.isBefore($index.startDate),
            $index.providerExternalId.equals(index.providerExternalId)
        )
    )
then
    insert(new Year2026Mips370Rate2EarliestIndexVisitProvider($index, $phq9));
end


/*
define "Denominator".org
  (( "Earliest Index Visit".org) Encounter
      and AgeInYearsAt(Encounter.start_date) >= 18) DenominatorEncounter
 ,
 if exists("Denominator".org)
 (from "Denominator".org
 return
 ,
 ExtendedMeasureResultV2(
    DenominatorEncounter //return 1 record even if multiple exist
    , 'Denominator Encounter' as name
    , display_date = start_date
    , calculated_record = false
    , population = Denominator
    , option_id = all
 )
 and from ("PHQ-9 >9" PHQ9
            with ("Denominator".org) Den
            such that "PHQ-9 >9".start_date during Interval[Den.start_date - 7 days, Den.start_date])IndexPHQ9
  return
  , 
  ExtendedMeasureResultV2(
      IndexPHQ9
      , 'Index PHQ-9' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator
      , option_id = all
  )
  and from( ["Diagnosis": "MIPS; 370_DEPRESSION_OR_DYSTHMIA"] Diagnosis
            with ("Denominator".org) Den
            such that Interval[Diagnosis.start_date, Diagnosis.stop_date] overlaps Interval[Den.start_date, Den.stop_date] ) EncounterDepressionDiagnosis
  return
  ,
  ExtendedMeasureResultV2(
      EncounterDepressionDiagnosis//return 1 record even if multiple exist
      , 'Depression or Dysthymia Diagnosis' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator
      , option_id = all
  )
)
*/
rule 'Year2026.Mips370Rate2.Denominator.Org'
salience 5
when
    $program: Program(rules contains 'measure.Mips.2026.Mips370Rate2')
    $patient: Patient()
    Year2026Mips370Rate2EarliestIndexVisitOrg(
        $phq9: phq9,
        $index: index,
        $patient.getAgeInYearsAt($index.startDate) >= 18
    )
then
    insert(new EncounterDenominator($program, $index, "Year2026.Mips370Rate2", EncounterDenominatorType.ORG)); 
end

rule 'Year2026.Mips370Rate2.Denominator.EMR.Org'
salience -10
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips370Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    and Year2026Mips370Rate2EarliestIndexVisitOrg(
        $phq9: phq9,
        index == $encounter
    )
    $d: Diagnosis() from accumulate (
        $result:= Diagnosis(
            withValueSet("MipsYear2026", "370_DEPRESSION_OR_DYSTHMIA"),
            overlaps($encounter)
        ),
        latestDiagnosis($result)
    )
    and not (
        exists Year2026Mips370Rate2DenominatorEMROrg()
    )
then
    insert (new Year2026Mips370Rate2DenominatorEMROrg());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "M1447", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "M1448", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "M1449", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "M1451", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "M1446", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "M1450", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G9509", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter", "G9510", PopulationEnum.denominator, $encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $encounter.startDate.toString());
    
    controlSet.addPatientEMR($program, $patient, $measure, "", "Index PHQ-9", "M1447", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Index PHQ-9", "M1448", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Index PHQ-9", "M1449", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Index PHQ-9", "M1451", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Index PHQ-9", "M1446", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Index PHQ-9", "M1450", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Index PHQ-9", "G9509", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Index PHQ-9", "G9510", PopulationEnum.denominator, $phq9, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $phq9.startDate.toString());
    
    controlSet.addPatientEMR($program, $patient, $measure, "", "Depression or Dysthymia Diagnosis", "M1447", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Depression or Dysthymia Diagnosis", "M1448", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Depression or Dysthymia Diagnosis", "M1449", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Depression or Dysthymia Diagnosis", "M1451", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Depression or Dysthymia Diagnosis", "M1446", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Depression or Dysthymia Diagnosis", "M1450", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Depression or Dysthymia Diagnosis", "G9509", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Depression or Dysthymia Diagnosis", "G9510", PopulationEnum.denominator, $d, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $d.startDate.toString());
end

