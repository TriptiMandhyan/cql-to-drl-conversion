/*
define "Exclusion Required Death".org:
 *
 * Option ID: M1446
 *
    exists((( ["Diagnosis": "ABLE; EXPIRED"] 
            union ["Clinical Activity": "ABLE; EXPIRED"])
                  where D.start_date before end of "Measure Assessment Period".org )
            union ["Clinical Activity": "MIPS; 370_DENOMINATOR_EXCLUSION_M1446_DECEASED"] QC
                  where QC.start_date during "Measurement Period" ) DeathExclOrg
      or Patient.deceased_datetime on or before end of "Measure Assessment Period".org
    and exists("Denominator".org)
    ,
    ExtendedMeasureResultV2(
        DeathExclOrg//return 1 record even if multiple exist
        , 'Evidence of Death' as name
        , display_date = start_date
        , calculated_record = false
        , population = Exclusion
        , option_id = M1446
    )

define "Measure Assessment Period".org:
  ("Earliest Index Visit".org) Index
  return Interval[Index.start_date, Index.start_date + 14 months] 
*/
rule 'Year2026.Mips370Rate2.Exclusion.M1446.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == "Year2026.Mips370Rate2", type == EncounterDenominatorType.ORG)
    $patient: Patient()
    eval ($patient.isDeceasedOnOrBefore($encounter.startDate.plusMonths(14)))
    or exists queryYear2026Mips370SharedExclusionDeath($program, $encounter, $result;)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1446");
end

