rule 'Year2026.Mips400Rate1.Denominator.Group.PreventiveEncounter'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate1')
    $groupEncounter: ClinicalActivity(
        withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        groupExternalIds != null
    )
    $patient: Patient(getAgeInYearsAt($groupEncounter.startDate) >= 18)
then
    insert(new EncounterDenominator($program, $groupEncounter, "Year2026.Mips400Rate1", EncounterDenominatorType.GROUP));
end

rule 'Year2026.Mips400Rate1.Denominator.Group.PreventiveEncounter.Marker'
salience 19
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate1')
    $groupEncounter: ClinicalActivity(
        withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        groupExternalIds != null
    )
    $groupId: String() from $groupEncounter.getGroupExternalIds()
    not (exists EncounterDenominatorGroup(groupId == $groupId))
then
    insert(new EncounterDenominatorGroup($groupId));
end

rule 'Year2026.Mips400Rate1.Denominator.Group.EncounterPair'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate1')
    $groupEncounter: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        groupExternalIds != null
    )
    $groupId: String() from $groupEncounter.getGroupExternalIds()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        $groupEncounter.startDate != startDate,
        groupExternalIds != null, groupExternalIds.contains($groupId)
    )
    not (exists EncounterDenominator(clinicalActivity == $groupEncounter, type == EncounterDenominatorType.GROUP, measure == "Year2026.Mips400Rate1"))
    $patient: Patient(getAgeInYearsAt($groupEncounter.startDate) >= 18)
then
    insert(new EncounterDenominator($program, $groupEncounter, "Year2026.Mips400Rate1", EncounterDenominatorType.GROUP));
end

rule 'Year2026.Mips400Rate1.Denominator.Group.EncounterPair.Marker'
salience 19
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate1')
    $enc1: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        groupExternalIds != null
    )
    $groupId: String() from $enc1.getGroupExternalIds()
    not (exists EncounterDenominatorGroup(groupId == $groupId))
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        startDate != $enc1.startDate,
        groupExternalIds != null, groupExternalIds.contains($groupId)
    )
then
    insert(new EncounterDenominatorGroup($groupId));
end

