        controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Encounter 2", optionId, PopulationEnum.denominator, $e2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e2.startDate.toString());
    }
end

/*
define "Denominator Exclusion-Hepatitis C":
Option ID: M1461 
  ((["Diagnosis": "MIPS; 400_DENOMINATOR_EXCLUSION_CHRONIC_HEPATITIS_C"]) HepCDx
    where Interval[HepCDx.start_date, HepCDx.stop_date] overlaps "Measurement Period"
   union ["Clinical Activity": "MIPS; 400_RATE1_DENOMINATOR_EXCLUSION_M1461"] HepCQC
    where HepCQC.start_date during "Measurement Period"
  and exists( "Denominator".org)
)HepCOrg
 ,
 return
  ExtendedMeasureResultV2(
        HepCOrg // return 1 record for each qualifying diagnosis or clinical activity, even if multiple records exist 
        , 'Evidence of Chronic Hepatitis C' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator Exclusion
        , option_id = M1461   
    )
*/
rule 'Year2026.Mips400Rate1.Exclusion.exclusion_hepatitisc.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not (exists Year2026Mips400Rate1ExclusionHepatitiscEMROrg())
    $hepC: QdmDatatype() from accumulate(
        queryYear2026Mips400Rate1ExclusionHepatitisc($program, $h;),
        latestQdmDatatype($h)
    )
then
    insert(new Year2026Mips400Rate1ExclusionHepatitiscEMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1461");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Chronic Hepatitis C", "M1461", PopulationEnum.denominator_exclusion, $hepC, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hepC.startDate.toString());
end

query queryYear2026Mips400Rate1ExclusionHepatitisc(Program $program, QdmDatatype $result)
    $result:= Diagnosis(
        withValueSet("MipsYear2026", "400_DENOMINATOR_EXCLUSION_CHRONIC_HEPATITIS_C"),
        overlaps($program.measurementPeriod)
    )
    or $result:= ClinicalActivity(
        withValueSet("MipsYear2026", "400_RATE1_DENOMINATOR_EXCLUSION_M1461"),
        startsDuring($program.measurementPeriod)
    )
end

/*
define "Denominator Exclusion-Hepatitis C".group:
Option ID: M1461 
  ((["Diagnosis": "MIPS; 400_DENOMINATOR_EXCLUSION_CHRONIC_HEPATITIS_C"]) HepCDx
    where Interval[HepCDx.start_date, HepCDx.stop_date] overlaps "Measurement Period"
   union ["Clinical Activity": "MIPS; 400_RATE1_DENOMINATOR_EXCLUSION_M1461"] HepCQC
    where HepCQC.start_date during "Measurement Period"
  and exists( "Denominator".group)
)HepCGroup
 ,
 return
  ExtendedMeasureResultV2(
        HepCGroup // return 1 record for each qualifying diagnosis or clinical activity, even if multiple records exist
        , 'Evidence of Chronic Hepatitis C' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator Exclusion
        , option_id = M1461   
    )
*/
rule 'Year2026.Mips400Rate1.Exclusion.exclusion_hepatitisc.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    exists EncounterDenominatorGroup(groupId == $groupId)
    not (exists Year2026Mips400Rate1ExclusionHepatitiscEMRGroup(groupId == $groupId))
    $hepC: QdmDatatype() from accumulate(
        queryYear2026Mips400Rate1ExclusionHepatitisc($program, $h;),
        latestQdmDatatype($h)
    )
then
    insert(new Year2026Mips400Rate1ExclusionHepatitiscEMRGroup($groupId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.EXCLUSION, "M1461");
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Evidence of Chronic Hepatitis C", "M1461", PopulationEnum.denominator_exclusion, $hepC, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hepC.startDate.toString());
end

/*
define "Denominator Exclusion-Hepatitis C".provider:
Option ID: M1461 
  ((["Diagnosis": "MIPS; 400_DENOMINATOR_EXCLUSION_CHRONIC_HEPATITIS_C"]) HepCDx
    where Interval[HepCDx.start_date, HepCDx.stop_date] overlaps "Measurement Period"
   union ["Clinical Activity": "MIPS; 400_RATE1_DENOMINATOR_EXCLUSION_M1461"] HepCQC
    where HepCQC.start_date during "Measurement Period"
  and exists( "Denominator".provider)
)HepCProvider
 ,
 return
  ExtendedMeasureResultV2(
        HepCProvider // return 1 record for each qualifying diagnosis or clinical activity, even if multiple records exist
        , 'Evidence of Chronic Hepatitis C' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator Exclusion
        , option_id = M1461   
    )
*/
rule 'Year2026.Mips400Rate1.Exclusion.exclusion_hepatitisc.Provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    not (exists Year2026Mips400Rate1ExclusionHepatitiscEMRProvider(providerId == $encounter.providerExternalId))
    $hepC: QdmDatatype() from accumulate(
        queryYear2026Mips400Rate1ExclusionHepatitisc($program, $h;),
        latestQdmDatatype($h)
    )
then
    insert(new Year2026Mips400Rate1ExclusionHepatitiscEMRProvider($encounter.providerExternalId));
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "M1461");
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Evidence of Chronic Hepatitis C", "M1461", PopulationEnum.denominator_exclusion, $hepC, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $hepC.startDate.toString());
end

/*
define "Denominator Exclusion-M1235".org:
Option ID: M1235 
   (( ["Clinical Activity": "MIPS; 400_DENOMINATOR_EXCLUSION_M1235"] M1235
            where M1235.start_date during "Measurement Period" 
    union ( "HCV Test" AnyTest
            where AnyTest.start_date starts before "Measurement Period" ) 
           )PrevTest
    and exists "Denominator".org) EvidenceOfPriorTesting
 ,
 return
  ExtendedMeasureResultV2(
        EvidenceOfPriorTesting // return 1 record for each qualifying clinical activity or test, even if multiple records exist
        , 'Evidence of Prior Hepatitis C Testing' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator Exclusion
        , option_id = M1235   
    )  

define "HCV Test":
  ["Laboratory Test Performed": "VSAC; HEPATITIS_C_VIRUS_INFECTION_COMBINATION_TESTS_THAT_INCLUDE_HEPATITIS_C_VIRUS_NUCLEIC_ACID"]
  union ["Laboratory Test Performed": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"]
  union ["Laboratory Test Performed": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIGEN"]
  union ["Laboratory Test Performed": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_NUCLEIC_ACID"]
  union ["Laboratory Test Performed": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"] 
  union ["Laboratory Test Performed": "ABLE; HEPATITIS_C_VIRAL_LOAD_TESTS_CPT"] 
  union ["Clinical Activity": "VSAC; HEPATITIS_C_VIRUS_INFECTION_COMBINATION_TESTS_THAT_INCLUDE_HEPATITIS_C_VIRUS_NUCLEIC_ACID"]
  union ["Clinical Activity": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"]
  union ["Clinical Activity": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIGEN"]
  union ["Clinical Activity": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_NUCLEIC_ACID"]
  union ["Clinical Activity": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"] 
  union ["Clinical Activity": "ABLE; HEPATITIS_C_VIRAL_LOAD_TESTS_CPT"] 
  union ["Clinical Activity": "MIPS; 400_RATE1_PERFORMANCE_MET_M1231"]
  union ["Clinical Activity": "MIPS; 400_RATE1_PERFORMANCE_MET_M1232"]
*/
rule 'Year2026.Mips400Rate1.Exclusion.M1235.Org'
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not (exists Year2026Mips400Rate1ExclusionM1235EMROrg())
    $priorTest: QdmDatatype() from accumulate(
        queryYear2026Mips400Rate1ExclusionM1235($program, $r;),
        latestQdmDatatype($r)
    )
then
    insert(new Year2026Mips400Rate1ExclusionM1235EMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1235");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Prior Hepatitis C Testing", "M1235", PopulationEnum.denominator_exclusion, $priorTest, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $priorTest.startDate.toString());
end

query queryYear2026Mips400Rate1ExclusionM1235(Program $program, QdmDatatype $result)
    $result:= ClinicalActivity(
            withValueSet("MipsYear2026", "400_DENOMINATOR_EXCLUSION_M1235"),
            startsDuring($program.measurementPeriod)
    )
    or $result:= LaboratoryTestPerformed(
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_COMBINATION_TESTS_THAT_INCLUDE_HEPATITIS_C_VIRUS_NUCLEIC_ACID") ||
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIGEN") ||
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_NUCLEIC_ACID") ||
        withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT") ||
        withValueSet("AbleYear2026", "HEPATITIS_C_VIRAL_LOAD_TESTS_CPT"),
        startsBefore($program.measurementPeriod.start)
    )
    or $result:= ClinicalActivity(
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_COMBINATION_TESTS_THAT_INCLUDE_HEPATITIS_C_VIRUS_NUCLEIC_ACID") ||
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIGEN") ||
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_NUCLEIC_ACID") ||
        withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT") ||
        withValueSet("AbleYear2026", "HEPATITIS_C_VIRAL_LOAD_TESTS_CPT") ||
        withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1231") ||
        withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1232"),
        startsBefore($program.measurementPeriod.start)
    )
end

