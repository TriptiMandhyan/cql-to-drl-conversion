/*
define "Numerator Performance Not Met-M1233".org:
Option ID: M1233
 "Denominator".org
 and not"Denominator Exclusion-Hepatitis C".org
 and not"Denominator Exclusion-M1235".org
 and not "Denominator Exception-G9452".org
 and not "Numerator Performance Met-M1231".org
 and not "Numerator Performance Met-M1232".org

define "Numerator Performance Not Met-M1233".group:
Option ID: M1233
 "Denominator".group
 and not"Denominator Exclusion-Hepatitis C".group
 and not"Denominator Exclusion-M1235".group
 and not "Denominator Exception-G9452".group
 and not "Numerator Performance Met-M1231".group
 and not "Numerator Performance Met-M1232".group

 define "Numerator Performance Not Met-M1233".provider:
Option ID: M1233
 "Denominator".provider
 and not "Denominator Exclusion-Hepatitis C".provider
 and not"Denominator Exclusion-M1235".provider
 and not "Denominator Exception-G9452".provider
 and not "Numerator Performance Met-M1231".provider
 and not "Numerator Performance Met-M1232".provider
*/
rule 'Year2026.Mips400Rate1.Gap.M1233.Org'
salience -20
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, 'Year2026.Mips400Rate1', MeasureStatusValue.GAP, "M1233");
end

rule 'Year2026.Mips400Rate1.Gap.M1233.Group'
salience -20
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    exists EncounterDenominatorGroup(groupId == $groupId)
then
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.GAP, "M1233");
end

rule 'Year2026.Mips400Rate1.Gap.M1233.Provider'
salience -20
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()    
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, 'Year2026.Mips400Rate1', MeasureStatusValue.GAP, 'M1233');
end
