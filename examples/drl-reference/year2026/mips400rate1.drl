rule 'Year2026.Mips400Rate1.Success.M1231.Provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    not (exists Year2026Mips400Rate1SuccessM1231EMRProvider(providerId == $encounter.providerExternalId))
    $negTest: QdmDatatype() from accumulate(
        queryYear2026Mips400Rate1SuccessM1231($program, $r;),
        latestQdmDatatype($r)
    )
then
    insert(new Year2026Mips400Rate1SuccessM1231EMRProvider($encounter.providerExternalId));
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "M1231");
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Negative HCV Antibody Test", "M1231", PopulationEnum.numerator_performance_met, $negTest, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $negTest.startDate.toString());
end

/*
define "Numerator Performance Met-M1232".org
Option ID: M1232 
    ((( ["Clinical Activity": "MIPS; 400_RATE1_PERFORMANCE_MET_M1232"] M1232
                where M1232.start_date during "Measurement Period")
    union (  "Reactive HCV Antibody Test" ReactiveHCV
                where ReactiveHCV.start_date during Interval[start of "Measurement Period", end of "Measurement Period" - 3 months] ) 
      ) PosTest 
    and exists "Denominator".org  )  PosTestOrg
   ,
   return
    ExtendedMeasureResultV2(
          PosTestOrg // return 1 record for each qualifying clinical activity or test, even if multiple records exist
          , 'Positive HCV Antibody Test' as name
          , display_date = start_date
          , calculated_record = false
          , population = Numerator Performance Met
          , option_id = M1232   
      ) 

define "Reactive HCV Antibody Test"
    (   ["Laboratory Test Performed": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"]
        union ["Laboratory Test Performed": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"]
        union ["Clinical Activity": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"] 
        union ["Clinical Activity": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"] ) AntibodyTest
    where  ( (AntibodyTest.result is not null or empty
            and (AntibodyTest.result_code_value not in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"]
                  and AntibodyTest.result_code_type not in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"] )
            and AntibodyTest.result not in {'negative'}) //NOT case sensitive
        or  (AntibodyTest.code_value is in ["ABLE; HCV_ANTIBODY_SIGNAL_CUTOFF"]
             and AntibodyTest.result_as_decimal >= 1.00 ))
*/
rule 'Year2026.Mips400Rate1.Success.M1232.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not (exists Year2026Mips400Rate1SuccessM1232EMROrg())
    $posTest: QdmDatatype() from accumulate(
        queryYear2026Mips400Rate1SuccessM1232($program, $r;),
        latestQdmDatatype($r)
    )
then
    insert(new Year2026Mips400Rate1SuccessM1232EMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1232");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Positive HCV Antibody Test", "M1232", PopulationEnum.numerator_performance_met, $posTest, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $posTest.startDate.toString());
end

query queryYear2026Mips400Rate1SuccessM1232(Program $program, QdmDatatype $result)
    $result:= ClinicalActivity(
        withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1232"),
        startsDuring($program.measurementPeriod)
    )
    or $result:= QdmResultDataType(
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
        withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        (!withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
        isPresent(result) && result.toLowerCase() != 'negative') ||
        (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)
        
    )
end

/*
define "Numerator Performance Met-M1232".group
Option ID: M1232 
  ((( ["Clinical Activity": "MIPS; 400_RATE1_PERFORMANCE_MET_M1232"] M1232
                where M1232.start_date during "Measurement Period")
    union (  "Reactive HCV Antibody Test" ReactiveHCV
                where ReactiveHCV.start_date during Interval[start of "Measurement Period", end of "Measurement Period" - 3 months] ) 
      ) PosTest 
    and exists "Denominator".group  )  PosTestGroup
   ,
   return
    ExtendedMeasureResultV2(
          PosTestGroup // return 1 record for each qualifying clinical activity or test, even if multiple records exist
          , 'Positive HCV Antibody Test' as name
          , display_date = start_date
          , calculated_record = false
          , population = Numerator Performance Met
          , option_id = M1232   
      ) 
*/
rule 'Year2026.Mips400Rate1.Success.M1232.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    exists EncounterDenominatorGroup(groupId == $groupId)
    not (exists Year2026Mips400Rate1SuccessM1232EMRGroup(groupId == $groupId))
    $posTest: QdmDatatype() from accumulate(
        queryYear2026Mips400Rate1SuccessM1232($program, $r;),
        latestQdmDatatype($r)
    )
then
    insert(new Year2026Mips400Rate1SuccessM1232EMRGroup($groupId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.SUCCESS, "M1232");
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Positive HCV Antibody Test", "M1232", PopulationEnum.numerator_performance_met, $posTest, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $posTest.startDate.toString());
end

