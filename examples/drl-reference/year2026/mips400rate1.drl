/*
define "Denominator Exception-G9452".org:
Option ID: G9452 
  (( ["Clinical Activity": "MIPS; 400_RATE1_DENOMINATOR_EXCEPTION_G9452"] G9452"Most Recent Denominator Encounter" Encounter
              with "Most Recent Denominator Encounter".org Encounter
              such that G9452.start_date during Interval[Encounter.start_date, Encounter.stop_date] )
    and exists "Denominator".org) G9452Org
  , 
  return
    ExtendedMeasureResultV2(
          G9452Org // return 1 record for each qualifying clinical activity, even if multiple records exist
          , 'Evidence of Limited Life Expectancy' as name
          , display_date = start_date
          , calculated_record = false
          , population = Denominator Exception
          , option_id = G9452   
      ) 

define "Most Recent Denominator Encounter".org:
  Last( "Denominator Encounter or Preventive Encounter" Encounter )
  sort by Encounter.start_date asc

define "Most Recent Denominator Encounter".group: //needs to return last encounter per group
  Last( "Denominator Encounter or Preventive Encounter" EncounterGroup where EncounterGroup.group_id = EncounterGroup.group_id )
  sort by EncounterGroup.start_date asc

define "Most Recent Denominator Encounter".provider: //needs to return last encounter per provider 
  LastperLevel( "Denominator Encounter or Preventive Encounter" EncounterProvider where EncounterProvider.provider_id = EncounterProvider.provider_id )
  sort by EncounterProvider.start_date asc
*/
rule 'Year2026.Mips400Rate1.Exception.G9452.Org'
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not (exists Year2026Mips400Rate1ExclusionG9452EMROrg())
    $mostRecentEncounter: ClinicalActivity() from accumulate (
        EncounterDenominator($encounterForLatest: clinicalActivity, measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.ORG),
        latestClinicalActivity($encounterForLatest)
    )
    $g9452: ClinicalActivity() from accumulate(
        $result: ClinicalActivity(
            withValueSet("MipsYear2026", "400_RATE1_DENOMINATOR_EXCEPTION_G9452"),
            startsDuring($mostRecentEncounter)
        ),
        latestClinicalActivity($result)
    )
then
    insert(new Year2026Mips400Rate1ExclusionG9452EMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCEPTION, "G9452");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Limited Life Expectancy", "G9452", PopulationEnum.denominator_exception, $g9452, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $g9452.startDate.toString());
end

/*
define "Denominator Exception-G9452".group:
Option ID: G9452 
  (( ["Clinical Activity": "MIPS; 400_RATE1_DENOMINATOR_EXCEPTION_G9452"] G9452
              with "Most Recent Denominator Encounter".group  EncounterGroup
              such that G9452.start_date during Interval[EncounterGroup.start_date, EncounterGroup.stop_date] )
    and exists "Denominator".group DenGroup
              where DenGroup.group_id = EncounterGroup.group_id) G9452Group
  ,
  return
    ExtendedMeasureResultV2(
          G9452Group // return 1 record for each qualifying clinical activity, even if multiple records exist
          , 'Evidence of Limited Life Expectancy' as name
          , display_date = start_date
          , calculated_record = false
          , population = Denominator Exception
          , option_id = G9452   
      )
*/
rule 'Year2026.Mips400Rate1.Exception.G9452.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    exists EncounterDenominatorGroup(groupId == $groupId)
    not (exists Year2026Mips400Rate1ExclusionG9452EMRGroup(groupId == $groupId))
    Year2026Mips400Rate1MostRecentDenominatorEncounterGroup(groupId == $groupId, $mostRecent: record)
    $g9452: ClinicalActivity() from accumulate(
        $result: ClinicalActivity(
            withValueSet("MipsYear2026", "400_RATE1_DENOMINATOR_EXCEPTION_G9452"),
            startsDuring($mostRecent)
        ),
        latestClinicalActivity($result)
    )
then
    insert(new Year2026Mips400Rate1ExclusionG9452EMRGroup($groupId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.EXCEPTION, "G9452");
    controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Evidence of Limited Life Expectancy", "G9452", PopulationEnum.denominator_exception, $g9452, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $g9452.startDate.toString());
end

rule 'Year2026.Mips400Rate1.MostRecentDenominatorEncounterGroup'
salience 15
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $groupId: String() from $encounter.getGroupExternalIds()
    exists EncounterDenominatorGroup(groupId == $groupId)
    $mostRecentEncounter: ClinicalActivity() from accumulate (
        EncounterDenominator($encounterForLatest: clinicalActivity, clinicalActivity.groupExternalIds != null , clinicalActivity.groupExternalIds.contains($groupId), measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.GROUP),
        latestClinicalActivity($encounterForLatest)
    )
    not Year2026Mips400Rate1MostRecentDenominatorEncounterGroup(groupId == $groupId)
then
     insert(new Year2026Mips400Rate1MostRecentDenominatorEncounterGroup($mostRecentEncounter, $groupId));
end

