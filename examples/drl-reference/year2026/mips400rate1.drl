/*
define "Numerator Performance Met-M1231".org
Option ID: M1231 
  ((["Clinical Activity": "MIPS; 400_RATE1_PERFORMANCE_MET_M1231"] M1231
          where M1231.start_date during "Measurement Period"
    union ( "Non-Reactive HCV Antibody Test" NonReactiveHCV
          where NonReactiveHCV.start_date during Interval[start of "Measurement Period", end of "Measurement Period" - 3 months] )       
      )NegTest 
   and exists "Denominator".org) NegTestOrg
   ,
   return
    ExtendedMeasureResultV2(
          NegTestOrg // return 1 record for each qualifying clinical activity or test, even if multiple records exist
          , 'Negative HCV Antibody Test' as name
          , display_date = start_date
          , calculated_record = false
          , population = Numerator Performance Met
          , option_id = M1231   
      )

define "Non-Reactive HCV Antibody Test"
    (   ["Laboratory Test Performed": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"]
        union ["Laboratory Test Performed": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"]
        union ["Clinical Activity": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"] 
        union ["Clinical Activity": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"] ) AntibodyTest
    where  ( (AntibodyTest.result_code_value in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"]
                  and AntibodyTest.result_code_type in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"] )
            or AnitbodyTest.result in {'negative'} //NOT case sensitive
            or (AntibodyTest.code_value is in ["ABLE; HCV_ANTIBODY_SIGNAL_CUTOFF"]
                and AntibodyTest.result_as_decimal < 1.00 ))
*/
rule 'Year2026.Mips400Rate1.Success.M1231.Org'
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    not (exists Year2026Mips400Rate1SuccessM1231EMROrg())
    $negTest: QdmDatatype() from accumulate(
        queryYear2026Mips400Rate1SuccessM1231($program, $r;),
        latestQdmDatatype($r)
    )
then
    insert(new Year2026Mips400Rate1SuccessM1231EMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1231");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Negative HCV Antibody Test", "M1231", PopulationEnum.numerator_performance_met, $negTest, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $negTest.startDate.toString());
end

query queryYear2026Mips400Rate1SuccessM1231(Program $program, QdmDatatype $result)
    $result:= ClinicalActivity(
            withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1231"),
            startsDuring($program.measurementPeriod)
    )
    or $result:= QdmResultDataType(
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
        withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        (withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") ||
        result != null && result.toLowerCase() == 'negative' ||
        (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal < 1))
    )
end

