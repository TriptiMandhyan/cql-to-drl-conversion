rule 'Year2026.Mips400Rate1.MostRecentDenominatorEncounterProvider'
salience 15
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate1')
    EncounterDenominator($providerId: clinicalActivity.providerExternalId, measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $mostRecentEncounter: ClinicalActivity() from accumulate (
        EncounterDenominator($encounterForLatest: clinicalActivity, clinicalActivity.providerExternalId == $providerId, measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.PROVIDER),
        latestClinicalActivity($encounterForLatest)
    )
    not Year2026Mips400Rate1MostRecentDenominatorEncounterProvider(providerId == $providerId)
then
     insert(new Year2026Mips400Rate1MostRecentDenominatorEncounterProvider($mostRecentEncounter, $providerId));
