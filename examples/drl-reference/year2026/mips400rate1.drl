package com.ablehealth.measure.mips.year2026;

import com.ablehealth.model.*
import com.ablehealth.payloads.*;
import com.ablehealth.results.*;
import com.ablehealth.enums.extendedmeaures.*;

import accumulate com.ablehealth.functions.LatestClinicalActivityAccumulateFunction latestClinicalActivity;
import accumulate com.ablehealth.functions.LatestQdmDatatypeAccumulateFunction latestQdmDatatype;

global PatientResults controlSet;

declare Year2026Mips400Rate1DenominatorEMROrg
end
declare Year2026Mips400Rate1DenominatorEMRGroup
    groupId: String
end
declare Year2026Mips400Rate1DenominatorEMRProvider
    providerId: String
end
declare Year2026Mips400Rate1ExclusionHepatitiscEMROrg
end
declare Year2026Mips400Rate1ExclusionHepatitiscEMRGroup
    groupId: String
end
declare Year2026Mips400Rate1ExclusionHepatitiscEMRProvider
    providerId: String
end
declare Year2026Mips400Rate1ExclusionM1235EMROrg
end
declare Year2026Mips400Rate1ExclusionM1235EMRGroup
    groupId: String
end
declare Year2026Mips400Rate1ExclusionM1235EMRProvider
    providerId: String
end
declare Year2026Mips400Rate1ExclusionG9452EMROrg
end
declare Year2026Mips400Rate1ExclusionG9452EMRGroup
    groupId: String
end
declare Year2026Mips400Rate1ExclusionG9452EMRProvider
    providerId: String
end
declare Year2026Mips400Rate1SuccessM1231EMROrg
end
declare Year2026Mips400Rate1SuccessM1231EMRGroup
    groupId: String
end
declare Year2026Mips400Rate1SuccessM1231EMRProvider
    providerId: String
end
declare Year2026Mips400Rate1SuccessM1232EMROrg
end
declare Year2026Mips400Rate1SuccessM1232EMRGroup
    groupId: String
end
declare Year2026Mips400Rate1SuccessM1232EMRProvider
    providerId: String
end
declare Year2026Mips400Rate1MostRecentDenominatorEncounterGroup
    record: ClinicalActivity
    groupId: String
end
declare Year2026Mips400Rate1MostRecentDenominatorEncounterProvider
    record: ClinicalActivity
    providerId: String
end
declare EncounterDenominatorGroup
    groupId: String
end

/*
define "Denominator".org:
  ("Denominator Preventive Encounter")
  union ( "Denominator Encounter" E1
              with  "Denominator Encounter" E2
              such that E1.start_date != E2.start_date )

define "Denominator Preventive Encounter":
  ["Clinical Activity": "MIPS; 400_PREVENTIVE_ENCOUNTER"] Encounter
  where Encounter.start_date during [start of  "Measurement Period", end of "Measurement Period" - 3 months]
        and AgeInYearsAt(Encounter.start_date) >= 18
        and Encounter.provider_id.hasMeasureMembership = true

define "Denominator Encounter":
  ["Clinical Activity": "MIPS; 400_ENCOUNTER"] Encounter
  where Encounter.start_date during [start of  "Measurement Period", end of "Measurement Period" - 3 months]
        and AgeInYearsAt(Encounter.start_date) >= 18
        and Encounter.provider_id.hasMeasureMembership = true
  ,
  if exists("Denominator".org)
  and exists("Denominator Preventive Encounter") PrevEnc
  return
  ExtendedMeasureResultV2(
        PrevEnc // return 1 record for each qualifying preventive encounter, even if multiple records exist
        , 'Denominator Preventive Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  else from ( "Denominator Encounter" E1
              with  "Denominator Encounter" E2
              such that E1.start_date != E2.start_date )
  return
  ExtendedMeasureResultV2(
        E1 
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        E2
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
*/
rule 'Year2026.Mips400Rate1.Denominator.Org'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate1')
    //define "Denominator Preventive Encounter"
    (
        $encounter: ClinicalActivity(
            withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
        )
    )
    or
    //define "Denominator Encounter"
    (
        $encounter: ClinicalActivity(
            withValueSet("MipsYear2026", "400_ENCOUNTER"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
        )
        and exists ClinicalActivity(
            withValueSet("MipsYear2026", "400_ENCOUNTER"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
            $encounter.startDate != startDate
        )
    )
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 18)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips400Rate1", EncounterDenominatorType.ORG));
end

rule 'Year2026.Mips400Rate1.Denominator.EMR.Org.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $preventive: ClinicalActivity(
        withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
    )
    not(
        exists Year2026Mips400Rate1DenominatorEMROrg()
    )
then
    insert(new Year2026Mips400Rate1DenominatorEMROrg());
    String[] optionIds = new String[]{"M1461", "M1235", "G9452", "M1231", "M1232", "M1233"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $preventive, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $preventive.startDate.toString());
    }
end

rule 'Year2026.Mips400Rate1.Denominator.EMR.Org.EncounterPair'
salience -25
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $e1: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
    )
    $e2: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        startDate != $e1.startDate
    )
    not(
        exists Year2026Mips400Rate1DenominatorEMROrg()
    )
then
    insert(new Year2026Mips400Rate1DenominatorEMROrg());
    String[] optionIds = new String[]{"M1461", "M1235", "G9452", "M1231", "M1232", "M1233"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 1", optionId, PopulationEnum.denominator, $e1, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e1.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 2", optionId, PopulationEnum.denominator, $e2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e2.startDate.toString());
    }
end

/*
define "Denominator".provider: 
  exists "Denominator Preventive Encounter"
  or exists ( "Denominator Encounter" E1
              with  "Denominator Encounter" E2
              such that E1.start_date != E2.start_date 
                        and E1.provider_id = E2.provider_id )
  ,
  if exists("Denominator".provider)
  and exists("Denominator Preventive Encounter") PrevEncProvider
  return
  ExtendedMeasureResultV2(
        PrevEncProvider "Most Recent Denominator Encounter"
        , 'Denominator Preventive Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  else from ( "Denominator Encounter" E1
              with  "Denominator Encounter" E2
              such that E1.start_date != E2.start_date 
              and E1.provider_id = E2.provider_id )
  return
  ExtendedMeasureResultV2(
        E1
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        E2
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
*/
rule 'Year2026.Mips400Rate1.Denominator.Provider'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate1')
    //define "Denominator Preventive Encounter"
    (
        $providerEncounter: ClinicalActivity(
            withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
        )
    )
    or
    //define "Denominator Encounter"
    (
        $providerEncounter: ClinicalActivity(
            withValueSet("MipsYear2026", "400_ENCOUNTER"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
        )
        and exists ClinicalActivity(
            withValueSet("MipsYear2026", "400_ENCOUNTER"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
            startDate != $providerEncounter.startDate,
            providerExternalId == $providerEncounter.providerExternalId
        )
    )
    $patient: Patient(getAgeInYearsAt($providerEncounter.startDate) >= 18)
then
    insert(new EncounterDenominator($program, $providerEncounter, "Year2026.Mips400Rate1", EncounterDenominatorType.PROVIDER));
end

rule 'Year2026.Mips400Rate1.Denominator.EMR.Provider.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    $preventive: ClinicalActivity(
        withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        providerExternalId == $encounter.providerExternalId
    )
    not(
        exists Year2026Mips400Rate1DenominatorEMRProvider($encounter.providerExternalId == providerId)
    )
then
    insert(new Year2026Mips400Rate1DenominatorEMRProvider($encounter.providerExternalId));
    String[] optionIds = new String[]{"M1461", "M1235", "G9452", "M1231", "M1232", "M1233"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $preventive, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $preventive.startDate.toString());
    }
end

rule 'Year2026.Mips400Rate1.Denominator.EMR.Provider.EncounterPair'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate1', type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    $e1: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        providerExternalId == $encounter.providerExternalId
    )
    $e2: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        startDate != $e1.startDate,
        providerExternalId == $encounter.providerExternalId
    )
    not(
        exists Year2026Mips400Rate1DenominatorEMRProvider($encounter.providerExternalId == providerId)
    )
then
    insert(new Year2026Mips400Rate1DenominatorEMRProvider($encounter.providerExternalId));
    String[] optionIds = new String[]{"M1461", "M1235", "G9452", "M1231", "M1232", "M1233"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter 1", optionId, PopulationEnum.denominator, $e1, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e1.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter 2", optionId, PopulationEnum.denominator, $e2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e2.startDate.toString());
    }
end

