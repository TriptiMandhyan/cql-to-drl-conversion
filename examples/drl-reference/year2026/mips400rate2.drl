define "Numerator Performance Met-M1229".org
  /* Option ID: M1229 
  (( ["Clinical Activity": "MIPS; 400_RATE2_PERFORMANCE_MET_M1229"] M1229
              where M1229.start_date during Interval[start of "Measurement Period", end of "Measurement Period"])
  and exists( "Denominator".org)) M1229Org
  ,
  return
  ExtendedMeasureResultV2(
        M1229Org
        , 'Numerator Performance Met M1229' as name
        , display_date = start_date
        , calculated_record = false
         , population = Numerator Performance Met 
         , option_id = M1229   
    )
*/
rule 'Year2026.Mips400Rate2.Success.M1229.Org.EMR'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $result: ClinicalActivity(
        withValueSet("MipsYear2026", "400_RATE2_PERFORMANCE_MET_M1229"),
        startsDuring($program.measurementPeriod)
    )
    not(
        exists Year2026Mips400Rate2SuccessM1229EMROrg()
    )
then
    insert(new Year2026Mips400Rate2SuccessM1229EMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1229");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Numerator Performance Met M1229", "M1229", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

