rule 'Year2026.Mips400Rate2.Denominator.Group.PreventiveEncounter'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate2')
    $groupEncounter: ClinicalActivity(
        withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        groupExternalIds != null
    )
    exists (
        ClinicalActivity(
            withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1232"),
            startsOnOrBefore($program.measurementPeriod.end)
        ) 
        or QdmResultDataType(
            withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
            withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
            (isPresent(result) && 
            !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
            result.toLowerCase() != 'negative') ||
            (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)
        )
    )
    $patient: Patient(getAgeInYearsAt($groupEncounter.startDate) >= 18)
then
    insert(new EncounterDenominator($program, $groupEncounter, "Year2026.Mips400Rate2", EncounterDenominatorType.GROUP));
end

rule 'Year2026.Mips400Rate2.Denominator.Group.PreventiveEncounter.Marker'
salience 19
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate2')
    exists (
        ClinicalActivity(
            withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1232"),
            startsOnOrBefore($program.measurementPeriod.end)
        ) 
        or QdmResultDataType(
            withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
            withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
            (isPresent(result) && 
            !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
            result.toLowerCase() != 'negative') ||
            (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)
        )
    )
    $groupEncounter: ClinicalActivity(
        withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        groupExternalIds != null
    )
    $groupId: String() from $groupEncounter.getGroupExternalIds()
    not (exists EncounterDenominatorGroup(groupId == $groupId))
then
    insert(new EncounterDenominatorGroup($groupId));
end

rule 'Year2026.Mips400Rate2.Denominator.Group.EncounterPair'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate2')
    $groupEncounter: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        groupExternalIds != null
    )
    $groupId: String() from $groupEncounter.getGroupExternalIds()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        $groupEncounter.startDate != startDate,
        groupExternalIds != null, groupExternalIds.contains($groupId)
    )
    exists (
        ClinicalActivity(
            withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1232"),
            startsOnOrBefore($program.measurementPeriod.end)
        ) 
        or QdmResultDataType(
            withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
            withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
            (isPresent(result) && 
            !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
            result.toLowerCase() != 'negative') ||
            (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)
        )
    )
    not (exists EncounterDenominator(clinicalActivity == $groupEncounter, type == EncounterDenominatorType.GROUP, measure == "Year2026.Mips400Rate2"))
    $patient: Patient(getAgeInYearsAt($groupEncounter.startDate) >= 18)
then
    insert(new EncounterDenominator($program, $groupEncounter, "Year2026.Mips400Rate2", EncounterDenominatorType.GROUP));
end

rule 'Year2026.Mips400Rate2.Denominator.Group.EncounterPair.Marker'
salience 19
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate2')
    exists (
        ClinicalActivity(
            withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1232"),
            startsOnOrBefore($program.measurementPeriod.end)
        ) 
        or QdmResultDataType(
            withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
            withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
            (isPresent(result) && 
            !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
            result.toLowerCase() != 'negative') ||
            (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)
        )
    )
    $enc1: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        groupExternalIds != null
    )
    $groupId: String() from $enc1.getGroupExternalIds()
    not (exists EncounterDenominatorGroup(groupId == $groupId))
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        startDate != $enc1.startDate,
        groupExternalIds != null, groupExternalIds.contains($groupId)
    )
then
    insert(new EncounterDenominatorGroup($groupId));
end

rule 'Year2026.Mips400Rate2.Denominator.EMR.Group.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    exists EncounterDenominatorGroup(groupId == $groupId)
    $preventive: ClinicalActivity(
        withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        groupExternalIds != null, groupExternalIds.contains($groupId)
    )
    not(
        exists Year2026Mips400Rate2DenominatorEMRGroup(groupId == $groupId)
    )
then
    insert(new Year2026Mips400Rate2DenominatorEMRGroup($groupId));
    String[] optionIds = new String[]{"M1229", "M1228", "M1234", "M1230"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $groupId, "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $preventive, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $preventive.startDate.toString());
    }
end

rule 'Year2026.Mips400Rate2.Denominator.EMR.Group.EncounterPair'
