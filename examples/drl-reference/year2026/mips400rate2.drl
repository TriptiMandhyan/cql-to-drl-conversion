package com.ablehealth.measure.mips.year2026;

import com.ablehealth.model.*
import com.ablehealth.payloads.*;
import com.ablehealth.results.*;
import com.ablehealth.enums.extendedmeaures.*;

global PatientResults controlSet;

declare Year2026Mips400Rate2DenominatorEMROrg
end
declare Year2026Mips400Rate2DenominatorEMRGroup
    groupId: String
end
declare Year2026Mips400Rate2DenominatorEMRProvider
    providerId: String
end
declare Year2026Mips400Rate2SuccessM1234EMROrg
end
declare Year2026Mips400Rate2SuccessM1234EMRGroup
    groupId: String
end
declare Year2026Mips400Rate2SuccessM1234EMRProvider
    providerId: String
end
declare Year2026Mips400Rate2SuccessM1228EMROrg
end
declare Year2026Mips400Rate2SuccessM1228EMRGroup
    groupId: String
end
declare Year2026Mips400Rate2SuccessM1228EMRProvider
    providerId: String
end
declare Year2026Mips400Rate2SuccessM1229EMROrg
end
declare Year2026Mips400Rate2SuccessM1229EMRGroup
    groupId: String
end
declare Year2026Mips400Rate2SuccessM1229EMRProvider
    providerId: String
end
declare EncounterDenominatorGroup
    groupId: String
end
/*
define "Denominator".org:
    (   exists("Denominator Preventive Encounter")
        or exists ( "Denominator Encounter" E1
                    with  "Denominator Encounter" E2
                    such that E1.start_date != E2.start_date )
  ) 
  and   (   exists( ["Clinical Activity": "MIPS; 400_RATE1_PERFORMANCE_MET_M1232"] M1232
                    where M1232.start_date on or before end of "Measurement Period")
            or exists(  "Reactive HCV Antibody Test" ReactiveHCV
                        where ReactiveHCV.start_date during Interval[start of "Measurement Period", end of "Measurement Period" - 3 months] )          
         )PosTest
  ,
  if exists("Denominator.org")
  return
    ExtendedMeasureResultV2(
          PosTest // return 1 record for each qualifying clinical activity or test, even if multiple records exist
          , 'Positive HCV Antibody Test' as name
          , display_date = start_date
          , calculated_record = false
          , population = Denominator
          , option_id = all   
      )
  and( if exists ("Denominator Preventive Encounter") PrevEnc
  return
  ExtendedMeasureResultV2(
        PrevEnc // return 1 record for each qualifying preventive encounter, even if multiple records exist
        , 'Denominator Preventive Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  else from ( "Denominator Encounter" E1
              with  "Denominator Encounter" E2
              such that E1.start_date != E2.start_date )
  return
  ExtendedMeasureResultV2(
        E1
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        E2
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )      
       
)     

define "Denominator Preventive Encounter":
  ["Clinical Activity": "MIPS; 400_PREVENTIVE_ENCOUNTER"] Encounter
  where Encounter.start_date during [start of  "Measurement Period", end of "Measurement Period" - 3 months]
        and AgeInYearsAt(Encounter.start_date) >= 18
        and Encounter.provider_id.hasMeasureMembership = true

define "Denominator Encounter":
  ["Clinical Activity": "MIPS; 400_ENCOUNTER"] Encounter
  where Encounter.start_date during [start of  "Measurement Period", end of "Measurement Period" - 3 months]
        and AgeInYearsAt(Encounter.start_date) >= 18
        and Encounter.provider_id.hasMeasureMembership = true

define "Reactive HCV Antibody Test"
    (   ["Laboratory Test Performed": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"]
        union ["Laboratory Test Performed": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"]
        union ["Clinical Activity": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"] 
        union ["Clinical Activity": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"] ) AntibodyTest
    where  ( (AntibodyTest.result is not null or empty
            and (AntibodyTest.result_code_value not in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"]
                  and AntibodyTest.result_code_type not in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"] )
            and AntibodyTest.result not in {'negative'}) //NOT case sensitive
        or  (AntibodyTest.code_value is in ["ABLE; HCV_ANTIBODY_SIGNAL_CUTOFF"]
             and AntibodyTest.result_as_decimal >= 1.00 ))
*/
rule 'Year2026.Mips400Rate2.Denominator.Org'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate2')
    (
        (
            $encounter: ClinicalActivity(
                withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
                startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
            ) 
        ) or (
            $encounter: ClinicalActivity(
                withValueSet("MipsYear2026", "400_ENCOUNTER"),
                startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
            )
            and exists ClinicalActivity(
                withValueSet("MipsYear2026", "400_ENCOUNTER"),
                startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
                $encounter.startDate != startDate
            )
        )
    )
    and exists (
        ClinicalActivity(
            withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1232"),
            startsOnOrBefore($program.measurementPeriod.end)
        ) 
        or QdmResultDataType(
            withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
            withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
            (isPresent(result) && 
            !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
            result.toLowerCase() != 'negative') ||
            (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)
        )
    )
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 18)
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips400Rate2", EncounterDenominatorType.ORG));
end

rule 'Year2026.Mips400Rate2.Denominator.EMR.Org.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $preventive: ClinicalActivity(
        withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
    )
    not(
        exists Year2026Mips400Rate2DenominatorEMROrg()
    )
then
    insert(new Year2026Mips400Rate2DenominatorEMROrg());
    String[] optionIds = new String[]{"M1229", "M1228", "M1234", "M1230"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $preventive, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $preventive.startDate.toString());
    }
end

rule 'Year2026.Mips400Rate2.Denominator.EMR.Org.EncounterPair'
salience -25
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $e1: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
    )
    $e2: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        startDate != $e1.startDate
    )
    not(
        exists Year2026Mips400Rate2DenominatorEMROrg()
    )
then
    insert(new Year2026Mips400Rate2DenominatorEMROrg());
    String[] optionIds = new String[]{"M1229", "M1228", "M1234", "M1230"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 1", optionId, PopulationEnum.denominator, $e1, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e1.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, "", "Denominator Encounter 2", optionId, PopulationEnum.denominator, $e2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e2.startDate.toString());
    }
end

rule 'Year2026.Mips400Rate2.Denominator.EMR.Org.PositiveHCVTest'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    $positiveTest: QdmResultDataType(
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
        withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        (isPresent(result) && 
        !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
        result.toLowerCase() != 'negative') ||
        (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)
    )
    not(
        exists Year2026Mips400Rate2DenominatorEMROrg()
    )
then
    insert(new Year2026Mips400Rate2DenominatorEMROrg());
    String[] optionIds = new String[]{"M1229", "M1228", "M1234", "M1230"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, "", "Positive HCV Antibody Test", optionId, PopulationEnum.denominator, $positiveTest, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $positiveTest.startDate.toString());
    }
end

