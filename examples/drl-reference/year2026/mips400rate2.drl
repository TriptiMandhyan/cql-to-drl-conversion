  and( if exists ("Denominator Preventive Encounter") PrevEncProvider
  return
        ExtendedMeasureResultV2(
              PrevEncProvider // return 1 record for each qualifying preventive encounter, even if multiple records exist
              , 'Denominator Preventive Encounter' as name
              , display_date = start_date
              , calculated_record = false
              , population = Denominator
              , option_id = all   
          )
  else from ( "Denominator Encounter" E1
              with  "Denominator Encounter" E2
              such that E1.start_date != E2.start_date 
              and E1.provider_id = E2.provider_id )
  return
  ExtendedMeasureResultV2(
        E1
        , 'Denominator Encounter 1' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
  and return
  ExtendedMeasureResultV2(
        E2
        , 'Denominator Encounter 2' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )
)
*/
rule 'Year2026.Mips400Rate2.Denominator.Provider'
salience 20
when
    $program: Program(rules contains 'measure.Mips.2026.Mips400Rate2')
    (
        (
            $providerEncounter: ClinicalActivity(
                withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
                startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
            ) 
        ) or (
            $providerEncounter: ClinicalActivity(
                withValueSet("MipsYear2026", "400_ENCOUNTER"),
                startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3))
            )
            and exists ClinicalActivity(
                withValueSet("MipsYear2026", "400_ENCOUNTER"),
                startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
                startDate != $providerEncounter.startDate,
                providerExternalId == $providerEncounter.providerExternalId
            )
        )
    )
    and exists (
        ClinicalActivity(
            withValueSet("MipsYear2026", "400_RATE1_PERFORMANCE_MET_M1232"),
            startsOnOrBefore($program.measurementPeriod.end)
        ) 
        or QdmResultDataType(
            withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
            withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
            startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
            (isPresent(result) && 
            !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
            result.toLowerCase() != 'negative') ||
            (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)
        )
    )
    $patient: Patient(getAgeInYearsAt($providerEncounter.startDate) >= 18)
then
    insert(new EncounterDenominator($program, $providerEncounter, "Year2026.Mips400Rate2", EncounterDenominatorType.PROVIDER));
end

rule 'Year2026.Mips400Rate2.Denominator.EMR.Provider.PreventiveEncounter'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    $preventive: ClinicalActivity(
        withValueSet("MipsYear2026", "400_PREVENTIVE_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        providerExternalId == $encounter.providerExternalId
    )
    not(
        exists Year2026Mips400Rate2DenominatorEMRProvider($encounter.providerExternalId == providerId)
    )
then
    insert(new Year2026Mips400Rate2DenominatorEMRProvider($encounter.providerExternalId));
    String[] optionIds = new String[]{"M1229", "M1228", "M1234", "M1230"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Preventive Encounter", optionId, PopulationEnum.denominator, $preventive, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $preventive.startDate.toString());
    }
end

rule 'Year2026.Mips400Rate2.Denominator.EMR.Provider.EncounterPair'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    $e1: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        providerExternalId == $encounter.providerExternalId
    )
    $e2: ClinicalActivity(
        withValueSet("MipsYear2026", "400_ENCOUNTER"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        startDate != $e1.startDate,
        providerExternalId == $encounter.providerExternalId
    )
    not(
        exists Year2026Mips400Rate2DenominatorEMRProvider($encounter.providerExternalId == providerId)
    )
then
    insert(new Year2026Mips400Rate2DenominatorEMRProvider($encounter.providerExternalId));
    String[] optionIds = new String[]{"M1229", "M1228", "M1234", "M1230"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter 1", optionId, PopulationEnum.denominator, $e1, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e1.startDate.toString());
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Denominator Encounter 2", optionId, PopulationEnum.denominator, $e2, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $e2.startDate.toString());
    }
end

rule 'Year2026.Mips400Rate2.Denominator.EMR.Provider.PositiveHCVTest'
salience -25
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.PROVIDER, clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    $positiveTest: QdmResultDataType(
        withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
        withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
        startsDuring($program.measurementPeriod.start, $program.measurementPeriod.end.minusMonths(3)),
        (isPresent(result) && 
        !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
        result.toLowerCase() != 'negative') ||
        (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)
    )
    not(
        exists Year2026Mips400Rate2DenominatorEMRProvider($encounter.providerExternalId == providerId)
    )
then
    insert(new Year2026Mips400Rate2DenominatorEMRProvider($encounter.providerExternalId));
    String[] optionIds = new String[]{"M1229", "M1228", "M1234", "M1230"};
    for (String optionId : optionIds) {
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Positive HCV Antibody Test", optionId, PopulationEnum.denominator, $positiveTest, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $positiveTest.startDate.toString());
    }
end

