/*
define "Negative HCV RNA Test"
    (  ["Laboratory Test Performed": "ABLE; HEPATITIS_C_VIRAL_LOAD_TESTS_CPT"]
        union ["Clinical Activity": "ABLE; HEPATITIS_C_VIRAL_LOAD_TESTS_CPT"]  ) HCVRNATest
    where ( ( HCVRNATest.result_code_value in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"]
                  and AntibodyTest.result_code_type in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"] )
            or HCVRNATest.result in {'negative'}) //NOT case sensitive

define "Reactive HCV Antibody Test"
    (   ["Laboratory Test Performed": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"]
        union ["Laboratory Test Performed": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"]
        union ["Clinical Activity": "VSAC; HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY"] 
        union ["Clinical Activity": "ABLE; HEPATITIS_C_ANTIBODY_TESTS_CPT"] ) AntibodyTest
    where  ( (AntibodyTest.result is not null or empty
            and (AntibodyTest.result_code_value not in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"]
                  and AntibodyTest.result_code_type not in ["eCQM Direct Reference Codes; NOT_DETECTED_QUALIFIER_VALUE"] )
            and AntibodyTest.result not in {'negative'}) //NOT case sensitive
        or  (AntibodyTest.code_value is in ["ABLE; HCV_ANTIBODY_SIGNAL_CUTOFF"]
             and AntibodyTest.result_as_decimal >= 1.00 ))

define "Numerator Performance Met-M1234".org
  /* Option ID: M1234 
  ((( ["Clinical Activity": "MIPS; 400_RATE2_PERFORMANCE_MET_M1234"] M1234
        where M1234.start_date on or before end of "Measurement Period" )    
  union ("Negative HCV RNA Test" NegativeRNATest
              with "Reactive HCV Antibody Test" ReactiveHCV 
              such that NegativeRNATest.start_date start during Interval[ReactiveHCV.start_date, end of "Measurement Period"]     )
        ) NegRNA 
  and exists "Denominator".org) NegRNAOrg
  ,
  return
  ExtendedMeasureResultV2(
        NegRNAOrg
        , 'Numerator Performance Met M1234 - Negative HCV RNA Test' as name
        , display_date = start_date
        , calculated_record = false
         , population = Numerator Performance Met 
         , option_id = M1234   
    )
*/
rule 'Year2026.Mips400Rate2.Success.M1234.Org.EMR'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.ORG)
    $patient: Patient()
    queryYear2026Mips400Rate2SuccessM1234($program, $result;)
    not(
        exists Year2026Mips400Rate2SuccessM1234EMROrg()
    )
then
    insert(new Year2026Mips400Rate2SuccessM1234EMROrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1234");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Numerator Performance Met M1234 - Negative HCV RNA Test", "M1234", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

query queryYear2026Mips400Rate2SuccessM1234(Program $program, QdmDatatype $result)
    $result:= ClinicalActivity(
        withValueSet("MipsYear2026", "400_RATE2_PERFORMANCE_MET_M1234"),
        startsDuring($program.measurementPeriod)
    )
    or (
        //"Negative HCV RNA Test"
        $result:= QdmResultDataType(
            withValueSet("AbleYear2026", "HEPATITIS_C_VIRAL_LOAD_TESTS_CPT"),
            withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") ||
            result.toLowerCase() == 'negative'
        )
        //"Reactive HCV Antibody Test"
        and exists (
            QdmResultDataType(
                withValueSet("VsacYear2026", "HEPATITIS_C_VIRUS_INFECTION_TESTS_FOR_HEPATITIS_C_VIRUS_ANTIBODY") ||
                withValueSet("AbleYear2026", "HEPATITIS_C_ANTIBODY_TESTS_CPT"),
                ((isPresent(result) &&
                !withValueSetInResultCodeValue("Ecqm_Direct_Reference_CodesYear2026", "NOT_DETECTED_QUALIFIER_VALUE") &&
                result.toLowerCase() != 'negative') ||
                (withValueSet("AbleYear2026", "HCV_ANTIBODY_SIGNAL_CUTOFF") && resultAsDecimal != null && resultAsDecimal >= 1)),
                $result.startsDuring(startDate, $program.measurementPeriod.end)
            )
        )
    )
end

