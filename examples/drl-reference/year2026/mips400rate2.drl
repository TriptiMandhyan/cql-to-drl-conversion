/*
define "Numerator Performance Not Met-M1230".org:
* Option ID: M1230 *
 "Denominator".org
 and not "Numerator Performance Met-M1229".org
 and not "Numerator Performance Met-M1228".org
 and not "Numerator Performance Met-M1234".org
*/
rule 'Year2026.Mips400Rate2.Gap.M1230.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.ORG)
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "M1230");
end

/*
define "Numerator Performance Not Met-M1230".group:
* Option ID: M1230 *
 "Denominator".group
 and not "Numerator Performance Met-M1229".group
 and not "Numerator Performance Met-M1228".group
 and not "Numerator Performance Met-M1234".group
*/
rule 'Year2026.Mips400Rate2.Gap.M1230.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.GROUP, clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupId: String() from $encounter.getGroupExternalIds()
    exists EncounterDenominatorGroup(groupId == $groupId)
then
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupId, $measure, MeasureStatusValue.GAP, "M1230");
end

/*
define "Numerator Performance Not Met-M1230".provider:
* Option ID: M1230 *
 "Denominator".provider
 and not "Numerator Performance Met-M1229".provider
 and not "Numerator Performance Met-M1228".provider
 and not "Numerator Performance Met-M1234".provider
*/
rule 'Year2026.Mips400Rate2.Gap.M1230.Provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == 'Year2026.Mips400Rate2', type == EncounterDenominatorType.PROVIDER)
    $patient: Patient()
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, 'M1230');
end