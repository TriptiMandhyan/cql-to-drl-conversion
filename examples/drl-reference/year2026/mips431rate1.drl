/*
define "Numerator Performance Not Met G2199".org:
   *
   * Option ID: G2199
   *
  "Denominator".org
   and not "Numerator Performance Met G2196"
   and not "Numerator Performance Met G2197"
   and not "Denominator Exclusion M1165"
   and not "Denominator Exclusion M1164"
*/
rule 'Year2026.Mips431Rate1.Gap.G2199.Org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips431Rate1', type == EncounterDenominatorType.ORG)
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "G2199");
end

/**
define "Numerator Performance Not Met G2199".group:
   *
   * Option ID: G2199
   *
  "Denominator".group
   and not "Numerator Performance Met G2196"
   and not "Numerator Performance Met G2197"
   and not "Denominator Exclusion M1165"
   and not "Denominator Exclusion M1164"
*/
rule 'Year2026.Mips431Rate1.Gap.G2199.Group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips431Rate1', type == EncounterDenominatorType.GROUP)
    $patient: Patient()
then
    for(String group: $encounter.groupExternalIds) {
        controlSet.addGroupPatientMeasureStatus($program, $patient, group, $measure, MeasureStatusValue.GAP, "G2199");
    }
end

/**
define "Numerator Performance Not Met G2199".provider:
   *
   * Option ID: G2199
   *
  "Denominator".provider
   and not "Numerator Performance Met G2196"
   and not "Numerator Performance Met G2197"
   and not "Denominator Exclusion M1165"
   and not "Denominator Exclusion M1164"
*/
rule 'Year2026.Mips431Rate1.Gap.G2199.Provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure, measure == 'Year2026.Mips431Rate1', type == EncounterDenominatorType.PROVIDER)
    $patient: Patient()
then
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "G2199");
end
