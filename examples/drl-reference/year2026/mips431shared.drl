package com.ablehealth.measure.mips.year2026;

import com.ablehealth.model.*
import com.ablehealth.payloads.*;
import com.ablehealth.results.*;
import com.ablehealth.enums.extendedmeaures.*;

import accumulate com.ablehealth.functions.LatestClinicalActivityAccumulateFunction latestClinicalActivity;
import accumulate com.ablehealth.functions.LatestQdmDatatypeAccumulateFunction latestQdmDatatype;

global PatientResults controlSet;

declare Year2026Mips431SharedEncounterOrg
    latestEncounter: ClinicalActivity
end

declare Year2026Mips431SharedEncounterGroup
    latestEncounter: ClinicalActivity
end

declare Year2026Mips431SharedEncounterProvider
    latestEncounter: ClinicalActivity
end

declare Year2026Mips431SharedExclusionHospiceOrg
end

declare Year2026Mips431SharedExclusionHospiceGroup
    group: String
end

declare Year2026Mips431SharedExclusionHospiceProvider
    provider: String
end

declare Year2026Mips431SharedExclusionDementiaOrg
end

declare Year2026Mips431SharedExclusionDementiaGroup
    group: String
end

declare Year2026Mips431SharedExclusionDementiaProvider
    provider: String
end

declare Year2026Mips431Groups
    groupExternalId: String
end

declare Year2026Mips431Providers
    providerExternalId: String
end

/*
define "DenominatorRate1Rate3".org:
    last(   (   (   "431 Encounter" P1
                    with "431 Encounter" P2
                    such that P1.start_date != P2.start_date    )
                union "431 Preventive Encounter"
                ) Denom
        ) sort by Denom.start_date asc
        
define "431 Encounter"
    ["Clinical Activity": "MIPS; 431_ENCOUNTER"] Encounter
    where   Encounter.start_date during "Measurement Period"
            and AgeInYearsAt(Encounter.start_date) >= 18
            and Encounter.provider_id.hasMeasureMembership = true
      
define "431 Preventive Encounter"
    ["Clinical Activity": "MIPS; 431_PREVENTIVE_ENCOUNTER"] Encounter
    where   Encounter.start_date during "Measurement Period"
            and AgeInYearsAt(Encounter.start_date) >= 18
            and Encounter.provider_id.hasMeasureMembership = true
*/
rule 'Year2026.Mips431.Denominator.Shared.Org'
salience 40
when
    $program: Program(
        rules contains 'measure.Mips.2026.Mips431Rate1' ||
        rules contains 'measure.Mips.2026.Mips431Rate2' ||
        rules contains 'measure.Mips.2026.Mips431Rate3'
    )
    $patient: Patient()
    $latestEncounter: ClinicalActivity() from accumulate (
        queryYear2026Mips431SharedDenominatorOrg($program, $patient, $encounter;),
        latestClinicalActivity($encounter)
    )
    and not(
        exists Year2026Mips431SharedEncounterOrg($latestEncounter == latestEncounter)
    )
then
    insert(new Year2026Mips431SharedEncounterOrg($latestEncounter));
end

query queryYear2026Mips431SharedDenominatorOrg(Program $program, Patient $patient, ClinicalActivity $encounter)
    (
        $encounter:= ClinicalActivity(
            withValueSet("MipsYear2026", "431_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            $patient.getAgeInYearsAt(startDate) >= 18
        ) and exists ClinicalActivity(
            withValueSet("MipsYear2026", "431_ENCOUNTER"),
            startsDuring($program.measurementPeriod),
            startDate != $encounter.startDate,
            $patient.getAgeInYearsAt(startDate) >= 18
        )
    )
    or $encounter:= ClinicalActivity(
        startsDuring($program.measurementPeriod),
        withValueSet("MipsYear2026", "431_PREVENTIVE_ENCOUNTER"),
        $patient.getAgeInYearsAt(startDate) >= 18
    )
end

/**
define "DenominatorRate1Rate3".group:
    last(   (   (   "431 Encounter" P1
                    with "431 Encounter" P2
                    such that   P1.start_date != P2.start_date    
                                and P1.group_id = P2.group_id   )
                union "431 Preventive Encounter"
                ) Denom
        ) sort by Denom.start_date asc
*/
rule 'Year2026.Mips431.FindGroups.P1'
salience 150
when
    $program: Program(
        rules contains 'measure.Mips.2026.Mips431Rate1' ||
        rules contains 'measure.Mips.2026.Mips431Rate2' ||
        rules contains 'measure.Mips.2026.Mips431Rate3'
    )
    $patient: Patient()
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "431_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        $patient.getAgeInYearsAt(startDate) >= 18,
        isPresent(groupExternalIds)
    )
    $groupId: String() from $encounter.groupExternalIds
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "431_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        startDate != $encounter.startDate,
        $patient.getAgeInYearsAt(startDate) >= 18,
        isPresent(groupExternalIds),
        groupExternalIds.contains($groupId)
    )
    not (exists Year2026Mips431Groups(groupExternalId == $groupId))
then
    insert(new Year2026Mips431Groups($groupId));
end

rule 'Year2026.Mips431.FindGroups.P2'
salience 150
when
    $program: Program(
        rules contains 'measure.Mips.2026.Mips431Rate1' ||
        rules contains 'measure.Mips.2026.Mips431Rate2' ||
        rules contains 'measure.Mips.2026.Mips431Rate3'
    )
    $patient: Patient()
    $encounter: ClinicalActivity(
        startsDuring($program.measurementPeriod),
        withValueSet("MipsYear2026", "431_PREVENTIVE_ENCOUNTER"),
        $patient.getAgeInYearsAt(startDate) >= 18
    )
    $groupId: String() from $encounter.groupExternalIds
    not (exists Year2026Mips431Groups(groupExternalId == $groupId))
then
    insert(new Year2026Mips431Groups($groupId));
end

