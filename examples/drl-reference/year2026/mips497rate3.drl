/*
define "Denominator":
    AgeInYearsAt(start of "Measurement Period") >= 41
    and AgeInYearsAt(start of "Measurement Period") < 74
    and "Patient Characteristic Sex" = 'Female'
    and exists( ["Clinical Activity": "MIPS; 497RATE3_ENCOUNTER"] Encounter
                where   Encounter.start_date during "Measurement Period"
                        and Encounter.provider_id.hasMeasureMembership = true)
      ,
    if exists "Denominator"
    from (    ["Clinical Activity": "MIPS; 497RATE3_ENCOUNTER"] Encounter
              where Encounter.start_date during "Measurement Period") MPEncounter
    return
    ExtendedMeasureResultV2(
        MPEncounter
        , 'Denominator Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all
    )
// Here we want to return the denominator encounter record that created the status
// Need to return this per status (providerPatientMeasureStatus, groupPatientMeasureStatus, PatientMeasureStatus)                    
*/
rule 'Year2026.Mips497Rate3.Denominator'
when
    $program: Program(rules contains "measure.Mips.2026.Mips497Rate3")
    $patient: Patient(
        getAgeInYearsAt($program.measurementPeriod.start) >= 41,
        getAgeInYearsAt($program.measurementPeriod.start) < 74,
        isFemale())
    $mips497Rate3encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "497RATE3_ENCOUNTER"),
        startsDuring($program.measurementPeriod)
    )
then
    insert(new EncounterDenominator($program, $mips497Rate3encounter, "Year2026.Mips497Rate3"));
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Denominator Encounter", "M1280", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Denominator Encounter", "M1303", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Denominator Encounter", "M1309", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Denominator Encounter", "M1284", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Denominator Encounter", "M1291", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Denominator Encounter", "M1292", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Denominator Encounter", "M1302", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Denominator Encounter", "M1285", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());

    if ($mips497Rate3encounter.isPresent($mips497Rate3encounter.groupExternalIds)) {
        for (String groupExternalId : $mips497Rate3encounter.groupExternalIds) {
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', groupExternalId, "Denominator Encounter", "M1280", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', groupExternalId, "Denominator Encounter", "M1303", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', groupExternalId, "Denominator Encounter", "M1309", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', groupExternalId, "Denominator Encounter", "M1284", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', groupExternalId, "Denominator Encounter", "M1291", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', groupExternalId, "Denominator Encounter", "M1292", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', groupExternalId, "Denominator Encounter", "M1302", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
            controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', groupExternalId, "Denominator Encounter", "M1285", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
        }
    }

    if ($mips497Rate3encounter.isPresent($mips497Rate3encounter.providerExternalId)) {
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', $mips497Rate3encounter.providerExternalId, "Denominator Encounter", "M1280", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', $mips497Rate3encounter.providerExternalId, "Denominator Encounter", "M1303", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', $mips497Rate3encounter.providerExternalId, "Denominator Encounter", "M1309", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', $mips497Rate3encounter.providerExternalId, "Denominator Encounter", "M1284", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', $mips497Rate3encounter.providerExternalId, "Denominator Encounter", "M1291", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', $mips497Rate3encounter.providerExternalId, "Denominator Encounter", "M1292", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', $mips497Rate3encounter.providerExternalId, "Denominator Encounter", "M1302", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
        controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', $mips497Rate3encounter.providerExternalId, "Denominator Encounter", "M1285", PopulationEnum.denominator, $mips497Rate3encounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $mips497Rate3encounter.startDate.toString());
    }
end

/*
define "Bilateral Mastectomy Evidence":
    ( ["Clinical Activity": "MIPS; 112_HISTORY_OF_MASTECTOMY_G9708"]
        union ["Clinical Activity": "MIPS; 497RATE3_DENOMINATOR_EXCLUSION_M1280"]
        union ["Clinical Activity": "VSAC; BILATERAL_MASTECTOMY"]
        union ["Clinical Activity": "VSAC; HISTORY_OF_BILATERAL_MASTECTOMY"]
        union ["Diagnosis": "VSAC; HISTORY_OF_BILATERAL_MASTECTOMY"]
    ) D
    where D.start_date on or before end of "Measurement Period"
define "Left Mastectomy Evidence":
    (   ["Clinical Activity": "VSAC; STATUS_POST_LEFT_MASTECTOMY"]
        union ["Diagnosis": "VSAC; STATUS_POST_LEFT_MASTECTOMY"]
    )   D
    where D.start_date on or before end of "Measurement Period"
define "Right Mastectomy Evidence":
    (   ["Clinical Activity": "VSAC; STATUS_POST_RIGHT_MASTECTOMY"]
        union ["Diagnosis": "VSAC; STATUS_POST_RIGHT_MASTECTOMY"]
    )   D
    where D.start_date on or before end of "Measurement Period"

define "Denominator Exclusion Mastectomy":
   //Option ID: M1280 
  exists ("Bilateral Mastectomy Evidence")
  or (exists ("Left Mastectomy Evidence") and exists ("Right Mastectomy Evidence"))
  ,
  if exists "Denominator Exclusion Mastectomy"
  from "Bilateral Mastectomy Evidence" BilateralMastectomy
  return
  ExtendedMeasureResultV2(
      BilateralMastectomy
      , 'Bilateral Mastectomy' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = M1280
  )
  ,
  if exists "Denominator Exclusion Mastectomy"
     and not exists "Bilateral Mastectomy Evidence"
  from "Left Mastectomy Evidence" LeftMastectomy,
       "Right Mastectomy Evidence" RightMastectomy
  return
  ExtendedMeasureResultV2(
      LeftMastectomy
      , 'Left Mastectomy' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = M1280
  )
  ,
  ExtendedMeasureResultV2(
      RightMastectomy
      , 'Right Mastectomy' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = M1280
  )
*/
rule 'Year2026.Mips497Rate3.Exclusion.M1280_Mastectomy_BilateralClinical'
when
    EncounterDenominator($program: program, $measure: measure, measure == 'Year2026.Mips497Rate3', $encounter: clinicalActivity)
    $patient: Patient()
    exists ClinicalActivity(
        withValueSet("MipsYear2026", "112_HISTORY_OF_MASTECTOMY_G9708") ||
        withValueSet("MipsYear2026", "497RATE3_DENOMINATOR_EXCLUSION_M1280") ||
        withValueSet("VsacYear2026", "BILATERAL_MASTECTOMY") ||
        withValueSet("VsacYear2026", "HISTORY_OF_BILATERAL_MASTECTOMY"),
        startsOnOrBefore($program.measurementPeriod.end)
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1280");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "M1280");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "M1280");
end

rule 'Year2026.Mips497Rate3.Exclusion.M1280_Mastectomy_BilateralClinical.Org.EMR'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips497Rate3')
    exists EncounterDenominator(measure == 'Year2026.Mips497Rate3', program == $program)
    $patient: Patient()
    not (exists Year2026Mips497Rate3ExclusionMastectomyBilateralOrg())
    $result: ClinicalActivity() from accumulate (
        $c: ClinicalActivity(
            withValueSet("MipsYear2026", "112_HISTORY_OF_MASTECTOMY_G9708") ||
            withValueSet("MipsYear2026", "497RATE3_DENOMINATOR_EXCLUSION_M1280") ||
            withValueSet("VsacYear2026", "BILATERAL_MASTECTOMY") ||
            withValueSet("VsacYear2026", "HISTORY_OF_BILATERAL_MASTECTOMY"),
            startsOnOrBefore($program.measurementPeriod.end)
        ),
        latestClinicalActivity($c)
    )
then
    insert(new Year2026Mips497Rate3ExclusionMastectomyBilateralOrg());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Bilateral Mastectomy", "M1280", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

