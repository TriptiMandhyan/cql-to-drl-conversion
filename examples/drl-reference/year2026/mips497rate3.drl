/*
define "Numerator Performance Met M1302":
* Option ID: M1302
    (   Last    (   (   (   (   ["Clinical Activity": "VSAC; MAMMOGRAPHY"]
                                union ["Clinical Activity": "ABLE; MAMMOGRAM"]
                                union ["Diagnosis": "ABLE; MAMMOGRAM"]
                                union ["Clinical Activity": "ABLE; MAMMOGRAM_CPTII"]
                            ) Mamm
                            where Mamm.start_date during Interval[start of "Measurement Period" - 15 months, end of "Measurement Period"]
                        )
                        union (( ["Clinical Activity": "MIPS; 497RATE3_PERFORMANCE_MET_M1302"]
                                union ["Clinical Activity": "MIPS; 112_PERFORMANCE_MET_G9899"] )P
                                where P.start_date during Interval[start of "Measurement Period" - 15 months, end of "Measurement Period"] )
                    ) M1302 
                ) sort by M1302.start.date
    )   LastM1302
  ,
  if exists "Numerator Performance Met M1302" return
  ExtendedMeasureResultV2(
      LastM1302
      , 'Mammogram' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = M1302
  )
*/
rule 'Year2026.Mips497Rate3.LastMammogram'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips497Rate3')
    exists EncounterDenominator(measure == 'Year2026.Mips497Rate3', program == $program)
    $last: QdmDatatype() from accumulate (
        $c: QdmDatatype(
          withValueSet("VsacYear2026", "MAMMOGRAPHY") ||
          withValueSet("AbleYear2026", "MAMMOGRAM") ||
          withValueSet("AbleYear2026", "MAMMOGRAM_CPTII") ||
          withValueSet("MipsYear2026", "497RATE3_PERFORMANCE_MET_M1302") ||
          withValueSet("MipsYear2026", "112_PERFORMANCE_MET_G9899"),
          startsDuring($program.measurementPeriod.start.minusMonths(15), $program.measurementPeriod.end)
        ),
        latestQdmDatatype($c)
    )
    and not (
      exists Year2026Mips497Rate3LastMammogram()
    )
then
    insert (new Year2026Mips497Rate3LastMammogram($last));
end

rule 'Year2026.Mips497Rate3.Success.M1302'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate3")
    $patient: Patient()
    exists Year2026Mips497Rate3LastMammogram()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1302");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "M1302");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.SUCCESS, "M1302");
end

rule 'Year2026.Mips497Rate3.Success.M1302.Org.EMR'
when
    $program: Program(rules contains 'measure.Mips.2026.Mips497Rate3')
    exists EncounterDenominator(measure == 'Year2026.Mips497Rate3', program == $program)
    $patient: Patient()
    not (exists Year2026Mips497Rate3SuccessM1302Org())
    Year2026Mips497Rate3LastMammogram($result: last)
then
    insert(new Year2026Mips497Rate3SuccessM1302Org());
    controlSet.addPatientEMR($program, $patient, 'Year2026.Mips497Rate3', "", "Mammogram", "M1302", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.getStart().toString());
end

rule 'Year2026.Mips497Rate3.Success.M1302.Group.EMR'
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips497Rate3', $encounter: clinicalActivity,
        $encounter.isPresent($encounter.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.groupExternalIds
    not (exists Year2026Mips497Rate3SuccessM1302Group(groupExternalId == $groupExternalId))
    Year2026Mips497Rate3LastMammogram($result: last)
then
    insert(new Year2026Mips497Rate3SuccessM1302Group($groupExternalId));
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Mammogram", "M1302", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.getStart().toString());
end

rule 'Year2026.Mips497Rate3.Success.M1302.Provider.EMR'
when
    EncounterDenominator($program: program, $measure: measure == 'Year2026.Mips497Rate3', $encounter: clinicalActivity,
        $encounter.isPresent($encounter.providerExternalId))
    $patient: Patient()
    not (exists Year2026Mips497Rate3SuccessM1302Provider(providerExternalId == $encounter.providerExternalId))
    Year2026Mips497Rate3LastMammogram($result: last)
then
    insert(new Year2026Mips497Rate3SuccessM1302Provider($encounter.providerExternalId));
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Mammogram", "M1302", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.getStart().toString());
end

/**
define "Numerator Performance Not Met M1285":
* Option ID: M1285
    not "Denominator Exclusion Mastectomy"
    and not "Denominator Exclusion Hospice"
    and not "Denominator Exclusion Palliative Care"
    and not "Denominator Exclusion LTI"
    and not "Denominator Exclusion Frailty and Dementia Medication"
    and not "Denominator Exclusion Frailty and Advanced Illness"
    and not "Numerator Performance Met M1285"

*/
rule 'Year2026.Mips497Rate3.Gap.M1285'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate3")
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "M1285");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "M1285");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "M1285");
end
