/**
define "Numerator Performance Met Fecal Occult":
  /* Option ID: performance_met_fecal_occult *
  Last (
      (   ["Clinical Activity": "VSAC; FECAL_OCCULT_BLOOD_TEST_FOBT"]
          union ["Clinical Activity": "VSAC; FOBT_LAB_CPT"]
          union ["Laboratory Test Performed": "VSAC; FECAL_OCCULT_BLOOD_TEST_FOBT"]
          union ["Laboratory Test Performed": "VSAC; FOBT_LAB_CPT"] ) L
      where L.start_date during "Measurement Period"
      sort by start_date
  ) FOBT
  ,
  if exists "Numerator Performance Met Fecal Occult" return
  ExtendedMeasureResultV2(
      FOBT
      , 'Fecal Occult Blood Test' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = performance_met_fecal_occult
  )
*/
rule 'Year2026.Mips497Rate4.Success.Fecal_Occult'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate4")
    $patient: Patient()
    $perfMet: QdmDatatype() from accumulate (
        $c: QdmDatatype(
            withValueSet("VsacYear2026", "FECAL_OCCULT_BLOOD_TEST_FOBT") ||
            withValueSet("VsacYear2026", "FOBT_LAB_CPT"),
            startsDuring($program.measurementPeriod)
        ),
        latestQdmDatatype($c)
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "performance_met_fecal_occult");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Fecal Occult Blood Test", "performance_met_fecal_occult", PopulationEnum.numerator_performance_met, $perfMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $perfMet.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.SUCCESS, "performance_met_fecal_occult");
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Fecal Occult Blood Test", "performance_met_fecal_occult", PopulationEnum.numerator_performance_met, $perfMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $perfMet.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "performance_met_fecal_occult");
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Fecal Occult Blood Test", "performance_met_fecal_occult", PopulationEnum.numerator_performance_met, $perfMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $perfMet.startDate.toString());
    }
end

/*
define "Numerator Performance Met FIT DNA":
  /* Option ID: performance_met_FIT_DNA *
  Last (
      (   ["Clinical Activity": "VSAC; SDNA_FIT_TEST"]
          union ["Clinical Activity": "VSAC; FIT_DNA_CPT"]
          union ["Laboratory Test Performed": "VSAC; SDNA_FIT_TEST"]
          union ["Laboratory Test Performed": "VSAC; FIT_DNA_CPT"]) L
      where L.start_date during Interval[start of "Measurement Period" - 2 years, end of "Measurement Period"]
      sort by start_date
  ) FITDNA
  ,
  if exists "Numerator Performance Met FIT DNA" return
  ExtendedMeasureResultV2(
      FITDNA
      , 'FIT DNA Test' as name
      , display_date = start_date
      , calculated_record = false
      , population = Performance Met
      , option_id = performance_met_FIT_DNA
  )
*/
rule 'Year2026.Mips497Rate4.Success.FIT_DNA'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate4")
    $patient: Patient()
    $perfMet: QdmDatatype() from accumulate (
        $c: QdmDatatype(
            withValueSet("VsacYear2026", "SDNA_FIT_TEST") ||
            withValueSet("VsacYear2026", "FIT_DNA_CPT"),
            startsDuring($program.measurementPeriod.start.minusYears(2), $program.measurementPeriod.end)
        ),
        latestQdmDatatype($c)
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "performance_met_FIT_DNA");
    controlSet.addPatientEMR($program, $patient, $measure, "", "FIT DNA Test", "performance_met_FIT_DNA", PopulationEnum.numerator_performance_met, $perfMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $perfMet.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)){
        for (String groupExternalId : $encounter.groupExternalIds) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.SUCCESS, "performance_met_FIT_DNA");
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "FIT DNA Test", "performance_met_FIT_DNA", PopulationEnum.numerator_performance_met, $perfMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $perfMet.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)){
        controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.SUCCESS, "performance_met_FIT_DNA");
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "FIT DNA Test", "performance_met_FIT_DNA", PopulationEnum.numerator_performance_met, $perfMet, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $perfMet.startDate.toString());
    }
end
/*
define "Numerator Performance Not Met 3017F-8P":
  * Option ID: M1315 *
  not "Denominator Exclusion Colorectal Cancer or Total Colectomy"
  and not "Denominator Exclusion Hospice"
  and not "Denominator Exclusion Palliative Care"
  and not "Denominator Exclusion LTI"
  and not "Denominator Exclusion Frailty and Dementia Medication"
  and not "Denominator Exclusion Frailty and Advanced Illness"
  and not "Numerator Performance Met M1277"
  and not "Numerator Performance Met Colonoscopy"
  and not "Numerator Performance Met Flex Sig"
  and not "Numerator Performance Met Fecal Occult"
  and not "Numerator Performance Met FIT DNA"
  and not "Numerator Performance Met CT Colonography"
*/
rule 'Year2026.Mips497Rate4.Gap.M1315'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate4")
    $patient: Patient()
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "M1315");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "M1315");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.GAP, "M1315");
end
