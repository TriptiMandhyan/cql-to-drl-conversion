    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Long Term Care", "M1284", PopulationEnum.denominator_exclusion, $lti, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lti.startDate.toString());
