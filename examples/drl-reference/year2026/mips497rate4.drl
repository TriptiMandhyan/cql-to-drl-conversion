/*
define "Denominator":
    ["Clinical Activity": "MIPS; 497RATE4_ENCOUNTER"] Encounter
    where   Encounter.start_date during "Measurement Period"
            and AgeInYearsAt(Encounter.start_date) >= 45
            and AgeInYearsAt(Encounter.start_date) <= 75
            and Encounter.provider_id.hasMeasureMembership = true
*/
rule 'Year2026.Mips497Rate4.Denominator'
when
    $program: Program(rules contains "measure.Mips.2026.Mips497Rate4")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "497RATE4_ENCOUNTER"),
        startsDuring($program.measurementPeriod)
    )
    exists Patient(
        getAgeInYearsAt($encounter.startDate) >= 45,
        getAgeInYearsAt($encounter.startDate) <= 75
    )
then
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips497Rate4"));
end

/*
define "Denominator Exclusion Colorectal Cancer or Total Colectomy":
  * Option ID: M1295 *
  exists ("Colorectal Cancer or Total Colectomy Evidence")
  ,
  if exists "Denominator Exclusion Colorectal Cancer or Total Colectomy"
  from "Colorectal Cancer or Total Colectomy Evidence" M1295
  return
  ExtendedMeasureResultV2(
      M1295
      , 'Colorectal Cancer or Total Colectomy' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = M1295
  )

define "Colorectal Cancer or Total Colectomy Evidence":
    (   ["Diagnosis": "VSAC; MALIGNANT_NEOPLASM_OF_COLON"]
        union ["Diagnosis": "VSAC; TOTAL_COLECTOMY"]
        union ["Clinical Activity": "VSAC; TOTAL_COLECTOMY"]
        union ["Clinical Activity": "VSAC; MALIGNANT_NEOPLASM_OF_COLON"]
        union ["Clinical Activity": "MIPS; 113_HISTORY_OF_TOTAL_COLECTOMY_OR_COLORECTAL_CANCER"]
        union ["Clinical Activity": "MIPS; 497RATE4_DENOMINATOR_EXCLUSION_M1295"]
    ) D
    where D.start_date on or before end of "Measurement Period"
*/
query queryYear2026Mips497Rate4ExclusionM1295(Program $program, QdmDatatype $result)
    $result:= Diagnosis(
        withValueSet("VsacYear2026", "MALIGNANT_NEOPLASM_OF_COLON") ||
        withValueSet("VsacYear2026", "TOTAL_COLECTOMY"),
        startsOnOrBefore($program.measurementPeriod.end)
    )
    or $result:= ClinicalActivity(
        withValueSet("VsacYear2026", "MALIGNANT_NEOPLASM_OF_COLON") ||
        withValueSet("VsacYear2026", "TOTAL_COLECTOMY") ||
        withValueSet("MipsYear2026", "113_HISTORY_OF_TOTAL_COLECTOMY_OR_COLORECTAL_CANCER") ||
        withValueSet("MipsYear2026", "497RATE4_DENOMINATOR_EXCLUSION_M1295"),
        startsOnOrBefore($program.measurementPeriod.end)
    )
end

rule 'Year2026.Mips497Rate4.Exclusion.M1295.org'
when
    EncounterDenominator($program: program, $measure: measure == "Year2026.Mips497Rate4")
    $patient: Patient()
    $result: QdmDatatype() from accumulate(
        queryYear2026Mips497Rate4ExclusionM1295($program, $r;),
        latestQdmDatatype($r)
    )
    not(
        exists Year2026Mips497Rate4ExclusionM1295Emr()
    )
then
    insert(new Year2026Mips497Rate4ExclusionM1295Emr());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1295");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Colorectal Cancer or Total Colectomy", "M1295", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

rule 'Year2026.Mips497Rate4.Exclusion.M1295.group'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate4", clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $patient: Patient()
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    $result: QdmDatatype() from accumulate(
        queryYear2026Mips497Rate4ExclusionM1295($program, $r;),
        latestQdmDatatype($r)
    )
    not(exists Year2026Mips497Rate4ExclusionM1295Group(groupExternalId == $groupExternalId))
then
    insert(new Year2026Mips497Rate4ExclusionM1295Group($groupExternalId));
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupExternalId, $measure, MeasureStatusValue.EXCLUSION, "M1295");
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, "Colorectal Cancer or Total Colectomy", "M1295", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

rule 'Year2026.Mips497Rate4.Exclusion.M1295.provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate4", clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    $patient: Patient()
    $result: QdmDatatype() from accumulate(
        queryYear2026Mips497Rate4ExclusionM1295($program, $r;),
        latestQdmDatatype($r)
    )
    not(exists Year2026Mips497Rate4ExclusionM1295Provider(providerExternalId == $encounter.providerExternalId))
then
    insert(new Year2026Mips497Rate4ExclusionM1295Provider($encounter.providerExternalId));
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "M1295");
    controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Colorectal Cancer or Total Colectomy", "M1295", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

/*
define "Denominator Exclusion Hospice":
  * Option ID: M1303 *
  exists (sharedHospice."Has Hospice") HospiceEvidence
  ,
  if exists "Denominator Exclusion Hospice" return
  ExtendedMeasureResultV2(
      HospiceEvidence
      , 'Evidence of Hospice' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = M1303
  )
*/
rule 'Year2026.Mips497Rate4.Exclusion.Hospice'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate4")
    $patient: Patient()
    exists queryYear2026MipsSharedHashospiceInMeasurementPeriod($program, $hospice;)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1303");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "M1303");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "M1303");
end

