/*
define "Denominator Exclusion LTI":
  * Option ID: M1284 *
  exists (sharedFrailtyLTI."Has Long Term Care with Age Anchor"(start of "Denominator")) LTI // the start of the denominator encounter is AgeInYearsAt anchor
  ,
  if exists "Has Long Term Care Periods Longer Than 90 Consecutive Days"
  from "Max Long Term Care Period Length" Period
  return
  ExtendedMeasureResultV2(
      'Long Term Care Period Duration' as name
      , "Max Long Term Care Period Length" as calculated_value
      , calculated_record = true
      , population = Exclusion
      , option_id = M1284
  )
  else if exists( ["Clinical Activity": "MIPS; MIPS_LTI_QUALITY_CODES"] LTI
                  where LTI.start_date during Interval[start of "Measurement Period", end of "Measurement Period"]    )
  ExtendedMeasureResultV2(
      LTI
      , 'Evidence of Long Term Care' as name
      , display_date = start_date
      , calculated_record = false
      , population = Exclusion
      , option_id = M1284
  )

*/
rule 'Year2026.Mips497Rate4.Exclusion.LTI'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate4")
    $patient: Patient()
    exists queryYear2026MipsSharedHasLongTermCareWithAgeAnchor($program, $encounter.startDate;)
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1284");
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.EXCLUSION, "M1284");
    controlSet.addGroupPatientMeasureStatus($program, $patient, $encounter.groupExternalIds, $measure, MeasureStatusValue.EXCLUSION, "M1284");
end

rule 'Year2026.Mips497Rate4.Exclusion.LTI.CalculatedPeriod.Org.EMR'
salience -5
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate4")
    $patient: Patient()
    exists queryYear2026MipsSharedHasLongTermCareWithAgeAnchor($program, $encounter.startDate;)
    queryYear2026MipsSharedHasLongTermCarePeriodsLongerThan90ConsecutiveDays($program, $encounter.startDate, $consecutiveDays;)
    not(exists Year2026Mips497Rate4ExclusionLtiCalculatedPeriodOrg())
then
    insert(new Year2026Mips497Rate4ExclusionLtiCalculatedPeriodOrg());
    controlSet.addPatientEMR($program, $patient, $measure, "", "Long Term Care Period Duration", "M1284", PopulationEnum.denominator_exclusion, null, SupplementalInfoEnum.CALCULATION_VALUE.displayName(), $consecutiveDays.toString());
end

