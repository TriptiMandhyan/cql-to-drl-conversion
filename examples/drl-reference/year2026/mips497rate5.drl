/*
define "Numerator Performance Met M1287".all:
   *
   * Option ID: M1287
   *
(((["Clinical Activity": "MIPS; 128_PERFORMANCE_MET_G8418"]
   union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_MET_M1287"]) P
        with "Denominator" Encounter
        such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date])
  union((["Clinical Activity": "ABLE; BELOW_NORMAL_BMI_FOLLOW_UP"]
          union ["Clinical Activity": "VSAC; FOLLOW_UP_FOR_BELOW_NORMAL_BMI"]
          union ["Diagnosis": "VSAC; FOLLOW_UP_FOR_BELOW_NORMAL_BMI"]) BelowFU 
            with "Denominator" Encounter
            and with "Last BMI Before Encounter Is Low" LowBMIEncounter
            such that( BelowFU.start_date during Interval[LowBMIEncounter.start_date - 12 months, LowBMIEncounter.start_date]
                      and LowBMIEncounter.start_date = Encounter.start_date))
)M1287
  ,
  if exists ((["Clinical Activity": "MIPS; 128_PERFORMANCE_MET_G8418"]
                union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_MET_M1287"]) P
                with "Denominator" Encounter
                such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]) M1287PerformanceMet
  then return
  ExtendedMeasureResultV2(
        M1287PerformanceMet //return 1 record per patient even if multiple exists
        , 'Below Normal BMI with Follow-Up Quality Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1287 
    )
  else if exists((["Clinical Activity": "ABLE; BELOW_NORMAL_BMI_FOLLOW_UP"]
          union ["Clinical Activity": "VSAC; FOLLOW_UP_FOR_BELOW_NORMAL_BMI"]
          union ["Diagnosis": "VSAC; FOLLOW_UP_FOR_BELOW_NORMAL_BMI"]) BelowFU 
            with "Denominator" Encounter
            and with "Last BMI Before Encounter Is Low" LowBMIEncounter
            such that( BelowFU.start_date during Interval[LowBMIEncounter.start_date - 12 months, LowBMIEncounter.start_date]
                      and LowBMIEncounter.start_date = Encounter.start_date) ) PerfMetBelowFU
  then return
 ( ExtendedMeasureResultV2(
        PerfMetBelowFU //return 1 record per patient even if multiple exists
        , 'Follow-up for Below Normal BMI' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1287 
    )
  and from (LastPerLevel(["Clinical Activity": "eCQM Direct Reference Code; BODY_MASS_INDEX_BMI_RATIO"] BMI // Use LastPerLevel to return statuses for org and each provider_id and group_id associated with a "Last Qualifying Encounter with BMI" Encounter
            with ("Denominator" ) Encounter
            such that BMI.start_date during Interval[Encounter.start_date - 12 months, Encounter.start_date])
          sort by BMI.start_date asc) LastBMI
  return
  ExtendedMeasureResultV2(
        LastBMI //return 1 record per patient even if multiple exists
        , 'Below Normal BMI' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1287 
    )
  )

define "Last BMI Before Encounter Is Low": 
    "Last BMI Before Encounter Result" < 18.5
*/
rule 'Year2026.Mips497Rate5.Success.M1287.p1.org'
salience 30
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate5")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_PERFORMANCE_MET_G8418") ||
            withValueSet("MipsYear2026", "497RATE5_PERFORMANCE_MET_M1287"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    )
    and not (
        exists Year2026Mips497rate5NumeratorPerformanceMetM1287Emr()
    )
then
    insert(new Year2026Mips497rate5NumeratorPerformanceMetM1287Emr());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1287");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Below Normal BMI with Follow-Up Quality Code", "M1287", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

