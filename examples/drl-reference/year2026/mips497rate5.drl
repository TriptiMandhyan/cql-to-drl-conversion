  else if exists("Last BMI Before Encounter Is Normal".group)LastBMINormalGroup
  then return
  ExtendedMeasureResultV2(
        LastBMINormalGroup //return 1 record per patient even if multiple exists
        , 'Normal BMI' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1296 
    )

define "Last BMI Before Encounter Is Normal":
    "Last BMI Before Encounter Result" >= 18.5
    and "Last BMI Before Encounter Result" < 25

Note: we want to only output EMR for 128_PERFORMANCE_MET_M1296 since "Last BMI Before Encounter Is Normal".org is already covered
