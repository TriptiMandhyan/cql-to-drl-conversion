end

/*
define "Numerator Performance Not Met M1314".all:
  *
  * Option ID: M1314
  *
  not "Denominator Exclusion Pregnancy M1298"
  and not "Denominator Exclusion Hospice or Palliative"
  and not "Numerator Performance Met M1296"
  and not "Numerator Performance Met M1293"
  and not "Numerator Performance Met M1287"
  and not "Denominator Exception M1286"
  and not "Denominator Exception M1297"
  and not "Numerator Performance Not Met M1276"

*/
rule 'Year2026.Mips497Rate5.Gap.M1314'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate5")
    $patient: Patient()
    not (
        exists Year2026Mips497rate5PerformanceNotMetM1276()
    )
then
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "M1314");
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.getGroupExternalIds()) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.GAP, "M1314");
        }
    }
    controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "M1314");
end