/*
define "Denominator".all:
  "Qualifying Encounter" Encounter
  ,
  if exists("Denominator") 
  return
  ExtendedMeasureResultV2(
        Last(Encounter) sort by Encounter.start_date ascending//LastperLevel
        , 'Denominator Encounter' as name
        , display_date = start_date
        , calculated_record = false
        , population = Denominator
        , option_id = all   
    )

define "Qualifying Encounter"
    ["Clinical Activity": "MIPS; 128_ENCOUNTER"] Encounter
      where Encounter.start_date during "Measurement Period"
        and AgeInYearsAt(Encounter.start_date) >= 18
        and not Encounter.code_modifier in {'GQ','GT','95','FQ','93'}
        and not Encounter.place_of_service in {'02','10','12'}
        and Encounter.provider_id.hasMeasureMembership = true
    and not exists((["Clinical Activity": "MIPS; 128_M1431_ENCOUNTERS_CONDUCTED_VIA_TELEHEALTH"]
                   union ["Clinical Activity": "MIPS; 497RATE5_M1426_ENCOUNTERS_CONDUCTED_VIA_TELEHEALTH"])TelehealthEncounter
                      with Encounter
                      such that TelehealthEncounter.start_date during Interval[Encounter.start_date, Encounter.stop_date])

*/
rule 'Year2026.Mips497Rate5.Denominator'
salience 70
when
    $program: Program(rules contains "measure.Mips.2026.Mips497Rate5")
    $encounter: ClinicalActivity(
        withValueSet("MipsYear2026", "128_ENCOUNTER"),
        startsDuring($program.measurementPeriod),
        withCodeModifiersNotIn("GQ", "GT", "95", "FQ", "93"),
        withPlaceOfServiceNotIn("02", "10", "12")
    )
    and not(
        exists ClinicalActivity(
            withValueSet("MipsYear2026", "128_M1431_ENCOUNTERS_CONDUCTED_VIA_TELEHEALTH") ||
            withValueSet("MipsYear2026", "497RATE5_M1426_ENCOUNTERS_CONDUCTED_VIA_TELEHEALTH"),
            startsDuring($encounter)
        )
    )
    $patient: Patient(getAgeInYearsAt($encounter.startDate) >= 18)
then 
    insert(new EncounterDenominator($program, $encounter, "Year2026.Mips497Rate5"));
end

// EMR rules for last encounter per org/group/provider
rule 'Year2026.Mips497Rate5.Denominator.EMR.Org'
salience -10
when
    $program: Program(rules contains "measure.Mips.2026.Mips497Rate5")
    $patient: Patient()
    exists EncounterDenominator(program == $program, measure == "Year2026.Mips497Rate5")
    $lastEncounter: ClinicalActivity() from accumulate(
        EncounterDenominator($e: clinicalActivity, measure == "Year2026.Mips497Rate5"),
        latestClinicalActivity($e)
    )
then
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", "", "Denominator Encounter", "M1298", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", "", "Denominator Encounter", "M1307", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", "", "Denominator Encounter", "M1296", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", "", "Denominator Encounter", "M1293", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", "", "Denominator Encounter", "M1287", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", "", "Denominator Encounter", "M1286", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", "", "Denominator Encounter", "M1297", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", "", "Denominator Encounter", "M1276", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", "", "Denominator Encounter", "M1314", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
end

rule 'Year2026.Mips497Rate5.Denominator.EMR.Group'
salience -10
when
    $program: Program(rules contains "measure.Mips.2026.Mips497Rate5")
    $patient: Patient()
    EncounterDenominator($encounter: clinicalActivity, program == $program, measure == "Year2026.Mips497Rate5", clinicalActivity.isPresent(clinicalActivity.groupExternalIds))
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    not Year2026Mips497rate5DenominatorEncounterEmrGroup(groupExternalId == $groupExternalId)
    $lastEncounter: ClinicalActivity() from accumulate(
        EncounterDenominator(
            $enc: clinicalActivity, 
            measure == "Year2026.Mips497Rate5",
            clinicalActivity.isPresent(clinicalActivity.groupExternalIds),
            $groupExternalId memberOf clinicalActivity.groupExternalIds
        ),
        latestClinicalActivity($enc)
    )
then
    insert(new Year2026Mips497rate5DenominatorEncounterEmrGroup($groupExternalId));
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $groupExternalId, "Denominator Encounter", "M1298", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $groupExternalId, "Denominator Encounter", "M1307", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $groupExternalId, "Denominator Encounter", "M1296", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $groupExternalId, "Denominator Encounter", "M1293", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $groupExternalId, "Denominator Encounter", "M1287", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $groupExternalId, "Denominator Encounter", "M1286", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $groupExternalId, "Denominator Encounter", "M1297", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $groupExternalId, "Denominator Encounter", "M1276", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $groupExternalId, "Denominator Encounter", "M1314", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
end

rule 'Year2026.Mips497Rate5.Denominator.EMR.Provider'
salience -10
when
    $program: Program(rules contains "measure.Mips.2026.Mips497Rate5")
    $patient: Patient()
    EncounterDenominator($encounter: clinicalActivity, program == $program, measure == "Year2026.Mips497Rate5", clinicalActivity.isPresent(clinicalActivity.providerExternalId))
    not Year2026Mips497rate5DenominatorEncounterEmrProvider(providerExternalId == $encounter.providerExternalId)
    $lastEncounter: ClinicalActivity() from accumulate(
        EncounterDenominator(
            $enc: clinicalActivity, 
            measure == "Year2026.Mips497Rate5",
            clinicalActivity.isPresent(clinicalActivity.providerExternalId),
            clinicalActivity.providerExternalId == $encounter.providerExternalId
        ),
        latestClinicalActivity($enc)
    )
then
    insert(new Year2026Mips497rate5DenominatorEncounterEmrProvider($encounter.providerExternalId));
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $encounter.providerExternalId, "Denominator Encounter", "M1298", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $encounter.providerExternalId, "Denominator Encounter", "M1307", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $encounter.providerExternalId, "Denominator Encounter", "M1296", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $encounter.providerExternalId, "Denominator Encounter", "M1293", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $encounter.providerExternalId, "Denominator Encounter", "M1287", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $encounter.providerExternalId, "Denominator Encounter", "M1286", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $encounter.providerExternalId, "Denominator Encounter", "M1297", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $encounter.providerExternalId, "Denominator Encounter", "M1276", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
    controlSet.addPatientEMR($program, $patient, "Year2026.Mips497Rate5", $encounter.providerExternalId, "Denominator Encounter", "M1314", PopulationEnum.denominator, $lastEncounter, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $lastEncounter.startDate.toString());
end

/*
define "Denominator Exclusion Pregnancy M1298".all: 
   *
   * Option ID: M1298
   *
  (((["Clinical Activity": "MIPS; 128_DENOMINATOR_EXCLUSION_G9997"] 
    union ["Clinical Activity": "MIPS; 497RATE5_DENOMINATOR_EXCLUSION_M1298"])QC 
            with "Denominator" Encounter
            such that QC.start_date during Interval[start of "Measurement Period", Encounter.start_date])
        or 
    union (["Diagnosis": "VSAC; PREGNANCY"] Preg
              with "Denominator" Encounter
              such that(( Interval[Preg.start_date, Preg.stop_date] overlaps Interval[start of "Measurement Period", Encounter.start_date]
                            and Preg.stop_ date is not null or empty)
                        or Preg.start_date during Interval[start of "Measurement Period", Encounter.start_date]))
        )M1298
        ,
        ExtendedMeasureResultV2(
          M1298 //return 1 record per patient even if multiple exists
          , 'Evidence of Pregnancy' as name
          , display_date = start_date
          , calculated_record = false
          , population = Denominator Exclusion
          , option_id = M1298 
      )
*/
query queryYear2026Mips497rate5DenominatorExclusionPregnancyM1298(Program $program, ClinicalActivity $encounter, QdmDatatype $result)
    $result:= ClinicalActivity(
        withValueSet("MipsYear2026", "128_DENOMINATOR_EXCLUSION_G9997") ||
        withValueSet("MipsYear2026", "497RATE5_DENOMINATOR_EXCLUSION_M1298"),
        startsDuring($program.measurementPeriod.start, $encounter.startDate)
    )
    or $result:= Diagnosis(
        withValueSet("VsacYear2026", "PREGNANCY"),
        overlaps($program.measurementPeriod.start, $encounter.startDate),
        stopDate != null  
    )
    or $result:= Diagnosis(
        withValueSet("VsacYear2026", "PREGNANCY"),
        startsDuring($program.measurementPeriod.start, $encounter.startDate)
    )
end

rule 'Year2026.Mips497Rate5.Exclusion.pregnancy.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate5")
    $patient: Patient()
    $result: QdmDatatype() from accumulate(
        queryYear2026Mips497rate5DenominatorExclusionPregnancyM1298($program, $encounter, $r;),
        latestQdmDatatype($r)
    )
    not (exists Year2026Mips497rate5ExclusionPregnancyOrg())
then
    insert(new Year2026Mips497rate5ExclusionPregnancyOrg());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCLUSION, "M1298");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Evidence of Pregnancy", "M1298", PopulationEnum.denominator_exclusion, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

