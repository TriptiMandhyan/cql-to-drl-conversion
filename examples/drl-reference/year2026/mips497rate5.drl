/*
define "Numerator Performance Not Met M1276":
   *
   * Option ID: M1276
   *
   exists((["Clinical Activity": "MIPS; 128_PERFORMANCE_NOT_MET_G8419"]
        union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_NOT_MET_M1276"]) P
         with "Denominator" Encounter
         such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]
        union P
          with "Denominator" Encounter
          such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]) M1276Encounter
   or exists("Last BMI Before Encounter Is High")
   or exists("Last BMI Before Encounter Is Low") 
  ,
  if exists((["Clinical Activity": "MIPS; 128_PERFORMANCE_NOT_MET_G8419"]
        union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_NOT_MET_M1276"]) P
          with "Denominator" Encounter
          such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]) M1276Encounter
  then return
  ExtendedMeasureResultV2(
        M1276Encounter //return 1 record per patient even if multiple exists
        , 'Abnormal BMI without Follow-up Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Not Met
        , option_id = M1276 
    )
  else if exists("Last BMI Before Encounter Is High") HighBMIEncounter
  then return
  ExtendedMeasureResultV2(
        HighBMIEncounter //return 1 record per patient even if multiple exists
        , 'High BMI without Follow-up' as name //will return the last high BMI for each org/group/provider depending on Denominator encounter
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Not Met
        , option_id = M1276 
    )
  else if exists("Last BMI Before Encounter Is Low") LowBMIEncounter
  then return
  ExtendedMeasureResultV2(
        LowBMI //return 1 record per patient even if multiple exists
        , 'Low BMI without Follow-up' as name //will return the last BMI for each org/group/provider depending on Denominator encounter
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Not Met
        , option_id = M1276 
    )

   
define "Last BMI Before Encounter Is High":
    "Last BMI Before Encounter Result" >= 25

define "Last BMI Before Encounter Is Low": 
    "Last BMI Before Encounter Result" < 18.5
*/
rule 'Year2026.Mips497Rate5.Gap.M1276.p1.all'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate5")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_PERFORMANCE_NOT_MET_G8419") ||
            withValueSet("MipsYear2026", "497RATE5_PERFORMANCE_NOT_MET_M1276"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    )
then
    insert(new Year2026Mips497rate5PerformanceNotMetM1276());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "M1276");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Abnormal BMI without Follow-up Code", "M1276", PopulationEnum.numerator_performance_not_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    if ($encounter.isPresent($encounter.groupExternalIds)) {
        for (String groupExternalId : $encounter.getGroupExternalIds()) {
            controlSet.addGroupPatientMeasureStatus($program, $patient, groupExternalId, $measure, MeasureStatusValue.GAP, "M1276");
            controlSet.addPatientEMR($program, $patient, $measure, groupExternalId, "Abnormal BMI without Follow-up Code", "M1276", PopulationEnum.numerator_performance_not_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
        }
    }
    if ($encounter.isPresent($encounter.providerExternalId)) {
        controlSet.addProviderPatientMeasureStatus($program, $patient, $encounter.providerExternalId, $measure, MeasureStatusValue.GAP, "M1276");
        controlSet.addPatientEMR($program, $patient, $measure, $encounter.providerExternalId, "Abnormal BMI without Follow-up Code", "M1276", PopulationEnum.numerator_performance_not_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
    }
end

rule 'Year2026.Mips497Rate5.Gap.M1276.p2.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate5")
    $patient: Patient()
    Year2026Mips497rate5LastBMIBeforeEncounterOrg(
        encounterStartDate == $encounter.startDate,
        $bmi: bmi,
        $bmiResult: bmiResult,
        bmiResult >= 25 ||
        bmiResult < 18.5
    )
then
    insert(new Year2026Mips497rate5PerformanceNotMetM1276());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.GAP, "M1276");
    String evidenceLabel = $bmiResult >= 25 ? "High BMI without Follow-up" : "Low BMI without Follow-up";
    controlSet.addPatientEMR($program, $patient, $measure, "", evidenceLabel, "M1276", PopulationEnum.numerator_performance_not_met, $bmi, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $bmi.startDate.toString());
end

rule 'Year2026.Mips497Rate5.Gap.M1276.p2.group'
when
