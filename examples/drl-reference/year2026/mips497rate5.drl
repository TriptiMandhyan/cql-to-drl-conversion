    $patient: Patient()
    $groupExternalId: String() from $encounter.getGroupExternalIds()
    Year2026Mips497rate5LastBMIBeforeEncounterGroup(
        encounterStartDate == $encounter.startDate,
        $bmi: bmi,
        $bmiResult: bmiResult,
        bmiResult >= 25 ||
        bmiResult < 18.5,
        groupExternalId == $groupExternalId
    )
then
    insert(new Year2026Mips497rate5PerformanceNotMetM1276());
    controlSet.addGroupPatientMeasureStatus($program, $patient, $groupExternalId, $measure, MeasureStatusValue.GAP, "M1276");
    String evidenceLabel = $bmiResult >= 25 ? "High BMI without Follow-up" : "Low BMI without Follow-up";
    controlSet.addPatientEMR($program, $patient, $measure, $groupExternalId, evidenceLabel, "M1276", PopulationEnum.numerator_performance_not_met, $bmi, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $bmi.startDate.toString());
end

rule 'Year2026.Mips497Rate5.Gap.M1276.p2.provider'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate5")
    $patient: Patient()
    Year2026Mips497rate5LastBMIBeforeEncounterProvider(
        encounterStartDate == $encounter.startDate,
        $bmi: bmi,
        $bmiResult: bmiResult,
