/*
define "Numerator Performance Met M1296".org:
   *
   * Option ID: M1296
   *
((((["Clinical Activity": "MIPS; 128_PERFORMANCE_MET_G8420"]
  union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_MET_M1296"]) P
    with "Denominator" Encounter
    such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date])c
  and not exists("Last Qualifying Encounter with BMI".org LastEncounterBMI
                  where LastEncounterBMI after Encounter.start_date) M1296
union "Last BMI Before Encounter Is Normal".org)LastBMINormal) 
  ,
  if exists ((["Clinical Activity": "MIPS; 128_PERFORMANCE_MET_G8420"]
             union ["Clinical Activity": "MIPS; 497RATE5_PERFORMANCE_MET_M1296"]) P
                with "Denominator" Encounter
                such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date])
              and not exists("Last Qualifying Encounter with BMI".org LastEncounterBMI
                  where LastEncounterBMI after Encounter.start_date) M1296
  then return
  ExtendedMeasureResultV2(
        M1296 //return 1 record per patient even if multiple exists
        , 'Normal BMI Quality Code' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1296 
    )
  else if exists("Last BMI Before Encounter Is Normal".org)LastBMINormal
  then return
  ExtendedMeasureResultV2(
        LastBMINormal //return 1 record per patient even if multiple exists
        , 'Normal BMI' as name
        , display_date = start_date
        , calculated_record = false
        , population = Numerator Performance Met
        , option_id = M1296 
    )

define "Last BMI Before Encounter Is Normal":
    "Last BMI Before Encounter Result" >= 18.5
    and "Last BMI Before Encounter Result" < 25

Note: CQL outputs EMR for both branches (M1296 quality code and normal BMI), so keep both.
*/
rule 'Year2026.Mips497Rate5.Success.M1296.p1.Org'
salience 30
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate5")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_PERFORMANCE_MET_G8420") ||
            withValueSet("MipsYear2026", "497RATE5_PERFORMANCE_MET_M1296"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    )
    and not (exists Year2026Mips497rate5LastBMIBeforeEncounterOrg(encounterStartDate.isAfter($encounter.startDate)))
    and not (exists Year2026Mips497rate5M1296OrgEmr())
then
    insert (new Year2026Mips497rate5M1296OrgEmr());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.SUCCESS, "M1296");
    controlSet.addPatientEMR($program, $patient, $measure, "", "Normal BMI Quality Code", "M1296", PopulationEnum.numerator_performance_met, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());

end

rule 'Year2026.Mips497Rate5.Success.M1296.p2.Org'
salience 40
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate5")
    $patient: Patient()
    Year2026Mips497rate5LastBMIBeforeEncounterOrg(
        encounterStartDate == $encounter.startDate,
        $bmi: bmi,
        bmiResult >= 18.5,
