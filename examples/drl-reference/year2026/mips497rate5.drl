/*
define "Denominator Exception M1286".org:
   *
   * Option ID: M1286
   *
((["Clinical Activity": "MIPS; 128_DENOMINATOR_EXCEPTION_G9716"] 
  union ["Clinical Activity": "MIPS; 497RATE5_DENOMINATOR_EXCEPTION_M1286"]) P
    with "Denominator" Encounter
    such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]
  and not exists ("Last Qualifying Encounter with BMI".org BMIEncounter
                   where BMIEncounter.start_date after Encounter.start_date))M1286Org
 ,
 return
 ExtendedMeasureResultV2(
      M1286Org //return 1 record per patient even if multiple exists
      , 'Abnormal BMI Follow-up Not Indicated' as name
      , display_date = start_date
      , calculated_record = false
      , population = Denominator Exception
      , option_id = M1286 
  )
*/
rule 'Year2026.Mips497Rate5.Exception.M1286.org'
when
    EncounterDenominator($program: program, $encounter: clinicalActivity, $measure: measure == "Year2026.Mips497Rate5")
    $patient: Patient()
    $result: ClinicalActivity() from accumulate(
        $r: ClinicalActivity(
            withValueSet("MipsYear2026", "128_DENOMINATOR_EXCEPTION_G9716")  ||
            withValueSet("MipsYear2026", "497RATE5_DENOMINATOR_EXCEPTION_M1286"),
            startsDuring($encounter)
        ),
        latestClinicalActivity($r)
    )
    and not (exists Year2026Mips497rate5LastBMIBeforeEncounterOrg(encounterStartDate.isAfter($encounter.startDate)))
    and not (exists Year2026Mips497rate5DenominatorExceptionM1286Emr())
then
    insert(new Year2026Mips497rate5DenominatorExceptionM1286Emr());
    controlSet.addPatientMeasureStatus($program, $patient, $measure, MeasureStatusValue.EXCEPTION, "M1286");    
    controlSet.addPatientEMR($program, $patient, $measure, "", "Abnormal BMI Follow-up Not Indicated", "M1286", PopulationEnum.denominator_exception, $result, SupplementalInfoEnum.DISPLAY_DATE.displayName(), $result.startDate.toString());
end

/*
define "Denominator Exception M1286".group:
   *
   * Option ID: M1286
   *
((["Clinical Activity": "MIPS; 128_DENOMINATOR_EXCEPTION_G9716"]
  union ["Clinical Activity": "MIPS; 497RATE5_DENOMINATOR_EXCEPTION_M1286"]) P
    with "Denominator" Encounter
    such that P.start_date during Interval[Encounter.start_date, Encounter.stop_date]
  and not exists ("Last Qualifying Encounter with BMI".group BMIEncounter 
                  where BMIEncounter.group_id = Encounter.group_id
                        and BMIEncounter.start_date after Encounter.start_date )) M1286Group
  ,
  return
  ExtendedMeasureResultV2(
      M1286Group //return 1 record per patient even if multiple exists
